        d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
            .didPrepareRuntimeNativeProbeD3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness,
        true,
        d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
            .shouldContinueExternalPacketPromotionAdmissionRoute &&
            d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
                .didConfirmExternalValidatedPacketShapeAdmitted,
        d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
            .didConfirmExternalMetalCapablePacketProvenanceRequired,
        d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
            .didConfirmExternalValidatedPacketShapeAdmitted &&
