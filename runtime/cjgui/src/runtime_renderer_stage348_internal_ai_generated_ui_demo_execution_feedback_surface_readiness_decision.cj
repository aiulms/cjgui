        .didKeepOwnerAcceptanceNotGranted && executionFeedbackSurfaceReadinessDecisionFacts.didKeepBackendReadyTruthBlocked && executionFeedbackSurfaceReadinessDecisionFacts
        .didKeepPublicComponentApiBlocked && executionFeedbackSurfaceReadinessDecisionFacts.didKeepActionDispatchBlocked && executionFeedbackSurfaceReadinessDecisionFacts
        .didKeepStateUpdateCommittedBlocked && executionFeedbackSurfaceReadinessDecisionFacts.didKeepRendererSubmissionBlocked &&
        executionFeedbackSurfaceReadinessDecisionFacts.didKeepRendererStateWriteBlocked && executionFeedbackSurfaceReadinessDecisionFacts
        .didKeepRuntimeStateWriteBlocked && executionFeedbackSurfaceReadinessDecisionFacts.didKeepVisibilityNotPublished

    return CjguiInternalRendererStage348InternalAiGeneratedUiDemoExecutionFeedbackSurfaceReadinessDecisionReadiness(
        executionFeedbackSurfaceProbeInputResultEnvelope,
        executionFeedbackSurfaceReadinessDecisionFacts,
        decisionReady && stopLineReady,
        decisionReady && stopLineReady,
        executionFeedbackSurfaceReadinessDecisionFacts.didJoinExecutionFeedbackSurfaceRefreshWithSemanticDiffExplain,
        executionFeedbackSurfaceReadinessDecisionFacts.didJoinExecutionFeedbackSurfaceProbeInputWithResultEnvelope,
        executionFeedbackSurfaceReadinessDecisionFacts.didJoinExecutionFeedbackSurfaceRunwayWithRollbackVisibilityBoundary,
        executionFeedbackSurfaceReadinessDecisionFacts.didMaterializeInternalAiGeneratedUiDemoExecutionFeedbackSurfaceReadinessDecision,
        executionFeedbackSurfaceReadinessDecisionFacts.didPrepareStage349InternalAiGeneratedUiDemoExecutionFeedbackSurfaceToProbeRefresh,
