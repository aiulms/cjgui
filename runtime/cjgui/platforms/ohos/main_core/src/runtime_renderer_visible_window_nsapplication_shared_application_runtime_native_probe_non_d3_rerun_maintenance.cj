    let didRequireAnchoredPacketIntegrityGuard: Bool
    let didRequireFailureDomainReplay: Bool
    let didRequireOrchestrationRunner: Bool
    let didRequireMaintenanceAggregateGuard: Bool
    let didKeepAutomationEnvironmentBlockerClassified: Bool
    let didKeepCodeFailureDomainFalse: Bool
    let didKeepD3RuntimeNativeProbeApprovalExternal: Bool
    let didKeepRuntimeNativeProbeExecutionBlocked: Bool
    let didConfirmNoApplicationAccessorCall: Bool
    let didConfirmNoNativeBridgeExpansion: Bool
    let didConfirmNoSingletonCreation: Bool
    let didConfirmNoPublicApi: Bool
    let didConfirmNoProductionPublicCAbi: Bool
    let didConfirmNoRendererStateWrite: Bool
    let didConfirmNoRuntimeStateWrite: Bool
    let didConfirmNoCjpmTomlChange: Bool
    let didAvoidSameShapeNoAccessorWrapper: Bool
    let didKeepNonD3RerunMaintenanceDehydrated: Bool

    init(
        didConsumeSourceBuildProbeEvidenceReadiness: Bool,
        didOpenNonD3RerunMaintenanceRoute: Bool,
        didRequireFreshFocusedRegressionSuiteRerun: Bool,
        didRequireAnchoredPacketIntegrityGuard: Bool,
        didRequireFailureDomainReplay: Bool,
        didRequireOrchestrationRunner: Bool,
        didRequireMaintenanceAggregateGuard: Bool,
        didKeepAutomationEnvironmentBlockerClassified: Bool,
        didKeepCodeFailureDomainFalse: Bool,
        didKeepD3RuntimeNativeProbeApprovalExternal: Bool,
        didKeepRuntimeNativeProbeExecutionBlocked: Bool,
        didConfirmNoApplicationAccessorCall: Bool,
        didConfirmNoNativeBridgeExpansion: Bool,
        didConfirmNoSingletonCreation: Bool,
        didConfirmNoPublicApi: Bool,
        didConfirmNoProductionPublicCAbi: Bool,
        didConfirmNoRendererStateWrite: Bool,
        didConfirmNoRuntimeStateWrite: Bool,
        didConfirmNoCjpmTomlChange: Bool,
        didAvoidSameShapeNoAccessorWrapper: Bool,
        didKeepNonD3RerunMaintenanceDehydrated: Bool
    ) {
        this.didConsumeSourceBuildProbeEvidenceReadiness =
            didConsumeSourceBuildProbeEvidenceReadiness
        this.didOpenNonD3RerunMaintenanceRoute =
            didOpenNonD3RerunMaintenanceRoute
        this.didRequireFreshFocusedRegressionSuiteRerun =
            didRequireFreshFocusedRegressionSuiteRerun
        this.didRequireAnchoredPacketIntegrityGuard =
            didRequireAnchoredPacketIntegrityGuard
        this.didRequireFailureDomainReplay = didRequireFailureDomainReplay
        this.didRequireOrchestrationRunner = didRequireOrchestrationRunner
        this.didRequireMaintenanceAggregateGuard =
            didRequireMaintenanceAggregateGuard
        this.didKeepAutomationEnvironmentBlockerClassified =
            didKeepAutomationEnvironmentBlockerClassified
        this.didKeepCodeFailureDomainFalse = didKeepCodeFailureDomainFalse
        this.didKeepD3RuntimeNativeProbeApprovalExternal =
            didKeepD3RuntimeNativeProbeApprovalExternal
        this.didKeepRuntimeNativeProbeExecutionBlocked =
            didKeepRuntimeNativeProbeExecutionBlocked
        this.didConfirmNoApplicationAccessorCall =
            didConfirmNoApplicationAccessorCall
        this.didConfirmNoNativeBridgeExpansion =
            didConfirmNoNativeBridgeExpansion
        this.didConfirmNoSingletonCreation = didConfirmNoSingletonCreation
        this.didConfirmNoPublicApi = didConfirmNoPublicApi
        this.didConfirmNoProductionPublicCAbi =
            didConfirmNoProductionPublicCAbi
        this.didConfirmNoRendererStateWrite =
            didConfirmNoRendererStateWrite
        this.didConfirmNoRuntimeStateWrite = didConfirmNoRuntimeStateWrite
        this.didConfirmNoCjpmTomlChange = didConfirmNoCjpmTomlChange
        this.didAvoidSameShapeNoAccessorWrapper =
            didAvoidSameShapeNoAccessorWrapper
        this.didKeepNonD3RerunMaintenanceDehydrated =
            didKeepNonD3RerunMaintenanceDehydrated
    }
}

