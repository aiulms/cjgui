func cjguiInternalBuildRendererStage750AiGeneratedUiPublicSurfacePreflightPlan(
    ownerAcceptancePreflight: CjguiInternalRendererStage749AiGeneratedUiOwnerAcceptancePreflightReadiness): CjguiInternalRendererStage750AiGeneratedUiPublicSurfacePreflightPlan {
    let stage749Ready = ownerAcceptancePreflight.didConfirmStage749AiGeneratedUiOwnerAcceptancePreflightReady && ownerAcceptancePreflight
        .didConfirmStage750AiGeneratedUiPublicSurfacePreflightPrepared
    let acceptanceLedgerReady = ownerAcceptancePreflight.didConfirmOwnerAcceptanceCandidateLedgerMaterialized && ownerAcceptancePreflight
        .didConfirmOwnerRiskClassificationLedgerMaterialized && ownerAcceptancePreflight
        .didConfirmOwnerRejectReasonLedgerMaterialized && ownerAcceptancePreflight
        .didConfirmChatComposerAiGeneratedUiOwnerAcceptancePreflightMaterialized
    let preflightReady = stage749Ready && acceptanceLedgerReady &&
        cjguiInternalRendererStage750AiGeneratedUiPublicSurfacePreflightMaterialized()
    return CjguiInternalRendererStage750AiGeneratedUiPublicSurfacePreflightPlan(
        stage749Ready,
        acceptanceLedgerReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        ownerAcceptancePreflight.didConfirmOwnerAcceptancePreflightBoundToAiGeneratedUiRuntimeManager,
        preflightReady,
        ownerAcceptancePreflight.didConfirmStablePublicApiAdded == false,
        ownerAcceptancePreflight.didConfirmRendererSubmissionBlocked,
        ownerAcceptancePreflight.didConfirmRendererStateWriteBlocked,
        ownerAcceptancePreflight.didConfirmRuntimeStateWriteBlocked
    )
}

