        .didMaterializeOwnerAcceptancePreflightRows && ownerAcceptancePreflightPlan
        .didMaterializeOwnerAcceptanceCandidateLedger && ownerAcceptancePreflightPlan
        .didMaterializeOwnerRiskClassificationLedger && ownerAcceptancePreflightPlan
        .didMaterializeOwnerRejectReasonLedger && ownerAcceptancePreflightPlan
