        teardownReadiness.didConfirmTeardownOrderingEvidenceStillRequired &&
        teardownReadiness.didConfirmTeardownBeforeVisibleEvidenceRequired &&
        teardownReadiness.didConfirmBoundedOwnerShutdownEvidenceRequired &&
        teardownReadiness
            .didConfirmStopConditionBeforeTeardownEvidenceRequired &&
        teardownReadiness.didConfirmAutoCloseCleanupEvidenceRequired &&
        teardownReadiness.didConfirmFailClosedTeardownRouteRequired &&
        teardownReadiness.didConfirmHeadlessArtifactPolicyEvidenceOnly &&
        teardownReadiness.didConfirmActualTeardownExecutionStillBlocked &&
        teardownReadiness.didConfirmActualEventLoopStillBlocked &&
        teardownReadiness.didConfirmActualRunLoopPumpStillBlocked &&
        teardownReadiness
            .didConfirmActualApplicationSingletonAccessorCallStillBlocked &&
        teardownReadiness.didConfirmNoApplicationSingletonAccessorCall &&
        teardownReadiness.didConfirmApplicationSingletonCreationStillBlocked &&
        teardownReadiness.didConfirmApplicationSideEffectStillBlocked &&
        teardownReadiness.didConfirmActivationPolicyMutationStillBlocked &&
        teardownReadiness.didConfirmApplicationActivationStillBlocked &&
        teardownReadiness.didConfirmNativeVisibleOrderStillBlocked &&
        teardownReadiness.didConfirmProductionDrawableStillBlocked &&
        teardownReadiness.didConfirmRenderStillBlocked &&
        teardownReadiness.didConfirmNoApplicationCreationOrActivation &&
        teardownReadiness.didConfirmNoPointerHandleClassIdReturn &&
        teardownReadiness.didConfirmNoPublicSurface &&
        teardownReadiness.didConfirmNoPublicCAbi &&
        teardownReadiness.didConfirmNoRendererStateWrite &&
        teardownReadiness.didConfirmNoBackendReadyTruth &&
        teardownReadiness
            .didKeepNsApplicationSharedApplicationTeardownOrderingEvidenceReadinessDehydrated

    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationHeadlessArtifactPolicyEvidenceFacts(
        upstreamReady,
        teardownReadiness.didConfirmHeadlessArtifactPolicyEvidenceOnly,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        teardownReadiness.didConfirmTeardownOrderingEvidenceStillRequired,
        teardownReadiness.didConfirmTeardownBeforeVisibleEvidenceRequired,
        teardownReadiness.didConfirmBoundedOwnerShutdownEvidenceRequired,
        teardownReadiness
            .didConfirmStopConditionBeforeTeardownEvidenceRequired,
        teardownReadiness.didConfirmAutoCloseCleanupEvidenceRequired,
        teardownReadiness.didConfirmFailClosedTeardownRouteRequired,
        teardownReadiness.didConfirmActualTeardownExecutionStillBlocked,
        teardownReadiness.didConfirmActualEventLoopStillBlocked,
        teardownReadiness.didConfirmActualRunLoopPumpStillBlocked,
        teardownReadiness.didConfirmLifecycleOwnerEvidenceStillRequired,
        teardownReadiness
            .didConfirmApplicationSingletonOwnershipEvidenceStillRequired,
        teardownReadiness.didConfirmSideEffectContainmentEvidenceStillRequired,
        teardownReadiness
            .didConfirmActualApplicationSingletonAccessorCallStillBlocked,
        teardownReadiness.didConfirmNoApplicationSingletonAccessorCall,
        teardownReadiness.didConfirmApplicationSingletonCreationStillBlocked,
        teardownReadiness.didConfirmApplicationSideEffectStillBlocked,
        teardownReadiness.didConfirmActivationPolicyMutationStillBlocked,
