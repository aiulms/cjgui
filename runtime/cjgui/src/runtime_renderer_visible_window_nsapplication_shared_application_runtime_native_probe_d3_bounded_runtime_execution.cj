// 中文维护注释：本文件是 visible-window production harness NSApplication
// shared-application runtime native-readiness D3 bounded runtime execution owner。
// Owner: runtime renderer internal D3 bounded runtime native execution route
// owner。
// Truth: 只消费 stage101 two-key handoff readiness，并把 automation standing
// D3 权限收敛成 bounded first-slice contract：先跑 capability detector；只有
// detector 返回 Metal-capable 时才允许执行 isolated visible-window native
// probe 并产出 result envelope。当前 owner 不直接执行 native probe，不写
// renderer state，不扩 production bridge，不升级 production truth。
// Stop-line: 不新增 production accessor call site，不调用 production
// application singleton accessor，不修改 activation policy，不扩 native bridge /
// public API / production C ABI，不写 runtime_state.cj / cjpm.toml / renderer
// state，不把 isolated probe evidence 解释成 backend-ready truth。
// Same-shape Boundary Brake: 本 owner 必须表达 bounded D3 runtime execution
// route 与 result-envelope contract，不得退化成 approval handoff、external
// packet、two-key handoff、environment recovery、no-runtime-execution 或 report
// wrapper。
package cjgui

struct CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedRuntimeExecutionFacts {
    let didConsumeRendererStateTwoKeyHandoffReadiness: Bool
    let didOpenBoundedD3RuntimeExecutionRoute: Bool
    let didRequireCapabilityDetectorBeforeExecution: Bool
    let didAllowAutomationStandingD3WhenMetalCapable: Bool
    let didRequireCurrentShellClassificationBeforeNativeExecution: Bool
    let didPermitIsolatedVisibleWindowProbeOnly: Bool
    let didRequireResultEnvelopeFromProbe: Bool
    let didKeepRendererStateWriteBlocked: Bool
    let didConfirmNonMetalShellDoesNotExecuteNativeProbe: Bool
    let didConfirmResultEnvelopeIsNotProductionTruth: Bool
    let didConfirmNoProductionApplicationAccessorCall: Bool
    let didConfirmNoNativeBridgeExpansion: Bool
    let didConfirmNoPublicApi: Bool
    let didConfirmNoProductionPublicCAbi: Bool
    let didConfirmNoRuntimeStateWrite: Bool
    let didConfirmNoCjpmTomlChange: Bool
    let didConfirmNoRendererStateWrite: Bool
    let didAvoidApprovalHandoffWrapper: Bool

    init(
        didConsumeRendererStateTwoKeyHandoffReadiness: Bool,
        didOpenBoundedD3RuntimeExecutionRoute: Bool,
        didRequireCapabilityDetectorBeforeExecution: Bool,
        didAllowAutomationStandingD3WhenMetalCapable: Bool,
        didRequireCurrentShellClassificationBeforeNativeExecution: Bool,
        didPermitIsolatedVisibleWindowProbeOnly: Bool,
        didRequireResultEnvelopeFromProbe: Bool,
        didKeepRendererStateWriteBlocked: Bool,
        didConfirmNonMetalShellDoesNotExecuteNativeProbe: Bool,
        didConfirmResultEnvelopeIsNotProductionTruth: Bool,
        didConfirmNoProductionApplicationAccessorCall: Bool,
        didConfirmNoNativeBridgeExpansion: Bool,
        didConfirmNoPublicApi: Bool,
        didConfirmNoProductionPublicCAbi: Bool,
        didConfirmNoRuntimeStateWrite: Bool,
        didConfirmNoCjpmTomlChange: Bool,
        didConfirmNoRendererStateWrite: Bool,
        didAvoidApprovalHandoffWrapper: Bool
    ) {
        this.didConsumeRendererStateTwoKeyHandoffReadiness =
            didConsumeRendererStateTwoKeyHandoffReadiness
        this.didOpenBoundedD3RuntimeExecutionRoute =
            didOpenBoundedD3RuntimeExecutionRoute
        this.didRequireCapabilityDetectorBeforeExecution =
            didRequireCapabilityDetectorBeforeExecution
        this.didAllowAutomationStandingD3WhenMetalCapable =
            didAllowAutomationStandingD3WhenMetalCapable
        this.didRequireCurrentShellClassificationBeforeNativeExecution =
            didRequireCurrentShellClassificationBeforeNativeExecution
        this.didPermitIsolatedVisibleWindowProbeOnly =
            didPermitIsolatedVisibleWindowProbeOnly
        this.didRequireResultEnvelopeFromProbe =
            didRequireResultEnvelopeFromProbe
        this.didKeepRendererStateWriteBlocked =
            didKeepRendererStateWriteBlocked
        this.didConfirmNonMetalShellDoesNotExecuteNativeProbe =
            didConfirmNonMetalShellDoesNotExecuteNativeProbe
        this.didConfirmResultEnvelopeIsNotProductionTruth =
            didConfirmResultEnvelopeIsNotProductionTruth
        this.didConfirmNoProductionApplicationAccessorCall =
            didConfirmNoProductionApplicationAccessorCall
        this.didConfirmNoNativeBridgeExpansion =
            didConfirmNoNativeBridgeExpansion
        this.didConfirmNoPublicApi = didConfirmNoPublicApi
        this.didConfirmNoProductionPublicCAbi =
            didConfirmNoProductionPublicCAbi
        this.didConfirmNoRuntimeStateWrite = didConfirmNoRuntimeStateWrite
        this.didConfirmNoCjpmTomlChange = didConfirmNoCjpmTomlChange
        this.didConfirmNoRendererStateWrite = didConfirmNoRendererStateWrite
        this.didAvoidApprovalHandoffWrapper = didAvoidApprovalHandoffWrapper
    }
}

