func cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryFacts(
    explicitApprovalReplayCheckpointReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeExplicitApprovalReplayCheckpointReadiness
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryFacts {
    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryFacts(
        explicitApprovalReplayCheckpointReadiness
            .didPrepareRuntimeNativeProbeExplicitApprovalReplayCheckpointReadiness,
        true,
        true,
        true,
        true,
        explicitApprovalReplayCheckpointReadiness
            .didConfirmHumanApprovedD3ExecutionUnconsumed,
        explicitApprovalReplayCheckpointReadiness
            .didConfirmRuntimeNativeProbeExecutionStillBlocked,
        true,
        true,
        true,
        true,
        explicitApprovalReplayCheckpointReadiness
            .shouldContinueNonD3ExplicitApprovalReplayCheckpointRoute,
        explicitApprovalReplayCheckpointReadiness.didConfirmCodeFailureDomainFalse,
        explicitApprovalReplayCheckpointReadiness
            .didConfirmNoApplicationAccessorCall,
        explicitApprovalReplayCheckpointReadiness.didConfirmNoNativeBridgeExpansion,
        explicitApprovalReplayCheckpointReadiness.didConfirmNoPublicApi,
        explicitApprovalReplayCheckpointReadiness.didConfirmNoProductionPublicCAbi,
        explicitApprovalReplayCheckpointReadiness.didConfirmNoRendererStateWrite,
        explicitApprovalReplayCheckpointReadiness.didConfirmNoRuntimeStateWrite,
        explicitApprovalReplayCheckpointReadiness.didConfirmNoCjpmTomlChange,
        explicitApprovalReplayCheckpointReadiness.didAvoidSameShapeNoAccessorWrapper,
        explicitApprovalReplayCheckpointReadiness
            .didKeepExplicitApprovalReplayCheckpointDehydrated
    )
}

func cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryReadiness(
    explicitApprovalReplayCheckpointReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeExplicitApprovalReplayCheckpointReadiness,
    d3EnvironmentRecoveryFacts:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryFacts
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryReadiness {
    let recoveryReady =
        d3EnvironmentRecoveryFacts
            .didConsumeExplicitApprovalReplayCheckpointReadiness &&
        d3EnvironmentRecoveryFacts.didOpenD3EnvironmentRecoveryRoute &&
        d3EnvironmentRecoveryFacts.didObserveCurrentShellMetalUnavailable &&
        d3EnvironmentRecoveryFacts
            .didClassifyFailureDomainAsAutomationEnvironment &&
        d3EnvironmentRecoveryFacts
            .didRequireExternalMetalCapableShellForD3Execution &&
        d3EnvironmentRecoveryFacts.didKeepD3LimitedApprovalUnconsumed &&
        d3EnvironmentRecoveryFacts
            .didKeepRuntimeNativeProbeExecutionBlockedByEnvironment &&
        d3EnvironmentRecoveryFacts.didRequireBoundedNativeFailClosedPacket &&
        d3EnvironmentRecoveryFacts.didRequireRecoveryClassifier &&
        d3EnvironmentRecoveryFacts.didRequireSourceBuildRecoveryGuard &&
        d3EnvironmentRecoveryFacts.didRequireFocusedRecoverySuite &&
        d3EnvironmentRecoveryFacts.didConfirmReplayCheckpointReusable &&
        d3EnvironmentRecoveryFacts.didConfirmCodeFailureDomainFalse &&
        d3EnvironmentRecoveryFacts.didConfirmNoApplicationAccessorCall &&
        d3EnvironmentRecoveryFacts.didConfirmNoNativeBridgeExpansion &&
        d3EnvironmentRecoveryFacts.didConfirmNoPublicApi &&
        d3EnvironmentRecoveryFacts.didConfirmNoProductionPublicCAbi &&
        d3EnvironmentRecoveryFacts.didConfirmNoRendererStateWrite &&
        d3EnvironmentRecoveryFacts.didConfirmNoRuntimeStateWrite &&
        d3EnvironmentRecoveryFacts.didConfirmNoCjpmTomlChange &&
        d3EnvironmentRecoveryFacts.didAvoidSameShapeNoAccessorWrapper &&
        d3EnvironmentRecoveryFacts.didKeepD3EnvironmentRecoveryDehydrated

    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryReadiness(
        explicitApprovalReplayCheckpointReadiness,
        d3EnvironmentRecoveryFacts,
        recoveryReady,
        recoveryReady,
        recoveryReady,
        !recoveryReady,
        d3EnvironmentRecoveryFacts
            .didConsumeExplicitApprovalReplayCheckpointReadiness,
        d3EnvironmentRecoveryFacts.didObserveCurrentShellMetalUnavailable,
        d3EnvironmentRecoveryFacts
            .didClassifyFailureDomainAsAutomationEnvironment,
        d3EnvironmentRecoveryFacts
            .didRequireExternalMetalCapableShellForD3Execution,
        d3EnvironmentRecoveryFacts.didKeepD3LimitedApprovalUnconsumed,
        d3EnvironmentRecoveryFacts
            .didKeepRuntimeNativeProbeExecutionBlockedByEnvironment,
        d3EnvironmentRecoveryFacts.didRequireBoundedNativeFailClosedPacket,
        d3EnvironmentRecoveryFacts.didRequireRecoveryClassifier,
        d3EnvironmentRecoveryFacts.didRequireSourceBuildRecoveryGuard,
        d3EnvironmentRecoveryFacts.didRequireFocusedRecoverySuite,
        d3EnvironmentRecoveryFacts.didConfirmReplayCheckpointReusable,
        d3EnvironmentRecoveryFacts.didConfirmCodeFailureDomainFalse,
        d3EnvironmentRecoveryFacts.didConfirmNoApplicationAccessorCall,
        d3EnvironmentRecoveryFacts.didConfirmNoNativeBridgeExpansion,
        d3EnvironmentRecoveryFacts.didConfirmNoPublicApi,
        d3EnvironmentRecoveryFacts.didConfirmNoProductionPublicCAbi,
        d3EnvironmentRecoveryFacts.didConfirmNoRendererStateWrite,
        d3EnvironmentRecoveryFacts.didConfirmNoRuntimeStateWrite,
        d3EnvironmentRecoveryFacts.didConfirmNoCjpmTomlChange,
        d3EnvironmentRecoveryFacts.didAvoidSameShapeNoAccessorWrapper,
        d3EnvironmentRecoveryFacts.didKeepD3EnvironmentRecoveryDehydrated
    )
}

func cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryDraft():
    CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryReadiness {
    let explicitApprovalReplayCheckpointReadiness =
        cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeExplicitApprovalReplayCheckpointDraft()
    let d3EnvironmentRecoveryFacts =
        cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryFacts(
            explicitApprovalReplayCheckpointReadiness
        )
    return cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryReadiness(
        explicitApprovalReplayCheckpointReadiness,
        d3EnvironmentRecoveryFacts
    )
}
