        .didKeepOwnerAcceptanceNotGranted && ownerAcceptancePreflightFacts.didKeepProductionRenderTruthBlocked && ownerAcceptancePreflightFacts
        .didKeepBackendReadyTruthBlocked && ownerAcceptancePreflightFacts.didKeepPublicComponentApiBlocked && ownerAcceptancePreflightFacts
        .didKeepStablePublicApiNotAdded && ownerAcceptancePreflightFacts.didKeepInputEventPipelineExecutionBlocked && ownerAcceptancePreflightFacts
        .didKeepActionDispatchBlocked && ownerAcceptancePreflightFacts.didKeepStateUpdateCommittedBlocked && ownerAcceptancePreflightFacts
        .didKeepVisibilityPublicationAdmittedBlocked && ownerAcceptancePreflightFacts.didKeepVisibilityPublishedBlocked &&
        ownerAcceptancePreflightPlan.didKeepRendererSubmissionBlocked && ownerAcceptancePreflightPlan
        .didKeepRendererStateWriteBlocked && ownerAcceptancePreflightPlan.didKeepRuntimeStateWriteBlocked && ownerAcceptancePreflightFacts
        .didKeepNativeBridgeExpansionBlocked
    return CjguiInternalRendererStage749AiGeneratedUiOwnerAcceptancePreflightReadiness(
        runtimeManager,
        ownerAcceptancePreflightPlan,
        ownerAcceptancePreflightFacts,
        preflightReady && stopLineReady,
        ownerAcceptancePreflightPlan.didConsumeStage748AiGeneratedUiRuntimeManager,
        runtimeManager.didConfirmStage747AiGeneratedUiHostInspectionSurfaceConsumed,
        runtimeManager.didConfirmStage746AiGeneratedUiOwnerReviewPreflightConsumedTransitively,
        runtimeManager.didConfirmStage745AiGeneratedUiDslDryRunConsumedTransitively,
        ownerAcceptancePreflightPlan.didConsumeAiGeneratedUiAuthoringRuntimeContract,
        ownerAcceptancePreflightPlan.didMaterializeOwnerAcceptancePreflightRows,
        ownerAcceptancePreflightPlan.didMaterializeOwnerAcceptanceCandidateLedger,
        ownerAcceptancePreflightPlan.didMaterializeOwnerRiskClassificationLedger,
        ownerAcceptancePreflightPlan.didMaterializeOwnerRejectReasonLedger,
        ownerAcceptancePreflightPlan.didMaterializeTodoAiGeneratedUiOwnerAcceptancePreflight,
        ownerAcceptancePreflightPlan.didMaterializeSettingsAiGeneratedUiOwnerAcceptancePreflight,
        ownerAcceptancePreflightPlan.didMaterializeAiGeneratedSettingsAiGeneratedUiOwnerAcceptancePreflight,
        ownerAcceptancePreflightPlan.didMaterializeChatComposerAiGeneratedUiOwnerAcceptancePreflight,
        ownerAcceptancePreflightPlan.didBindOwnerAcceptancePreflightToAiGeneratedUiRuntimeManager,
        ownerAcceptancePreflightPlan.didPrepareStage750AiGeneratedUiPublicSurfacePreflight,
        false,
        ownerAcceptancePreflightFacts.didKeepOwnerAcceptanceRequired,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        ownerAcceptancePreflightPlan.didKeepRendererSubmissionBlocked,
        ownerAcceptancePreflightPlan.didKeepRendererStateWriteBlocked,
        ownerAcceptancePreflightPlan.didKeepRuntimeStateWriteBlocked,
