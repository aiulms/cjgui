func cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeAdmissionFacts(
    d3EnvironmentRecoveryReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryReadiness
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeAdmissionFacts {
    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeAdmissionFacts(
        d3EnvironmentRecoveryReadiness
            .didPrepareRuntimeNativeProbeD3EnvironmentRecoveryReadiness,
        true,
        d3EnvironmentRecoveryReadiness
            .didConfirmExternalMetalCapableShellRequired,
        true,
        d3EnvironmentRecoveryReadiness
            .didConfirmBoundedNativeFailClosedPacketRequired,
        true,
        true,
        true,
        true,
        true,
        true,
        d3EnvironmentRecoveryReadiness
            .didConfirmRuntimeNativeProbeExecutionBlockedByEnvironment,
        d3EnvironmentRecoveryReadiness.didConfirmD3LimitedApprovalUnconsumed,
        d3EnvironmentRecoveryReadiness.didConfirmCodeFailureDomainFalse,
        d3EnvironmentRecoveryReadiness.didConfirmNoApplicationAccessorCall,
        d3EnvironmentRecoveryReadiness.didConfirmNoNativeBridgeExpansion,
        d3EnvironmentRecoveryReadiness.didConfirmNoPublicApi,
        d3EnvironmentRecoveryReadiness.didConfirmNoProductionPublicCAbi,
        d3EnvironmentRecoveryReadiness.didConfirmNoRendererStateWrite,
        d3EnvironmentRecoveryReadiness.didConfirmNoRuntimeStateWrite,
        d3EnvironmentRecoveryReadiness.didConfirmNoCjpmTomlChange,
        true,
        true
    )
}

func cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeAdmissionReadiness(
    d3EnvironmentRecoveryReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryReadiness,
    d3ResultEnvelopeAdmissionFacts:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeAdmissionFacts
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeAdmissionReadiness {
    let admissionReady =
        d3ResultEnvelopeAdmissionFacts
            .didConsumeD3EnvironmentRecoveryReadiness &&
        d3ResultEnvelopeAdmissionFacts.didOpenD3ResultEnvelopeAdmissionRoute &&
        d3ResultEnvelopeAdmissionFacts
            .didRequireExternalMetalCapableShellPacket &&
        d3ResultEnvelopeAdmissionFacts
            .didRequireHumanApprovalConsumptionProofInExternalPacket &&
        d3ResultEnvelopeAdmissionFacts
            .didRequireCapabilityPacketBeforeResultEnvelope &&
        d3ResultEnvelopeAdmissionFacts.didRequireNativeResultPacketSchema &&
        d3ResultEnvelopeAdmissionFacts.didRequireIntegerClassificationOnly &&
        d3ResultEnvelopeAdmissionFacts.didRequireSideEffectClassification &&
        d3ResultEnvelopeAdmissionFacts.didRequireArtifactContainmentProof &&
        d3ResultEnvelopeAdmissionFacts
            .didRequireNoPointerOrNativeObjectPayload &&
        d3ResultEnvelopeAdmissionFacts.didRequireNoProductionTruthUpgrade &&
        d3ResultEnvelopeAdmissionFacts
            .didKeepCurrentEnvironmentExecutionBlocked &&
        d3ResultEnvelopeAdmissionFacts
            .didKeepD3LimitedApprovalUnconsumedByDefaultDraft &&
        d3ResultEnvelopeAdmissionFacts.didConfirmCodeFailureDomainFalse &&
        d3ResultEnvelopeAdmissionFacts.didConfirmNoApplicationAccessorCall &&
        d3ResultEnvelopeAdmissionFacts.didConfirmNoNativeBridgeExpansion &&
        d3ResultEnvelopeAdmissionFacts.didConfirmNoPublicApi &&
        d3ResultEnvelopeAdmissionFacts.didConfirmNoProductionPublicCAbi &&
        d3ResultEnvelopeAdmissionFacts.didConfirmNoRendererStateWrite &&
        d3ResultEnvelopeAdmissionFacts.didConfirmNoRuntimeStateWrite &&
        d3ResultEnvelopeAdmissionFacts.didConfirmNoCjpmTomlChange &&
        d3ResultEnvelopeAdmissionFacts.didAvoidSameShapeRecoveryWrapper &&
        d3ResultEnvelopeAdmissionFacts
            .didKeepD3ResultEnvelopeAdmissionDehydrated

    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeAdmissionReadiness(
        d3EnvironmentRecoveryReadiness,
        d3ResultEnvelopeAdmissionFacts,
        admissionReady,
        admissionReady,
        admissionReady,
        admissionReady,
        admissionReady,
        admissionReady,
        !admissionReady,
        d3ResultEnvelopeAdmissionFacts
            .didConsumeD3EnvironmentRecoveryReadiness,
        d3ResultEnvelopeAdmissionFacts
            .didRequireExternalMetalCapableShellPacket,
        d3ResultEnvelopeAdmissionFacts
            .didRequireHumanApprovalConsumptionProofInExternalPacket,
        d3ResultEnvelopeAdmissionFacts
            .didRequireCapabilityPacketBeforeResultEnvelope,
        d3ResultEnvelopeAdmissionFacts.didRequireNativeResultPacketSchema,
        d3ResultEnvelopeAdmissionFacts.didRequireIntegerClassificationOnly,
        d3ResultEnvelopeAdmissionFacts.didRequireSideEffectClassification,
        d3ResultEnvelopeAdmissionFacts.didRequireArtifactContainmentProof,
        d3ResultEnvelopeAdmissionFacts
            .didRequireNoPointerOrNativeObjectPayload,
        d3ResultEnvelopeAdmissionFacts.didRequireNoProductionTruthUpgrade,
        d3ResultEnvelopeAdmissionFacts
            .didKeepCurrentEnvironmentExecutionBlocked,
        d3ResultEnvelopeAdmissionFacts
            .didKeepD3LimitedApprovalUnconsumedByDefaultDraft,
        d3ResultEnvelopeAdmissionFacts.didConfirmCodeFailureDomainFalse,
        d3ResultEnvelopeAdmissionFacts.didConfirmNoApplicationAccessorCall,
        d3ResultEnvelopeAdmissionFacts.didConfirmNoNativeBridgeExpansion,
        d3ResultEnvelopeAdmissionFacts.didConfirmNoPublicApi,
        d3ResultEnvelopeAdmissionFacts.didConfirmNoProductionPublicCAbi,
        d3ResultEnvelopeAdmissionFacts.didConfirmNoRendererStateWrite,
        d3ResultEnvelopeAdmissionFacts.didConfirmNoRuntimeStateWrite,
        d3ResultEnvelopeAdmissionFacts.didConfirmNoCjpmTomlChange,
        d3ResultEnvelopeAdmissionFacts.didAvoidSameShapeRecoveryWrapper,
        d3ResultEnvelopeAdmissionFacts
            .didKeepD3ResultEnvelopeAdmissionDehydrated
    )
}

func cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeAdmissionDraft():
    CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeAdmissionReadiness {
    let d3EnvironmentRecoveryReadiness =
        cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3EnvironmentRecoveryDraft()
    let d3ResultEnvelopeAdmissionFacts =
        cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeAdmissionFacts(
            d3EnvironmentRecoveryReadiness
        )
    return cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeAdmissionReadiness(
        d3EnvironmentRecoveryReadiness,
        d3ResultEnvelopeAdmissionFacts
    )
}
