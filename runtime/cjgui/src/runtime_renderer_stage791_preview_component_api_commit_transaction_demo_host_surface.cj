        didConfirmStage790PreviewComponentApiCommitTransactionPatchPlanConsumed: Bool,
        didConfirmStage789PreviewComponentApiCommitAdmissionDecisionConsumedTransitively: Bool,
        didConfirmOwnerLocalTransactionPatchPlanConsumed: Bool,
        didConfirmCommitTransactionHostInspectionReceiptMaterialized: Bool,
