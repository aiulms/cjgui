        teardownProof
            .shouldDeferRendererRealBackendPlatformObjectTeardownProof ==
            false &&
        teardownProof
            .shouldReportRendererRealBackendPlatformObjectTeardownProofBlocked ==
            false
    let proofDeferred =
        teardownProof.didPrepareRendererRealBackendPlatformObjectTeardownProof ==
        false &&
        teardownProof.shouldDeferRendererRealBackendPlatformObjectTeardownProof &&
        teardownProof
            .shouldReportRendererRealBackendPlatformObjectTeardownProofBlocked ==
            false
    let proofInconsistent =
        teardownProof
            .shouldReportRendererRealBackendPlatformObjectTeardownProofBlocked ||
        (
            teardownProof
                .didPrepareRendererRealBackendPlatformObjectTeardownProof &&
            proofReady == false
        ) ||
        (
            teardownProof
                .didPreserveRendererRealBackendPlatformObjectShellPolicy &&
            teardownProof
                .didPrepareRendererRealBackendPlatformObjectTeardownProof ==
                false
        )

    if (proofInconsistent) {
        return CjguiInternalRendererRealBackendPlatformObjectFailurePolicy(
            teardownProof,
            false,
            false,
            true,
            false,
            false,
            true,
            true,
            true,
