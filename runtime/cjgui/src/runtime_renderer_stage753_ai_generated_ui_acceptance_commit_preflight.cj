        ownerAcceptanceRuntimeManager.didConfirmActionDispatch == false,
        ownerAcceptanceRuntimeManager.didConfirmStateUpdateCommitted == false,
        ownerAcceptanceRuntimeManager.didConfirmVisibilityPublicationAdmitted == false,
