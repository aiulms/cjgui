        didOpenD3EnvironmentRecoveryRoute: Bool,
        didObserveCurrentShellMetalUnavailable: Bool,
        didClassifyFailureDomainAsAutomationEnvironment: Bool,
        didRequireExternalMetalCapableShellForD3Execution: Bool,
        didKeepD3LimitedApprovalUnconsumed: Bool,
        didKeepRuntimeNativeProbeExecutionBlockedByEnvironment: Bool,
        didRequireBoundedNativeFailClosedPacket: Bool,
        didRequireRecoveryClassifier: Bool,
        didRequireSourceBuildRecoveryGuard: Bool,
        didRequireFocusedRecoverySuite: Bool,
        didConfirmReplayCheckpointReusable: Bool,
        didConfirmCodeFailureDomainFalse: Bool,
        didConfirmNoApplicationAccessorCall: Bool,
        didConfirmNoNativeBridgeExpansion: Bool,
        didConfirmNoPublicApi: Bool,
        didConfirmNoProductionPublicCAbi: Bool,
        didConfirmNoRendererStateWrite: Bool,
        didConfirmNoRuntimeStateWrite: Bool,
        didConfirmNoCjpmTomlChange: Bool,
        didAvoidSameShapeNoAccessorWrapper: Bool,
        didKeepD3EnvironmentRecoveryDehydrated: Bool
    ) {
        this.didConsumeExplicitApprovalReplayCheckpointReadiness =
            didConsumeExplicitApprovalReplayCheckpointReadiness
        this.didOpenD3EnvironmentRecoveryRoute =
            didOpenD3EnvironmentRecoveryRoute
        this.didObserveCurrentShellMetalUnavailable =
            didObserveCurrentShellMetalUnavailable
        this.didClassifyFailureDomainAsAutomationEnvironment =
            didClassifyFailureDomainAsAutomationEnvironment
        this.didRequireExternalMetalCapableShellForD3Execution =
            didRequireExternalMetalCapableShellForD3Execution
        this.didKeepD3LimitedApprovalUnconsumed =
            didKeepD3LimitedApprovalUnconsumed
        this.didKeepRuntimeNativeProbeExecutionBlockedByEnvironment =
            didKeepRuntimeNativeProbeExecutionBlockedByEnvironment
        this.didRequireBoundedNativeFailClosedPacket =
            didRequireBoundedNativeFailClosedPacket
        this.didRequireRecoveryClassifier = didRequireRecoveryClassifier
        this.didRequireSourceBuildRecoveryGuard =
            didRequireSourceBuildRecoveryGuard
        this.didRequireFocusedRecoverySuite = didRequireFocusedRecoverySuite
        this.didConfirmReplayCheckpointReusable =
            didConfirmReplayCheckpointReusable
        this.didConfirmCodeFailureDomainFalse =
            didConfirmCodeFailureDomainFalse
        this.didConfirmNoApplicationAccessorCall =
            didConfirmNoApplicationAccessorCall
        this.didConfirmNoNativeBridgeExpansion =
            didConfirmNoNativeBridgeExpansion
        this.didConfirmNoPublicApi = didConfirmNoPublicApi
        this.didConfirmNoProductionPublicCAbi =
            didConfirmNoProductionPublicCAbi
        this.didConfirmNoRendererStateWrite = didConfirmNoRendererStateWrite
        this.didConfirmNoRuntimeStateWrite = didConfirmNoRuntimeStateWrite
        this.didConfirmNoCjpmTomlChange = didConfirmNoCjpmTomlChange
        this.didAvoidSameShapeNoAccessorWrapper =
            didAvoidSameShapeNoAccessorWrapper
        this.didKeepD3EnvironmentRecoveryDehydrated =
            didKeepD3EnvironmentRecoveryDehydrated
    }
}

