        .didKeepPublicCAbiNotAdded && demoHostSurfacePlan.didKeepOwnerAcceptanceNotGranted && demoHostSurfacePlan
        .didKeepStateStoreCommitNotPublished && demoHostSurfacePlan.didKeepActionDispatchBlocked && demoHostSurfacePlan
        .didKeepStateUpdateCommittedBlocked && demoHostSurfacePlan.didKeepVisibilityPublicationAdmittedBlocked && demoHostSurfacePlan
        .didKeepVisibilityPublishedBlocked && demoHostSurfacePlan.didKeepRendererSubmissionBlocked && demoHostSurfacePlan
        .didKeepRendererStateWriteBlocked && demoHostSurfacePlan.didKeepRuntimeStateWriteBlocked && demoHostSurfaceFacts
        .didKeepNativeBridgeExpansionBlocked
    return CjguiInternalRendererStage875OwnerLocalStateStoreCommitDemoHostSurfaceReadiness(
        rollbackLedger,
        demoHostSurfacePlan,
        demoHostSurfaceFacts,
        surfaceReady && stopLineReady,
        demoHostSurfacePlan.didConsumeStage874OwnerLocalStateStoreCommitRollbackLedger,
        rollbackLedger.didConfirmStage873OwnerLocalStateStoreCommitFirstSliceProofConsumed,
        rollbackLedger.didConfirmStage872TextInputCommitStateStorePublicApiRuntimeManagerConsumedTransitively,
        demoHostSurfacePlan.didConsumeOwnerLocalStateStoreCommitRollbackLedger,
        demoHostSurfacePlan.didMaterializeTodoOwnerLocalStateStoreCommitDemoHostSurface,
