    let ownerAcceptancePreflight = cjguiInternalExecuteDefaultRendererStage749AiGeneratedUiOwnerAcceptancePreflightDraft()
    let publicSurfacePreflightPlan = cjguiInternalBuildRendererStage750AiGeneratedUiPublicSurfacePreflightPlan(
        ownerAcceptancePreflight)
    let publicSurfacePreflightFacts = cjguiInternalBuildRendererStage750AiGeneratedUiPublicSurfacePreflightFacts(
        ownerAcceptancePreflight,
