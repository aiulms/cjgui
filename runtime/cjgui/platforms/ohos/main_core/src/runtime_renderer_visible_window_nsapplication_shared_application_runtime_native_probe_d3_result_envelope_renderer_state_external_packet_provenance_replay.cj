                .shouldReportExternalValidatedPacketMissingInCurrentShell,
        d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
            .didConfirmExternalMetalCapablePacketProvenanceRequired,
        d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
            .shouldKeepRendererStateWriteBlockedUntilExternalPromotion &&
            d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
                .didConfirmExternalPromotionAdmissionDoesNotWriteRendererState,
        d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
            .didConfirmNoAutomationDefaultApprovalConsumptionRequired,
        d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
            .didConfirmResultEnvelopeSchemaContinuityRequired,
        d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
            .didConfirmRuntimeStateLineCountInvariantRequired,
        d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
            .didConfirmExternalPromotionAdmissionDoesNotWriteRendererState,
        true,
        d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
            .didConfirmNoProductionTruthUpgradeRequired,
        d3ResultEnvelopeRendererStateExternalPacketPromotionAdmissionReadiness
            .didConfirmNoApplicationAccessorCall,
