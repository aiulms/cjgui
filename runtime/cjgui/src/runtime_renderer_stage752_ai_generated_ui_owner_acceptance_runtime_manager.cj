func cjguiInternalBuildRendererStage752AiGeneratedUiOwnerAcceptanceRuntimeManagerPlan(
    acceptanceDemoHostSurface: CjguiInternalRendererStage751AiGeneratedUiAcceptanceDemoHostSurfaceReadiness): CjguiInternalRendererStage752AiGeneratedUiOwnerAcceptanceRuntimeManagerPlan {
    let stage751Ready = acceptanceDemoHostSurface.didConfirmStage751AiGeneratedUiAcceptanceDemoHostSurfaceReady && acceptanceDemoHostSurface
        .didConfirmStage752AiGeneratedUiOwnerAcceptanceRuntimeManagerPrepared
    let hostSurfaceReady = acceptanceDemoHostSurface.didConfirmAcceptanceDemoHostInspectionRowsMaterialized && acceptanceDemoHostSurface
        .didConfirmAcceptanceResultSurfacePreviewMaterialized && acceptanceDemoHostSurface
        .didConfirmAcceptanceRenderCommandPreviewReceiptMaterialized && acceptanceDemoHostSurface
        .didConfirmChatComposerAiGeneratedUiAcceptanceDemoHostSurfaceMaterialized
    let runtimeManagerReady = stage751Ready && hostSurfaceReady &&
        cjguiInternalRendererStage752AiGeneratedUiOwnerAcceptanceRuntimeManagerMaterialized()
    return CjguiInternalRendererStage752AiGeneratedUiOwnerAcceptanceRuntimeManagerPlan(
        stage751Ready,
        hostSurfaceReady,
        runtimeManagerReady,
        runtimeManagerReady,
        runtimeManagerReady,
        runtimeManagerReady,
        runtimeManagerReady,
        runtimeManagerReady,
        runtimeManagerReady,
        runtimeManagerReady,
        acceptanceDemoHostSurface.didConfirmStage749AiGeneratedUiOwnerAcceptancePreflightConsumedTransitively,
        acceptanceDemoHostSurface.didConfirmStage750AiGeneratedUiPublicSurfacePreflightConsumed,
        acceptanceDemoHostSurface.didConfirmAcceptanceDemoHostSurfaceBoundToPublicSurfacePreflight,
        runtimeManagerReady,
        runtimeManagerReady,
        true,
        acceptanceDemoHostSurface.didConfirmStablePublicApiAdded == false,
        acceptanceDemoHostSurface.didConfirmRendererSubmissionBlocked,
        acceptanceDemoHostSurface.didConfirmRendererStateWriteBlocked,
        acceptanceDemoHostSurface.didConfirmRuntimeStateWriteBlocked
    )
}

