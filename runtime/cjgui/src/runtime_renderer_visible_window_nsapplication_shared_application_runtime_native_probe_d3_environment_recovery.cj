    let didConsumeExplicitApprovalReplayCheckpointReadiness: Bool
    let didOpenD3EnvironmentRecoveryRoute: Bool
    let didObserveCurrentShellMetalUnavailable: Bool
    let didClassifyFailureDomainAsAutomationEnvironment: Bool
    let didRequireExternalMetalCapableShellForD3Execution: Bool
    let didKeepD3LimitedApprovalUnconsumed: Bool
    let didKeepRuntimeNativeProbeExecutionBlockedByEnvironment: Bool
    let didRequireBoundedNativeFailClosedPacket: Bool
    let didRequireRecoveryClassifier: Bool
    let didRequireSourceBuildRecoveryGuard: Bool
    let didRequireFocusedRecoverySuite: Bool
    let didConfirmReplayCheckpointReusable: Bool
    let didConfirmCodeFailureDomainFalse: Bool
    let didConfirmNoApplicationAccessorCall: Bool
    let didConfirmNoNativeBridgeExpansion: Bool
    let didConfirmNoPublicApi: Bool
    let didConfirmNoProductionPublicCAbi: Bool
    let didConfirmNoRendererStateWrite: Bool
    let didConfirmNoRuntimeStateWrite: Bool
    let didConfirmNoCjpmTomlChange: Bool
    let didAvoidSameShapeNoAccessorWrapper: Bool
    let didKeepD3EnvironmentRecoveryDehydrated: Bool

    init(
