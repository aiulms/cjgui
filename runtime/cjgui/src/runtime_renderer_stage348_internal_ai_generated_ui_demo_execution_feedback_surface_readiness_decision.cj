    let diffExplain = executionFeedbackSurfaceProbeInputResultEnvelope.executionFeedbackSurfaceSemanticDiffExplain
    let surface = diffExplain.executionFeedbackSurfaceRefresh

    return CjguiInternalRendererStage348InternalAiGeneratedUiDemoExecutionFeedbackSurfaceReadinessDecisionFacts(
        executionFeedbackSurfaceProbeInputResultEnvelope
            .didConfirmAiGeneratedUiDemoExecutionFeedbackSurfaceProbeInputResultEnvelopeReady,
        surface.didConfirmAiGeneratedUiDemoExecutionFeedbackSurfaceRefreshReady && diffExplain
            .didConfirmAiGeneratedUiDemoExecutionFeedbackSurfaceSemanticDiffExplainReady && executionFeedbackSurfaceProbeInputResultEnvelope
            .didConfirmExecutionFeedbackSurfaceProbeInputBoundToSurfaceRefresh,
        executionFeedbackSurfaceProbeInputResultEnvelope.didConfirmAiGeneratedUiDemoExecutionFeedbackSurfaceProbeInputMaterialized && executionFeedbackSurfaceProbeInputResultEnvelope
            .didConfirmAiGeneratedUiDemoExecutionFeedbackSurfaceProbeResultEnvelopeMaterialized,
        executionFeedbackSurfaceProbeInputResultEnvelope.didConfirmExecutionFeedbackSurfaceProbeResultEnvelopeRollbackReady && executionFeedbackSurfaceProbeInputResultEnvelope
            .didConfirmExecutionFeedbackSurfaceProbeResultEnvelopeVisibilityNotPublished,
        true,
        true,
