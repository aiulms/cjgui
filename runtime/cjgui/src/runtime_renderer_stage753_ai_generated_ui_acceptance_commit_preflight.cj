        ownerAcceptanceRuntimeManager.didConfirmProductionRenderTruth == false,
        ownerAcceptanceRuntimeManager.didConfirmBackendReadyTruth == false,
        ownerAcceptanceRuntimeManager.didConfirmPublicComponentApiAdded == false,
        acceptanceCommitPreflightPlan.didKeepStablePublicApiBlocked,
