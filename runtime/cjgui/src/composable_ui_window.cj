private class CjguiComposableUiPendingPresentTransaction {
    /// 提交类型：0 = 完整刷新投影；1 = 交互投影。
    /// 交互投影没有 participant/identity/layout 候选，因此不得调用完整刷新的
    /// 回滚链，也只做自己的收尾（Astra：交互投影走自己的收尾）。
    let kind: Int64
    /// 本地单调递增的提交尝试编号（每窗口唯一在途事务的护栏）。
    let attemptId: Int64
    /// native 侧票据编号；0 表示 native 声称 PENDING 却没给票据（协议缺口）。
    let ticketId: UInt64
    /// 发起本次提交时的刷新请求代际。结算只消费它，不消费更新值。
    let consumedRequestEpoch: Int64
    /// 本次提交要晋升的场景（两类提交都有）。
    let paintScene: CjguiComposableUiScene
    // ---- kind = 0（完整刷新）专用 ----
    let root: ?CjguiComposableUiNode
    let previouslySubmittedScene: ?CjguiComposableUiScene
    let participant: ?CjguiComposableUiSceneRefreshParticipant
    let candidateCommands: ?ArrayList<CjguiComposableUiCommand>
    let candidateDataTransferBindings: ?ArrayList<CjguiComposableUiDataTransferBinding>
    let declaredVersion: Int64
    let candidateBusinessOwnerRevision: Int64
    let viewportResizeVersion: UInt64
    let viewportResourceCompletionVersion: UInt64
    // The window-scoped background request frozen with this scene candidate.
    // A later generated submission cannot change a pending transaction.
    let windowBackgroundToken: String
    let windowBackgroundColorScheme: UInt32
    // ---- kind = 1（交互投影）专用 ----
    let interactionDataTransferBindings: ?ArrayList<CjguiComposableUiDataTransferBinding>
    let selectionTransfer: ?CjguiCandidateSelectionTransfer
    let candidateSelection: ?CjguiCandidateSelectionDeclaration
    /// 是否已结算。结算只发生一次；重复查询不得再次 commit/rollback。
    var settled: Bool = false
    // ---- A1：native 终态、核心收尾、ACK 完成三者分开 ----
    // settled 只表示 native 终态已观察（Accepted/Rejected），不再改判；
    // acceptanceStarted 表示核心收尾已进入过一次——一旦为真绝不再进入同一
    // 回调（防止重复 participant/focus 调用）；
    // coreSettled 表示核心收尾完整成功；ackCompleted 只表示原票 ACK 完成
    // （协议层了结），不得当成核心收尾成功；settlementFault 是核心未完整
    // 收尾时的命名原因（进入不可回滚的终止收敛路径）。
    var acceptanceStarted: Bool = false
    var coreSettled: Bool = false
    var ackCompleted: Bool = false
    var settlementFault: String = ""

    init(kind: Int64, attemptId: Int64, ticketId: UInt64, consumedRequestEpoch: Int64,
        paintScene: CjguiComposableUiScene, root!: ?CjguiComposableUiNode = None,
        previouslySubmittedScene!: ?CjguiComposableUiScene = None,
        participant!: ?CjguiComposableUiSceneRefreshParticipant = None,
        candidateCommands!: ?ArrayList<CjguiComposableUiCommand> = None,
        candidateDataTransferBindings!: ?ArrayList<CjguiComposableUiDataTransferBinding> = None,
        declaredVersion!: Int64 = 0, candidateBusinessOwnerRevision!: Int64 = -1,
        viewportResizeVersion!: UInt64 = 0u64,
        viewportResourceCompletionVersion!: UInt64 = 0u64,
        windowBackgroundToken!: String = CjguiWindowBackgroundPolicy.OPAQUE,
        windowBackgroundColorScheme!: UInt32 = 2u32,
        interactionDataTransferBindings!: ?ArrayList<CjguiComposableUiDataTransferBinding> = None,
        selectionTransfer!: ?CjguiCandidateSelectionTransfer = None,
        candidateSelection!: ?CjguiCandidateSelectionDeclaration = None) {
        this.kind = kind
        this.attemptId = attemptId
        this.ticketId = ticketId
        this.consumedRequestEpoch = consumedRequestEpoch
        this.paintScene = paintScene
        this.root = root
        this.previouslySubmittedScene = previouslySubmittedScene
        this.participant = participant
        this.candidateCommands = candidateCommands
        this.candidateDataTransferBindings = candidateDataTransferBindings
        this.declaredVersion = declaredVersion
        this.candidateBusinessOwnerRevision = candidateBusinessOwnerRevision
        this.viewportResizeVersion = viewportResizeVersion
        this.viewportResourceCompletionVersion = viewportResourceCompletionVersion
        this.windowBackgroundToken = windowBackgroundToken
        this.windowBackgroundColorScheme = windowBackgroundColorScheme
        this.interactionDataTransferBindings = interactionDataTransferBindings
        this.selectionTransfer = selectionTransfer
        this.candidateSelection = candidateSelection
    }
}

/// 启动结果：Ready = 首帧已确认；Preparing = 首帧仍在有界 Cangjie 布局
/// 准备中，native 窗口保持空初始面；AcceptedPending = native 已受理首帧票据
/// （终态未定），宿主继续泵送至收敛；Failed = 真实失败且会话已清理。
public enum CjguiComposableUiWindowStartOutcome {
    | StartReady
    | StartPreparing
    | StartAcceptedPending
    | StartFailed
}

/// Normal macOS window consuming only Cangjie-computed generic scene nodes.
/// The native bridge sees neither consumer field names nor business command
/// branches; it receives copied geometry/style/semantics and returns a
/// bounded FIFO event with the rendered projection version.
/// Projects a style's optional paint effects onto the flat native node
/// contract. Both staging paths (normal and interaction-only) build this one
/// projection so they send identical bytes; a default style projects to
/// all-zero fields, which is exactly the native "no effect" path. This is a
/// pure projection of accepted style data and performs no layout or
/// measurement work.
private class CjguiComposableUiNativeEffectProjection {
    let shadowPresent: UInt32
    let shadowOffsetX: Float64
    let shadowOffsetY: Float64
    let shadowBlurRadius: Float64
    let shadowSpread: Float64
    let shadowRed: Float64
    let shadowGreen: Float64
    let shadowBlue: Float64
    let shadowAlpha: Float64
    let gradientPresent: UInt32
    let gradientStopCount: UInt32
    let gradientStartX: Float64
    let gradientStartY: Float64
    let gradientEndX: Float64
    let gradientEndY: Float64
    let gradientStop0Position: Float64
    let gradientStop0Red: Float64
    let gradientStop0Green: Float64
    let gradientStop0Blue: Float64
    let gradientStop0Alpha: Float64
    let gradientStop1Position: Float64
    let gradientStop1Red: Float64
    let gradientStop1Green: Float64
    let gradientStop1Blue: Float64
    let gradientStop1Alpha: Float64
    let gradientStop2Position: Float64
    let gradientStop2Red: Float64
    let gradientStop2Green: Float64
    let gradientStop2Blue: Float64
    let gradientStop2Alpha: Float64
    let gradientStop3Position: Float64
    let gradientStop3Red: Float64
    let gradientStop3Green: Float64
    let gradientStop3Blue: Float64
    let gradientStop3Alpha: Float64
    let effectGroupPresent: UInt32
    let effectGroupOpacity: Float64
    let effectGroupBlendMode: UInt32
    let effectMaskPresent: UInt32
    let effectMaskStopCount: UInt32
    let effectMaskStartX: Float64
    let effectMaskStartY: Float64
    let effectMaskEndX: Float64
    let effectMaskEndY: Float64
    let effectMaskStop0Position: Float64
    let effectMaskStop0Alpha: Float64
    let effectMaskStop1Position: Float64
    let effectMaskStop1Alpha: Float64
    let effectMaskStop2Position: Float64
    let effectMaskStop2Alpha: Float64
    let effectMaskStop3Position: Float64
    let effectMaskStop3Alpha: Float64
    let effectBackdropBlurRadiusPoints: UInt32
    let effectBackdropBlurFallback: UInt32
    init(style: CjguiComposableUiStyle) {
        var shadowPresentValue: UInt32 = 0u32
        var shadowOffsetXValue: Float64 = 0.0
        var shadowOffsetYValue: Float64 = 0.0
        var shadowBlurRadiusValue: Float64 = 0.0
        var shadowSpreadValue: Float64 = 0.0
        var shadowRedValue: Float64 = 0.0
        var shadowGreenValue: Float64 = 0.0
        var shadowBlueValue: Float64 = 0.0
        var shadowAlphaValue: Float64 = 0.0
        if (let Some(shadow) <- style.shadow) {
            if (shadow.isVisible()) {
                shadowPresentValue = 1u32
                shadowOffsetXValue = Float64(shadow.offsetX)
                shadowOffsetYValue = Float64(shadow.offsetY)
                shadowBlurRadiusValue = Float64(shadow.blurRadius)
                shadowSpreadValue = Float64(shadow.spread)
                shadowRedValue = shadow.color.red
                shadowGreenValue = shadow.color.green
                shadowBlueValue = shadow.color.blue
                shadowAlphaValue = shadow.color.alpha
            }
        }
        this.shadowPresent = shadowPresentValue
        this.shadowOffsetX = shadowOffsetXValue
        this.shadowOffsetY = shadowOffsetYValue
        this.shadowBlurRadius = shadowBlurRadiusValue
        this.shadowSpread = shadowSpreadValue
        this.shadowRed = shadowRedValue
        this.shadowGreen = shadowGreenValue
        this.shadowBlue = shadowBlueValue
        this.shadowAlpha = shadowAlphaValue
        var gradientPresentValue: UInt32 = 0u32
        var gradientStopCountValue: UInt32 = 0u32
        var gradientStartXValue: Float64 = 0.0
        var gradientStartYValue: Float64 = 0.0
        var gradientEndXValue: Float64 = 0.0
        var gradientEndYValue: Float64 = 0.0
        let stopPositions: Array<Float64> = [0.0, 0.0, 0.0, 0.0]
        let stopReds: Array<Float64> = [0.0, 0.0, 0.0, 0.0]
        let stopGreens: Array<Float64> = [0.0, 0.0, 0.0, 0.0]
        let stopBlues: Array<Float64> = [0.0, 0.0, 0.0, 0.0]
        let stopAlphas: Array<Float64> = [0.0, 0.0, 0.0, 0.0]
        if (let Some(gradient) <- style.gradient) {
            if (gradient.isValid()) {
                gradientPresentValue = 1u32
                gradientStopCountValue = UInt32(gradient.stops.size)
                gradientStartXValue = gradient.startX
                gradientStartYValue = gradient.startY
                gradientEndXValue = gradient.endX
                gradientEndYValue = gradient.endY
                var stopIndex: Int64 = 0
                while (stopIndex < gradient.stops.size && stopIndex < 4) {
                    stopPositions[stopIndex] = gradient.stops[stopIndex].position
                    stopReds[stopIndex] = gradient.stops[stopIndex].color.red
                    stopGreens[stopIndex] = gradient.stops[stopIndex].color.green
                    stopBlues[stopIndex] = gradient.stops[stopIndex].color.blue
                    stopAlphas[stopIndex] = gradient.stops[stopIndex].color.alpha
                    stopIndex += 1
                }
                // Unused slots repeat the last real stop, so a consumer that
                // ignores `gradientStopCount` still interpolates a stable end
                // instead of falling through to transparent black.
                var fillIndex = stopIndex
                while (fillIndex < 4 && stopIndex > 0) {
                    stopPositions[fillIndex] = stopPositions[stopIndex - 1]
                    stopReds[fillIndex] = stopReds[stopIndex - 1]
                    stopGreens[fillIndex] = stopGreens[stopIndex - 1]
                    stopBlues[fillIndex] = stopBlues[stopIndex - 1]
                    stopAlphas[fillIndex] = stopAlphas[stopIndex - 1]
                    fillIndex += 1
                }
            }
        }
        this.gradientPresent = gradientPresentValue
        this.gradientStopCount = gradientStopCountValue
        this.gradientStartX = gradientStartXValue
        this.gradientStartY = gradientStartYValue
        this.gradientEndX = gradientEndXValue
        this.gradientEndY = gradientEndYValue
        this.gradientStop0Position = stopPositions[0]
        this.gradientStop0Red = stopReds[0]
        this.gradientStop0Green = stopGreens[0]
        this.gradientStop0Blue = stopBlues[0]
        this.gradientStop0Alpha = stopAlphas[0]
        this.gradientStop1Position = stopPositions[1]
        this.gradientStop1Red = stopReds[1]
        this.gradientStop1Green = stopGreens[1]
        this.gradientStop1Blue = stopBlues[1]
        this.gradientStop1Alpha = stopAlphas[1]
        this.gradientStop2Position = stopPositions[2]
        this.gradientStop2Red = stopReds[2]
        this.gradientStop2Green = stopGreens[2]
        this.gradientStop2Blue = stopBlues[2]
        this.gradientStop2Alpha = stopAlphas[2]
        this.gradientStop3Position = stopPositions[3]
        this.gradientStop3Red = stopReds[3]
        this.gradientStop3Green = stopGreens[3]
        this.gradientStop3Blue = stopBlues[3]
        this.gradientStop3Alpha = stopAlphas[3]
        var groupPresent: UInt32 = 0u32
        var groupOpacity: Float64 = 1.0
        var groupBlendMode: UInt32 = 0u32
        var maskPresent: UInt32 = 0u32
        var maskStopCount: UInt32 = 0u32
        var maskStartX: Float64 = 0.0
        var maskStartY: Float64 = 0.0
        var maskEndX: Float64 = 0.0
        var maskEndY: Float64 = 0.0
        let maskPositions: Array<Float64> = [0.0, 0.0, 0.0, 0.0]
        let maskAlphas: Array<Float64> = [0.0, 0.0, 0.0, 0.0]
        var backdropBlurRadiusPoints: UInt32 = 0u32
        // Fallback code 0 represents the explicit public `unblurred` policy.
        let backdropBlurFallback: UInt32 = 0u32
        if (let Some(group) <- style.effectGroup) {
            groupPresent = 1u32
            groupOpacity = group.opacity
            groupBlendMode = if (group.blendMode == "multiply") { 1u32 } else { 0u32 }
            backdropBlurRadiusPoints = UInt32(group.backdropBlurRadiusPoints)
            if (let Some(mask) <- group.mask) {
                maskPresent = 1u32
                maskStopCount = UInt32(mask.stops.size)
                maskStartX = mask.startX
                maskStartY = mask.startY
                maskEndX = mask.endX
                maskEndY = mask.endY
                var maskIndex: Int64 = 0
                while (maskIndex < mask.stops.size && maskIndex < 4) {
                    maskPositions[maskIndex] = mask.stops[maskIndex].position
                    maskAlphas[maskIndex] = mask.stops[maskIndex].alpha
                    maskIndex += 1
                }
            }
        }
        this.effectGroupPresent = groupPresent
        this.effectGroupOpacity = groupOpacity
        this.effectGroupBlendMode = groupBlendMode
        this.effectMaskPresent = maskPresent
        this.effectMaskStopCount = maskStopCount
        this.effectMaskStartX = maskStartX
        this.effectMaskStartY = maskStartY
        this.effectMaskEndX = maskEndX
        this.effectMaskEndY = maskEndY
        this.effectMaskStop0Position = maskPositions[0]
        this.effectMaskStop0Alpha = maskAlphas[0]
        this.effectMaskStop1Position = maskPositions[1]
        this.effectMaskStop1Alpha = maskAlphas[1]
        this.effectMaskStop2Position = maskPositions[2]
        this.effectMaskStop2Alpha = maskAlphas[2]
        this.effectMaskStop3Position = maskPositions[3]
        this.effectMaskStop3Alpha = maskAlphas[3]
        this.effectBackdropBlurRadiusPoints = backdropBlurRadiusPoints
        this.effectBackdropBlurFallback = backdropBlurFallback
    }
}

/// H2：窗口登记的一条 scroll 活动绑定事实。它把「活动属于谁」写成可比较的
/// 身份：同一对象留在树里、但 node/resource/kind/accepted 绑定代次已经改变时，
/// 旧活动必须失效；自身滚动接受新帧时代次不变，活动照常继续。
/// `viewportIdentity` 是 viewport 对象身份，用于按视口去重与拒绝歧义绑定。
class CjguiComposableUiScrollBindingRecord {
    let viewport: CjguiComposableUiScrollViewport
    let viewportIdentity: Int64
    let nodeId: Int64
    let resourceId: Int64
    let nodeKind: Int64
    let acceptedBindingEpoch: UInt64

    init(viewport: CjguiComposableUiScrollViewport, viewportIdentity: Int64, nodeId: Int64,
        resourceId: Int64, nodeKind: Int64, acceptedBindingEpoch: UInt64) {
        this.viewport = viewport
        this.viewportIdentity = viewportIdentity
        this.nodeId = nodeId
        this.resourceId = resourceId
        this.nodeKind = nodeKind
        this.acceptedBindingEpoch = acceptedBindingEpoch
    }

    func sameBinding(other: CjguiComposableUiScrollBindingRecord): Bool {
        return other.viewportIdentity == viewportIdentity && other.nodeId == nodeId &&
            other.resourceId == resourceId && other.nodeKind == nodeKind &&
            other.acceptedBindingEpoch == acceptedBindingEpoch
    }
}

/// H2：滚动物理策略的**只读公布**。声明值与实际生效值分开：一个后端可以
/// 声明了策略但实际不支持（例如 macOS 的系统惯性已单次消费），这种状态必须
/// 能被消费方看见，而不是把声明当成功。
public struct CjguiComposableUiScrollPhysicsInfo {
    public let declared: String
    public let effective: String
    public let support: String
    public let specification: String
    public init(declared: String, effective: String, support: String, specification: String) {
        this.declared = declared
        this.effective = effective
        this.support = support
        this.specification = specification
    }
}

/// 会话释放前最后一次已结算事件后的不可变计数快照（带绑定身份）。活计数在
/// close/换绑照常清零；窗口退出循环后的汇总读这份终局，不拿若干帧前采样冒充。
/// 守恒：rangeDecisions == acceptedEdits + refusedEdits + zeroWriteSelections。
/// acceptedEdits 只计实际正文接受（owner 写入），移动/扩选不计入。
public class CjguiTextSessionTerminalCounters {
    public let bindingNodeId: Int64
    public let bindingResourceId: UInt32
    public let bindingNodeKind: Int64
    public let bindingEpoch: UInt64
    public let rangeDecisions: Int64
    public let acceptedEdits: Int64
    public let refusedEdits: Int64
    public let zeroWriteSelections: Int64
    public let restores: Int64
    public let restoreFailures: Int64
    public let compositionDecisions: Int64
    public let compositionRefusals: Int64

    init(bindingNodeId: Int64, bindingResourceId: UInt32, bindingNodeKind: Int64,
        bindingEpoch: UInt64, rangeDecisions: Int64, acceptedEdits: Int64,
        refusedEdits: Int64, zeroWriteSelections: Int64, restores: Int64,
        restoreFailures: Int64, compositionDecisions: Int64, compositionRefusals: Int64) {
        this.bindingNodeId = bindingNodeId
        this.bindingResourceId = bindingResourceId
        this.bindingNodeKind = bindingNodeKind
        this.bindingEpoch = bindingEpoch
        this.rangeDecisions = rangeDecisions
        this.acceptedEdits = acceptedEdits
        this.refusedEdits = refusedEdits
        this.zeroWriteSelections = zeroWriteSelections
        this.restores = restores
        this.restoreFailures = restoreFailures
        this.compositionDecisions = compositionDecisions
        this.compositionRefusals = compositionRefusals
    }
}

// One admitted physical press owns one bounded, revocable activation. Its
// original projection and precise points remain untouched; only a continuous
// accepted binding can carry the terminal across a paint-only scene advance.
private class CjguiComposableUiPressLease {
    let sequence: UInt64
    let node: CjguiComposableUiLayoutNode
    let bindingEpoch: UInt64
    let geometry: CjguiComposableUiVisualGeometry
    let viewport: CjguiComposableUiRect
    let modalLayerId: String
    let downX: Float64
    let downY: Float64
    var valid: Bool = true
    var ended: Bool = false
    var endX: Float64 = 0.0
    var endY: Float64 = 0.0
    init(sequence: UInt64, node: CjguiComposableUiLayoutNode, bindingEpoch: UInt64,
        geometry: CjguiComposableUiVisualGeometry, viewport: CjguiComposableUiRect,
        modalLayerId: String, downX: Float64, downY: Float64) {
        this.sequence = sequence
        this.node = node
        this.bindingEpoch = bindingEpoch
        this.geometry = geometry
        this.viewport = viewport
        this.modalLayerId = modalLayerId
        this.downX = downX
        this.downY = downY
    }
}

// A window/session-private interval of uninterrupted accepted wheel ownership.
// It grants no authority to callers outside the native FIFO.
private class CjguiAcceptedWheelBinding {
    let identity: String
    let bornProjectionVersion: Int64
    // Fractional displacement belongs to this continuous accepted binding.
    // It is not a second viewport offset and cannot survive a rebind.
    private var preciseRemainder: Float64 = 0.0
    private var preciseRequestGeneration: Int64 = -1
    init(identity: String, bornProjectionVersion: Int64) {
        this.identity = identity
        this.bornProjectionVersion = bornProjectionVersion
    }
    func clearPreciseRemainder(): Unit {
        preciseRemainder = 0.0
        preciseRequestGeneration = -1
    }
    func applyPreciseWheel(viewport: CjguiComposableUiScrollViewport,
        delta: CjguiComposableUiWheelDelta): Bool {
        if (delta.beginsGesture() || preciseRequestGeneration != viewport.requestGeneration()) {
            preciseRemainder = 0.0
        }
        // AppKit precise deltas are logical points, including an aggregated
        // packet. Positive scrollingDeltaY moves toward the document head.
        let accumulated = preciseRemainder - delta.deltaY
        let whole = Int64(if (accumulated >= 0.0) { floor(accumulated) } else { ceil(accumulated) })
        preciseRemainder = accumulated - Float64(whole)
        let changed = viewport.scrollBy(whole)
        preciseRequestGeneration = viewport.requestGeneration()
        if (delta.isTerminal() || (accumulated < 0.0 && viewport.offset() == viewport.minimumOffset()) ||
            (accumulated > 0.0 && viewport.offset() == viewport.maximumOffset())) {
            clearPreciseRemainder()
        }
        return changed
    }
}

public class CjguiComposableUiWindow <: CjguiSharedOperationWindowProjectionProvider &
    CjguiSharedOperationWindowProgressProvider & CjguiSharedOperationTransferReceiptProvider &
    CjguiSharedOperationPositionMotionProvider {
    private let controller: CjguiComposableUiController
    /// The per-process identity of THIS window instance, used to detect a
    /// declaration that tries to share one mutable view object between windows.
    private let instanceToken: Int64 = CjguiComposableUiWindowInstanceAllocator.allocate()
    private var installedRangeNonceSequence: UInt64 = 0u64
    private var installedRangeSessionGeneration: UInt64 = 0u64
    private var installedRangeCandidate: ?CjguiInstalledRangeBasis = None
    private var installedRangeCandidateRequest: Int64 = -1
    private var installedRangeCandidateScene: Int64 = -1
    // Presentation selection changes the native declaration before the source
    // proxy is focused. Keep a separate future source basis armed across that
    // gap; it is not active until an actual TextKit install receipt is read back.
    private var pendingSourceHandoffBasis: ?CjguiInstalledRangeBasis = None
    private var pendingSourceHandoffScene: Int64 = -1
    private var pendingSourceHandoffExpectedBinding: UInt64 = 0u64
    private var pendingSourceHandoffExpectedNode: Int64 = -1
    private var pendingSourceHandoffExpectedResource: Int64 = -1
    private var pendingSourceHandoffSelectionConfirmed: Bool = false
    private let configuration: CjguiMacosApplicationWindowConfiguration
    private var sessionToken: UInt64
    private var isWindowOpen: Bool
    /// True when this window asked the native renderer to deliver explicit
    /// edit deltas for text nodes (see `rangeTextEditDeltaDeliveryEnabled`).
    private var textRangeEditDeltaDeliveryEnabled: Bool
    /// A range edit the application refused. The hidden proxy still holds the
    /// refused local text, so the next drain must roll it back to the value the
    /// owner actually accepted before any further delta is judged.
    private var refusedRangeTextPending: Bool
    private var refusedRangeTextNodeId: Int64
    private var refusedRangeTextResourceId: Int64
    private var refusedRangeTextNodeKind: Int64
    private var refusedRangeTextAttempts: Int64
    private var refusedRangeTextRecoveries: Int64
    private var refusedRangeTextFailures: Int64
    /// 1b(方案 R)：窗口拥有的正文会话。绑定之后，该节点的范围意图只经会话判决，
    /// 消费方不再有第二条写入路径；拒绝后的代理回滚也由窗口把**会话签发**的恢复
    /// 回执交回会话，消费方不必在 `buildUi` 里轮询自签自认。
    private var ownedTextSession: Option<CjguiTextSession> = None
    private let activationPrefixGate = CjguiMacActivationPrefixGate()
    private var deferredPairRevealNode: Int64 = -1
    private func activationPrefixPending(): Bool { activationPrefixGate.pending() }
    private func traceActivationPrefixMarker(phase: UInt32, prefix: InternalRendererActivationPrefix): Unit {
        if (prefix.nonce == 0u64) { return }
        let span = cjguiOwnerTraceRecord(3u32, sessionToken, ownerTraceTurnIdentity(), prefix.nonce,
            0u64, prefix.sessionGeneration, phase, 0u64)
        let _ = cjguiOwnerTraceRecord(4u32, sessionToken, ownerTraceTurnIdentity(), prefix.nonce,
            0u64, prefix.sessionGeneration, phase, span)
    }
    private var ownedTextSessionNodeId: Int64 = -1
    private var ownedTextSessionResourceId: Int64 = -1
    private var ownedTextSessionNodeKind: Int64 = -1
    // One currently focused presentation TEXT surface may use the same source
    // session. It is declared only after the accepted scene and native proxy
    // selection have been read back as the application's visible selection.
    private var presentationTextSessionNodeId: Int64 = -1
    private var presentationTextSessionResourceId: Int64 = -1
    private var presentationTextSessionSceneVersion: Int64 = -1
    private var presentationCompositionId: Int64 = -1
    private var presentationLastTerminalId: Int64 = -1
    private var presentationCompositionRange: ?CjguiPreparedSourceRange = None
    private var staleOwnedSelectionEvents: Int64 = 0
    private var ownerTurnBudget: ?CjguiOwnerTurnBudget = None
    private var preparingCandidate: ?CjguiComposableUiPreparedCandidate = None
    private var staticLayoutPreparation: ?CjguiComposableUiStaticLayoutPreparation = None
    // Diagnostic-only bounded history. The first rejection freezes this ring
    // before the ordinary owner trace can overwrite the causal transition.
    private let candidateFailureTraceEnabled: Bool = getVariable("CJGUI_CANDIDATE_FIRST_FAILURE").isSome()
    private let candidateFailureTrace: Array<String> = Array<String>(96, { _ => "" })
    private var candidateFailureTraceCursor: Int64 = 0
    private var candidateFailureTraceCount: Int64 = 0
    private var candidateFailureTraceLatched: Bool = false
    private let preparationCorrelationEnabled: Bool = getVariable("CJGUI_PREPARATION_CORRELATION").isSome()
    private let preparationCorrelationEndSemantic: String =
        getVariable("CJGUI_PREPARATION_CORRELATION_END_SEMANTIC_PREFIX") ?? ""
    private let preparationCorrelationRows: Array<?CjguiPreparationCorrelationRow> =
        Array<?CjguiPreparationCorrelationRow>(1024, { _ => None })
    private var preparationCorrelationCount: Int64 = 0
    private var preparationCorrelationOverflow: Bool = false
    private var preparationCorrelationEnded: Bool = false

    private func recordPreparationCorrelation(key: String, facts: String): Unit {
        if (!preparationCorrelationEnabled || preparationCorrelationEnded) { return }
        let now = unsafe { cjgui_internal_renderer_owner_clock_ns() }
        let cpu = unsafe { cjgui_internal_renderer_owner_thread_cpu_ns() }
        let trace = this.beginOwnerTracePhase(399u32)
        this.endOwnerTracePhase(399u32, trace)
        if (preparationCorrelationCount > 0) {
            let previous = preparationCorrelationRows[preparationCorrelationCount - 1].getOrThrow()
            if (previous.key == key) {
                previous.repeats += 1; previous.lastNs = now; previous.lastCpuNs = cpu
                previous.traceEnd = trace; return
            }
        }
        if (preparationCorrelationCount == 1024) { preparationCorrelationOverflow = true; return }
        let deadline = match (ownerTurnBudget) { case Some(value) => value.deadlineNs(); case None => 0u64 }
        preparationCorrelationRows[preparationCorrelationCount] = Some(CjguiPreparationCorrelationRow(key,
            "${facts} deadline_ns=${deadline}", now, cpu, trace))
        preparationCorrelationCount += 1
    }

    private func finishPreparationCorrelation(scene: CjguiComposableUiScene, frame: Int64): Unit {
        if (!preparationCorrelationEnabled || preparationCorrelationEnded || preparationCorrelationEndSemantic.size == 0) { return }
        var body = false
        for (node in scene.nodes()) {
            if (node.semanticId.startsWith(preparationCorrelationEndSemantic) && node.value.size > 0) {
                body = true; break
            }
        }
        if (!body) { return }
        recordPreparationCorrelation("promote:${scene.version}",
            "phase=promote reason=first_body_accepted scene=${scene.version} frame=${frame} request=${refreshRequestEpoch}")
        preparationCorrelationEnded = true
        println("CJGUI_PREPARATION_CORRELATION_BEGIN session=${sessionToken} scene=${scene.version} frame=${frame} " +
            "records=${preparationCorrelationCount} capacity=1024 overflow=${preparationCorrelationOverflow} " +
            "cpu_basis=native_trace_same_thread_only")
        var index: Int64 = 0
        while (index < preparationCorrelationCount) {
            let row = preparationCorrelationRows[index].getOrThrow()
            println("CJGUI_PREPARATION_CORRELATION session=${sessionToken} row=${index} " +
                "first_ns=${row.firstNs} last_ns=${row.lastNs} first_cpu_ns=${row.firstCpuNs} last_cpu_ns=${row.lastCpuNs} " +
                "trace_begin=${row.traceBegin} trace_end=${row.traceEnd} repeats=${row.repeats} ${row.facts}")
            index += 1
        }
        println("CJGUI_PREPARATION_CORRELATION_END session=${sessionToken} overflow=${preparationCorrelationOverflow}")
        getStdOut().flush()
    }

    private func recordCandidateLifecycle(phase: String, reason: String,
        failure!: Bool = false): Unit {
        if ((!candidateFailureTraceEnabled || candidateFailureTraceLatched) &&
            (!preparationCorrelationEnabled || preparationCorrelationEnded)) { return }
        var basis = "candidate=none"
        var progress = "candidate=none"
        if (let Some(value) <- preparingCandidate) {
            basis = "candidate=${value.preparationId} scene=${value.paintScene.version} " +
                "previous=${value.previousScene.version}:${nativeInputScene.version} " +
                "declared=${value.declaredVersion}:${controller.uiSceneVersion()} dependency=${value.preparationDependency}:${this.currentPreparationDependency()} " +
                "owner=${value.businessOwnerRevision}:${currentBusinessOwnerRevision()} " +
                "request=${value.requestEpoch}:${value.viewportDemandEpoch}:${refreshRequestEpoch} " +
                "binding=${value.bindingEpoch}:${textSessionBindingEpoch} " +
                "focus=${value.focus[0]},${value.focus[1]},${value.focus[2]}:" +
                "${focusedNodeId},${focusedResourceId},${focusedNodeKind} " +
                "cursor=${value.packet.packetCursor}:${value.packet.nativeCursor} " +
                "native=${value.packet.nativeBegun} ready=${value.packet.ready}"
            progress = basis
        } else if (let Some(value) <- staticLayoutPreparation) {
            basis = "layout=${value.attemptId} scene=${value.candidateVersion} " +
                "previous=${value.previousNativeSceneVersion}:${nativeInputScene.version} " +
                "declared=${value.declaredVersion}:${controller.uiSceneVersion()} dependency=${value.preparationDependency}:${this.currentPreparationDependency()} " +
                "owner=${value.businessOwnerRevision}:${currentBusinessOwnerRevision()} " +
                "request=${value.requestEpoch}:${refreshRequestEpoch} " +
                "binding=${value.bindingEpoch}:${textSessionBindingEpoch} " +
                "focus=${value.focus[0]},${value.focus[1]},${value.focus[2]}:" +
                "${focusedNodeId},${focusedResourceId},${focusedNodeKind} " +
                "pins=${value.measurer.pinCount()} workers=${value.measurer.workerStartCount()} " +
                "no_progress=${value.noProgressSlices} ready=${value.readyResult.isSome()}"
            progress = "layout=${value.attemptId} scene=${value.candidateVersion} " +
                "declared=${value.declaredVersion}:${controller.uiSceneVersion()} dependency=${value.preparationDependency}:${this.currentPreparationDependency()} " +
                "owner=${value.businessOwnerRevision}:${currentBusinessOwnerRevision()} " +
                "request=${value.requestEpoch}:${refreshRequestEpoch} binding=${value.bindingEpoch}:${textSessionBindingEpoch} " +
                "pins=${value.measurer.pinCount()} workers=${value.measurer.workerStartCount()} ready=${value.readyResult.isSome()}"
        }
        var gesture = 0u64
        if (let Some(value) <- macTextCapture) { gesture = value.gestureEpoch }
        var scroll = ""
        for (record in acceptedScrollBindings) {
            if (scroll.size >= 512) { break }
            let value = record.viewport
            scroll += " viewport=${value.viewStateIdentity()}:${value.requestGeneration()}:" +
                "${value.acceptedRequestGeneration()}:${value.offset()}:${value.acceptedOffset()}"
        }
        let remaining = if (let Some(value) <- ownerTurnBudget) { value.remainingMicroseconds() } else { -1 }
        let record = "CJGUI_CANDIDATE_LIFECYCLE session=${sessionToken} turn=${ownerTraceTurnIdentity()} " +
            "gesture=${gesture} phase=${phase} reason=${reason} startup=${startupPhase} " +
            "refresh=${refreshRequested} budget_us=${remaining} ${basis}${scroll}"
        recordPreparationCorrelation("${phase}:${reason}:${progress}",
            "turn=${ownerTraceTurnIdentity()} phase=${phase} reason=${reason} startup=${startupPhase} " +
                "gesture=${gesture} refresh=${refreshRequested} budget_us=${remaining} ${basis}${scroll}")
        if (!candidateFailureTraceEnabled || candidateFailureTraceLatched) { return }
        candidateFailureTrace[candidateFailureTraceCursor] = record
        candidateFailureTraceCursor = (candidateFailureTraceCursor + 1) % 96
        if (candidateFailureTraceCount < 96) { candidateFailureTraceCount += 1 }
        if (!failure) { return }
        candidateFailureTraceLatched = true
        println("CJGUI_CANDIDATE_FIRST_FAILURE session=${sessionToken} phase=${phase} reason=${reason} " +
            "records=${candidateFailureTraceCount} capacity=96")
        var index: Int64 = 0
        while (index < candidateFailureTraceCount) {
            println(candidateFailureTrace[(candidateFailureTraceCursor + 96 - candidateFailureTraceCount + index) % 96])
            index += 1
        }
        getStdOut().flush()
    }

    /// Share one allowance across the consumer's complete serialized loop.
    /// Attaching does not begin/reset it, including inside callbacks.
    public func useOwnerTurnBudget(budget: CjguiOwnerTurnBudget): Unit {
        cancelPreparedCandidate("owner_budget_changed")
        ownerTurnBudget = Some(budget)
    }

    // Attached consumers finish one shared wait only after all sibling hosts
    // and document jobs. This pump still services its accepted FIFO once.
    @When[os == "macOS"]
    func hasActiveOwnerSchedulingRound(): Bool {
        return match (ownerTurnBudget) { case Some(budget) => budget.isActive(); case None => false }
    }

    @When[os != "macOS"]
    func hasActiveOwnerSchedulingRound(): Bool { return false }

    private func ownerBudgetAdmits(reserveUs: Int64, phase: String): Bool {
        if (let Some(budget) <- ownerTurnBudget) {
            let admitted = if (phase == "refresh") {
                budget.admitsRefresh(sessionToken, reserveUs)
            } else { budget.admits(reserveUs) }
            if (!admitted) {
                this.traceOwnerPhase("budget_defer_${phase}", this.ownerPhaseStarted())
                return false
            }
        }
        return true
    }
    /// 换绑/销毁代次：native 在组合开始时快照声明里的这个值，旧队列事件带着它回来。
    /// 窗口拒绝代次不符的事件（具名，不落回 owner dispatcher），即使 node/resource
    /// 原地复用也一样。
    private var textSessionBindingEpoch: UInt64 = 0
    private var textSessionRangeDecisions: Int64 = 0
    /// 成功的零写入选区意图（移动/扩选）：有判决、无正文事务的第三类结果。
    private var textSessionZeroWriteSelections: Int64 = 0
    /// 释放前终局快照：close/discard 清零活计数后，消费方在窗口退出循环外读到的
    /// 仍是这份带绑定身份的不可变事实（指导复核：原 real-input 关闭前
    /// decisions=15、关闭后读 0）。
    private var textSessionTerminal: ?CjguiTextSessionTerminalCounters = None
    private var textSessionAcceptedEdits: Int64 = 0
    private var textSessionRefusedEdits: Int64 = 0
    private var lastTextSessionDecision: Option<CjguiTextSessionEdit> = None
    private var textSessionRestores: Int64 = 0
    private var textSessionRestoreFailures: Int64 = 0
    /// kind 52 组字相位的判决计数与最近原因（更新/提交/取消各计一次）。
    private var textSessionCompositionDecisions: Int64 = 0
    private var textSessionCompositionRefusals: Int64 = 0
    /// 代次不符/身份不符而被框架消费掉的旧组字事件数（从未进入任何会话或 owner）。
    private var textSessionCompositionStaleRefusals: Int64 = 0
    private var lastTextSessionCompositionReason: String = ""
    /// 已发给 native 的组合重锚基文：接受点装好且读回一致后，平台 preedit 就落在
    /// 这段基文上。只有它仍等于会话镜像时，续接结算才允许采用新的组合基点。
    private var pendingReanchorBase: String = ""
    /// 组合重锚实验开关（0=关闭，-1=安装后重装 marked，-2=安装后保持未标记）。
    private var reanchorExperimentMode: Int64 = 0
    /// 生产路径（重锚关闭）上「场景刷新在活动仲裁 claim 之上推进了组合面正文」这一事实：
    /// 由暂存记录、由随后的组字取消相位一次性消费，用来把普通取消与重锚不可用分开。
    private var pendingExternalCompositionDisruption: Bool = false
    /// 最近一次组字判决失败的底层原因（当前仅重锚不可用路径填充）。
    private var lastTextSessionCompositionCause: String = ""
    private var lastNativeStatus: Int32
    // Standard AppKit Quit is admitted as one process-level native intent.
    // It never becomes a controller action: the enclosing
    // `CjguiMacosApplication` consumes it and asks its established exit
    // decision provider during the ordinary application turn.
    private var applicationExitRequested: Bool
    private var renderedRoot: CjguiComposableUiNode
    private var renderedScene: CjguiComposableUiScene
    // External context can advance without a Metal submission when only
    // containment changes. Native FIFO intents must instead resolve against
