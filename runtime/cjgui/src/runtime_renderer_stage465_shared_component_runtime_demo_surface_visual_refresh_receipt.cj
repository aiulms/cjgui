func cjguiInternalBuildRendererStage465SharedComponentRuntimeDemoSurfaceVisualRefreshReceiptPlan(
    layoutStyle: CjguiInternalRendererStage464SharedComponentRuntimeLayoutStyleRefreshContractReadiness): CjguiInternalRendererStage465SharedComponentRuntimeDemoSurfaceVisualRefreshReceiptPlan {
    let stage464Ready = layoutStyle.didConfirmStage464SharedComponentRuntimeLayoutStyleRefreshContractReady && layoutStyle
        .didConfirmStage465SharedComponentRuntimeDemoSurfaceVisualRefreshReceiptPrepared
    let previewReady = stage464Ready && layoutStyle
        .didConfirmSharedComponentRuntimeLayoutStyleRefreshContractMaterialized && layoutStyle
        .didConfirmTodoRuntimeLayoutStyleTextFocusPreviewMaterialized && layoutStyle
        .didConfirmSettingsRuntimeLayoutStyleTextFocusPreviewMaterialized && layoutStyle
        .didConfirmAiGeneratedSettingsRuntimeLayoutStyleTextFocusPreviewMaterialized && layoutStyle
        .didConfirmLayoutStyleRefreshContractPreviewOnly
    let receiptReady = previewReady && layoutStyle
        .didConfirmRenderCommandRefreshBridgeToLayoutStyleRefreshContractBound && layoutStyle
        .didConfirmComponentRuntimeContractToLayoutStyleRefreshContractBound

    return CjguiInternalRendererStage465SharedComponentRuntimeDemoSurfaceVisualRefreshReceiptPlan(
        stage464Ready,
        previewReady,
        previewReady,
        previewReady,
        previewReady,
        receiptReady,
        receiptReady,
        receiptReady,
        receiptReady,
        receiptReady,
        receiptReady,
        receiptReady,
        receiptReady,
        receiptReady,
        receiptReady && layoutStyle.didConfirmRendererStateWriteBlocked,
        layoutStyle.didConfirmInputEventPipelineEnabled == false,
        layoutStyle.didConfirmInputEventPipelineExecution == false,
        layoutStyle.didConfirmActionDispatch == false,
        layoutStyle.didConfirmStateUpdateCommitted == false,
        layoutStyle.didConfirmVisibilityPublicationAdmitted == false,
        layoutStyle.didConfirmVisibilityPublished == false,
        layoutStyle.didConfirmPublicComponentApiAdded == false,
        layoutStyle.didConfirmLayoutEngineEnabled == false,
        layoutStyle.didConfirmStyleResolverEnabled == false,
        layoutStyle.didConfirmTextShapingEnabled == false,
        layoutStyle.didConfirmFocusManagerEnabled == false,
        layoutStyle.didConfirmBackendImplementationBlocked,
        layoutStyle.didConfirmPlatformCommandBufferBlocked,
        layoutStyle.didConfirmRendererSubmissionBlocked,
        layoutStyle.didConfirmRendererStateWriteBlocked,
        layoutStyle.didConfirmRuntimeStateWriteBlocked
    )
}

