func cjguiInternalRendererStage797PreviewComponentApiStateStoreCommitAdmissionPreviewMaterialized(): Bool {
    return true
}

func cjguiInternalBuildRendererStage797PreviewComponentApiStateStoreCommitAdmissionPreviewPlan(
    runtimeManager: CjguiInternalRendererStage796PreviewComponentApiStateStoreBridgeRuntimeManagerReadiness): CjguiInternalRendererStage797PreviewComponentApiStateStoreCommitAdmissionPreviewPlan {
    let stage796Ready = runtimeManager.didConfirmStage796PreviewComponentApiStateStoreBridgeRuntimeManagerReady && runtimeManager
        .didConfirmStage797PreviewComponentApiStateStoreCommitAdmissionPreviewPrepared
    let bridgeRuntimeReady = runtimeManager.didConfirmSharedComponentStateStoreBridgeRuntimeManagerMaterialized && runtimeManager
        .didConfirmComponentStateStoreBridgeExecutionReceiptContractMaterialized && runtimeManager
        .didConfirmFileBrowserComponentStateStoreBridgeRuntimeSurfaceMaterialized && runtimeManager
        .didConfirmStateStoreBridgeRuntimeManagerBoundToStage794DryRunExecutor
    let admissionReady = stage796Ready && bridgeRuntimeReady &&
        cjguiInternalRendererStage797PreviewComponentApiStateStoreCommitAdmissionPreviewMaterialized()
    return CjguiInternalRendererStage797PreviewComponentApiStateStoreCommitAdmissionPreviewPlan(
        stage796Ready,
        bridgeRuntimeReady,
        admissionReady,
        admissionReady,
        admissionReady,
        admissionReady,
        admissionReady,
        admissionReady,
        admissionReady,
        admissionReady,
        runtimeManager.didConfirmRendererSubmissionBlocked,
        runtimeManager.didConfirmRendererStateWriteBlocked,
        runtimeManager.didConfirmRuntimeStateWriteBlocked
    )
}

