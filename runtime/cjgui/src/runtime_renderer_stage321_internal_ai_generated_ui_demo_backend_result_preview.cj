func cjguiInternalBuildRendererStage321InternalAiGeneratedUiDemoBackendResultPreviewFacts(
    internalAiGeneratedUiDemoBackendAdapterReadinessDecision: CjguiInternalRendererStage320InternalAiGeneratedUiDemoBackendAdapterReadinessDecisionReadiness): CjguiInternalRendererStage321InternalAiGeneratedUiDemoBackendResultPreviewFacts {
    let diffExplain = internalAiGeneratedUiDemoBackendAdapterReadinessDecision.backendAdapterSemanticDiffExplain
    let resultEnvelope = diffExplain.backendAdapterResultEnvelope
    let adapterDryRun = resultEnvelope.aiGeneratedUiActionLoopBackendAdapterDryRun
    let actionLoop = adapterDryRun.internalAiGeneratedUiDemoActionLoopReadinessDecision

    return CjguiInternalRendererStage321InternalAiGeneratedUiDemoBackendResultPreviewFacts(
        internalAiGeneratedUiDemoBackendAdapterReadinessDecision
            .didConfirmInternalAiGeneratedUiDemoBackendAdapterReadinessDecisionReady,
        true,
        resultEnvelope.didConfirmAiGeneratedUiBackendAdapterDryRunResultEnvelopeReady,
        diffExplain.didConfirmAiGeneratedUiBackendAdapterSemanticDiffExplainReady,
        adapterDryRun.didConfirmBackendAdapterDryRunBoundToRefreshedRenderCommandPreview,
        resultEnvelope.didConfirmBackendAdapterResultOwnerLocalInMemoryOnly,
        internalAiGeneratedUiDemoBackendAdapterReadinessDecision
            .didConfirmBackendAdapterRunwayJoinedWithRollbackVisibilityBoundary && resultEnvelope
            .didConfirmBackendAdapterResultVisibilityNotPublished && actionLoop
            .didConfirmAiGeneratedUiActionLoopJoinedWithVisibilityNotPublishedBoundary,
        true,
        internalAiGeneratedUiDemoBackendAdapterReadinessDecision.didConfirmOwnerAcceptanceRequired,
        internalAiGeneratedUiDemoBackendAdapterReadinessDecision.didConfirmOwnerAcceptanceGranted == false,
        actionLoop.didConfirmPublicComponentApiAdded == false,
        actionLoop.didConfirmActionDispatch == false,
        actionLoop.didConfirmStateUpdateCommitted == false,
        internalAiGeneratedUiDemoBackendAdapterReadinessDecision.didConfirmBackendReadyTruth == false,
        internalAiGeneratedUiDemoBackendAdapterReadinessDecision.didConfirmPlatformCommandBufferBlocked,
        internalAiGeneratedUiDemoBackendAdapterReadinessDecision.didConfirmRendererSubmissionBlocked,
        internalAiGeneratedUiDemoBackendAdapterReadinessDecision.didConfirmRendererStateWriteBlocked,
        internalAiGeneratedUiDemoBackendAdapterReadinessDecision.didConfirmRuntimeStateWriteBlocked,
        true,
        internalAiGeneratedUiDemoBackendAdapterReadinessDecision.didConfirmVisibilityPublished == false
    )
}

func cjguiInternalBuildRendererStage321InternalAiGeneratedUiDemoBackendResultPreviewReadiness(
    internalAiGeneratedUiDemoBackendAdapterReadinessDecision: CjguiInternalRendererStage320InternalAiGeneratedUiDemoBackendAdapterReadinessDecisionReadiness,
    backendResultPreviewFacts: CjguiInternalRendererStage321InternalAiGeneratedUiDemoBackendResultPreviewFacts
): CjguiInternalRendererStage321InternalAiGeneratedUiDemoBackendResultPreviewReadiness {
    let previewReady = backendResultPreviewFacts
        .didConsumeStage320InternalAiGeneratedUiDemoBackendAdapterReadinessDecision && backendResultPreviewFacts
        .didMaterializeAiGeneratedUiBackendResultPreview && backendResultPreviewFacts
        .didBindBackendResultPreviewToBackendAdapterResultEnvelope && backendResultPreviewFacts
        .didBindBackendResultPreviewToBackendAdapterSemanticDiffExplain && backendResultPreviewFacts
        .didBindBackendResultPreviewToActionLoopRefreshedRenderCommand && backendResultPreviewFacts
        .didKeepBackendResultPreviewOwnerLocalInMemoryOnly && backendResultPreviewFacts
        .didPreserveBackendAdapterRollbackVisibilityBoundary && backendResultPreviewFacts
        .didPrepareStage322BackendResultSemanticDiffExplainInput
    let stopLineReady = backendResultPreviewFacts.didKeepOwnerAcceptanceRequired && backendResultPreviewFacts
        .didKeepOwnerAcceptanceNotGranted && backendResultPreviewFacts.didKeepPublicComponentApiBlocked && backendResultPreviewFacts
        .didKeepActionDispatchBlocked && backendResultPreviewFacts.didKeepStateUpdateCommittedBlocked && backendResultPreviewFacts
        .didKeepBackendReadyTruthBlocked && backendResultPreviewFacts.didKeepPlatformCommandBufferBlocked && backendResultPreviewFacts
        .didKeepRendererSubmissionBlocked && backendResultPreviewFacts.didKeepRendererStateWriteBlocked && backendResultPreviewFacts
        .didKeepRuntimeStateWriteBlocked && backendResultPreviewFacts.didKeepNativeBridgeExpansionBlocked && backendResultPreviewFacts
        .didKeepVisibilityNotPublished

    return CjguiInternalRendererStage321InternalAiGeneratedUiDemoBackendResultPreviewReadiness(
        internalAiGeneratedUiDemoBackendAdapterReadinessDecision,
        backendResultPreviewFacts,
        previewReady && stopLineReady,
        previewReady && stopLineReady,
        backendResultPreviewFacts.didMaterializeAiGeneratedUiBackendResultPreview,
        backendResultPreviewFacts.didBindBackendResultPreviewToBackendAdapterResultEnvelope,
        backendResultPreviewFacts.didBindBackendResultPreviewToBackendAdapterSemanticDiffExplain,
        backendResultPreviewFacts.didBindBackendResultPreviewToActionLoopRefreshedRenderCommand,
        backendResultPreviewFacts.didKeepBackendResultPreviewOwnerLocalInMemoryOnly,
        backendResultPreviewFacts.didPreserveBackendAdapterRollbackVisibilityBoundary,
        backendResultPreviewFacts.didPrepareStage322BackendResultSemanticDiffExplainInput,
        backendResultPreviewFacts.didKeepOwnerAcceptanceRequired,
        false,
        false,
        false,
        false,
        false,
        backendResultPreviewFacts.didKeepPlatformCommandBufferBlocked,
        backendResultPreviewFacts.didKeepRendererSubmissionBlocked,
        backendResultPreviewFacts.didKeepRendererStateWriteBlocked,
        backendResultPreviewFacts.didKeepRuntimeStateWriteBlocked,
        backendResultPreviewFacts.didKeepNativeBridgeExpansionBlocked,
        false
    )
}

