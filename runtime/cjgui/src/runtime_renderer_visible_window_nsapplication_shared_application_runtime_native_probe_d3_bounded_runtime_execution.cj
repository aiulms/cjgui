func cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedRuntimeExecutionFacts(
    d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeRendererStateTwoKeyHandoffReadiness
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedRuntimeExecutionFacts {
    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedRuntimeExecutionFacts(
        d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness
            .didPrepareRuntimeNativeProbeD3ResultEnvelopeRendererStateTwoKeyHandoffReadiness,
        true,
        true,
        true,
        true,
        true,
        true,
        d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness
            .didConfirmNoRendererStateWrite,
        true,
        true,
        d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness
            .didConfirmNoApplicationAccessorCall,
        d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness
            .didConfirmNoNativeBridgeExpansion,
        d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness
            .didConfirmNoPublicApi,
        d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness
            .didConfirmNoProductionPublicCAbi,
        d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness
            .didConfirmNoRuntimeStateWrite,
        d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness
            .didConfirmNoCjpmTomlChange,
        d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness
            .didConfirmNoRendererStateWrite,
        true
    )
}

func cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedRuntimeExecutionReadiness(
    d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeRendererStateTwoKeyHandoffReadiness,
    d3BoundedRuntimeExecutionFacts:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedRuntimeExecutionFacts
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedRuntimeExecutionReadiness {
    let boundedRuntimeExecutionReady =
        d3BoundedRuntimeExecutionFacts
            .didConsumeRendererStateTwoKeyHandoffReadiness &&
        d3BoundedRuntimeExecutionFacts.didOpenBoundedD3RuntimeExecutionRoute &&
        d3BoundedRuntimeExecutionFacts
            .didRequireCapabilityDetectorBeforeExecution &&
        d3BoundedRuntimeExecutionFacts
            .didAllowAutomationStandingD3WhenMetalCapable &&
        d3BoundedRuntimeExecutionFacts
            .didRequireCurrentShellClassificationBeforeNativeExecution &&
        d3BoundedRuntimeExecutionFacts.didPermitIsolatedVisibleWindowProbeOnly &&
        d3BoundedRuntimeExecutionFacts.didRequireResultEnvelopeFromProbe &&
        d3BoundedRuntimeExecutionFacts.didKeepRendererStateWriteBlocked &&
        d3BoundedRuntimeExecutionFacts
            .didConfirmNonMetalShellDoesNotExecuteNativeProbe &&
        d3BoundedRuntimeExecutionFacts
            .didConfirmResultEnvelopeIsNotProductionTruth &&
        d3BoundedRuntimeExecutionFacts
            .didConfirmNoProductionApplicationAccessorCall &&
        d3BoundedRuntimeExecutionFacts.didConfirmNoNativeBridgeExpansion &&
        d3BoundedRuntimeExecutionFacts.didConfirmNoPublicApi &&
        d3BoundedRuntimeExecutionFacts.didConfirmNoProductionPublicCAbi &&
        d3BoundedRuntimeExecutionFacts.didConfirmNoRuntimeStateWrite &&
        d3BoundedRuntimeExecutionFacts.didConfirmNoCjpmTomlChange &&
        d3BoundedRuntimeExecutionFacts.didConfirmNoRendererStateWrite &&
        d3BoundedRuntimeExecutionFacts.didAvoidApprovalHandoffWrapper

    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedRuntimeExecutionReadiness(
        d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness,
        d3BoundedRuntimeExecutionFacts,
        boundedRuntimeExecutionReady,
        d3BoundedRuntimeExecutionFacts
            .didRequireCapabilityDetectorBeforeExecution,
        d3BoundedRuntimeExecutionFacts
            .didAllowAutomationStandingD3WhenMetalCapable,
        d3BoundedRuntimeExecutionFacts.didRequireResultEnvelopeFromProbe,
        d3BoundedRuntimeExecutionFacts.didKeepRendererStateWriteBlocked,
        boundedRuntimeExecutionReady,
        d3BoundedRuntimeExecutionFacts
            .didConsumeRendererStateTwoKeyHandoffReadiness,
        d3BoundedRuntimeExecutionFacts
            .didAllowAutomationStandingD3WhenMetalCapable,
        d3BoundedRuntimeExecutionFacts.didPermitIsolatedVisibleWindowProbeOnly,
        d3BoundedRuntimeExecutionFacts
            .didConfirmNonMetalShellDoesNotExecuteNativeProbe,
        d3BoundedRuntimeExecutionFacts
            .didConfirmResultEnvelopeIsNotProductionTruth,
        d3BoundedRuntimeExecutionFacts
            .didConfirmNoProductionApplicationAccessorCall,
        d3BoundedRuntimeExecutionFacts.didConfirmNoNativeBridgeExpansion,
        d3BoundedRuntimeExecutionFacts.didConfirmNoPublicApi,
        d3BoundedRuntimeExecutionFacts.didConfirmNoProductionPublicCAbi,
        d3BoundedRuntimeExecutionFacts.didConfirmNoRuntimeStateWrite,
        d3BoundedRuntimeExecutionFacts.didConfirmNoCjpmTomlChange,
        d3BoundedRuntimeExecutionFacts.didConfirmNoRendererStateWrite,
        d3BoundedRuntimeExecutionFacts.didAvoidApprovalHandoffWrapper
    )
}

func cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedRuntimeExecutionDraft():
    CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedRuntimeExecutionReadiness {
    let d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness =
        cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3ResultEnvelopeRendererStateTwoKeyHandoffDraft()
    let d3BoundedRuntimeExecutionFacts =
        cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedRuntimeExecutionFacts(
            d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness
        )
    return cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedRuntimeExecutionReadiness(
        d3ResultEnvelopeRendererStateTwoKeyHandoffReadiness,
        d3BoundedRuntimeExecutionFacts
    )
}
