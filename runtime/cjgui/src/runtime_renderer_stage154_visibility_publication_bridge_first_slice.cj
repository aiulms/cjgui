        didKeepVisibilityPublicationAdmissionPredicatesUnsatisfied: Bool,
        didKeepRendererStateWriteBlocked: Bool,
        didKeepRuntimeStateWriteBlocked: Bool,
        didConfirmNoNativeBridgeExpansion: Bool,
        didConfirmNoPublicApi: Bool,
        didConfirmNoProductionPublicCAbi: Bool,
        didConfirmNoRuntimeStateWrite: Bool,
        didConfirmNoCjpmTomlChange: Bool,
        didConfirmNoRendererStateWrite: Bool
    ) {
        this.didConsumeStage153GuardedExecutorBridgeReadiness =
            didConsumeStage153GuardedExecutorBridgeReadiness
        this.didConsumeLegacyVisibilityPublicationDenialReadiness =
            didConsumeLegacyVisibilityPublicationDenialReadiness
        this.didRequireStage153GuardedExecutorBridgePacket =
            didRequireStage153GuardedExecutorBridgePacket
        this.didRequireLegacyVisibilityPublicationDenialPacket =
            didRequireLegacyVisibilityPublicationDenialPacket
        this.didBindStage153DenialInputToVisibilityPublicationEnvelope =
            didBindStage153DenialInputToVisibilityPublicationEnvelope
        this.didMaterializeVisibilityPublicationPositivePredicateMap =
            didMaterializeVisibilityPublicationPositivePredicateMap
        this.didDefineVisibilityPublicationAdmissionPositiveFixture =
            didDefineVisibilityPublicationAdmissionPositiveFixture
        this.didBindLegacyVisibilityDenialToStage154Bridge =
            didBindLegacyVisibilityDenialToStage154Bridge
        this.didPrepareRollbackVisibilityBoundaryInput =
            didPrepareRollbackVisibilityBoundaryInput
        this.didKeepVisibilityPublicationBridgeSourceOnly =
            didKeepVisibilityPublicationBridgeSourceOnly
        this.didKeepVisibilityPublicationRuntimeAdmissionBlocked =
            didKeepVisibilityPublicationRuntimeAdmissionBlocked
        this.didKeepVisibilityPublicationNonExecutable =
            didKeepVisibilityPublicationNonExecutable
        this.didKeepVisibilityPublicationDenied =
            didKeepVisibilityPublicationDenied
        this.didKeepVisibilityPublicationAdmissionPredicatesUnsatisfied =
            didKeepVisibilityPublicationAdmissionPredicatesUnsatisfied
        this.didKeepRendererStateWriteBlocked = didKeepRendererStateWriteBlocked
        this.didKeepRuntimeStateWriteBlocked = didKeepRuntimeStateWriteBlocked
        this.didConfirmNoNativeBridgeExpansion = didConfirmNoNativeBridgeExpansion
