func cjguiInternalBuildRendererStage404DemoSurfaceBackendAdapterResultRefreshPreview(
    backendAdapterDryRun: CjguiInternalRendererStage403DemoSurfaceRenderCommandBackendAdapterDryRunReadiness): CjguiInternalRendererStage404DemoSurfaceBackendAdapterResultRefreshPreview {
    let stage403Ready = backendAdapterDryRun.didConfirmStage403DemoSurfaceRenderCommandBackendAdapterDryRunReady && backendAdapterDryRun
        .didConfirmStage404DemoSurfaceBackendAdapterResultRefreshPrepared
    let mappingReady = stage403Ready && backendAdapterDryRun.didConfirmBackendAdapterDryRunMappingMaterialized && backendAdapterDryRun
        .didConfirmBackendAdapterMappingOwnerLocal && backendAdapterDryRun.didConfirmBackendAdapterMappingPreviewOnly
    let classifiedDemoSurfacesReady = mappingReady && backendAdapterDryRun
        .didConfirmTodoRenderCommandBatchToBackendAdapterSlotMapped && backendAdapterDryRun
        .didConfirmSettingsRenderCommandBatchToBackendAdapterSlotMapped && backendAdapterDryRun
        .didConfirmAiGeneratedSettingsRenderCommandBatchToBackendAdapterSlotMapped

    return CjguiInternalRendererStage404DemoSurfaceBackendAdapterResultRefreshPreview(
        stage403Ready,
        mappingReady,
        classifiedDemoSurfacesReady,
        classifiedDemoSurfacesReady,
        classifiedDemoSurfacesReady,
        classifiedDemoSurfacesReady,
        classifiedDemoSurfacesReady && backendAdapterDryRun.didConfirmBackendAdapterDryRunBoundToStage401AdapterSlots,
        classifiedDemoSurfacesReady && backendAdapterDryRun.didConfirmBackendAdapterDryRunBoundToStage402CommandBatch,
        classifiedDemoSurfacesReady,
        classifiedDemoSurfacesReady,
        backendAdapterDryRun.didConfirmBackendImplementationBlocked,
        backendAdapterDryRun.didConfirmPlatformCommandBufferBlocked,
        backendAdapterDryRun.didConfirmRendererSubmissionBlocked
    )
}

