func cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationExternalPreexistingSingletonSourceWitnessTruthRecoveryPreflightFacts(
    productionSingletonOwnershipFalseBranchDownstreamReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationProductionSingletonOwnershipFalseBranchDownstreamReadiness
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationExternalPreexistingSingletonSourceWitnessTruthRecoveryPreflightFacts {
    let downstream =
        productionSingletonOwnershipFalseBranchDownstreamReadiness
            .productionSingletonOwnershipFalseBranchDownstream
    let downstreamFacts = downstream.falseBranchDownstreamFacts
    let downstreamReady =
        productionSingletonOwnershipFalseBranchDownstreamReadiness
            .didPrepareProductionSingletonOwnershipFalseBranchDownstreamReadiness &&
        productionSingletonOwnershipFalseBranchDownstreamReadiness
            .didClassifyProductionSingletonOwnershipFalseBranch &&
        productionSingletonOwnershipFalseBranchDownstreamReadiness
            .didRouteBackToSourceReadinessEvidenceGap &&
        productionSingletonOwnershipFalseBranchDownstreamReadiness
            .didKeepProductionSingletonOwnershipTruthFalse &&
        productionSingletonOwnershipFalseBranchDownstreamReadiness
            .didKeepProductionSingletonImplementationBlocked &&
        productionSingletonOwnershipFalseBranchDownstreamReadiness
            .didKeepProductionActualAccessorCallSiteBlocked &&
        productionSingletonOwnershipFalseBranchDownstreamReadiness
            .didKeepFalseBranchDownstreamReadinessDehydrated

    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationExternalPreexistingSingletonSourceWitnessTruthRecoveryPreflightFacts(
        downstreamReady,
        true,
        downstreamFacts.didRequireExternalWitnessTruthBeforeImplementation,
        downstreamFacts
            .didKeepExternalPreexistingSingletonSourceWitnessTruthFalse,
        downstreamFacts.didRouteBackToSourceReadinessEvidenceGap,
        downstreamFacts.didRequireMainThreadConfinementBeforeImplementation,
        true,
        downstreamFacts.didRequireCleanupOwnershipBeforeImplementation,
        true,
        true,
        downstreamFacts.didRequireHeadlessFailClosedBeforeImplementation,
        true,
        downstreamFacts.didKeepExternalPreexistingSingletonSourceWitnessTruthFalse,
        downstreamFacts.didKeepSourceReadinessTruthValueFalse,
        downstreamFacts.didKeepProductionSingletonOwnershipTruthFalse,
        downstreamFacts.didKeepProductionSingletonImplementationBlocked,
        downstreamFacts.didKeepProductionActualAccessorCallSiteBlocked,
        true,
        true,
        downstreamFacts.didConfirmNoApplicationAccessorCall,
        downstreamFacts.didConfirmNoApplicationAccessorCall,
        downstreamFacts.didConfirmNoActivationPolicyMutation,
        downstreamFacts.didConfirmNoApplicationActivation,
        downstreamFacts.didConfirmNoAppKitEventLoop,
        downstreamFacts.didConfirmNoBoundedRunLoopPump,
        downstreamFacts.didKeepCleanupTeardownExecutionBlocked,
        downstreamFacts.didConfirmNoWindowViewLayerCreation,
        downstreamFacts.didConfirmNoVisibleOrder,
        downstreamFacts.didConfirmNoDrawable,
        downstreamFacts.didConfirmNoCommandQueueBufferEncoder,
        downstreamFacts.didConfirmNoRenderCommitPresentGpuSubmission,
        downstreamFacts.didConfirmNoArtifactOrDiagnosticsPublication,
        downstreamFacts.didConfirmNoPointerHandleClassIdReturn,
        downstreamFacts.didConfirmNoPublicApi,
        downstreamFacts.didConfirmNoProductionPublicCAbi,
        downstreamFacts.didConfirmNoRuntimeStateWrite,
        downstreamFacts.didConfirmNoCjpmTomlChange,
        downstreamFacts.didConfirmNoRendererStateWrite,
        downstreamFacts.didConfirmNoBackendReadyTruth,
        true,
        true,
        true,
        true,
        true
    )
}

