}

func cjguiInternalBuildRendererStage741ComponentApiAuthoringDslInternalProbePlan(
    runtimeManager: CjguiInternalRendererStage740ComponentApiInternalShapeRuntimeManagerReadiness): CjguiInternalRendererStage741ComponentApiAuthoringDslInternalProbePlan {
    let stage740Ready = runtimeManager.didConfirmStage740ComponentApiInternalShapeRuntimeManagerReady && runtimeManager
        .didConfirmStage741ComponentApiAuthoringDslInternalProbePrepared
    let contractReady = runtimeManager.didConfirmComponentApiInternalAuthoringRuntimeContractMaterialized && runtimeManager
        .didConfirmComponentApiInternalShapeExecutionReceiptContractMaterialized && runtimeManager
        .didConfirmChatComposerComponentApiInternalShapeRuntimeSurfaceMaterialized
    let dslProbeReady = stage740Ready && contractReady &&
        cjguiInternalRendererStage741ComponentApiAuthoringDslInternalProbeMaterialized()
    return CjguiInternalRendererStage741ComponentApiAuthoringDslInternalProbePlan(
        stage740Ready,
        contractReady,
        dslProbeReady,
        dslProbeReady,
        dslProbeReady,
        dslProbeReady,
        dslProbeReady,
        dslProbeReady,
        dslProbeReady,
        dslProbeReady,
        runtimeManager.didConfirmSharedComponentApiInternalShapeRuntimeManagerMaterialized,
        dslProbeReady && runtimeManager.didConfirmPublicComponentApiAdded == false,
        dslProbeReady,
        runtimeManager.didConfirmHostMutation == false,
        runtimeManager.didConfirmStablePublicApiAdded == false,
        runtimeManager.didConfirmRendererSubmissionBlocked,
        runtimeManager.didConfirmRendererStateWriteBlocked,
        runtimeManager.didConfirmRuntimeStateWriteBlocked
    )
}

