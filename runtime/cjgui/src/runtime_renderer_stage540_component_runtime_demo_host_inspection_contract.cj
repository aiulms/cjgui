        .didKeepBackendReadyTruthBlocked && demoHostInspectionFacts.didKeepPublicComponentApiBlocked && demoHostInspectionFacts
        .didKeepInputEventPipelineBlocked && demoHostInspectionFacts.didKeepInputEventPipelineExecutionBlocked && demoHostInspectionFacts
        .didKeepActionDispatchBlocked && demoHostInspectionFacts.didKeepStateUpdateCommittedBlocked && demoHostInspectionFacts
