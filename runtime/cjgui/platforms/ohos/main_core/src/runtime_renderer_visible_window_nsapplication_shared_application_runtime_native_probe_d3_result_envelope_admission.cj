        didAvoidSameShapeRecoveryWrapper: Bool,
        didKeepD3ResultEnvelopeAdmissionDehydrated: Bool
    ) {
        this.didConsumeD3EnvironmentRecoveryReadiness =
            didConsumeD3EnvironmentRecoveryReadiness
        this.didOpenD3ResultEnvelopeAdmissionRoute =
