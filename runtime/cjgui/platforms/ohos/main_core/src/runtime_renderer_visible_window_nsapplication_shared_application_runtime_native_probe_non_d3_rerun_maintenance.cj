func cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeNonD3RerunMaintenanceFacts(
    sourceBuildProbeEvidenceReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeSourceBuildProbeEvidenceReadiness
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeNonD3RerunMaintenanceFacts {
    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeNonD3RerunMaintenanceFacts(
        sourceBuildProbeEvidenceReadiness
            .didPrepareRuntimeNativeProbeSourceBuildProbeEvidenceReadiness,
        true,
        true,
        true,
        true,
        true,
        true,
        sourceBuildProbeEvidenceReadiness
            .didConfirmAutomationEnvironmentBlockerClassified,
        sourceBuildProbeEvidenceReadiness.didConfirmCodeFailureDomainFalse,
        sourceBuildProbeEvidenceReadiness.didConfirmD3ApprovalStillExternal,
        sourceBuildProbeEvidenceReadiness
            .didConfirmRuntimeNativeProbeExecutionStillBlocked,
        sourceBuildProbeEvidenceReadiness.didConfirmNoApplicationAccessorCall,
        sourceBuildProbeEvidenceReadiness.didConfirmNoNativeBridgeExpansion,
        sourceBuildProbeEvidenceReadiness.didConfirmNoSingletonCreation,
        sourceBuildProbeEvidenceReadiness.didConfirmNoPublicApi,
        sourceBuildProbeEvidenceReadiness.didConfirmNoProductionPublicCAbi,
        sourceBuildProbeEvidenceReadiness.didConfirmNoRendererStateWrite,
        sourceBuildProbeEvidenceReadiness.didConfirmNoRuntimeStateWrite,
        sourceBuildProbeEvidenceReadiness.didConfirmNoCjpmTomlChange,
        sourceBuildProbeEvidenceReadiness.didAvoidSameShapeNoAccessorWrapper,
        sourceBuildProbeEvidenceReadiness
            .didKeepSourceBuildProbeEvidenceRouteDehydrated
    )
}

func cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeNonD3RerunMaintenanceReadiness(
    sourceBuildProbeEvidenceReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeSourceBuildProbeEvidenceReadiness,
    nonD3RerunMaintenanceFacts:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeNonD3RerunMaintenanceFacts
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeNonD3RerunMaintenanceReadiness {
    let rerunMaintenanceReady =
        nonD3RerunMaintenanceFacts
            .didConsumeSourceBuildProbeEvidenceReadiness &&
        nonD3RerunMaintenanceFacts.didOpenNonD3RerunMaintenanceRoute &&
        nonD3RerunMaintenanceFacts
            .didRequireFreshFocusedRegressionSuiteRerun &&
        nonD3RerunMaintenanceFacts.didRequireAnchoredPacketIntegrityGuard &&
        nonD3RerunMaintenanceFacts.didRequireFailureDomainReplay &&
        nonD3RerunMaintenanceFacts.didRequireOrchestrationRunner &&
        nonD3RerunMaintenanceFacts.didRequireMaintenanceAggregateGuard &&
        nonD3RerunMaintenanceFacts
            .didKeepAutomationEnvironmentBlockerClassified &&
        nonD3RerunMaintenanceFacts.didKeepCodeFailureDomainFalse &&
        nonD3RerunMaintenanceFacts.didKeepD3RuntimeNativeProbeApprovalExternal &&
        nonD3RerunMaintenanceFacts.didKeepRuntimeNativeProbeExecutionBlocked &&
        nonD3RerunMaintenanceFacts.didConfirmNoApplicationAccessorCall &&
        nonD3RerunMaintenanceFacts.didConfirmNoNativeBridgeExpansion &&
        nonD3RerunMaintenanceFacts.didConfirmNoSingletonCreation &&
        nonD3RerunMaintenanceFacts.didConfirmNoPublicApi &&
        nonD3RerunMaintenanceFacts.didConfirmNoProductionPublicCAbi &&
        nonD3RerunMaintenanceFacts.didConfirmNoRendererStateWrite &&
        nonD3RerunMaintenanceFacts.didConfirmNoRuntimeStateWrite &&
        nonD3RerunMaintenanceFacts.didConfirmNoCjpmTomlChange &&
        nonD3RerunMaintenanceFacts.didAvoidSameShapeNoAccessorWrapper &&
        nonD3RerunMaintenanceFacts.didKeepNonD3RerunMaintenanceDehydrated

    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeNonD3RerunMaintenanceReadiness(
        sourceBuildProbeEvidenceReadiness,
        nonD3RerunMaintenanceFacts,
        rerunMaintenanceReady,
        true,
        rerunMaintenanceReady,
        !rerunMaintenanceReady,
        nonD3RerunMaintenanceFacts
            .didConsumeSourceBuildProbeEvidenceReadiness,
        nonD3RerunMaintenanceFacts
            .didRequireFreshFocusedRegressionSuiteRerun,
        nonD3RerunMaintenanceFacts.didRequireAnchoredPacketIntegrityGuard,
        nonD3RerunMaintenanceFacts.didRequireFailureDomainReplay,
        nonD3RerunMaintenanceFacts.didRequireOrchestrationRunner,
        nonD3RerunMaintenanceFacts.didRequireMaintenanceAggregateGuard,
        nonD3RerunMaintenanceFacts
            .didKeepAutomationEnvironmentBlockerClassified,
        nonD3RerunMaintenanceFacts.didKeepCodeFailureDomainFalse,
        nonD3RerunMaintenanceFacts.didKeepD3RuntimeNativeProbeApprovalExternal,
        nonD3RerunMaintenanceFacts.didKeepRuntimeNativeProbeExecutionBlocked,
        nonD3RerunMaintenanceFacts.didConfirmNoApplicationAccessorCall,
        nonD3RerunMaintenanceFacts.didConfirmNoNativeBridgeExpansion,
        nonD3RerunMaintenanceFacts.didConfirmNoSingletonCreation,
        nonD3RerunMaintenanceFacts.didConfirmNoPublicApi,
        nonD3RerunMaintenanceFacts.didConfirmNoProductionPublicCAbi,
        nonD3RerunMaintenanceFacts.didConfirmNoRendererStateWrite,
        nonD3RerunMaintenanceFacts.didConfirmNoRuntimeStateWrite,
        nonD3RerunMaintenanceFacts.didConfirmNoCjpmTomlChange,
        nonD3RerunMaintenanceFacts.didAvoidSameShapeNoAccessorWrapper,
        nonD3RerunMaintenanceFacts.didKeepNonD3RerunMaintenanceDehydrated
    )
}

func cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeNonD3RerunMaintenanceDraft():
    CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeNonD3RerunMaintenanceReadiness {
    let sourceBuildProbeEvidenceReadiness =
        cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeSourceBuildProbeEvidenceDraft()
    let nonD3RerunMaintenanceFacts =
        cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeNonD3RerunMaintenanceFacts(
            sourceBuildProbeEvidenceReadiness
        )
    return cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeNonD3RerunMaintenanceReadiness(
        sourceBuildProbeEvidenceReadiness,
        nonD3RerunMaintenanceFacts
    )
}
