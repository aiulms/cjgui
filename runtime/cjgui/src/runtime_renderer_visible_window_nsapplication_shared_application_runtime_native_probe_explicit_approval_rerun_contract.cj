        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeExplicitApprovalRerunContractFacts
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeExplicitApprovalRerunContractReadiness {
    let rerunContractReady =
        explicitApprovalRerunContractFacts
            .didConsumeExplicitApprovalHandoffEvidenceMeshReadiness &&
        explicitApprovalRerunContractFacts
            .didOpenExplicitApprovalRerunContractRoute &&
        explicitApprovalRerunContractFacts.didRequireTwoPassMeshRerunContract &&
        explicitApprovalRerunContractFacts
            .didRequireStableNonD3ApprovalFactsAcrossReruns &&
        explicitApprovalRerunContractFacts.didRequireSourceBuildGuard &&
        explicitApprovalRerunContractFacts.didRequireEvidenceHandoffPacket &&
        explicitApprovalRerunContractFacts.didRequireFocusedRegressionSuite &&
        explicitApprovalRerunContractFacts
            .didKeepMetalCapabilitySeparateFromD3Approval &&
        explicitApprovalRerunContractFacts
            .didKeepD3RuntimeNativeProbeApprovalExternal &&
        explicitApprovalRerunContractFacts
            .didKeepRuntimeNativeProbeExecutionBlocked &&
        explicitApprovalRerunContractFacts
            .didKeepHumanApprovedD3ExecutionUnconsumed &&
        explicitApprovalRerunContractFacts.didKeepCodeFailureDomainFalse &&
        explicitApprovalRerunContractFacts.didConfirmNoApplicationAccessorCall &&
        explicitApprovalRerunContractFacts.didConfirmNoNativeBridgeExpansion &&
        explicitApprovalRerunContractFacts.didConfirmNoSingletonCreation &&
        explicitApprovalRerunContractFacts.didConfirmNoPublicApi &&
        explicitApprovalRerunContractFacts.didConfirmNoProductionPublicCAbi &&
        explicitApprovalRerunContractFacts.didConfirmNoRendererStateWrite &&
        explicitApprovalRerunContractFacts.didConfirmNoRuntimeStateWrite &&
        explicitApprovalRerunContractFacts.didConfirmNoCjpmTomlChange &&
        explicitApprovalRerunContractFacts.didAvoidSameShapeNoAccessorWrapper &&
        explicitApprovalRerunContractFacts
            .didKeepExplicitApprovalRerunContractDehydrated

    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeExplicitApprovalRerunContractReadiness(
        explicitApprovalHandoffEvidenceMeshReadiness,
        explicitApprovalRerunContractFacts,
        rerunContractReady,
        true,
        rerunContractReady,
        !rerunContractReady,
        explicitApprovalRerunContractFacts
            .didConsumeExplicitApprovalHandoffEvidenceMeshReadiness,
        explicitApprovalRerunContractFacts.didRequireTwoPassMeshRerunContract,
        explicitApprovalRerunContractFacts
            .didRequireStableNonD3ApprovalFactsAcrossReruns,
        explicitApprovalRerunContractFacts.didRequireSourceBuildGuard,
        explicitApprovalRerunContractFacts.didRequireEvidenceHandoffPacket,
        explicitApprovalRerunContractFacts.didRequireFocusedRegressionSuite,
        explicitApprovalRerunContractFacts
            .didKeepMetalCapabilitySeparateFromD3Approval,
        explicitApprovalRerunContractFacts
            .didKeepD3RuntimeNativeProbeApprovalExternal,
        explicitApprovalRerunContractFacts
            .didKeepRuntimeNativeProbeExecutionBlocked,
        explicitApprovalRerunContractFacts
            .didKeepHumanApprovedD3ExecutionUnconsumed,
        explicitApprovalRerunContractFacts.didKeepCodeFailureDomainFalse,
        explicitApprovalRerunContractFacts
            .didConfirmNoApplicationAccessorCall,
        explicitApprovalRerunContractFacts.didConfirmNoNativeBridgeExpansion,
        explicitApprovalRerunContractFacts.didConfirmNoSingletonCreation,
        explicitApprovalRerunContractFacts.didConfirmNoPublicApi,
        explicitApprovalRerunContractFacts.didConfirmNoProductionPublicCAbi,
        explicitApprovalRerunContractFacts.didConfirmNoRendererStateWrite,
        explicitApprovalRerunContractFacts.didConfirmNoRuntimeStateWrite,
        explicitApprovalRerunContractFacts.didConfirmNoCjpmTomlChange,
        explicitApprovalRerunContractFacts.didAvoidSameShapeNoAccessorWrapper,
        explicitApprovalRerunContractFacts
            .didKeepExplicitApprovalRerunContractDehydrated
    )
}

func cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeExplicitApprovalRerunContractDraft():
