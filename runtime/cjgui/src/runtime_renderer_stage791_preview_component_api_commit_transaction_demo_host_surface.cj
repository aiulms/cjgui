    let didConsumeStage790PreviewComponentApiCommitTransactionPatchPlan: Bool
    let didConsumeOwnerLocalTransactionPatchPlan: Bool
    let didMaterializeCommitTransactionHostInspectionReceipt: Bool
    let didMaterializeCommitTransactionResultSurfaceRefresh: Bool
    let didMaterializeCommitTransactionRollbackPreviewReceipt: Bool
