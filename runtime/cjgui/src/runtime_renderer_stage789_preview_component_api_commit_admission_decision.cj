        didPrepareStage790PreviewComponentApiCommitTransactionPatchPlan: Bool,
        didKeepRendererSubmissionBlocked: Bool,
        didKeepRendererStateWriteBlocked: Bool,
        didKeepRuntimeStateWriteBlocked: Bool
    ) {
        this.didConsumeStage788PreviewComponentApiCommitInspectionPublicPreviewRuntimeManager = didConsumeStage788PreviewComponentApiCommitInspectionPublicPreviewRuntimeManager
        this.didConsumePublicPreviewRuntimeManagerContract = didConsumePublicPreviewRuntimeManagerContract
        this.didMaterializePreviewComponentApiCommitAdmissionDecisionResolver = didMaterializePreviewComponentApiCommitAdmissionDecisionResolver
        this.didMaterializeAcceptedPreviewCommitDecisionRoute = didMaterializeAcceptedPreviewCommitDecisionRoute
        this.didMaterializeRejectedPreviewCommitDecisionRoute = didMaterializeRejectedPreviewCommitDecisionRoute
        this.didMaterializeRequestChangesCommitDecisionRoute = didMaterializeRequestChangesCommitDecisionRoute
        this.didMaterializeRollbackOnlyCommitDecisionRoute = didMaterializeRollbackOnlyCommitDecisionRoute
        this.didMaterializeOwnerControlledCommitDecisionLedger = didMaterializeOwnerControlledCommitDecisionLedger
        this.didBindCommitAdmissionDecisionToStage788PublicPreviewRuntimeManager = didBindCommitAdmissionDecisionToStage788PublicPreviewRuntimeManager
        this.didKeepCommitAdmissionDecisionNonDispatching = didKeepCommitAdmissionDecisionNonDispatching
        this.didPrepareStage790PreviewComponentApiCommitTransactionPatchPlan = didPrepareStage790PreviewComponentApiCommitTransactionPatchPlan
        this.didKeepRendererSubmissionBlocked = didKeepRendererSubmissionBlocked
        this.didKeepRendererStateWriteBlocked = didKeepRendererStateWriteBlocked
        this.didKeepRuntimeStateWriteBlocked = didKeepRuntimeStateWriteBlocked
    }
}

