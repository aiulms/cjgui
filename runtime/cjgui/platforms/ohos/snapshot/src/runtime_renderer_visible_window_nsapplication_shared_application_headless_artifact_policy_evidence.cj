    headlessArtifactPolicyEvidenceFacts:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationHeadlessArtifactPolicyEvidenceFacts
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationHeadlessArtifactPolicyEvidenceAdmission {
    let admitted =
        headlessArtifactPolicyEvidenceFacts
            .didPreserveTeardownOrderingEvidenceReadiness &&
        headlessArtifactPolicyEvidenceFacts
            .didKeepHeadlessArtifactPolicyEvidenceRequired &&
        headlessArtifactPolicyEvidenceFacts.didKeepCiArtifactPolicyEvidenceOnly &&
        headlessArtifactPolicyEvidenceFacts
            .didRequireHeadlessArtifactPathContainment &&
        headlessArtifactPolicyEvidenceFacts
            .didRequireHeadlessArtifactRetentionPolicy &&
        headlessArtifactPolicyEvidenceFacts
