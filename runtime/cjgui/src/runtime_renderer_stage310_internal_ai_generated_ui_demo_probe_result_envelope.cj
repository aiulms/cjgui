            .didPrepareStage311AiGeneratedUiDemoProbeSemanticDiffExplainInput
    let stopLineReady =
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didKeepOwnerAcceptanceRequired &&
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didKeepOwnerAcceptanceNotGranted &&
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didKeepBackendReadyTruthBlocked &&
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didKeepPublicComponentApiBlocked &&
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didKeepActionDispatchBlocked &&
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didKeepStateUpdateCommittedBlocked &&
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didKeepRendererSubmissionBlocked &&
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didKeepRendererStateWriteBlocked &&
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didKeepRuntimeStateWriteBlocked &&
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didKeepVisibilityNotPublished

    return CjguiInternalRendererStage310InternalAiGeneratedUiDemoProbeResultEnvelopeReadiness(
        internalAiGeneratedUiDemoProbeInput,
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts,
        envelopeReady && stopLineReady,
        envelopeReady && stopLineReady,
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didMaterializeInternalAiGeneratedUiDemoProbeResultEnvelope,
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didBindAiGeneratedUiProbeResultEnvelopeToProbeInput,
        internalAiGeneratedUiDemoProbeResultEnvelopeFacts
            .didBindAiGeneratedUiProbeResultEnvelopeToComponentStateDeltaDryRun,
