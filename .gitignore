# CJGUI local framework-consumption/build products.  Native source lives in
# `runtime/cjgui/native/`; the nested `native/lib/` folders and `.cjgui/`
# mirrors contain generated object archives, launchers and fingerprints.
__pycache__/
runtime/cjgui/**/.cjgui/
runtime/cjgui/**/native/lib/
runtime/cjgui/independent_consumer_tmp_20260913/

