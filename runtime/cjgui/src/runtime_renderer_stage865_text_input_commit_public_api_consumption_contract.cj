        .didKeepPublicCAbiNotAdded && publicApiConsumptionContractPlan.didKeepOwnerAcceptanceNotGranted && publicApiConsumptionContractPlan
        .didKeepTextInputCommitNotCommitted && publicApiConsumptionContractPlan.didKeepStateStoreCommitNotPublished && publicApiConsumptionContractPlan
        .didKeepActionDispatchBlocked && publicApiConsumptionContractPlan.didKeepStateUpdateCommittedBlocked && publicApiConsumptionContractPlan
        .didKeepVisibilityPublicationAdmittedBlocked && publicApiConsumptionContractPlan
        .didKeepVisibilityPublishedBlocked && publicApiConsumptionContractPlan.didKeepRendererSubmissionBlocked && publicApiConsumptionContractPlan
        .didKeepRendererStateWriteBlocked && publicApiConsumptionContractPlan.didKeepRuntimeStateWriteBlocked && publicApiConsumptionContractFacts
        .didKeepNativeBridgeExpansionBlocked
    return CjguiInternalRendererStage865TextInputCommitPublicApiConsumptionContractReadiness(
        runtimeManager,
