        .didKeepPublicCAbiNotAdded && visualResolverRuntimeManagerFacts.didKeepOwnerAcceptanceNotGranted && visualResolverRuntimeManagerFacts
        .didKeepAcceptanceCommitNotCommitted && visualResolverRuntimeManagerFacts
        .didKeepInputEventPipelineExecutionBlocked && visualResolverRuntimeManagerFacts.didKeepActionDispatchBlocked && visualResolverRuntimeManagerFacts
        .didKeepStateUpdateCommittedBlocked && visualResolverRuntimeManagerPlan.didKeepRendererSubmissionBlocked && visualResolverRuntimeManagerPlan
        .didKeepRendererStateWriteBlocked && visualResolverRuntimeManagerPlan.didKeepRuntimeStateWriteBlocked && visualResolverRuntimeManagerFacts
        .didKeepNativeBridgeExpansionBlocked
    return CjguiInternalRendererStage764PreviewComponentApiVisualResolverRuntimeManagerReadiness(
        demoHostInspectionSurface,
        visualResolverRuntimeManagerPlan,
        visualResolverRuntimeManagerFacts,
        runtimeReady && stopLineReady,
        visualResolverRuntimeManagerPlan.didConsumeStage763PreviewComponentApiDemoHostInspectionSurface,
        demoHostInspectionSurface.didConfirmStage762PreviewComponentApiTextFocusProjectionConsumed,
        demoHostInspectionSurface
            .textFocusProjection
            .didConfirmStage761PreviewComponentApiLayoutStyleConsumptionConsumed,
