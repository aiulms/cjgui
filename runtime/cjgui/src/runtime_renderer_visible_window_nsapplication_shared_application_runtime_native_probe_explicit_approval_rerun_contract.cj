    let explicitApprovalHandoffEvidenceMeshReadiness =
        cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeExplicitApprovalHandoffEvidenceMeshDraft()
    let explicitApprovalRerunContractFacts =
        cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeExplicitApprovalRerunContractFacts(
            explicitApprovalHandoffEvidenceMeshReadiness
