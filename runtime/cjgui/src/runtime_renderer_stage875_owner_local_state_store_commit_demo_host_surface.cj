func cjguiInternalBuildRendererStage875OwnerLocalStateStoreCommitDemoHostSurfacePlan(
    rollbackLedger: CjguiInternalRendererStage874OwnerLocalStateStoreCommitRollbackLedgerReadiness): CjguiInternalRendererStage875OwnerLocalStateStoreCommitDemoHostSurfacePlan {
    let stage874Ready = rollbackLedger.didConfirmStage874OwnerLocalStateStoreCommitRollbackLedgerReady && rollbackLedger
        .didConfirmStage875OwnerLocalStateStoreCommitDemoHostSurfacePrepared
    let ledgerReady = rollbackLedger.didConfirmOwnerLocalStateStoreCommitRollbackLedgerMaterialized && rollbackLedger
        .didConfirmOwnerLocalStateStoreNotPublishedCommitReceiptMaterialized && rollbackLedger
        .didConfirmOwnerLocalStateStoreCommitReversible
    let surfaceReady = stage874Ready && ledgerReady &&
        cjguiInternalRendererStage875OwnerLocalStateStoreCommitDemoHostSurfaceMaterialized()
    return CjguiInternalRendererStage875OwnerLocalStateStoreCommitDemoHostSurfacePlan(
        stage874Ready,
        ledgerReady,
        surfaceReady,
        surfaceReady,
        surfaceReady,
        surfaceReady,
        surfaceReady,
        surfaceReady,
        surfaceReady,
        surfaceReady,
        rollbackLedger.didConfirmRollbackLedgerBoundToStage873Proof,
        surfaceReady,
        rollbackLedger.didConfirmOwnerAcceptanceGranted == false,
        rollbackLedger.didConfirmStateStoreCommitPublished == false,
        rollbackLedger.didConfirmActionDispatch == false,
        rollbackLedger.didConfirmStateUpdateCommitted == false,
        rollbackLedger.didConfirmVisibilityPublicationAdmitted == false,
        rollbackLedger.didConfirmVisibilityPublished == false,
        rollbackLedger.didConfirmRendererSubmission == false,
        rollbackLedger.didConfirmRendererStateWrite == false,
        rollbackLedger.didConfirmRuntimeStateWrite == false
    )
}

