    let didMaterializeChatComposerCommitTransactionDemoHostSurface: Bool
    let didBindDemoHostSurfaceToStage790TransactionPatchPlan: Bool
    let didKeepCommitTransactionDemoHostSurfaceNonCommitting: Bool
    let didPrepareStage792PreviewComponentApiCommitDecisionTransactionRuntimeExecutor: Bool
    let didKeepRendererSubmissionBlocked: Bool
    let didKeepRendererStateWriteBlocked: Bool
    let didKeepRuntimeStateWriteBlocked: Bool

    init(
        didConsumeStage790PreviewComponentApiCommitTransactionPatchPlan: Bool,
        didConsumeOwnerLocalTransactionPatchPlan: Bool,
