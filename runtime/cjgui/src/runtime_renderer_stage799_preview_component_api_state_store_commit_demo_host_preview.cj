        this.didConsumeOwnerCommitReviewCheckpoint = didConsumeOwnerCommitReviewCheckpoint
        this.didMaterializeCommitAdmissionDemoHostPreviewRows = didMaterializeCommitAdmissionDemoHostPreviewRows
        this.didMaterializeCommitAdmissionResultSurfaceRefresh = didMaterializeCommitAdmissionResultSurfaceRefresh
