func internalRendererSetComposableOwnedTextSession(s: UInt64, n: UInt64, r: Int64,
    k: UInt32, b: UInt64, enabled: Bool): Int32 {
    nativeDeclarationCalls += 1; return if(declarationAccepted){0}else{14}
