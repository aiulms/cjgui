func cjguiInternalBuildRendererStage309InternalAiGeneratedUiDemoProbeInputFacts(
    internalAiGeneratedUiDemoComponentStateRenderReadinessDecision:
        CjguiInternalRendererStage308InternalAiGeneratedUiDemoComponentStateRenderReadinessDecisionReadiness
): CjguiInternalRendererStage309InternalAiGeneratedUiDemoProbeInputFacts {
    let renderPreview =
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .internalAiGeneratedUiDemoComponentRenderCommandPreview
    let stateDelta =
        renderPreview.internalAiGeneratedUiDemoComponentStateDeltaDryRun

    return CjguiInternalRendererStage309InternalAiGeneratedUiDemoProbeInputFacts(
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmInternalAiGeneratedUiComponentStateRenderReadinessDecisionReady,
        true,
        renderPreview.didConfirmGeneratedFormSemanticNodePreviewMaterialized &&
            stateDelta.didConfirmGeneratedFormFieldStateDeltaDryRunMaterialized,
        renderPreview.didConfirmGeneratedSettingsSemanticNodePreviewMaterialized &&
            stateDelta.didConfirmGeneratedSettingsSwitchStateDeltaDryRunMaterialized,
        renderPreview
            .didConfirmGeneratedValidationMessageSemanticNodePreviewMaterialized &&
            stateDelta.didConfirmGeneratedValidationStateDeltaDryRunMaterialized,
        stateDelta.didConfirmGeneratedComponentStateDeltaInMemoryOnly &&
            stateDelta.didConfirmAiGeneratedUiComponentOwnerLocalStateSnapshotMaterialized,
        renderPreview
            .didConfirmAiGeneratedUiComponentRenderCommandPreviewMaterialized &&
            renderPreview
                .didConfirmGeneratedComponentRenderPreviewBoundToRenderCommandRefreshRequirement,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmGeneratedUiComponentStateRenderJoinedWithRollbackReadyBoundary,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmGeneratedUiComponentStateRenderJoinedWithVisibilityNotPublishedBoundary,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmStateUpdateCommitted == false &&
            internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
                .didConfirmVisibilityPublished == false,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmActionDispatch == false,
        true,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmOwnerAcceptanceRequired,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmOwnerAcceptanceGranted == false,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmBackendReadyTruth == false,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmPublicComponentApiAdded == false,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmActionDispatch == false,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmStateUpdateCommitted == false,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmRendererSubmissionBlocked,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmRendererStateWriteBlocked,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmRuntimeStateWriteBlocked,
        internalAiGeneratedUiDemoComponentStateRenderReadinessDecision
            .didConfirmVisibilityPublished == false
    )
}

