    let didKeepStablePublicApiUnpromised: Bool
    let didKeepPublicCAbiUnexpanded: Bool
    let didReduceFuturePublicPreviewApiTemplateNeed: Bool
    let didPrepareStage761PreviewComponentApiLayoutStyleConsumption: Bool
    let didKeepRendererSubmissionBlocked: Bool
    let didKeepRendererStateWriteBlocked: Bool
    let didKeepRuntimeStateWriteBlocked: Bool

    init(
