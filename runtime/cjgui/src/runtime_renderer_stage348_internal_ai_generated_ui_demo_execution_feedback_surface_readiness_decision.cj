    let decisionReady = executionFeedbackSurfaceReadinessDecisionFacts
        .didConsumeStage347ExecutionFeedbackSurfaceProbeInputResultEnvelope && executionFeedbackSurfaceReadinessDecisionFacts
        .didJoinExecutionFeedbackSurfaceRefreshWithSemanticDiffExplain && executionFeedbackSurfaceReadinessDecisionFacts
        .didJoinExecutionFeedbackSurfaceProbeInputWithResultEnvelope && executionFeedbackSurfaceReadinessDecisionFacts
