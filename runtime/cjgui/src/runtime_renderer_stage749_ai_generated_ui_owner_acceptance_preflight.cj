func cjguiInternalBuildRendererStage749AiGeneratedUiOwnerAcceptancePreflightPlan(
    runtimeManager: CjguiInternalRendererStage748AiGeneratedUiRuntimeManagerReadiness): CjguiInternalRendererStage749AiGeneratedUiOwnerAcceptancePreflightPlan {
    let stage748Ready = runtimeManager.didConfirmStage748AiGeneratedUiRuntimeManagerReady && runtimeManager
        .didConfirmStage749AiGeneratedUiOwnerAcceptancePreflightPrepared
    let runtimeContractReady = runtimeManager.didConfirmSharedAiGeneratedUiAuthoringRuntimeManagerMaterialized && runtimeManager
        .didConfirmAiGeneratedUiAuthoringRuntimeContractMaterialized && runtimeManager
        .didConfirmAiGeneratedUiExecutionReceiptContractMaterialized && runtimeManager
        .didConfirmChatComposerAiGeneratedUiRuntimeSurfaceMaterialized
    let preflightReady = stage748Ready && runtimeContractReady &&
        cjguiInternalRendererStage749AiGeneratedUiOwnerAcceptancePreflightMaterialized()
    return CjguiInternalRendererStage749AiGeneratedUiOwnerAcceptancePreflightPlan(
        stage748Ready,
        runtimeContractReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        runtimeManager.didConfirmRuntimeManagerBoundToStage747HostInspectionSurface,
        preflightReady,
        runtimeManager.didConfirmStablePublicApiAdded == false,
        runtimeManager.didConfirmRendererSubmissionBlocked,
        runtimeManager.didConfirmRendererStateWriteBlocked,
        runtimeManager.didConfirmRuntimeStateWriteBlocked
    )
}

