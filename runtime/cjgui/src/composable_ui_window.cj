private let CJGUI_SEMANTIC_FOCUS_MAX_ATTEMPTS: Int64 = 3

func cjguiFocusVisibleIntersection(bounds: CjguiComposableUiRect,
    constraints: ArrayList<CjguiComposableUiClipConstraint>): CjguiComposableUiRect {
    var visible = bounds
    for (constraint in constraints) {
        visible = visible.intersect(constraint.rect)
    }
    return visible
}

func cjguiFocusRetryAllowed(attempts: Int64, didFocus: Bool): Bool {
    return !didFocus && attempts < CJGUI_SEMANTIC_FOCUS_MAX_ATTEMPTS
}

func cjguiFocusNextAttemptCount(attempts: Int64, didFocus: Bool): Int64 {
    return if (didFocus) { 0 } else { attempts + 1 }
}

func cjguiFocusBindingEpochMatches(prior: UInt64, current: UInt64): Bool {
    return prior == current
}

func cjguiFocusNativeFailureIsRetryable(status: Int32): Bool {
    return status == CJGUI_INTERNAL_RENDERER_NOT_MAIN_THREAD || status == CJGUI_INTERNAL_RENDERER_VIEW_INVALIDATED
}

/// Public normalized pointer phases. Coordinates are logical layout points,
/// never native event objects. A controller receives them through its normal
/// `applyUiEvent` path and owns the resulting business/local state.
public let CJGUI_COMPOSABLE_UI_EVENT_POINTER_BEGIN: Int64 = 37
public let CJGUI_COMPOSABLE_UI_EVENT_POINTER_UPDATE: Int64 = 38
public let CJGUI_COMPOSABLE_UI_EVENT_POINTER_END: Int64 = 39
public let CJGUI_COMPOSABLE_UI_EVENT_POINTER_CANCEL: Int64 = 40
public let CJGUI_COMPOSABLE_UI_EVENT_HOVER_ENTER: Int64 = 43
public let CJGUI_COMPOSABLE_UI_EVENT_HOVER_LEAVE: Int64 = 44
public let CJGUI_COMPOSABLE_UI_EVENT_PRESS_BEGIN: Int64 = 45
public let CJGUI_COMPOSABLE_UI_EVENT_PRESS_END: Int64 = 46
public let CJGUI_COMPOSABLE_UI_EVENT_PRESS_CANCEL: Int64 = 47

/// The human-input kinds a self-drawn control reports, published so a
/// controller never has to hardcode them. They match the native bridge's
/// normalized event kinds: a press activation, an edited text projection, a
/// toggled boolean projection (whose `text` is the projected next value), a
/// scroll intent and a focus change. A generated editor kind maps to exactly
/// one of these through `CjguiGeneratedUiFieldSpec.changeEventKind()`.
public let CJGUI_COMPOSABLE_UI_EVENT_ACTIVATE: Int64 = 27
public let CJGUI_COMPOSABLE_UI_EVENT_TEXT_CHANGED: Int64 = 28
public let CJGUI_COMPOSABLE_UI_EVENT_BOOLEAN_CHANGED: Int64 = 29
public let CJGUI_COMPOSABLE_UI_EVENT_SCROLL: Int64 = 30
public let CJGUI_COMPOSABLE_UI_EVENT_FOCUS: Int64 = 31
/// Platform-owned text selection/caret movement; updates view state only.
public let CJGUI_COMPOSABLE_UI_EVENT_SELECTION_CHANGED: Int64 = 33

/// A human text edit delivered as an edit delta instead of the whole value.
/// `selectionStart`/`selectionEnd` are the replaced UTF-16 range in the value
/// the event was projected from, and `text` is the inserted replacement
/// string. `CJGUI_COMPOSABLE_UI_EVENT_TEXT_CHANGED` (28) keeps its existing
/// "here is the resulting value" meaning, so current consumers are unaffected.
public let CJGUI_COMPOSABLE_UI_EVENT_TEXT_RANGE_CHANGED: Int64 = 51

// This identifier is deliberately separate from the renderer's session token:
// clients may compare it in a window projection, but it grants no native
// operation.  The process nonce prevents a restarted/rebound endpoint from
// reusing a prior window name, while the locked counter makes concurrent
// windows and reopened instances distinct in one process.
private class CjguiComposableUiWindowSessionIdentityAllocator {
    private static let allocationLock = Mutex()
    private static let processNonce = Random().nextUInt64()
    private static var nextWindowGeneration: Int64 = 1

    public static func allocate(): String {
        return synchronized(CjguiComposableUiWindowSessionIdentityAllocator.allocationLock) {
            let generation = CjguiComposableUiWindowSessionIdentityAllocator.nextWindowGeneration
            CjguiComposableUiWindowSessionIdentityAllocator.nextWindowGeneration += 1
            return "cjgui_window_${CjguiComposableUiWindowSessionIdentityAllocator.processNonce}_${generation}"
        }
    }
}

/// Allocates the per-PROCESS identity of one window INSTANCE. Shared mutable view
/// state (scroll viewport, split size, active tab page) belongs to exactly one
/// window, so the framework needs a cheap way to name that window without
/// building a second global registry.
private class CjguiComposableUiWindowInstanceAllocator {
    private static let allocationLock = Mutex()
    private static var nextInstanceToken: Int64 = 1

    public static func allocate(): Int64 {
        return synchronized(CjguiComposableUiWindowInstanceAllocator.allocationLock) {
            let token = CjguiComposableUiWindowInstanceAllocator.nextInstanceToken
            CjguiComposableUiWindowInstanceAllocator.nextInstanceToken += 1
            return token
        }
    }
}

// A viewport first mentioned by a candidate must not be half-solved by a
// sibling while native preparation is pending. This private reservation is
// separate from accepted ownership and is released by the existing candidate
// ownership cleanup on accept/reject/cancel/close.
private class CjguiCandidateViewportReservations {
    private static let lock = Mutex()
    private static let owners = HashMap<Int64, Int64>()
    static func reserve(identity: Int64, owner: Int64): Bool {
        return synchronized(lock) {
            if (let Some(prior) <- owners.get(identity)) { return prior == owner }
            if (owners.size >= 32768) { return false }
            owners[identity] = owner
            return true
        }
    }
    static func matches(identity: Int64, owner: Int64): Bool {
        return synchronized(lock) { (owners.get(identity) ?? 0) == owner }
    }
    static func release(identity: Int64, owner: Int64): Unit {
        synchronized(lock) {
            if ((owners.get(identity) ?? 0) == owner) { owners.remove(identity) }
        }
    }
}

private class CjguiStaticLayoutViewportBasis {
    let viewport: CjguiComposableUiScrollViewport
    let generation: Int64
    let offset: Int64
    init(viewport: CjguiComposableUiScrollViewport) {
        this.viewport = viewport
        this.generation = viewport.requestGeneration()
        this.offset = viewport.offset()
    }
    init(viewport: CjguiComposableUiScrollViewport, generation: Int64, offset: Int64) {
        this.viewport = viewport
        this.generation = generation
        this.offset = offset
    }
}

// A change observed around one admitted framework wheel, not a fresh reading
// substituted for the viewport facts that produced an older layout.
private class CjguiWheelViewportRequest {
    let before: CjguiStaticLayoutViewportBasis
    let after: CjguiStaticLayoutViewportBasis
    init(viewport: CjguiComposableUiScrollViewport, beforeGeneration: Int64, beforeOffset: Int64,
        afterGeneration: Int64, afterOffset: Int64) {
        this.before = CjguiStaticLayoutViewportBasis(viewport, beforeGeneration, beforeOffset)
        this.after = CjguiStaticLayoutViewportBasis(viewport, afterGeneration, afterOffset)
    }
}

/// B2: the bounded per-page focus/selection bookmark. It records WHERE a person
/// was (an accepted identity, its resource/kind, and a selection position), never
/// a business value: a value the owner changed while the page was hidden is read
/// from the owner on the next accepted scene, and a stale position is bounded or
/// dropped instead of replayed.
private class CjguiComposableUiPageFocusBookmark {
    let groupIdentity: Int64
    let pageKey: String
    let nodeId: Int64
    let resourceId: Int64
    let nodeKind: Int64
    let selectionStart: Int64
    let selectionEnd: Int64
    /// UTF-16 code units, matching AppKit's NSRange selection positions.
    let valueLength: Int64

    init(groupIdentity: Int64, pageKey: String, nodeId: Int64, resourceId: Int64, nodeKind: Int64,
        selectionStart: Int64, selectionEnd: Int64, valueLength: Int64) {
        this.groupIdentity = groupIdentity
        this.pageKey = pageKey
        this.nodeId = nodeId
        this.resourceId = resourceId
        this.nodeKind = nodeKind
        this.selectionStart = selectionStart
        this.selectionEnd = selectionEnd
        this.valueLength = valueLength
    }
}

private func cjguiSelectionUtf16Length(value: String): Int64 {
    var length: Int64 = 0
    for (rune in value.runes()) {
        length += if (rune.toString().size == 4) {
            2
        } else {
            1
        }
    }
    return length
}

/// Intent derived from one node in the most recently rendered scene. The
/// window refuses an event whose projection version or array target no longer
/// matches, so an external reorder/delete cannot retarget queued input.
/// AppKit keyboard modifier bits as delivered on pointer events. They are
/// public so controllers can implement ordinary Command/Shift click semantics
/// without a second input mechanism.
public let CJGUI_UI_MODIFIER_SHIFT: Int64 = 1 << 17
public let CJGUI_UI_MODIFIER_CONTROL: Int64 = 1 << 18
public let CJGUI_UI_MODIFIER_OPTION: Int64 = 1 << 19
public let CJGUI_UI_MODIFIER_COMMAND: Int64 = 1 << 20

/// Actual native source-selection transfer proof. A proves where the current
/// source proxy came from; B proves only the real local intersection held by
/// TextKit. Product code receives this proof from the window and cannot build
/// one from a same-valued mirror.
public class CjguiInstalledSelectionInputProof {
    public let transferId: UInt64
    public let inputId: UInt64
    public let inputSequence: UInt64
    public let previousInputSequence: UInt64
    public let sourceInstalledNonce: UInt64
    public let rendererSessionGeneration: UInt64
    public let windowInstanceToken: UInt64
    public let sourceBindingEpoch: UInt64
    public let sourceContextEpoch: Int64
    public let sourceMirrorRevision: Int64
    public let sourceOwnerVersion: Int64
    public let sourceStartByte: Int64
    public let sourceEndByte: Int64
    public let sourceProxyGeneration: UInt64
    public let sourceSelectionRevision: UInt64
    public let sourceNodeId: Int64
    public let sourceResourceId: Int64
    public let sourceSceneVersion: Int64
    public let sourceSelectionStart16: Int64
    public let sourceSelectionEnd16: Int64
    public let sourceBody: String
    public let targetNodeId: Int64
    public let targetResourceId: Int64
    public let targetProjectionVersion: Int64
    public let targetSceneVersion: Int64
    public let targetBindingEpoch: UInt64
    public let targetNodeKind: Int64
    public let targetSelectionRevision: UInt64
    public let targetProxyGeneration: UInt64
    public let targetSelectionStart16: Int64
    public let targetSelectionEnd16: Int64
    public let targetFocus16: Int64
    public let targetBody: String
    public let editStart16: Int64
    public let editEnd16: Int64
    public let replacement: String
    init(transferId: UInt64, inputId: UInt64, sequence: UInt64, previous: UInt64,
        sourceNonce: UInt64, sessionGeneration: UInt64, windowToken: UInt64, sourceBinding: UInt64,
        sourceContext: Int64, sourceMirror: Int64, ownerVersion: Int64, sourceStart: Int64,
        sourceEnd: Int64, sourceProxy: UInt64, sourceSelectionRevision: UInt64,
        sourceNode: Int64, sourceResource: Int64, sourceScene: Int64,
        sourceSelectionStart: Int64, sourceSelectionEnd: Int64, sourceBody: String,
        targetNode: Int64, targetResource: Int64, targetProjection: Int64, targetScene: Int64,
        targetBinding: UInt64,
        targetKind: Int64, targetSelectionRevision: UInt64, targetProxyGeneration: UInt64,
        targetSelectionStart: Int64, targetSelectionEnd: Int64,
        targetFocus: Int64, targetBody: String, editStart: Int64, editEnd: Int64,
        replacement: String) {
        this.transferId = transferId; this.inputId = inputId
        this.inputSequence = sequence; this.previousInputSequence = previous
        this.sourceInstalledNonce = sourceNonce; this.rendererSessionGeneration = sessionGeneration
        this.windowInstanceToken = windowToken; this.sourceBindingEpoch = sourceBinding
        this.sourceContextEpoch = sourceContext; this.sourceMirrorRevision = sourceMirror
        this.sourceOwnerVersion = ownerVersion; this.sourceStartByte = sourceStart
        this.sourceEndByte = sourceEnd; this.sourceProxyGeneration = sourceProxy
        this.sourceSelectionRevision = sourceSelectionRevision; this.sourceNodeId = sourceNode
        this.sourceResourceId = sourceResource; this.sourceSceneVersion = sourceScene
        this.sourceSelectionStart16 = sourceSelectionStart; this.sourceSelectionEnd16 = sourceSelectionEnd
        this.sourceBody = sourceBody; this.targetNodeId = targetNode
        this.targetResourceId = targetResource; this.targetProjectionVersion = targetProjection
        this.targetSceneVersion = targetScene; this.targetNodeKind = targetKind
        this.targetBindingEpoch = targetBinding
        this.targetSelectionRevision = targetSelectionRevision
        this.targetProxyGeneration = targetProxyGeneration
        this.targetSelectionStart16 = targetSelectionStart; this.targetSelectionEnd16 = targetSelectionEnd
        this.targetFocus16 = targetFocus; this.targetBody = targetBody
        this.editStart16 = editStart; this.editEnd16 = editEnd; this.replacement = replacement
    }
}

/// Product-authorized, owner-global selection identity for one text input.
/// The endpoints preserve direction; only their min/max are used for a write.
public class CjguiOwnerSelectionChoice {
    public let documentId: String
    public let sessionEpoch: Int64
    public let contentVersion: Int64
    public let acceptedProjectionId: Int64
    public let contextEpoch: Int64
    public let selectionRevision: Int64
    public let choiceId: Int64
    public let anchorByte: Int64
    public let focusByte: Int64
    public init(documentId: String, sessionEpoch: Int64, contentVersion: Int64,
        acceptedProjectionId: Int64, contextEpoch: Int64, selectionRevision: Int64,
        choiceId: Int64, anchorByte: Int64, focusByte: Int64) {
        this.documentId = documentId; this.sessionEpoch = sessionEpoch
        this.contentVersion = contentVersion; this.acceptedProjectionId = acceptedProjectionId
        this.contextEpoch = contextEpoch; this.selectionRevision = selectionRevision
        this.choiceId = choiceId; this.anchorByte = anchorByte; this.focusByte = focusByte
    }
}

/// Typed edit captured before TextKit changes the B proxy. `replacement` is
/// the actual delegate payload; editStart/editEnd remain B-local evidence.
public class CjguiInstalledSelectionInput {
    public let proof: CjguiInstalledSelectionInputProof
    public init(proof: CjguiInstalledSelectionInputProof) { this.proof = proof }
}

/// Optional owner boundary for an ordinary insert/Delete arriving on the
/// verified B TextKit surface of an installed A-to-B selection transfer.
/// The callback returns the product's directed, owner-global choice; the
/// window never derives it from B-local UTF-16 coordinates.
public interface CjguiComposableUiInstalledSelectionInputProvider {
    func authorizeInstalledSelectionInput(proof: CjguiInstalledSelectionInputProof):
        ?CjguiOwnerSelectionChoice
    func installedSelectionChoiceIsCurrent(choice: CjguiOwnerSelectionChoice): Bool
}

private class CjguiSelectionTransferProofContext {
    let candidate: CjguiInternalSelectionTransferCandidate
    let sourceBody: String
    let sourceSemantic: ?CjguiTextSelectionTicket
    var receipt: CjguiInternalSelectionTransferReceipt
    var currentTargetBody: String
    var lastInputSequence: UInt64
    var active: Bool = false
    let pointerDispatch: ?CjguiMacTextPointerSelectionDispatch
    init(candidate: CjguiInternalSelectionTransferCandidate, sourceBody: String, targetBody: String,
        pointerDispatch!: ?CjguiMacTextPointerSelectionDispatch = None,
        sourceSemantic!: ?CjguiTextSelectionTicket = None) {
        this.candidate = candidate
        this.pointerDispatch = pointerDispatch
        this.sourceBody = sourceBody
        this.sourceSemantic = sourceSemantic
        this.currentTargetBody = targetBody
        this.lastInputSequence = candidate.sourceAcceptedSequence
        this.receipt = CjguiInternalSelectionTransferReceipt()
    }
    func activate(receipt: CjguiInternalSelectionTransferReceipt): Unit {
        this.receipt = receipt
        this.active = receipt.proxyGeneration != 0u64 && receipt.firstResponder == 1u8
    }
    func proof(claim: InternalRendererInstalledRangeClaim, inputId: UInt64):
        ?CjguiInstalledSelectionInputProof {
        let raw = claim.raw
        let input = claim.input
        if (!active || inputId == 0u64 || raw.proxyGeneration != receipt.proxyGeneration ||
            raw.selectionRevision != receipt.selectionRevision ||
            raw.rendererSessionGeneration != candidate.sourceRendererSessionGeneration ||
            raw.windowInstanceToken != candidate.sourceWindowInstanceToken || raw.flags != 2u32 ||
            raw.nonce != candidate.transferId ||
            raw.bindingEpoch != receipt.bindingEpoch ||
            raw.nodeId != candidate.targetNodeId || raw.resourceId != candidate.targetResourceId ||
            raw.installedSceneVersion != candidate.targetSceneVersion ||
            raw.previousSeq != lastInputSequence || raw.seq <= raw.previousSeq ||
            input.preBody != currentTargetBody || raw.selectionEnd16 < raw.selectionStart16 ||
            Int64(raw.selectionEnd16) > cjguiUtf16Length(input.preBody) ||
            UInt64(raw.rangeStart16) + UInt64(raw.rangeLength16) > UInt64(cjguiUtf16Length(input.preBody))) {
            return None
        }
        return Some(CjguiInstalledSelectionInputProof(
            candidate.transferId, inputId, raw.seq, raw.previousSeq,
            candidate.sourceInstalledNonce, candidate.sourceRendererSessionGeneration,
            candidate.sourceWindowInstanceToken, candidate.sourceBindingEpoch,
            Int64(candidate.sourceContextEpoch), Int64(candidate.sourceMirrorRevision),
            candidate.sourceOwnerVersion, Int64(candidate.sourceStartByte), Int64(candidate.sourceEndByte),
            candidate.sourceProxyGeneration, candidate.sourceSelectionRevision,
            Int64(candidate.sourceNodeId), candidate.sourceResourceId, Int64(candidate.sourceSceneVersion),
            Int64(candidate.sourceSelectionStart16), Int64(candidate.sourceSelectionEnd16), sourceBody,
            Int64(receipt.nodeId), receipt.resourceId, Int64(receipt.projectionVersion),
            Int64(receipt.sceneVersion), receipt.bindingEpoch, Int64(receipt.nodeKind), receipt.selectionRevision,
            receipt.proxyGeneration, Int64(raw.selectionStart16),
            Int64(raw.selectionEnd16), Int64(raw.selectionEnd16), input.preBody,
            Int64(raw.rangeStart16), Int64(raw.rangeStart16) + Int64(raw.rangeLength16), claim.replacement))
    }
}

/// One owner decision whose native FIFO ACK has not fully settled yet. The
/// immutable claim/decision and input identity stay together until native
/// confirmation and (when present) managed memo retirement both succeed.
private class CjguiHeldInstalledRangeSettlement {
    let claim: InternalRendererInstalledRangeClaim
    let decision: CjguiTextSessionEdit
    let session: CjguiTextSession
    let transferId: UInt64
    let inputId: UInt64
    let needsMemoRetirement: Bool
    let proofContext: ?CjguiSelectionTransferProofContext
    var nativeAckConfirmed: Bool = false
    var lastNativeAckStatus: Int32 = CJGUI_INTERNAL_RENDERER_OK
    var ownerHandoffId: UInt64 = 0u64
    var ownerHandoffTarget: ?CjguiSourceSelectionSnapshot = None

    init(claim: InternalRendererInstalledRangeClaim, decision: CjguiTextSessionEdit,
        session: CjguiTextSession, transferId: UInt64, inputId: UInt64,
        needsMemoRetirement: Bool,
        proofContext: ?CjguiSelectionTransferProofContext) {
        this.claim = claim
        this.decision = decision
        this.session = session
        this.transferId = transferId
        this.inputId = inputId
        this.needsMemoRetirement = needsMemoRetirement
        this.proofContext = proofContext
    }
}

// A real history callback has already written the owner once. Only this exact
// receipt may be confirmed on a later pump; the callback is never retained.
private class CjguiHeldCaretOwnerReceipt {
    let input: InternalRendererInputProvenance
    let before: CjguiTextSelectionTicket
    let target: CjguiTextSelectionTicket
    let afterVersion: Int64
    init(input: InternalRendererInputProvenance, before: CjguiTextSelectionTicket,
        target: CjguiTextSelectionTicket, afterVersion: Int64) {
        this.input = input
        this.before = before
        this.target = target
        this.afterVersion = afterVersion
    }
}

private class CjguiSelectionTransferReceiptBox {
    var value: ?CjguiInternalSelectionTransferReceipt = None
}

private class CjguiSelectionInstallStatusBox {
    var value: Int32 = -1
}

public class CjguiComposableUiEvent {
    public let node: CjguiComposableUiLayoutNode
    public let eventKind: Int64
    public let text: String
    public let selectionStart: Int64
    public let selectionEnd: Int64
    public let projectionVersion: Int64
    public let pointerX: Int64
    public let pointerY: Int64
    /// Exact accepted window-content point for native pointer events. The
    /// integer pair above remains the compatibility projection.
    public let pointerVisualX: Float64
    public let pointerVisualY: Float64
    public let pointerTranslateX: Float64
    public let pointerTranslateY: Float64
    public let pointerGeometryAccepted: Bool
    /// Keyboard modifier flags of the pointer event (AppKit
    /// NSEventModifierFlag* bits): command = 1 << 20, shift = 1 << 17,
    /// option = 1 << 19, control = 1 << 18. Non-pointer intents carry 0.
    public let modifierFlags: Int64
    /// Provenance of one physical Up/Down input from the exact native pump
    /// result. Zero denotes synthetic or programmatic input.
    public let inputSessionGeneration: UInt64
    public let inputSequence: UInt64
    public let inputPreviousSequence: UInt64
    /// The decoded displacement, when a native wheel packet has one. Opting in changes who
    /// applies the displacement; every admitted consumer can inspect the original packet.
    public let wheelDelta: ?CjguiComposableUiWheelDelta
    /// One admitted wheel dispatch in this window. The observation uses the same event as the
    /// viewport step, so a consumer can avoid applying the same displacement a second time.
    public let wheelEventSerial: Int64
    public let frameworkScrollApplied: Bool
    public let scrollRequestedBefore: Int64
    public let scrollRequestedAfter: Int64
    public let scrollAcceptedBefore: Int64
    public let scrollAcceptedAfter: Int64
    public let sliderCaptureIntent: ?CjguiComposableUiSliderCaptureIntent
    public let installedSelectionInput: ?CjguiInstalledSelectionInput
    public init(node: CjguiComposableUiLayoutNode, eventKind: Int64, text: String, selectionStart: Int64,
        selectionEnd: Int64, projectionVersion: Int64, pointerX!: Int64 = 0, pointerY!: Int64 = 0,
        pointerVisualX!: Float64 = 0.0, pointerVisualY!: Float64 = 0.0,
        pointerTranslateX!: Float64 = 0.0, pointerTranslateY!: Float64 = 0.0,
        pointerGeometryAccepted!: Bool = false,
        modifierFlags!: Int64 = 0, inputSessionGeneration!: UInt64 = 0u64,
        inputSequence!: UInt64 = 0u64, inputPreviousSequence!: UInt64 = 0u64,
        wheelDelta!: ?CjguiComposableUiWheelDelta = None,
        wheelEventSerial!: Int64 = 0, frameworkScrollApplied!: Bool = false,
        scrollRequestedBefore!: Int64 = 0, scrollRequestedAfter!: Int64 = 0,
        scrollAcceptedBefore!: Int64 = 0, scrollAcceptedAfter!: Int64 = 0,
        sliderCaptureIntent!: ?CjguiComposableUiSliderCaptureIntent = None,
        installedSelectionInput!: ?CjguiInstalledSelectionInput = None) {
        this.node = node
        this.eventKind = eventKind
        this.text = text
        this.selectionStart = selectionStart
        this.selectionEnd = selectionEnd
        this.projectionVersion = projectionVersion
        this.pointerX = pointerX
        this.pointerY = pointerY
        this.pointerVisualX = pointerVisualX
        this.pointerVisualY = pointerVisualY
        this.pointerTranslateX = pointerTranslateX
        this.pointerTranslateY = pointerTranslateY
        this.pointerGeometryAccepted = pointerGeometryAccepted
        this.modifierFlags = modifierFlags
        this.inputSessionGeneration = inputSessionGeneration
        this.inputSequence = inputSequence
        this.inputPreviousSequence = inputPreviousSequence
        this.wheelDelta = wheelDelta
        this.wheelEventSerial = wheelEventSerial
        this.frameworkScrollApplied = frameworkScrollApplied
        this.scrollRequestedBefore = scrollRequestedBefore
        this.scrollRequestedAfter = scrollRequestedAfter
        this.scrollAcceptedBefore = scrollAcceptedBefore
        this.scrollAcceptedAfter = scrollAcceptedAfter
        this.sliderCaptureIntent = sliderCaptureIntent
        this.installedSelectionInput = installedSelectionInput
    }
}

public class CjguiComposableUiDispatchResult {
    public let didApply: Bool
    public let shouldClose: Bool
    /// Exact result returned by the single owner CAS, when this dispatch is
    /// a transfer. Legacy controllers may leave it unavailable.
    public let transferResult: ?CjguiSharedOperationTransferResult
    public init(didApply: Bool, shouldClose!: Bool = false,
        transferResult!: ?CjguiSharedOperationTransferResult = None) {
        this.didApply = didApply
        this.shouldClose = shouldClose
        this.transferResult = transferResult
    }
}

public let CJGUI_COMPOSABLE_UI_EVENT_DATA_TRANSFER_COPY: Int64 = 48
public let CJGUI_COMPOSABLE_UI_EVENT_DATA_TRANSFER_PASTE: Int64 = 49
public let CJGUI_COMPOSABLE_UI_EVENT_DATA_TRANSFER_DROP: Int64 = 50
public let CJGUI_COMPOSABLE_UI_EVENT_FILE_TRANSFER_BEGIN: Int64 = 53
public let CJGUI_COMPOSABLE_UI_EVENT_FILE_TRANSFER_REJECTED: Int64 = 54

/// Experimental transfer declaration for one semantic composable node. The
/// node remains a normal control; the declaration merely lets the host copy a
/// bounded UTF-8 offer on an explicit shortcut or drag gesture. Native owns
/// no application handler, owner reference or durable transfer history.
/// Bounds of the first macOS standard PNG exchange. They describe CJGUI's
/// retained/decoded work after AppKit returns `dataForType`; the system fetch
/// itself may materialize the whole provider value before its size is known.
/// A backend that does not implement this exchange must not publish this
/// macOS capability as its own.
public class CjguiComposableUiPngTransferCapability {
    public let backend: String = "macos"
    public let systemFormat: String = "public.png"
    public let localFileSystemFormat: String = "public.file-url"
    public let localFileAllowedByDefault: Bool = false
    public let optInSourceOrder: String = "local_file_url,pasteboard_png"
    public let maximumLocalFilesPerOffer: Int64 = 1
    public let localFileReadMode: String = "bounded_async"
    public let mimeFormat: String = "image/png"
    public let imageClass: String = "static"
    public let supportedBitDepths: String = "8"
    public let supportedColorTypes: String = "rgb,rgba"
    public let supportedInterlaceModes: String = "none"
    public let maximumEncodedItemBytes: Int64 = 512 * 1024
    public let maximumWidth: Int64 = 2048
    public let maximumHeight: Int64 = 2048
    public let maximumPixels: Int64 = 1048576
    public let maximumQueuedBinaryBytes: Int64 = 2 * 1024 * 1024
    public let maximumDecodedTextureBytes: Int64 = 32 * 1024 * 1024
    public let maximumRetainedEncodedResourceBytes: Int64 = 8 * 1024 * 1024
    public let maximumResourceRecords: Int64 = 64
    public let maximumPendingEventsPerWindow: Int64 = 64
    public let systemFetchPreflightBounded: Bool = false
    public init() {}
}

public class CjguiComposableUiDataTransferDeclaration {
    public let semanticId: String
    public let role: String
    public let format: CjguiSharedOperationTransferFormat
    public let offer: ?CjguiSharedOperationTransferOffer
    /// Owner-supplied receiver incarnation. Preserve across ordinary redraws;
    /// advance when the same semantic target is rebound to a new owner slot.
    public let receiverIncarnation: Int64
    /// Opt in to one local regular PNG file URL. When both system
    /// representations exist, file URL wins and failure never falls back.
    public let localPngFileAllowed: Bool

    private init(
        semanticId: String,
        role: String,
        format: CjguiSharedOperationTransferFormat,
        offer: ?CjguiSharedOperationTransferOffer,
        receiverIncarnation: Int64,
        localPngFileAllowed: Bool
    ) {
        this.semanticId = semanticId
        this.role = role
        this.format = format
        this.offer = offer
        this.receiverIncarnation = receiverIncarnation
        this.localPngFileAllowed = localPngFileAllowed
    }

    public static func source(
        semanticId: String,
        offer: CjguiSharedOperationTransferOffer
    ): CjguiComposableUiDataTransferDeclaration {
        return CjguiComposableUiDataTransferDeclaration(semanticId, "SOURCE", offer.format, Some(offer), 0,
            false)
    }

    public static func target(
        semanticId: String,
        format: CjguiSharedOperationTransferFormat,
        receiverIncarnation!: Int64 = 0,
        localPngFileAllowed!: Bool = false
    ): CjguiComposableUiDataTransferDeclaration {
        return CjguiComposableUiDataTransferDeclaration(semanticId, "TARGET", format, None,
            receiverIncarnation, localPngFileAllowed)
    }

    public func isValid(): Bool {
        if (semanticId.size == 0 || !format.isValid() || receiverIncarnation < 0 ||
            (localPngFileAllowed && (role != "TARGET" || format.kind != "BINARY" ||
                format.identifier != "image/png"))) {
            return false
        }
        if (role == "SOURCE") {
            if (let Some(value) <- offer) {
                return value.operation == "COPY" && value.format.kind == format.kind && value.format.identifier == format
                    .identifier && value.format.version == format.version && value.fitsFormat(format)
            }
            return false
        }
        return role == "TARGET" && offer.isNone()
    }
}

/// Copied platform intent delivered only after the window has re-resolved the
/// native event against an accepted semantic node. A target event's offer is
/// an immutable external-pasteboard value; the application decides whether it
/// reaches an existing human owner operation.
public class CjguiComposableUiDataTransferEvent {
    public let node: CjguiComposableUiLayoutNode
    public let eventKind: Int64
    public let offer: CjguiSharedOperationTransferOffer
    public let format: CjguiSharedOperationTransferFormat
    public let projectionVersion: Int64
    public let imageWidth: Int64
    public let imageHeight: Int64
    public let decodeMicros: Int64
    public let bindingEpoch: UInt64
    public let expectedOwnerVersion: Int64
    public let nativeEventId: UInt64

    public init(
        node: CjguiComposableUiLayoutNode,
        eventKind: Int64,
        offer: CjguiSharedOperationTransferOffer,
        format: CjguiSharedOperationTransferFormat,
        projectionVersion: Int64,
        imageWidth!: Int64 = 0, imageHeight!: Int64 = 0, decodeMicros!: Int64 = 0,
        bindingEpoch!: UInt64 = 0u64, expectedOwnerVersion!: Int64 = -1,
        nativeEventId!: UInt64 = 0u64
    ) {
        this.node = node
        this.eventKind = eventKind
        this.offer = offer
        this.format = format
        this.projectionVersion = projectionVersion
        this.imageWidth = imageWidth
        this.imageHeight = imageHeight
        this.decodeMicros = decodeMicros
        this.bindingEpoch = bindingEpoch
        this.expectedOwnerVersion = expectedOwnerVersion
        this.nativeEventId = nativeEventId
    }
}

/// Optional public value boundary for a controller with normal transfer
/// consumers. An application keeps offer construction, validation and all
/// domain mutation behind this interface; the composable host only stages the
/// resulting bounded values and returns copied native intents.
public interface CjguiComposableUiDataTransferProvider {
    func dataTransferDeclarations(): ArrayList<CjguiComposableUiDataTransferDeclaration>
    func applyDataTransfer(event: CjguiComposableUiDataTransferEvent): CjguiComposableUiDispatchResult
    func dataTransferOwnerVersion(node: CjguiComposableUiLayoutNode): Int64 { return -1 }
    func rejectDataTransfer(nodeId: Int64, eventKind: Int64, reason: String): CjguiComposableUiDispatchResult {
        return CjguiComposableUiDispatchResult(false)
    }
}

/// Experimental consumer boundary. Business state, field validation,
/// authorization and external operations remain with the application domain;
/// this controller only supplies a projection and routes a stable UI intent.
public interface CjguiComposableUiController {
    /// Monotonically advance for every renderer-visible declaration change:
    /// content, hierarchy, style, resource identity and local UI state. It is
    /// a cheap invalidation hint, not a business-content version. `refresh()`
    /// remains an explicit conservative rebuild for compatibility.
    func uiSceneVersion(): Int64
    func buildUi(): CjguiComposableUiNode
    func applyUiEvent(event: CjguiComposableUiEvent): CjguiComposableUiDispatchResult
    /// A queued intent no longer identifies a live rendered target. The
    /// consumer must surface this to the human rather than silently dropping
    /// keystrokes after an external delete/reorder.
    func rejectUiEvent(eventKind: Int64, nodeId: Int64): CjguiComposableUiDispatchResult
    func requestWindowClose(): CjguiComposableUiDispatchResult
}

/// An application maps the first replacement range of a presentation TEXT
/// composition to its own source coordinates. The window retains the returned
/// single-use credential and owns all subsequent IME phases and recovery.
public class CjguiMappedCompositionRange {
    public let prepared: ?CjguiPreparedSourceRange
    public let reason: String

    public init(prepared: ?CjguiPreparedSourceRange, reason!: String = "") {
        this.prepared = prepared
        this.reason = reason
    }
}

public interface CjguiComposableUiCompositionRangeProvider {
    func prepareCompositionSourceRange(node: CjguiComposableUiLayoutNode,
        start16: Int64, end16: Int64, sceneVersion: Int64): CjguiMappedCompositionRange
}

/// Frozen accepted identity for one secondary-click context request. The
/// application may build a semantic layer from this value, but the window
/// retains the opaque selection ticket and validates it again at install and
/// command dispatch boundaries.
public class CjguiComposableUiContextMenuRequest {
    public let requestId: Int64
    public let layerId: String
    public let nodeId: Int64
    public let resourceId: Int64
    public let nodeKind: Int64
    public let identityKey: String
    public let value: String
    public let projectionVersion: Int64
    public let hostLocalX: Int64
    public let hostLocalY: Int64
    public let bindingEpoch: UInt64
    public let contextEpoch: Int64
    public let sourceVersion: Int64
    public let selectionRevision: Int64
    public let selectionAnchor16: Int64
    public let selectionFocus16: Int64
    // Source selection and presentation proxy selection have different units
    // of context. Only an exact native read may freeze a presentation range.
    let proxySelectionStart16: Int64
    let proxySelectionEnd16: Int64
    let selectionTicket: ?CjguiTextSelectionTicket
    init(requestId: Int64, node: CjguiComposableUiLayoutNode, projection: Int64, x: Int64, y: Int64,
        binding: UInt64, ticket: ?CjguiTextSelectionTicket, context: Int64, source: Int64,
        revision: Int64, anchor: Int64, focus: Int64, proxyStart: Int64, proxyEnd: Int64) {
        this.requestId = requestId
        this.layerId = "context-menu-${requestId}"
        this.nodeId = node.nodeId
        this.resourceId = node.resourceId
        this.nodeKind = node.nodeKind
        this.identityKey = node.identityKey
        this.value = node.value
        this.projectionVersion = projection
        this.hostLocalX = x
        this.hostLocalY = y
        this.bindingEpoch = binding
        this.contextEpoch = context
        this.sourceVersion = source
        this.selectionRevision = revision
        this.selectionAnchor16 = anchor
        this.selectionFocus16 = focus
        this.proxySelectionStart16 = proxyStart
        this.proxySelectionEnd16 = proxyEnd
        this.selectionTicket = ticket
    }
}

/// Optional typed consumer for the framework's secondary-click intent. It
/// only updates the caller's declarative projection; commands return through
/// `invokeContextMenuCommand` on the window.
public interface CjguiComposableUiContextMenuRequestHandler {
    func requestContextMenu(request: CjguiComposableUiContextMenuRequest): Bool
    func contextMenuRequestEnded(requestId: Int64, reason: String): Unit { }
}

/// The installed state of one reanchor attempt: which platform mechanism the
/// live marked run survived with, and where the marked run and its inner
/// selection actually sit afterwards. `installed=false` means NOTHING was
/// changed — the caller must cancel the composition, not treat it as continued.
/// The readback fields describe the proxy, so a caller can bind a receipt to the
/// exact draft revision instead of trusting its own request.
public class CjguiCompositionReanchorReceipt {
    public let installed: Bool
    /// 1 = the marked run survived the storage update; 2 = it was re-installed
    /// through the ordinary client entry; 0 when not installed.
    public let mechanism: Int64
    public let markedStart16: Int64
    public let markedLength16: Int64
    public let innerStart16: Int64
    public let innerEnd16: Int64
    public let status: Int32

    public init(installed: Bool, mechanism: Int64, markedStart16: Int64, markedLength16: Int64,
        innerStart16: Int64, innerEnd16: Int64, status: Int32) {
        this.installed = installed
        this.mechanism = mechanism
        this.markedStart16 = markedStart16
        this.markedLength16 = markedLength16
        this.innerStart16 = innerStart16
        this.innerEnd16 = innerEnd16
        this.status = status
    }

    public static func refused(status: Int32): CjguiCompositionReanchorReceipt {
        return CjguiCompositionReanchorReceipt(false, 0, 0, 0, 0, 0, status)
    }

    public func describe(): String {
        return "installed=${this.installed} mechanism=${this.mechanism} " +
            "marked=${this.markedStart16}:${this.markedLength16} " +
            "inner=${this.innerStart16}:${this.innerEnd16} status=${this.status}"
    }
}

/// Optional revision of accepted business owner truth, independent of
/// `uiSceneVersion()` and generated structure versions. Advance it for every
/// independently accepted owner write, including a same-value replacement;
/// a generated structure reorder alone must leave it unchanged. Without this
/// boundary the window conservatively rotates native text editing context.
/// Return a nonnegative monotonic revision; -1 disables this continuation.
public interface CjguiComposableUiBusinessOwnerRevisionProvider {
    func uiBusinessOwnerRevision(): Int64
}

// A recycled renderer slot cannot inherit either a local-edit handoff or an
// owner-stable reordering handoff. Compare the whole field binding and focus
// domain; geometry, paint and caption may change without changing ownership.
func cjguiSameFocusedTextBinding(previous: CjguiComposableUiLayoutNode,
    candidate: CjguiComposableUiLayoutNode,
    focusedNodeId: Int64, focusedResourceId: Int64, focusedNodeKind: Int64): Bool {
    if (focusedNodeId < 0 || previous.nodeId != focusedNodeId || previous.resourceId != focusedResourceId ||
        previous.nodeKind != focusedNodeKind || !previous.canReceiveInput() || !candidate.canReceiveInput()) {
        return false
    }
    if (candidate.nodeKind != CJGUI_COMPOSABLE_UI_TEXT_INPUT && candidate.nodeKind !=
        CJGUI_COMPOSABLE_UI_INTEGER_INPUT && candidate.nodeKind != CJGUI_COMPOSABLE_UI_MULTILINE_TEXT_INPUT) {
        return false
    }
    return previous.nodeId == candidate.nodeId && previous.identityKey == candidate.identityKey &&
        previous.semanticId == candidate.semanticId && previous.nodeKind == candidate.nodeKind &&
        previous.resourceId == candidate.resourceId && previous.fieldId == candidate.fieldId &&
        previous.actionName == candidate.actionName && previous.operationActionName == candidate.operationActionName &&
        previous.operationResourceId == candidate.operationResourceId && previous.displayValueRole == candidate
        .displayValueRole && previous.inputScopeId == candidate.inputScopeId && previous.layerId == candidate.layerId &&
        previous.layerKind == candidate.layerKind && previous.isEnabled == candidate.isEnabled && previous.isReadOnly ==
        candidate.isReadOnly && previous.tabInsertsText == candidate.tabInsertsText &&
        previous.semanticIncarnation == candidate.semanticIncarnation
}

// A native present may be needed only because another node moved or repainted.
// Restage the focused editor with the existing native continuation hint only
// when the accepted owner and every field-binding identity still match.
func cjguiPreservesOwnerStableText(previous: CjguiComposableUiLayoutNode,
    candidate: CjguiComposableUiLayoutNode, acceptedOwnerRevision: Int64, candidateOwnerRevision: Int64,
    focusedNodeId: Int64, focusedResourceId: Int64, focusedNodeKind: Int64): Bool {
    return acceptedOwnerRevision >= 0 && candidateOwnerRevision == acceptedOwnerRevision &&
        cjguiSameFocusedTextBinding(previous, candidate, focusedNodeId, focusedResourceId, focusedNodeKind) &&
        previous.value == candidate.value
}

func cjguiLocalTextOwnerRevisionMatches(providerExists: Bool, localRevision: Int64,
    candidateRevision: Int64): Bool {
    return !providerExists || (localRevision >= 0 && candidateRevision == localRevision)
}

func cjguiOwnerRevisionRequiresNativeTextReconcile(acceptedRevision: Int64, candidateRevision: Int64,
    focused: CjguiComposableUiLayoutNode, focusedNodeId: Int64, focusedResourceId: Int64,
    focusedNodeKind: Int64): Bool {
    return (acceptedRevision >= 0 || candidateRevision >= 0) && candidateRevision != acceptedRevision &&
        cjguiSameFocusedTextBinding(focused, focused, focusedNodeId, focusedResourceId, focusedNodeKind)
}

func cjguiFocusedTextBindingRequiresNativeReconcile(accepted: CjguiComposableUiLayoutNode,
    candidate: CjguiComposableUiLayoutNode, focusedNodeId: Int64, focusedResourceId: Int64,
    focusedNodeKind: Int64): Bool {
    return cjguiSameFocusedTextBinding(accepted, accepted, focusedNodeId, focusedResourceId, focusedNodeKind) &&
        !cjguiSameFocusedTextBinding(accepted, candidate, focusedNodeId, focusedResourceId, focusedNodeKind)
}

/// Optional window-scoped background declaration. A generated controller
/// returns its staged root request here; the window reads it only inside the
/// same candidate refresh that stages the scene. It is never a node paint
/// property and does not grant native access to a generated description.
public interface CjguiComposableUiWindowBackgroundProvider {
    func candidateWindowBackground(): String
}

/// Optional invalidation boundary for a captured continuous control. A
/// controller may expose an owner-scoped revision for one pointer target so
/// unrelated scene changes (for example a different document or status row)
/// do not revoke a live drag. The returned revision must advance whenever an
/// independently accepted write changes that target's owner truth. Controllers
/// also keep this revision stable only while the target's source mapping is
/// unchanged: retained mapped selections reuse this same invalidation boundary
/// when an unrelated accepted scene replaces a private preparation.
/// Controllers that do not implement this interface retain the conservative whole-scene
/// invalidation policy.
public interface CjguiComposableUiPointerCaptureVersionProvider {
    func pointerCaptureVersion(node: CjguiComposableUiLayoutNode): Int64
}

/// Optional public transaction boundary for a controller that owns keyed
/// component identities and semantic command declarations. The window calls
/// it around one ordinary build/layout/native-present cycle. Implementers keep
/// domain state outside this API: it carries only candidate component identity
/// and command declarations, never native handles or application callbacks.
public interface CjguiComposableUiSceneRefreshParticipant {
    func beginSceneRefresh(): Bool
    func prepareSceneRefresh(): Bool
    func candidateSceneCommands(): ArrayList<CjguiComposableUiCommand>
    func commitSceneRefresh(): Unit
    func rollbackSceneRefresh(): Unit
    /// Releases view-owned resources when the window is disposed (a normal close
    /// or a startup/native failure). The default does nothing, so existing
    /// participants keep working; a participant that holds references into a
    /// SHARED catalog releases exactly its own holds here, and the release must
    /// be idempotent because dispose can run more than once for one window.
    func disposeSceneRefreshResources(): Unit {
    }
}

class CjguiComposableUiDataTransferBinding {
    let declaration: CjguiComposableUiDataTransferDeclaration
    let node: CjguiComposableUiLayoutNode
    let nativeFormat: String
