func cjguiInternalBuildRendererStage154VisibilityPublicationBridgeFirstSliceFacts(
    guardedExecutorBridge:
        CjguiInternalRendererStage153GuardedExecutorBridgeAfterMutationRequestBridgeFirstSliceReadiness,
    legacyVisibilityPublicationDenial:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedResultEnvelopeFirstFrameObservationSemanticComparisonAdmittedRendererStateVisibilityPublicationDenialFirstSliceReadiness
): CjguiInternalRendererStage154VisibilityPublicationBridgeFirstSliceFacts {
    return CjguiInternalRendererStage154VisibilityPublicationBridgeFirstSliceFacts(
        guardedExecutorBridge
            .didPrepareRendererStage153GuardedExecutorBridgeAfterMutationRequestBridgeFirstSliceReadiness,
        legacyVisibilityPublicationDenial
            .didPrepareRuntimeNativeProbeD3BoundedResultEnvelopeFirstFrameObservationSemanticComparisonAdmittedRendererStateVisibilityPublicationDenialFirstSliceReadiness,
        true,
        true,
        guardedExecutorBridge.didConfirmVisibilityPublicationDenialInputPrepared &&
            legacyVisibilityPublicationDenial
                .didConfirmVisibilityPublicationDenialEnvelopeMaterialized,
        true,
        true,
        legacyVisibilityPublicationDenial.didConfirmVisibilityPublicationDenied,
        legacyVisibilityPublicationDenial
            .didConfirmVisibilityPublicationDenialEnvelopeMaterialized,
        true,
        true,
        legacyVisibilityPublicationDenial
            .didConfirmVisibilityPublicationNonExecutable,
        legacyVisibilityPublicationDenial.didConfirmVisibilityPublicationDenied,
        true,
        guardedExecutorBridge.didConfirmRendererStateWriteBlocked &&
            legacyVisibilityPublicationDenial
                .didConfirmRendererStateWriteBlockedAfterVisibilityDenial,
        guardedExecutorBridge.didConfirmRuntimeStateWriteBlocked &&
            legacyVisibilityPublicationDenial
                .didConfirmRuntimeStateWriteBlockedAfterVisibilityDenial,
        guardedExecutorBridge.didConfirmNoNativeBridgeExpansion &&
            legacyVisibilityPublicationDenial.didConfirmNoNativeBridgeExpansion,
        guardedExecutorBridge.didConfirmNoPublicApi &&
            legacyVisibilityPublicationDenial.didConfirmNoPublicApi,
        guardedExecutorBridge.didConfirmNoProductionPublicCAbi &&
            legacyVisibilityPublicationDenial.didConfirmNoProductionPublicCAbi,
        guardedExecutorBridge.didConfirmNoRuntimeStateWrite &&
            legacyVisibilityPublicationDenial.didConfirmNoRuntimeStateWrite,
        guardedExecutorBridge.didConfirmNoCjpmTomlChange &&
            legacyVisibilityPublicationDenial.didConfirmNoCjpmTomlChange,
        guardedExecutorBridge.didConfirmNoRendererStateWrite &&
            legacyVisibilityPublicationDenial.didConfirmNoRendererStateWrite
    )
}

func cjguiInternalBuildRendererStage154VisibilityPublicationBridgeFirstSliceReadiness(
    guardedExecutorBridge:
        CjguiInternalRendererStage153GuardedExecutorBridgeAfterMutationRequestBridgeFirstSliceReadiness,
    legacyVisibilityPublicationDenial:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedResultEnvelopeFirstFrameObservationSemanticComparisonAdmittedRendererStateVisibilityPublicationDenialFirstSliceReadiness,
    visibilityPublicationBridgeFacts:
        CjguiInternalRendererStage154VisibilityPublicationBridgeFirstSliceFacts
): CjguiInternalRendererStage154VisibilityPublicationBridgeFirstSliceReadiness {
    let stage153InputReady =
        visibilityPublicationBridgeFacts
            .didConsumeStage153GuardedExecutorBridgeReadiness &&
        guardedExecutorBridge.didConfirmGuardedExecutorBridgeReady
    let legacyInputReady =
        visibilityPublicationBridgeFacts
            .didConsumeLegacyVisibilityPublicationDenialReadiness &&
        legacyVisibilityPublicationDenial
            .didConfirmVisibilityPublicationDenialEnvelopeMaterialized
    let positivePredicateReady =
        visibilityPublicationBridgeFacts
            .didBindStage153DenialInputToVisibilityPublicationEnvelope &&
        visibilityPublicationBridgeFacts
            .didMaterializeVisibilityPublicationPositivePredicateMap &&
        visibilityPublicationBridgeFacts
            .didDefineVisibilityPublicationAdmissionPositiveFixture
    let bridgeReady =
        stage153InputReady &&
        legacyInputReady &&
        positivePredicateReady &&
        visibilityPublicationBridgeFacts.didBindLegacyVisibilityDenialToStage154Bridge &&
        visibilityPublicationBridgeFacts.didPrepareRollbackVisibilityBoundaryInput &&
        visibilityPublicationBridgeFacts.didKeepVisibilityPublicationBridgeSourceOnly
    let stopLineReady =
        visibilityPublicationBridgeFacts
            .didKeepVisibilityPublicationRuntimeAdmissionBlocked &&
        visibilityPublicationBridgeFacts.didKeepVisibilityPublicationNonExecutable &&
        visibilityPublicationBridgeFacts.didKeepVisibilityPublicationDenied &&
        visibilityPublicationBridgeFacts
            .didKeepVisibilityPublicationAdmissionPredicatesUnsatisfied &&
        visibilityPublicationBridgeFacts.didKeepRendererStateWriteBlocked &&
        visibilityPublicationBridgeFacts.didKeepRuntimeStateWriteBlocked &&
        visibilityPublicationBridgeFacts.didConfirmNoNativeBridgeExpansion &&
        visibilityPublicationBridgeFacts.didConfirmNoPublicApi &&
        visibilityPublicationBridgeFacts.didConfirmNoProductionPublicCAbi &&
        visibilityPublicationBridgeFacts.didConfirmNoRuntimeStateWrite &&
        visibilityPublicationBridgeFacts.didConfirmNoCjpmTomlChange &&
        visibilityPublicationBridgeFacts.didConfirmNoRendererStateWrite

    return CjguiInternalRendererStage154VisibilityPublicationBridgeFirstSliceReadiness(
        guardedExecutorBridge,
        legacyVisibilityPublicationDenial,
        visibilityPublicationBridgeFacts,
        bridgeReady && stopLineReady,
        visibilityPublicationBridgeFacts
            .didConsumeStage153GuardedExecutorBridgeReadiness,
        visibilityPublicationBridgeFacts
            .didConsumeLegacyVisibilityPublicationDenialReadiness,
        visibilityPublicationBridgeFacts
            .didBindStage153DenialInputToVisibilityPublicationEnvelope,
        visibilityPublicationBridgeFacts
            .didMaterializeVisibilityPublicationPositivePredicateMap,
        visibilityPublicationBridgeFacts
            .didDefineVisibilityPublicationAdmissionPositiveFixture,
        visibilityPublicationBridgeFacts
            .didKeepVisibilityPublicationBridgeSourceOnly,
        stage153InputReady,
        legacyInputReady,
        bridgeReady,
        bridgeReady,
        false,
        visibilityPublicationBridgeFacts
            .didMaterializeVisibilityPublicationPositivePredicateMap,
        visibilityPublicationBridgeFacts
            .didDefineVisibilityPublicationAdmissionPositiveFixture,
        false,
        visibilityPublicationBridgeFacts.didKeepVisibilityPublicationDenied,
        visibilityPublicationBridgeFacts.didPrepareRollbackVisibilityBoundaryInput,
        visibilityPublicationBridgeFacts.didKeepRendererStateWriteBlocked,
        visibilityPublicationBridgeFacts.didKeepRuntimeStateWriteBlocked,
        visibilityPublicationBridgeFacts.didConfirmNoNativeBridgeExpansion,
        visibilityPublicationBridgeFacts.didConfirmNoPublicApi,
        visibilityPublicationBridgeFacts.didConfirmNoProductionPublicCAbi,
        visibilityPublicationBridgeFacts.didConfirmNoRuntimeStateWrite,
        visibilityPublicationBridgeFacts.didConfirmNoCjpmTomlChange,
        visibilityPublicationBridgeFacts.didConfirmNoRendererStateWrite
    )
}

func cjguiInternalExecuteDefaultRendererStage154VisibilityPublicationBridgeFirstSliceDraft():
    CjguiInternalRendererStage154VisibilityPublicationBridgeFirstSliceReadiness {
    let guardedExecutorBridge =
        cjguiInternalExecuteDefaultRendererStage153GuardedExecutorBridgeAfterMutationRequestBridgeFirstSliceDraft()
    let legacyVisibilityPublicationDenial =
        cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedResultEnvelopeFirstFrameObservationSemanticComparisonAdmittedRendererStateVisibilityPublicationDenialFirstSliceDraft()
    let visibilityPublicationBridgeFacts =
        cjguiInternalBuildRendererStage154VisibilityPublicationBridgeFirstSliceFacts(
            guardedExecutorBridge,
            legacyVisibilityPublicationDenial
        )
    return cjguiInternalBuildRendererStage154VisibilityPublicationBridgeFirstSliceReadiness(
        guardedExecutorBridge,
        legacyVisibilityPublicationDenial,
        visibilityPublicationBridgeFacts
    )
}
