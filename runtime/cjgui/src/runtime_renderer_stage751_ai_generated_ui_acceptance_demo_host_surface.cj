        acceptanceDemoHostSurfacePlan,
        acceptanceDemoHostSurfaceFacts,
        surfaceReady && stopLineReady,
        acceptanceDemoHostSurfacePlan.didConsumeStage750AiGeneratedUiPublicSurfacePreflight,
        publicSurfacePreflight.didConfirmStage749AiGeneratedUiOwnerAcceptancePreflightConsumed,
        acceptanceDemoHostSurfacePlan.didConsumeInternalPublicSurfaceBoundary,
        acceptanceDemoHostSurfacePlan.didMaterializeAcceptanceDemoHostInspectionRows,
        acceptanceDemoHostSurfacePlan.didMaterializeAcceptanceResultSurfacePreview,
        acceptanceDemoHostSurfacePlan.didMaterializeAcceptanceRenderCommandPreviewReceipt,
        acceptanceDemoHostSurfacePlan.didMaterializeAcceptanceProbeInputContract,
        acceptanceDemoHostSurfacePlan.didMaterializeTodoAiGeneratedUiAcceptanceDemoHostSurface,
