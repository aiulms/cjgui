        didConsumeTodoAndSettingsPreviewApiDemoSurfaces: Bool,
        didMaterializePublicDeclarationScanReceipt: Bool,
        didListCjguiExperimentalComponentPreviewApiReadyAsExperimentalPublicSurface: Bool,
        didMaterializeCompatibilityRollbackNote: Bool,
        didKeepStablePublicApiUnpromised: Bool,
        didKeepPublicCAbiUnexpanded: Bool,
        didReduceFuturePublicPreviewApiTemplateNeed: Bool,
        didPrepareStage761PreviewComponentApiLayoutStyleConsumption: Bool,
        didKeepRendererSubmissionBlocked: Bool,
        didKeepRendererStateWriteBlocked: Bool,
        didKeepRuntimeStateWriteBlocked: Bool
    ) {
        this.didConsumeStage759MinimalPublicPreviewApiDemoConsumption = didConsumeStage759MinimalPublicPreviewApiDemoConsumption
        this.didConsumeTodoAndSettingsPreviewApiDemoSurfaces = didConsumeTodoAndSettingsPreviewApiDemoSurfaces
        this.didMaterializePublicDeclarationScanReceipt = didMaterializePublicDeclarationScanReceipt
        this.didListCjguiExperimentalComponentPreviewApiReadyAsExperimentalPublicSurface = didListCjguiExperimentalComponentPreviewApiReadyAsExperimentalPublicSurface
        this.didMaterializeCompatibilityRollbackNote = didMaterializeCompatibilityRollbackNote
        this.didKeepStablePublicApiUnpromised = didKeepStablePublicApiUnpromised
        this.didKeepPublicCAbiUnexpanded = didKeepPublicCAbiUnexpanded
        this.didReduceFuturePublicPreviewApiTemplateNeed = didReduceFuturePublicPreviewApiTemplateNeed
        this.didPrepareStage761PreviewComponentApiLayoutStyleConsumption = didPrepareStage761PreviewComponentApiLayoutStyleConsumption
        this.didKeepRendererSubmissionBlocked = didKeepRendererSubmissionBlocked
        this.didKeepRendererStateWriteBlocked = didKeepRendererStateWriteBlocked
        this.didKeepRuntimeStateWriteBlocked = didKeepRuntimeStateWriteBlocked
    }
}

