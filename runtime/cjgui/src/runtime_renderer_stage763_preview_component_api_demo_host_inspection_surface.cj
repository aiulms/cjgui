    ) {
        this.didConsumeStage762PreviewComponentApiTextFocusProjection = didConsumeStage762PreviewComponentApiTextFocusProjection
        this.didConsumePreviewComponentApiTextFocusProjectionReceipts = didConsumePreviewComponentApiTextFocusProjectionReceipts
        this.didMaterializePreviewComponentApiHostInspectionRows = didMaterializePreviewComponentApiHostInspectionRows
