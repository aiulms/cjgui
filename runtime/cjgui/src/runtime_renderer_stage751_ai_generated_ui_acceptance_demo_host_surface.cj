    let acceptanceDemoHostSurfacePlan = cjguiInternalBuildRendererStage751AiGeneratedUiAcceptanceDemoHostSurfacePlan(
        publicSurfacePreflight)
    let acceptanceDemoHostSurfaceFacts = cjguiInternalBuildRendererStage751AiGeneratedUiAcceptanceDemoHostSurfaceFacts(
        publicSurfacePreflight,
