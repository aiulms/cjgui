func cjguiInternalBuildRendererStage753AiGeneratedUiAcceptanceCommitPreflightPlan(
    ownerAcceptanceRuntimeManager: CjguiInternalRendererStage752AiGeneratedUiOwnerAcceptanceRuntimeManagerReadiness): CjguiInternalRendererStage753AiGeneratedUiAcceptanceCommitPreflightPlan {
    let stage752Ready = ownerAcceptanceRuntimeManager.didConfirmStage752AiGeneratedUiOwnerAcceptanceRuntimeManagerReady &&
        ownerAcceptanceRuntimeManager.didConfirmStage753AiGeneratedUiAcceptanceCommitPreflightPrepared
    let runtimeContractReady = ownerAcceptanceRuntimeManager
        .didConfirmSharedAiGeneratedUiOwnerAcceptanceRuntimeManagerMaterialized && ownerAcceptanceRuntimeManager
        .didConfirmOwnerAcceptanceRuntimeContractMaterialized && ownerAcceptanceRuntimeManager
        .didConfirmOwnerAcceptanceExecutionReceiptContractMaterialized && ownerAcceptanceRuntimeManager
        .didConfirmChatComposerAiGeneratedUiOwnerAcceptanceRuntimeSurfaceMaterialized
    let preflightReady = stage752Ready && runtimeContractReady &&
        cjguiInternalRendererStage753AiGeneratedUiAcceptanceCommitPreflightMaterialized()
    return CjguiInternalRendererStage753AiGeneratedUiAcceptanceCommitPreflightPlan(
        stage752Ready,
        runtimeContractReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        preflightReady,
        ownerAcceptanceRuntimeManager.didConfirmRuntimeManagerBoundToStage751AcceptanceDemoHostSurface,
        preflightReady,
        preflightReady,
        ownerAcceptanceRuntimeManager.didConfirmStablePublicApiAdded == false,
        ownerAcceptanceRuntimeManager.didConfirmRendererSubmissionBlocked,
        ownerAcceptanceRuntimeManager.didConfirmRendererStateWriteBlocked,
        ownerAcceptanceRuntimeManager.didConfirmRuntimeStateWriteBlocked
    )
}

