func cjguiInternalBuildRendererStage456RecoveryDemoSurfaceFocusInputActionIntentAdapterPlan(
    execution: CjguiInternalRendererStage455RecoveryDemoSurfaceLayoutStyleExecutionDryRunReadiness): CjguiInternalRendererStage456RecoveryDemoSurfaceFocusInputActionIntentAdapterPlan {
    let stage455Ready = execution.didConfirmStage455RecoveryDemoSurfaceLayoutStyleExecutionDryRunReady && execution
        .didConfirmStage456RecoveryDemoSurfaceFocusInputActionIntentAdapterPrepared
    let receiptReady = stage455Ready && execution
        .didConfirmSharedRecoveryDemoSurfaceLayoutStyleExecutionReceiptMaterialized && execution
        .didConfirmRecoveryDemoSurfaceTextFocusExecutionAffordanceMaterialized && execution
        .didConfirmRecoveryDemoSurfaceLayoutStyleExecutionDryRunOnly
    let adapterReady = receiptReady && execution.didConfirmLayoutStylePreviewToExecutionDryRunBound && execution
        .didConfirmRenderCommandRefreshToExecutionReceiptBound

    return CjguiInternalRendererStage456RecoveryDemoSurfaceFocusInputActionIntentAdapterPlan(
        stage455Ready,
        receiptReady,
        receiptReady,
        adapterReady,
        adapterReady,
        adapterReady,
        adapterReady,
        adapterReady,
        adapterReady,
        adapterReady,
        adapterReady,
        adapterReady && execution.didConfirmRendererStateWriteBlocked,
        execution.didConfirmInputEventPipelineEnabled == false,
        execution.didConfirmInputEventPipelineExecution == false,
        execution.didConfirmActionDispatch == false,
        execution.didConfirmStateUpdateCommitted == false,
        execution.didConfirmVisibilityPublicationAdmitted == false,
        execution.didConfirmVisibilityPublished == false,
        execution.didConfirmPublicComponentApiAdded == false,
        execution.didConfirmLayoutEngineEnabled == false,
        execution.didConfirmStyleResolverEnabled == false,
        execution.didConfirmTextShapingEnabled == false,
        execution.didConfirmFocusManagerEnabled == false,
        execution.didConfirmBackendImplementationBlocked,
        execution.didConfirmPlatformCommandBufferBlocked,
        execution.didConfirmRendererSubmissionBlocked,
        execution.didConfirmRendererStateWriteBlocked,
        execution.didConfirmRuntimeStateWriteBlocked
    )
}

