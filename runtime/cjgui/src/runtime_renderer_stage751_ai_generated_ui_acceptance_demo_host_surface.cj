        publicSurfacePreflight.didConfirmOwnerAcceptanceGranted == false,
        publicSurfacePreflight.didConfirmProductionRenderTruth == false,
        publicSurfacePreflight.didConfirmBackendReadyTruth == false,
        publicSurfacePreflight.didConfirmPublicComponentApiAdded == false,
        acceptanceDemoHostSurfacePlan.didKeepStablePublicApiBlocked,
        publicSurfacePreflight.didConfirmInputEventPipelineExecution == false,
        publicSurfacePreflight.didConfirmActionDispatch == false,
        publicSurfacePreflight.didConfirmStateUpdateCommitted == false,
        publicSurfacePreflight.didConfirmVisibilityPublicationAdmitted == false,
        publicSurfacePreflight.didConfirmVisibilityPublished == false,
