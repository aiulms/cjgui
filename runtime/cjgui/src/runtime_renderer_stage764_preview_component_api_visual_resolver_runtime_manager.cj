func cjguiInternalExecuteDefaultRendererStage764PreviewComponentApiVisualResolverRuntimeManagerDraft(): CjguiInternalRendererStage764PreviewComponentApiVisualResolverRuntimeManagerReadiness {
    let demoHostInspectionSurface = cjguiInternalExecuteDefaultRendererStage763PreviewComponentApiDemoHostInspectionSurfaceDraft()
    let visualResolverRuntimeManagerPlan = cjguiInternalBuildRendererStage764PreviewComponentApiVisualResolverRuntimeManagerPlan(
        demoHostInspectionSurface)
    let visualResolverRuntimeManagerFacts = cjguiInternalBuildRendererStage764PreviewComponentApiVisualResolverRuntimeManagerFacts(
        demoHostInspectionSurface,
        visualResolverRuntimeManagerPlan
    )
    return cjguiInternalBuildRendererStage764PreviewComponentApiVisualResolverRuntimeManagerReadiness(
        demoHostInspectionSurface,
        visualResolverRuntimeManagerPlan,
        visualResolverRuntimeManagerFacts
