func cjguiInternalBuildRendererStage748AiGeneratedUiRuntimeManagerPlan(
    hostInspectionSurface: CjguiInternalRendererStage747AiGeneratedUiHostInspectionSurfaceReadiness): CjguiInternalRendererStage748AiGeneratedUiRuntimeManagerPlan {
    let stage747Ready = hostInspectionSurface.didConfirmStage747AiGeneratedUiHostInspectionSurfaceReady && hostInspectionSurface
        .didConfirmStage748AiGeneratedUiRuntimeManagerPrepared
    let hostSurfaceReady = hostInspectionSurface.didConfirmAiGeneratedUiHostInspectionRowsMaterialized && hostInspectionSurface
        .didConfirmAiGeneratedUiResultSurfacePreviewMaterialized && hostInspectionSurface
        .didConfirmAiGeneratedUiRenderCommandPreviewReceiptMaterialized && hostInspectionSurface
        .didConfirmChatComposerAiGeneratedUiHostInspectionSurfaceMaterialized
    let runtimeManagerReady = stage747Ready && hostSurfaceReady &&
        cjguiInternalRendererStage748AiGeneratedUiRuntimeManagerMaterialized()
    return CjguiInternalRendererStage748AiGeneratedUiRuntimeManagerPlan(
        stage747Ready,
        hostSurfaceReady,
        runtimeManagerReady,
        runtimeManagerReady,
        runtimeManagerReady,
        runtimeManagerReady,
        runtimeManagerReady,
        runtimeManagerReady,
        runtimeManagerReady,
        runtimeManagerReady,
        hostInspectionSurface.didConfirmStage745AiGeneratedUiDslDryRunConsumedTransitively,
        hostInspectionSurface.didConfirmStage746AiGeneratedUiOwnerReviewPreflightConsumed,
        hostInspectionSurface.didConfirmHostInspectionSurfaceBoundToOwnerReviewPreflight,
        runtimeManagerReady,
        runtimeManagerReady,
        true,
        hostInspectionSurface.didConfirmStablePublicApiAdded == false,
        hostInspectionSurface.didConfirmRendererSubmissionBlocked,
        hostInspectionSurface.didConfirmRendererStateWriteBlocked,
        hostInspectionSurface.didConfirmRuntimeStateWriteBlocked
    )
}

