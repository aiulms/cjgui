    let didConfirmStage791PreviewComponentApiCommitTransactionDemoHostSurfaceReady: Bool
    let didConfirmStage790PreviewComponentApiCommitTransactionPatchPlanConsumed: Bool
    let didConfirmStage789PreviewComponentApiCommitAdmissionDecisionConsumedTransitively: Bool
    let didConfirmOwnerLocalTransactionPatchPlanConsumed: Bool
    let didConfirmCommitTransactionHostInspectionReceiptMaterialized: Bool
    let didConfirmCommitTransactionResultSurfaceRefreshMaterialized: Bool
    let didConfirmCommitTransactionRollbackPreviewReceiptMaterialized: Bool
    let didConfirmCommitTransactionSemanticDiffExplainMaterialized: Bool
    let didConfirmTodoCommitTransactionDemoHostSurfaceMaterialized: Bool
    let didConfirmSettingsCommitTransactionDemoHostSurfaceMaterialized: Bool
    let didConfirmAiGeneratedSettingsCommitTransactionDemoHostSurfaceMaterialized: Bool
    let didConfirmChatComposerCommitTransactionDemoHostSurfaceMaterialized: Bool
    let didConfirmDemoHostSurfaceBoundToStage790TransactionPatchPlan: Bool
    let didConfirmCommitTransactionDemoHostSurfaceNonCommitting: Bool
