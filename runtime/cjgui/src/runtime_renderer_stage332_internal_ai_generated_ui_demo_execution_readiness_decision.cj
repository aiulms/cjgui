            .didConfirmExecutionResultEnvelopeVisibilityNotPublished && executionSemanticDiffExplain
            .didConfirmExecutionSemanticDiffRollbackReady && executionSemanticDiffExplain
            .didConfirmExecutionExplainVisibilityNotPublished,
        true,
        true,
