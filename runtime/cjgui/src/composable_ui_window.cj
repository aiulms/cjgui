    /// A1：启动受理与 Ready 结果分别可观察。首帧 PENDING 不是失败：
    /// native 已受理票据、会话与候选持有保留，宿主把窗口留在泵送集合里，
    /// 由后续 turn 的前置结算门推进到 Ready/失败；失败/单次 close/Starting
    /// 时 stop 都留在同一实例状态机内直到真实收敛。
    public func startWithOutcome(): CjguiComposableUiWindowStartOutcome {
        if (isWindowOpen) {
            if (isStartingPending()) { return StartAcceptedPending }
            if (isStartingPreparing()) { return StartPreparing }
            return StartReady
        }
        if (!configuration.isValid()) {
            lastNativeStatus = CJGUI_INTERNAL_RENDERER_INTERNAL_ERROR
            firstStartupFailure = "invalid_configuration"
            return StartFailed
        }
        // Charge all startup work, including renderer creation and native
        // bootstrap, to one allowance. A host that already owns an active
        // shared turn retains that turn and its trace envelope.
        var ownsStartupTurn = false
        var startupTurnAvailable = true
        var startupTraceStarted = false
        var startupTraceTurn: Int64 = 0
        var startupTraceSpan: UInt64 = 0u64
        var startupTraceSession: UInt64 = CJGUI_INTERNAL_RENDERER_INVALID_SESSION_TOKEN
        if (let Some(budget) <- ownerTurnBudget) {
            if (!budget.isActive()) {
                ownsStartupTurn = budget.begin()
                startupTurnAvailable = ownsStartupTurn
                if (ownsStartupTurn) { startupTraceTurn = budget.turnIdentity() }
            }
        }
        if (!startupTurnAvailable) {
            firstStartupFailure = "owner_turn_unavailable"
            return StartFailed
        }
        try {
        if (ownsStartupTurn) {
            // The bootstrap has no renderer token yet. Keep that same trace
            // identity through its end, so creation is included and pairing
            // cannot silently switch to the newly created session.
            startupTraceSession = sessionToken
            startupTraceSpan = beginOwnerTraceTurn(startupTraceTurn)
            startupTraceStarted = true
        }
        startupPhase = "renderer_create"
        let created = internalRendererCreate(
            CjguiInternalRendererConfig(
                windowWidth: configuration.width,
                windowHeight: configuration.height,
                clearColorRed: 0.08,
                clearColorGreen: 0.16,
                clearColorBlue: 0.20,
                clearColorAlpha: 1.0
            )
        )
        if (created.status != CJGUI_INTERNAL_RENDERER_OK || created.token ==
            CJGUI_INTERNAL_RENDERER_INVALID_SESSION_TOKEN) {
            lastNativeStatus = created.status
            firstStartupFailure = if (created.status == CJGUI_INTERNAL_RENDERER_OK) {
                "renderer_create_invalid_token"
            } else {
                "renderer_create_${nativeStatusReason(created.status)}"
            }
            return StartFailed
        }
        sessionToken = created.token
        isWindowOpen = true
        textRangeEditDeltaDeliveryEnabled = false
        if (configuration.rangeTextEditDeltaDelivery) {
            let deltaStatus = internalRendererSetComposableRangeEditDelta(sessionToken, true)
            if (deltaStatus == CJGUI_INTERNAL_RENDERER_OK) {
                textRangeEditDeltaDeliveryEnabled = true
            } else {
                lastNativeStatus = deltaStatus
                firstStartupFailure = "renderer_range_edit_${nativeStatusReason(deltaStatus)}"
                discardSession("start_range_edit_failed")
                return StartFailed
            }
        }
        lastNativeStatus = internalRendererSetWindowTitle(sessionToken, configuration.title)
        if (lastNativeStatus != CJGUI_INTERNAL_RENDERER_OK) {
            firstStartupFailure = "renderer_title_${nativeStatusReason(lastNativeStatus)}"
            discardSession("start_title_failed")
            return StartFailed
        }
        // 新 native 会话不继承旧会话的任何声明：已绑定的正文会话在这里重新声明，
        // 否则该节点的组字相位不会以 kind 52 到达窗口。
        if (ownedTextSession.isSome()) {
            let declarationStatus = this.declareOwnedTextSession()
            if (declarationStatus != CJGUI_INTERNAL_RENDERER_OK) {
                lastNativeStatus = declarationStatus
                firstStartupFailure = "renderer_owned_text_session_${nativeStatusReason(declarationStatus)}"
                discardSession("start_owned_text_session_failed")
                return StartFailed
            }
        }
        windowSessionIdentity = CjguiComposableUiWindowSessionIdentityAllocator.allocate()
        // Native delivery ordinals belong to one renderer session. The
        // retained receipts/revision remain on this window object so an old
        // (session, event) can be read independently after restart.
        transferReceiptLastDeliveryOrdinal = 0u64
        // A reopened native session owns no prior scene snapshot. Retaining
        // the old Cangjie scene here could make `sameRenderedScene` suppress
        // the initial staging/submission into an empty new Metal view.
        renderedRoot = cjguiComposableVertical(-1, "inactive-window", CjguiComposableUiStyle())
        renderedScene = CjguiComposableUiScene(0, CjguiComposableUiRect(0, 0, 0, 0),
            ArrayList<CjguiComposableUiLayoutNode>())
        nativeInputScene = CjguiComposableUiScene(0, CjguiComposableUiRect(0, 0, 0, 0),
            ArrayList<CjguiComposableUiLayoutNode>())
        acceptedBindingKeys.clear()
        acceptedBindingEpochs.clear()
        acceptedWheelBindings.clear()
        lastNativeFailure = "none"
        lastReportedSceneRejection = ""
        pendingRefreshReason = "none"
        deferredInteractionPaint = false
        deferredEventWork = false
        firstStartupFailure = "none"
        startupPhase = "viewport"
        acceptedSceneVersion = 0
        acceptedWindowBackgroundToken = CjguiWindowBackgroundPolicy.OPAQUE
        acceptedWindowBackgroundColorScheme = 2u32
        observedWindowBackgroundEnvironmentRevision = 0u64
        windowBackgroundRecoveryRequested = false
        submittedSceneVersion = -1
        lastRefusedEffectPathValue = ""
        submittedFrameIndex = -1
        observedMetalCompletionFrameIndex = -1
        observedMetalFailureFrameIndex = -1
        observedMetalGpuDurationMicros = -1
        overlayDrawnSceneVersion = -1
        effectSubmittedSceneVersion = -1
        effectSubmittedFrameIndex = -1
        effectSubmittedRadiusPoints = 0
        effectModeCode = 0u32
        effectFallbackReasonCode = 0u32
        effectCompletionCode = 0u32
        diagnosticOverlayOptions = CjguiComposableUiDiagnosticOverlayOptions(false)
        diagnosticOverlayStatus = "disabled"
        buildPassCount = 0
        layoutPassCount = 0
        nativeSubmissionCount = 0
        testCloseReason = ""
        testCloseEventKind = -1
        testCloseNativeStatus = 0
        sceneWriteTraceEnabled = false
        workloadDiagnosticsEnabled = false
        workloadDiagnosticsStatus = "disabled"
        workloadAttemptBaseValid = false
        workloadAttemptBase = CjguiInternalRendererWorkloadAttemptCounts()
        workloadLastResult = "none"
        workloadLastNodeWrites = -1
        workloadLastNodeClones = -1
        workloadLastNodeAllocations = -1
        workloadLastTextLayoutPreparations = -1
        workloadLastImageDecodeStarts = -1
        lastNativeSubmissionSnapshotValue = None
        lastBuildElapsedMs = 0
        lastLayoutElapsedMs = 0
        lastNativeMeasurementElapsedMs = 0
        lastNativeStageAndSubmitElapsedMs = 0
        lastRefreshTiming = CjguiComposableUiRefreshTiming()
        timingAttemptActive = false
        totalBuildNanoseconds = 0
        totalLayoutNanoseconds = 0
        totalNativeStageAndSubmitNanoseconds = 0
        lastNativeMeasurementCallCount = 0
        lastStaticLayoutWorkerStartCount = 0
        lastLayoutReuseHitCount = 0
        lastLayoutReuseMissCount = 0
        lastLayoutReuseRevalidationNodeCount = 0
        lastLayoutReuseReplayedNodeCount = 0
        lastLayoutReuseEntryCount = 0
        lastControllerSceneVersion = -1
        lastAcceptedBusinessOwnerRevision = -1
        lastViewportResizeVersion = 0u64
        lastResourceCompletionVersion = 0u64
        lastAttemptedControllerSceneVersion = -1
        lastAttemptedViewportResizeVersion = 0u64
        lastAttemptedResourceCompletionVersion = 0u64
        pointerCaptureNode = CjguiComposableUiLayoutNode.missing()
        pointerCaptureOwnerVersion = -1
        pointerCaptureModalLayerId = ""
        pointerCaptureActive = false
        pointerCaptureX = 0
        pointerCaptureY = 0
        hoveredInteractionNode = CjguiComposableUiLayoutNode.missing()
        pressedInteractionNode = CjguiComposableUiLayoutNode.missing()
        suppressedPressActivationNode = CjguiComposableUiLayoutNode.missing()
        pressLease = None
        lastAdmittedPressSequence = 0u64
        lastTerminalPressIdentityChanged = false
        lastPressActivationSuppressed = false
        textMeasurer = CjguiInternalRendererTextMeasurer(sessionToken)
        layoutReuseCache = CjguiComposableUiLayoutReuseCache()
        identityRegistry.clear()
        requestRefresh()
        var refreshedAtStart = false
        if (startupTurnAvailable) {
            refreshedAtStart = refreshIfNeeded()
        }
        if (!refreshedAtStart) {
            // A1：首帧 PENDING 不是启动失败。native 已受理首帧票据（终态未定），
            // 会话与原事务保留，宿主继续泵送至 Ready/失败；不得 discard——
            // 那会让 native 票据变成不可寻址的孤儿。
            var pendingNow = false
            match (pendingTransaction) {
                case Some(_) => pendingNow = true
                case None => pendingNow = false
            }
            if (isWindowOpen && pendingNow) {
                startingPending = true
                startupPhase = "starting_pending"
                firstStartupFailure = "none"
                return StartAcceptedPending
            }
            // A cold layout may have yielded before any native scene ticket
            // exists. This is a live empty initial surface, not an accepted
            // first frame; normal owner turns continue the retained request.
            if (isWindowOpen && refreshRequested && firstStartupFailure == "none" &&
                lastNativeFailure == "none") {
                startupPhase = if (staticLayoutPreparation.isSome()) {
                    "starting_preparation"
                } else {
                    "starting_preparation_deferred"
                }
                return StartPreparing
            }
            if (firstStartupFailure == "none") {
                firstStartupFailure = "refresh_unknown_failure"
            }
            discardSession("start_refresh_failed")
            return StartFailed
        }
        return StartReady
        } finally {
            if (startupTraceStarted) {
                let _ = cjguiOwnerTraceRecord(2u32, startupTraceSession, UInt64(startupTraceTurn),
                    0u64, 0u64, UInt64.Max, 0u32, startupTraceSpan)
            }
            if (ownsStartupTurn) {
                if (let Some(budget) <- ownerTurnBudget) {
                    let elapsedUs = budget.elapsedWorkMicroseconds()
                    if (elapsedUs > 16000) {
                        getStdOut().writeln("CJGUI_STARTUP_TURN_OVERRUN turn=${startupTraceTurn} " +
                            "elapsed_us=${elapsedUs} allowance_us=16000")
                        getStdOut().flush()
                    }
                    budget.end()
                }
            }
            if (startupTraceStarted) {
                cjguiOwnerTraceBoundary(startupTraceSession, UInt64(startupTraceTurn),
                    145u32, 0u32, 0u32, 0u64, UInt64.Max)
            }
        }
    }

    /// 兼容入口：Preparing、native 受理（首帧未定）与 Ready 都算窗口已打开，只有真实失败返回假。
    /// 需要区分受理/Ready 的宿主改用 startWithOutcome 与 isStartingPending。
    public func start(): Bool {
        let outcome = startWithOutcome()
        match (outcome) {
            case StartFailed => return false
            case _ => return true
        }
    }

    /// A1：首帧受理状态。native 已收下首帧票据但终态未定；真实 Ready 清零。
    public func isStartingPending(): Bool {
        return isWindowOpen && startingPending
    }

    /// The empty renderer has not received an accepted first scene yet, but a
    /// budgeted startup projection is retained for later owner turns.
    public func isStartingPreparing(): Bool {
        return isWindowOpen && renderedScene.version <= 0 && refreshRequested &&
            firstStartupFailure == "none" && lastNativeFailure == "none" && pendingTransaction.isNone()
    }

    /// A1：最近一次「核心收尾未完整」的命名原因（终止收敛可观察出口）；
    /// 空串 = 无未收敛故障。
    public func settlementFault(): String {
        return lastSettlementFault
    }

    /// Compatibility entry point: request one explicit conservative rebuild.
    /// A caller that merely observes state should instead use
    /// `refreshIfNeeded`, which performs no build/layout/native submission
    /// while the Cangjie UI revision and native viewport are unchanged.
    public func refresh(): Bool {
        requestRefresh()
        return refreshIfNeeded()
    }

    /// Mark a real external domain/style change for one coalesced refresh.
    /// Repeated marks before `refreshIfNeeded` intentionally stay one pass.
    public func requestRefresh() {
        cancelPreparedCandidate("request_changed")
        if (isWindowOpen) {
            refreshRequested = true
            // A1：推进刷新请求代际。等待中的原事务只消费它自己记录的 epoch，
            // 因此等待期间产生的任何新修改都会在结算后再走一轮，不会被吞掉。
            refreshRequestEpoch += 1
        }
    }

    // A full layout has already frozen A, including its staged viewport solve.
    // An ordinary wheel may request B while native prepares those copied facts.
    // Finish A; its original epoch keeps B scheduled after the real acceptance.
    // An unfinished static layout still reads shared offset() and is cancelled.
    private func requestViewportRefresh(requests: ArrayList<CjguiWheelViewportRequest>): Unit {
        if (let Some(candidate) <- preparingCandidate) {
            if (getVariable("CJGUI_VIEWPORT_HANDOFF_TRACE").isSome()) {
                println("CJGUI_VIEWPORT_HANDOFF phase=admission preparation=${candidate.preparationId} " +
                    "ui=${candidate.declaredVersion}:${controller.uiSceneVersion()} " +
                    "owner=${candidate.businessOwnerRevision}:${currentBusinessOwnerRevision()} " +
                    "demand=${candidate.viewportDemandEpoch}:${refreshRequestEpoch} " +
                    "binding=${candidate.bindingEpoch}:${textSessionBindingEpoch} " +
                    "focus=${candidate.focus == (focusedNodeId, focusedResourceId, focusedNodeKind)} " +
                    "selection=${staticLayoutSelectionMatches(candidate.selectionBasis)} " +
                    "session=${ownedTextSession.isSome()} ticket=${candidate.selectionBasis.isSome()} " +
                    "idle=${staticLayoutMovementIdle()} deferred_paint=${deferredInteractionPaint} requests=${requests.size}")
            }
            if (candidate.session == sessionToken && candidate.previousScene.version == nativeInputScene.version &&
                this.preparationDeclarationMatches(candidate.declaredVersion, candidate.preparationDependency, controller.uiSceneVersion()) &&
                candidate.businessOwnerRevision == currentBusinessOwnerRevision() &&
                candidate.viewportDemandEpoch == refreshRequestEpoch &&
                candidate.bindingEpoch == textSessionBindingEpoch &&
                candidate.focus == (focusedNodeId, focusedResourceId, focusedNodeKind) &&
                (ownedTextSession.isNone() || candidate.selectionBasis.isSome()) &&
                staticLayoutSelectionMatches(candidate.selectionBasis) && staticLayoutMovementIdle() &&
                !deferredInteractionPaint && requests.size > 0) {
                let nextBases = ArrayList<CjguiStaticLayoutViewportBasis>(candidate.viewportDemandBases)
                var valid = true
                for (request in requests) {
                    var matched = false
                    var index: Int64 = 0
                    while (index < nextBases.size) {
                        let previous = nextBases[index]
                        if (previous.viewport.viewStateIdentity() == request.before.viewport.viewStateIdentity()) {
                            if (previous.generation != request.before.generation || previous.offset != request.before.offset) {
                                valid = false
                            }
                            nextBases[index] = request.after
                            matched = true
                            break
                        }
                        index += 1
                    }
                    if (!matched) { valid = false }
                }
                for (basis in nextBases) {
                    if (basis.viewport.requestGeneration() != basis.generation || basis.viewport.offset() != basis.offset ||
                        !basis.viewport.hasStagedExtents() || basis.viewport.ownerWindowToken() != instanceToken) {
                        valid = false
                    }
                    if (getVariable("CJGUI_VIEWPORT_HANDOFF_TRACE").isSome()) {
                        println("CJGUI_VIEWPORT_HANDOFF phase=chain viewport=${basis.viewport.viewStateIdentity()} " +
                            "generation=${basis.generation}:${basis.viewport.requestGeneration()} " +
                            "offset=${basis.offset}:${basis.viewport.offset()} " +
                            "staged=${basis.viewport.hasStagedExtents()} " +
                            "owner=${basis.viewport.ownerWindowToken()}:${instanceToken} valid=${valid}")
                    }
                }
                if (valid) {
                    refreshRequestEpoch += 1
                    refreshRequested = true
                    candidate.viewportDemandEpoch = refreshRequestEpoch
                    candidate.viewportDemandBases = nextBases
                    if (getVariable("CJGUI_VIEWPORT_HANDOFF_TRACE").isSome()) {
                        println("CJGUI_PREPARE_TRACE preparation=${candidate.preparationId} status=retain_viewport " +
                            "original_epoch=${candidate.requestEpoch} demand_epoch=${refreshRequestEpoch}")
                    }
                    return
                }
            }
        }
        requestRefresh()
    }

    /// Bounded explicit recovery for a retained, temporarily unavailable
    /// renderer. It never loops or schedules background retries.
    public func retryPendingRefresh(): Bool {
        requestRefresh()
        return refreshIfNeeded()
    }

    private func imageResourceStatusFromNative(result: InternalRendererImageResourceResult): CjguiComposableUiImageResourceStatus {
        if (result.status != CJGUI_INTERNAL_RENDERER_OK) {
            return CjguiComposableUiImageResourceStatus("failed", result.status)
        }
        let state = if (result.stateCode == 2u32) {
            "ready"
        } else if (result.stateCode == 1u32) {
            "loading"
        } else if (result.stateCode == 3u32) {
            "failed"
        } else if (result.stateCode == 4u32) {
            "busy"
        } else {
            "unrequested"
        }
        return CjguiComposableUiImageResourceStatus(state, result.status)
    }

    /// Explicitly starts a bounded preparation before a component references
    /// it. This does not schedule a timer or create a second state machine;
    /// the next ordinary host turn notices a completed resource version.
    public func prepareImageResource(resourcePath: String, resourceId: String, resourceVersion: Int64): CjguiComposableUiImageResourceStatus {
        if (!isWindowOpen) {
            return CjguiComposableUiImageResourceStatus("failed", CJGUI_INTERNAL_RENDERER_INVALID_SESSION)
        }
        return imageResourceStatusFromNative(
            internalRendererPrepareComposableImageResource(sessionToken, resourcePath, resourceId, resourceVersion))
    }

    /// Reads existing preparation state only. It does not start I/O, redraw,
    /// or mutate Cangjie application state.
    public func imageResourceStatus(resourcePath: String, resourceId: String, resourceVersion: Int64): CjguiComposableUiImageResourceStatus {
        if (!isWindowOpen) {
            return CjguiComposableUiImageResourceStatus("failed", CJGUI_INTERNAL_RENDERER_INVALID_SESSION)
        }
        return imageResourceStatusFromNative(
            internalRendererComposableImageResourceState(sessionToken, resourcePath, resourceId, resourceVersion))
    }

    /// Cheap invalidation check used from ordinary application loops. It reads
    /// only the controller's declared UI revision and native viewport until a
    /// real change, resize, or explicit request requires one full projection.
    public func refreshIfNeeded(): Bool {
        let phaseStarted = this.ownerPhaseStarted()
        try {
        if (!isWindowOpen) {
            return false
        }
        // A1 前置结算门：必须先结算原票据，再决定本轮是否提交新候选。它早于
        // viewport 失败判断，因此 PENDING 期间的 viewport 波动不会被误当成新失败。
        let settlementSpan = this.beginOwnerTracePhase(1u32)
        let settledPending = settlePendingPresent()
        this.endOwnerTracePhase(1u32, settlementSpan)
        if (settledPending) {
            return false
        }
        if (!isWindowOpen) {
            return false
        }
        // A prior destroy rejection leaves the native session and all accepted
        // resources with this window. Retry that exact close before any new
        // viewport, candidate or animation work on a legal owner turn.
        if (discardRetryReason.size > 0) {
            discardSession(discardRetryReason)
            return false
        }
        if (closeIntentPending) {
            if (isWindowOpen) {
                internalRendererRequestCloseBeforeDestroy(sessionToken)
            }
            discardSession("close_after_settlement")
            return false
        }
        if (activationPrefixPending()) { return false }
        // A nonblocking native pump can return NONE while AppKit is still
        // acquiring this window's next input. Its retained ticket must be
        // consumed before publishing a scene that would invalidate that input.
        // This also covers an event already removed from the native FIFO.
        if (internalRendererOwnerPumpHasUnconsumedInput(sessionToken)) { return false }
        // Admission precedes any new candidate/staging work. An original
        // present settlement above always finishes before this pacing gate.
        if (!this.ownerBudgetAdmits(if (staticLayoutPreparation.isSome()) { 5000 } else { 12000 }, "refresh")) { return false }
        let nativeStateSpan = this.beginOwnerTracePhase(2u32)
        let _ = deliverPendingPlatformColorScheme()
        let _ = deliverPendingPlatformAccent()
        // A reduction request can hide the material immediately in AppKit.
        // When the preference turns off again, the last drawable may still
        // have the opaque fallback clear. Route recovery through this window's
        // ordinary accepted scene transaction so native/Cangjie frame indices
        // and staged input stay in one owner path. Reads of windowProgress()
        // remain observational and never schedule work.
        if (acceptedWindowBackgroundToken == CjguiWindowBackgroundPolicy.SYSTEM_CONTENT_AREA) {
            let backgroundEnvironment = internalRendererWindowBackgroundSnapshot(sessionToken)
            if (backgroundEnvironment.status == CJGUI_INTERNAL_RENDERER_OK) {
                let background = backgroundEnvironment.snapshot
                let changed = background.environmentRevision != observedWindowBackgroundEnvironmentRevision
                observedWindowBackgroundEnvironmentRevision = background.environmentRevision
                if (changed && background.reduceTransparency == 0u32 && background.actualMode == 2u32 &&
                    background.fallbackReason == 2u32) {
                    windowBackgroundRecoveryRequested = true
                    requestRefresh()
                }
            }
        }
        this.endOwnerTracePhase(2u32, nativeStateSpan)
        startupPhase = "viewport"
        let viewportSpan = this.beginOwnerTracePhase(3u32)
        let viewport = internalRendererComposableViewport(sessionToken)
        this.endOwnerTracePhase(3u32, viewportSpan)
        if (viewport.status != CJGUI_INTERNAL_RENDERER_OK || viewport.width == 0u32 || viewport.height == 0u32) {
            cancelPreparedCandidate("viewport_unavailable")
            return noteRefreshFailure(if (viewport.status == CJGUI_INTERNAL_RENDERER_OK) {
                CJGUI_INTERNAL_RENDERER_INTERNAL_ERROR
            } else {
                viewport.status
            })
        }
        let declaredVersion = controller.uiSceneVersion()
        if (let Some(candidate) <- staticLayoutPreparation) {
            if (!staticLayoutBasisMatches(candidate, viewport, declaredVersion)) {
                recordCandidateLifecycle("invalidate", staticLayoutBasisChangeReason(candidate, viewport, declaredVersion))
                cancelPreparedCandidate("static_layout_basis_changed")
                return syncProjection(viewport, controller.uiSceneVersion())
            }
            return advanceStaticLayoutPreparation(candidate)
        }
        if (let Some(candidate) <- preparingCandidate) {
            if (candidate.session != sessionToken || candidate.previousScene.version != nativeInputScene.version ||
                !this.preparationDeclarationMatches(candidate.declaredVersion, candidate.preparationDependency, declaredVersion) ||
                candidate.businessOwnerRevision != currentBusinessOwnerRevision() ||
                (candidate.requestEpoch != refreshRequestEpoch && candidate.viewportDemandEpoch != refreshRequestEpoch) ||
                candidate.bindingEpoch != textSessionBindingEpoch ||
                candidate.focus != (focusedNodeId, focusedResourceId, focusedNodeKind) ||
                candidate.viewport.resizeVersion != viewport.resizeVersion ||
                candidate.viewport.resourceCompletionVersion != viewport.resourceCompletionVersion ||
                !preparedSelectionAndViewportBasisMatches(candidate)) {
                recordCandidateLifecycle("invalidate", preparedCandidateBasisChangeReason(candidate, viewport, declaredVersion))
                cancelPreparedCandidate("owner_or_view_changed")
                // Rollback may legitimately advance the participant's UI revision.
                return syncProjection(viewport, controller.uiSceneVersion())
            }
            if (candidate.packet.ready && !preparedPreserveBasisStillMatches(candidate)) {
                cancelPreparedCandidate("preserve_basis_changed")
                return syncProjection(viewport, controller.uiSceneVersion())
            }
            if (let Some(budget) <- ownerTurnBudget) {
                // Reentrant host calls cannot combine both expensive phases
                // into the original owner turn, even after a credited idle wait.
                if (!budget.isActive()) { return false }
                if (budget.isActive() && candidate.preparedTurn == budget.turnIdentity()) { return false }
                candidate.preparedTurn = budget.turnIdentity()
                let progress = advancePreparedCandidate(candidate, budget)
                recordCandidateLifecycle(if (progress == 1) { "ready" } else { "retain" },
                    "native_preparation_progress_${progress}")
                if (progress == 0 || progress == 3) { return false }
                if (candidate.packet.ready && !preparedPreserveBasisStillMatches(candidate)) {
                    cancelPreparedCandidate("preserve_basis_changed")
                    return syncProjection(viewport, controller.uiSceneVersion())
                }
                // Ready does not reserve staging/present/accepted publication.
                // They are one indivisible transaction: retain the original
                // preparation until this SAME owner allowance admits its tail.
                // No idle or retry is inserted; hasPreparedWork keeps the host
                // demand active and input is drained against the accepted scene.
                if (!this.ownerBudgetAdmits(14000, "prepared_submit")) {
                    recordCandidateLifecycle("retain", "ready_submit_allowance")
                    return false
                }
                preparingCandidate = None
                budget.releasePreparedOwner(sessionToken)
                if (candidate.packet.syncFallback) {
                    let traceStatus = if (candidate.packet.unsupportedReason == "native_begin_unsupported" ||
                        candidate.packet.unsupportedReason == "native_node_unsupported" ||
                        candidate.packet.unsupportedReason == "native_advance_unsupported") {
                        "prepare_sync_unsupported"
                    } else { "prepare_sync_fallback" }
                    println("CJGUI_PREPARE_TRACE preparation=${candidate.preparationId} " +
                        "status=${traceStatus} reason=${candidate.packet.unsupportedReason}")
                }
                return submitPreparedCandidate(candidate)
            }
            preparingCandidate = None
            return submitPreparedCandidate(candidate)
        }
        if (!refreshRequested && pendingRefreshReason != "none" && declaredVersion == lastAttemptedControllerSceneVersion &&
            viewport.resizeVersion == lastAttemptedViewportResizeVersion && viewport.resourceCompletionVersion ==
            lastAttemptedResourceCompletionVersion) {
            return false
        }
        if (!refreshRequested && !windowBackgroundRecoveryRequested && renderedScene.version > 0 &&
            declaredVersion == lastControllerSceneVersion &&
            viewport.resizeVersion == lastViewportResizeVersion && viewport.resourceCompletionVersion ==
            lastResourceCompletionVersion) {
            return true
        }
        lastAttemptedControllerSceneVersion = declaredVersion
        lastAttemptedViewportResizeVersion = viewport.resizeVersion
        lastAttemptedResourceCompletionVersion = viewport.resourceCompletionVersion
        startupPhase = "scene_sync"
        let synced = syncProjection(viewport, declaredVersion)
        return synced
        } finally {
            this.traceOwnerPhase("refresh", phaseStarted)
        }
    }

    public func pump(timeoutMs: UInt32): CjguiComposableUiWindowPumpResult {
        return pumpWithRefreshPolicy(timeoutMs, true)
    }

    // Application turns drain every window's accepted FIFO before beginning
    // any potentially expensive scene preparation. Public pump keeps its
    // synchronous refresh semantics for direct callers.
    func pumpEventsWithoutRefresh(timeoutMs: UInt32): CjguiComposableUiWindowPumpResult {
        return pumpWithRefreshPolicy(timeoutMs, false)
    }

    func hasDeferredEventWork(): Bool {
        return deferredEventWork
    }

    func refreshAfterDeferredPump(): Bool {
        let refreshed = refreshIfNeeded()
        if (deferredInteractionPaint && isWindowOpen) {
            if (refreshInteractionPaintIfNeeded()) { deferredInteractionPaint = false }
        }
        if (!activationPrefixPending() && !deferredInteractionPaint && refreshed) { deferredEventWork = false }
        return refreshed
    }

    // ===================== P2 动效公共入口 =====================

    /// 对 accepted 节点设置 paint 透明度目标。只改变节点 paint 的 alpha：
    /// 不触发布局、文本测量、图片解码或控制器回调。首次绑定从当前呈现值
    /// 1.0 起步；再次调用是改目标，从中途的当前视觉值继续（补间重新起步、
    /// 弹簧保留速度）。
    ///
    /// `identityKey` 与手写/生成/注册组合消费者使用的同一稳定身份（语义 id
    /// 或 scoped canonical key）。`atTime` 是显式单调时间，供确定性测试复用
    /// 同一推进序列。
    ///
    /// `acceptedToken` 供异步调用方携带发起时的槽位身份：若 accepted 已换绑，
    /// 携带旧 token 的调用会因与当前槽位不一致而被拒绝，不会落到新实例。
    public func animateNodeOpacity(identityKey: String, targetOpacity: Float64,
        spec!: CjguiComposableUiAnimationSpec = CjguiComposableUiAnimationSpec.spring(), atTime!: MonoTime,
        acceptedToken!: ?CjguiComposableUiAnimationBinding = None): Bool {
        if (!isWindowOpen || identityKey.size == 0) {
            return false
        }
        if (let Some(binding) <- acceptedBindingForAnimationIdentity(identityKey)) {
            if (let Some(expected) <- acceptedToken) {
                if (!expected.matches(binding)) {
                    return false
                }
            }
            let started = animationDriver.animateOpacity(identityKey, binding.nodeId, targetOpacity, spec: spec,
                nowMs: animationNowMs(atTime), resourceId: binding.resourceId, nodeKind: binding.nodeKind,
                actionName: binding.actionName, operationActionName: binding.operationActionName,
                operationResourceId: binding.operationResourceId, fieldId: binding.fieldId, token: acceptedToken,
                acceptedBindingEpoch: binding.acceptedBindingEpoch)
            if (!started) {
                return false
            }
            // 零时长补间 / 减少动态效果：通道创建即完成（inactive），普通模式的
            // 下一帧不会再报 changed，所以必须在这里立即提交终值。提交失败时脏
            // 标记保留，后续任一帧靠 hasPendingPresentation 可靠重试。
            if (animationDriver.reduceMotion() || !animationDriver.isActiveFor(identityKey)) {
                let _ = presentAnimationValueOrKeepPending()
            }
            return true
        }
        return false
    }

    /// 以窗口已接受的节点引用（手工 node id 或 scoped 身份）绑定同一动效。
    public func animateNodeOpacity(reference: CjguiComposableUiNodeReference, targetOpacity: Float64,
        spec!: CjguiComposableUiAnimationSpec = CjguiComposableUiAnimationSpec.spring(), atTime!: MonoTime): Bool {
        if (!isWindowOpen || !reference.isValid()) {
            return false
        }
        let nodeId = identityRegistry.acceptedNodeIdForReference(reference)
        if (nodeId < 0) {
            return false
        }
        let node = nativeInputScene.nodeForId(nodeId)
        if (node.nodeId != nodeId) {
            return false
        }
        return animateNodeOpacity(node.identityKey, targetOpacity, spec: spec, atTime: atTime)
    }

    /// Animate only the accepted isolated effect group's opacity. This channel
    /// is independent from node paint opacity and is applied once to the
    /// group's flattened subtree by the renderer.
    public func animateEffectGroupOpacity(identityKey: String, targetOpacity: Float64,
        spec!: CjguiComposableUiAnimationSpec = CjguiComposableUiAnimationSpec.spring(), atTime!: MonoTime,
        acceptedToken!: ?CjguiComposableUiAnimationBinding = None): Bool {
        if (!isWindowOpen || identityKey.size == 0) { return false }
        if (let Some(binding) <- acceptedEffectGroupBindingTable.get(identityKey)) {
            if (let Some(expected) <- acceptedToken) {
                if (!expected.matches(binding)) { return false }
            }
            let acceptedNode = nativeInputScene.nodeForId(binding.nodeId)
            if (acceptedNode.nodeId != binding.nodeId) { return false }
            let baseOpacity = match (acceptedNode.declaredStyle.effectGroup) {
                case Some(group) => group.opacity
                case None => return false
            }
            let started = animationDriver.animateEffectGroupOpacity(identityKey, binding.nodeId, baseOpacity,
                targetOpacity, spec: spec, nowMs: animationNowMs(atTime), resourceId: binding.resourceId,
                nodeKind: binding.nodeKind, actionName: binding.actionName,
                operationActionName: binding.operationActionName, operationResourceId: binding.operationResourceId,
                fieldId: binding.fieldId, token: acceptedToken, acceptedBindingEpoch: binding.acceptedBindingEpoch)
            if (!started) { return false }
            if (animationDriver.reduceMotion() || !animationDriver.isEffectGroupActiveFor(identityKey)) {
                let _ = presentAnimationValueOrKeepPending()
            }
            return true
        }
        return false
    }

    /// Animate an accepted node's local post-layout translation in logical
    /// points. The value replaces that node's declared translateX/Y for the
    /// current picture; its ancestor motion is accumulated once by the scene.
    /// `acceptedToken` rejects an async request after rebinding. Experimental.
    public func animateNodeTranslation(identityKey: String, targetX: Float64, targetY: Float64,
        spec!: CjguiComposableUiAnimationSpec = CjguiComposableUiAnimationSpec.spring(), atTime!: MonoTime,
        acceptedToken!: ?CjguiComposableUiAnimationBinding = None): Bool {
        if (!isWindowOpen || identityKey.size == 0) { return false }
        if (let Some(binding) <- acceptedBindingForAnimationIdentity(identityKey)) {
            if (let Some(expected) <- acceptedToken) {
                if (!expected.matches(binding)) { return false }
            }
            let node = nativeInputScene.nodeForId(binding.nodeId)
            if (node.nodeId != binding.nodeId || node.identityKey != identityKey) { return false }
            if (!positionTargetGeometryAllowed(identityKey, targetX, targetY)) { return false }
            let started = animationDriver.animatePosition(identityKey, binding,
                CjguiComposableUiPositionValue(node.style.translateX, node.style.translateY),
                CjguiComposableUiPositionValue(targetX, targetY), spec, animationNowMs(atTime))
            if (!started) { return false }
            notePositionMotionRequest(identityKey, "set")
            if (animationDriver.reduceMotion() || !animationDriver.isPositionActiveFor(identityKey)) {
                let _ = presentAnimationValueOrKeepPending()
            }
            return true
        }
        return false
    }

    private func positionTargetGeometryAllowed(identityKey: String, targetX: Float64, targetY: Float64,
        removing!: Bool = false): Bool {
        if (!cjguiAnimationIsFiniteScalar(targetX) || !cjguiAnimationIsFiniteScalar(targetY) ||
            targetX < -1024.0 || targetX > 1024.0 || targetY < -1024.0 || targetY > 1024.0) { return false }
        let replacement: ?CjguiComposableUiPositionValue = if (removing) { None } else {
            Some(CjguiComposableUiPositionValue(targetX, targetY))
        }
        if (!positionTargetGeometryAllowedInScene(nativeInputScene, acceptedAnimationBindingTable,
            identityKey, replacement, removing)) { return false }
        if (let Some(pending) <- pendingTransaction) {
            if (!positionTargetGeometryAllowedInScene(pending.paintScene, stagedAnimationBindingTable,
                identityKey, replacement, removing, originRebased: true)) { return false }
        }
        return true
    }

    /// Evaluate the entire effective target picture, using declarations as the
    /// base. The accepted picture's current intermediate samples are not target
    /// values and cannot establish the validity of another request.
    private func positionTargetGeometryAllowedInScene(scene: CjguiComposableUiScene,
        bindings: HashMap<String, CjguiComposableUiAnimationBinding>, identityKey: String,
        replacement: ?CjguiComposableUiPositionValue, removing: Bool, originRebased!: Bool = false): Bool {
        let nodes = ArrayList<CjguiComposableUiLayoutNode>()
        for (node in scene.nodes()) {
            var target = CjguiComposableUiPositionValue(node.declaredStyle.translateX,
                node.declaredStyle.translateY)
            if (let Some(binding) <- bindings.get(node.identityKey)) {
                if (node.identityKey == identityKey) {
                    // A staged scene may reuse a key for a new semantic
                    // incarnation. Keep this request on its accepted binding.
                    if (!removing) {
                        if (let Some(accepted) <- acceptedAnimationBindingTable.get(identityKey)) {
                            if (accepted.matches(binding)) { target = replacement ?? target }
                        }
                    }
                } else if (animationDriver.positionSampleFor(node.identityKey, binding).isSome()) {
                    target = animationDriver.positionTargetFor(node.identityKey) ?? target
                }
                if (originRebased) {
                    if (let Some(rebase) <- stagedPositionOriginRebases.get(node.identityKey)) {
                        if (rebase.ticket.binding.matches(binding)) {
                            target = CjguiComposableUiPositionValue(target.x + rebase.compensation.x,
                                target.y + rebase.compensation.y)
                        }
                    }
                }
            }
            nodes.add(node.withResolvedPaintStyle(cjguiComposableUiStyleWithTranslation(node.declaredStyle,
                target.x, target.y)))
        }
        return CjguiComposableUiScene(scene.version, scene.viewport, nodes).isValid()
    }

    public func animateNodeTranslation(reference: CjguiComposableUiNodeReference, targetX: Float64,
        targetY: Float64, spec!: CjguiComposableUiAnimationSpec = CjguiComposableUiAnimationSpec.spring(),
        atTime!: MonoTime): Bool {
        if (!isWindowOpen || !reference.isValid()) { return false }
        let nodeId = identityRegistry.acceptedNodeIdForReference(reference)
        if (nodeId < 0) { return false }
        let node = nativeInputScene.nodeForId(nodeId)
        if (node.nodeId != nodeId) { return false }
        return animateNodeTranslation(node.identityKey, targetX, targetY, spec: spec, atTime: atTime)
    }

    /// Stop at the last accepted location. Clearing instead restores the
    /// accepted declaration's translation on the next picture.
    public func stopNodeTranslationAnimation(identityKey: String, atTime!: MonoTime): Bool {
        if (pendingTransaction.isSome() && stagedPositionOriginRebases.get(identityKey).isSome()) { return false }
        let accepted = match (animationDriver.positionAcceptedFor(identityKey)) {
            case Some(value) => value
            case None => return false
        }
        if (!positionTargetGeometryAllowed(identityKey, accepted.x, accepted.y)) { return false }
        if (!isWindowOpen || !animationDriver.stopPositionAtAccepted(identityKey, animationNowMs(atTime))) {
            return false
        }
        notePositionMotionRequest(identityKey, "stop")
        let _ = presentAnimationValueOrKeepPending()
        return true
    }

    public func cancelNodeTranslationAnimation(identityKey: String): Bool {
        if (pendingTransaction.isSome() && stagedPositionOriginRebases.get(identityKey).isSome()) { return false }
        if (!positionTargetGeometryAllowed(identityKey, 0.0, 0.0, removing: true)) { return false }
        if (!isWindowOpen || !animationDriver.cancelPosition(identityKey)) { return false }
        notePositionMotionRequest(identityKey, "clear")
        if (pendingTransaction.isNone() && !drainingInputEvents) { let _ = refreshInteractionPaintIfNeeded() }
        return true
    }

    public func animatedNodeTranslation(identityKey: String): ?CjguiComposableUiPositionStatus {
        if (let Some(binding) <- acceptedBindingForAnimationIdentity(identityKey)) {
            if (let Some(target) <- animationDriver.positionTargetFor(identityKey)) {
                if (let Some(presented) <- animationDriver.positionAcceptedFor(identityKey)) {
                    return Some(CjguiComposableUiPositionStatus(target, presented, binding, windowSessionIdentity,
                        nativeInputScene.version, submittedFrameIndex,
                        animationDriver.isPositionActiveFor(identityKey),
                        originTicket: positionOriginTicketFor(identityKey, binding)))
                }
            }
        }
        return None
    }

    private func positionOriginTicketFor(identityKey: String,
        binding: CjguiComposableUiAnimationBinding): ?CjguiComposableUiPositionOriginTicket {
        if (let Some(state) <- animationDriver.positionOriginStateFor(identityKey, binding)) {
            return Some(CjguiComposableUiPositionOriginTicket(identityKey, binding, windowSessionIdentity,
                nativeInputScene.version, Int64(lastViewportResizeVersion), state.channelGeneration,
                state.originRevision, positionRequestRevisions.get(identityKey) ?? 0))
        }
        return None
    }

    /// Attach a coordinate compensation to the full candidate being built.
    /// "staged" is admission, not acceptance; rejection discards the attachment.
    /// The window issues the opaque ticket from animatedNodeTranslation.
    /// Stability: experimental.
    public func stageNodeTranslationOriginRebase(ticket: CjguiComposableUiPositionOriginTicket,
        compensationX: Float64, compensationY: Float64): String {
        if (!isWindowOpen || !originRebaseCandidateOpen || pendingTransaction.isSome()) {
            return "candidate_required"
        }
        if (ticket.sessionIdentity != windowSessionIdentity || ticket.acceptedSceneVersion != nativeInputScene.version) {
            return "accepted_scene_stale"
        }
        if (ticket.geometryRevision != originRebaseCandidateResizeVersion) { return "geometry_stale" }
        let binding = match (acceptedAnimationBindingTable.get(ticket.identityKey)) {
            case Some(value) => value
            case None => return "binding_missing"
        }
        if (!ticket.binding.matches(binding)) { return "binding_stale" }
        if (ticket.requestRevision != (positionRequestRevisions.get(ticket.identityKey) ?? 0)) {
            return "request_stale"
        }
        let state = match (animationDriver.positionOriginStateFor(ticket.identityKey, binding)) {
            case Some(value) => value
            case None => return "channel_missing"
        }
        if (state.channelGeneration != ticket.channelGeneration || state.originRevision != ticket.originRevision) {
            return "origin_stale"
        }
        if (!cjguiAnimationIsFiniteScalar(compensationX) || !cjguiAnimationIsFiniteScalar(compensationY)) {
            return "compensation_invalid"
        }
        if (!animationDriver.canRebasePositionOrigin(ticket.identityKey, binding,
            CjguiComposableUiPositionValue(compensationX, compensationY))) { return "compensation_out_of_bounds" }
        let presented = animationDriver.positionAcceptedFor(ticket.identityKey) ?? CjguiComposableUiPositionValue(0.0, 0.0)
        let target = animationDriver.positionTargetFor(ticket.identityKey) ?? presented
        if (abs(presented.x + compensationX) > 1024.0 || abs(presented.y + compensationY) > 1024.0 ||
            abs(target.x + compensationX) > 1024.0 || abs(target.y + compensationY) > 1024.0) {
            return "compensation_out_of_bounds"
        }
        let rebase = CjguiComposableUiPositionOriginRebase(ticket,
            CjguiComposableUiPositionValue(compensationX, compensationY))
        if (let Some(previous) <- stagedPositionOriginRebases.get(ticket.identityKey)) {
            return if (previous.matches(rebase)) { "staged" } else { "candidate_conflict" }
        }
        let _ = stagedPositionOriginRebases.add(ticket.identityKey, rebase)
        return "staged"
    }

    private func notePositionMotionRequest(identityKey: String, mode: String): Unit {
        positionRequestCounter += 1
        positionRequestRevisions.add(identityKey, positionRequestCounter)
        positionRequestModes.add(identityKey, mode)
    }

    /// An application opts in exact accepted identities before giving an
    /// external client the position-motion capability. No arbitrary node in a
    /// window becomes externally movable merely because it is discoverable.
    public func exposeAcceptedPositionMotionTarget(identityKey: String): Bool {
        if (!isWindowOpen || identityKey.size == 0 || identityKey.size > 128) { return false }
        let binding = match (acceptedBindingForAnimationIdentity(identityKey)) {
            case Some(value) => value
            case None => return false
        }
        for (key in exposedPositionMotionKeys) {
            if (key == identityKey) {
                exposedPositionMotionBindings.add(identityKey, binding)
                return true
            }
        }
        if (exposedPositionMotionKeys.size >= 32) { return false }
        exposedPositionMotionKeys.add(identityKey)
        exposedPositionMotionBindings.add(identityKey, binding)
        return true
    }

    private func positionMotionKeyIsExposed(identityKey: String): Bool {
        if (let Some(exposed) <- exposedPositionMotionBindings.get(identityKey)) {
            if (let Some(current) <- acceptedBindingForAnimationIdentity(identityKey)) {
                return exposed.matches(current)
            }
        }
        return false
    }

    public func positionMotionTargets(): ArrayList<Int64> {
        let targets = ArrayList<Int64>()
        if (!isWindowOpen) { return targets }
        for (node in nativeInputScene.nodes()) {
            if (positionMotionKeyIsExposed(node.identityKey)) { targets.add(node.nodeId) }
        }
        return targets
    }

    public func positionMotionRead(nodeId: Int64): ?CjguiSharedOperationPositionMotionFact {
        if (!isWindowOpen || nodeId < 0) { return None }
        let node = nativeInputScene.nodeForId(nodeId)
        if (node.nodeId != nodeId || !positionMotionKeyIsExposed(node.identityKey)) { return None }
        let binding = match (acceptedBindingForAnimationIdentity(node.identityKey)) {
            case Some(value) => value
            case None => return None
        }
        let revision = positionRequestRevisions.get(node.identityKey) ?? 0
        let acceptedRevision = acceptedPositionRequestRevisions.get(node.identityKey) ?? 0
        let mode = positionRequestModes.get(node.identityKey) ?? "declaration"
        let target = animationDriver.positionTargetFor(node.identityKey) ??
            CjguiComposableUiPositionValue(node.declaredStyle.translateX, node.declaredStyle.translateY)
        let token = "${windowSessionIdentity}|${nativeInputScene.version}|" +
            "${binding.acceptedBindingEpoch}|${revision}|${node.nodeId}"
        return Some(CjguiSharedOperationPositionMotionFact(node.nodeId, node.resourceId, node.semanticId,
            windowSessionIdentity, token, revision, acceptedRevision, mode, target.x, target.y,
            node.style.translateX, node.style.translateY, node.declaredStyle.translateX,
            node.declaredStyle.translateY, nativeInputScene.version, submittedFrameIndex,
            animationDriver.isPositionActiveFor(node.identityKey),
            revision > acceptedRevision || animationDriver.isPositionActiveFor(node.identityKey) ||
                target.x != node.style.translateX || target.y != node.style.translateY,
            positionLastFailure.get(node.identityKey) ?? "none"))
    }

    public func positionMotionSet(nodeId: Int64, casToken: String, x: Float64, y: Float64,
        motionReference: String): CjguiSharedOperationPositionMotionDecision {
        let current = positionMotionRead(nodeId)
        let fact = match (current) {
            case Some(value) => value
            case None => return CjguiSharedOperationPositionMotionDecision(false,
                if (isWindowOpen) { "target_unavailable" } else { "window_closed" }, None)
        }
        if (casToken != fact.casToken) {
            return CjguiSharedOperationPositionMotionDecision(false, "version_conflict", current)
        }
        let spec = match (CjguiGeneratedMotionRegistry.specFor(motionReference)) {
            case Some(value) => value
            case None => return CjguiSharedOperationPositionMotionDecision(false, "unknown_motion_reference", current)
        }
        if (!cjguiAnimationIsFiniteScalar(x) || !cjguiAnimationIsFiniteScalar(y) ||
            x < -1024.0 || x > 1024.0 || y < -1024.0 || y > 1024.0) {
            return CjguiSharedOperationPositionMotionDecision(false, "invalid_target_geometry", current)
        }
        let acceptedToken = acceptedAnimationBindingToken(nativeInputScene.nodeForId(nodeId).identityKey)
        if (!animateNodeTranslation(nativeInputScene.nodeForId(nodeId).identityKey, x, y,
            spec: spec, atTime: MonoTime.now(), acceptedToken: acceptedToken)) {
            return CjguiSharedOperationPositionMotionDecision(false, "invalid_target_geometry", current)
        }
        return CjguiSharedOperationPositionMotionDecision(true, "none", positionMotionRead(nodeId))
    }

    public func positionMotionClear(nodeId: Int64, casToken: String): CjguiSharedOperationPositionMotionDecision {
        let current = positionMotionRead(nodeId)
        let fact = match (current) {
            case Some(value) => value
            case None => return CjguiSharedOperationPositionMotionDecision(false,
                if (isWindowOpen) { "target_unavailable" } else { "window_closed" }, None)
        }
        if (casToken != fact.casToken) {
            return CjguiSharedOperationPositionMotionDecision(false, "version_conflict", current)
        }
        if (!cancelNodeTranslationAnimation(nativeInputScene.nodeForId(nodeId).identityKey)) {
            let key = nativeInputScene.nodeForId(nodeId).identityKey
            return CjguiSharedOperationPositionMotionDecision(false,
                if (animationDriver.positionTargetFor(key).isSome()) { "invalid_target_geometry" } else { "motion_absent" }, current)
        }
        return CjguiSharedOperationPositionMotionDecision(true, "none", positionMotionRead(nodeId))
    }

    func testRejectNextPositionPresentation(): Unit {
        testPositionPresentFailuresRemaining += 1
    }

    func testHoldNextComposablePresent(): Bool {
        return isWindowOpen &&
            internalRendererTestHoldNextComposablePresent(sessionToken) == CJGUI_INTERNAL_RENDERER_OK
    }

    func testResolvePendingComposablePresent(): Bool {
        return pendingTransaction.isSome() &&
            internalRendererTestResolvePendingComposablePresent(sessionToken) == CJGUI_INTERNAL_RENDERER_OK
    }
    func testSelectionRestoreAttemptCount(): Int64 {
        return pendingSelectionRestoreAttempts
    }

    /// 取消一个身份上的动效，恢复该节点为它的 accepted 样式 paint。返回真表示
    /// 确有绑定被取消。
    public func cancelNodeOpacityAnimation(identityKey: String): Bool {
        if (!animationDriver.cancel(identityKey)) {
            return false
        }
        let _ = refreshInteractionPaintIfNeeded()
        return true
    }

    /// Cancel the accepted effect group channel and restore its accepted opacity.
    public func cancelEffectGroupOpacityAnimation(identityKey: String): Bool {
        if (!animationDriver.cancelEffectGroupOpacity(identityKey)) { return false }
        let _ = refreshInteractionPaintIfNeeded()
        return true
    }

    /// 推进本窗所有活动动效。返回推进后是否仍需要为本窗申请下一次动画机会
    /// （有活动通道，或有尚未成功提交的终值）。有可见变化时走一次 paint-only
    /// 提交，不触发布局/测量/解码。
    ///
    /// 暂停时不推进、不提交、也不重建身份表，并直接报告“不需要下一次机会”，
    /// 宿主因此不再按动画帧预算唤醒本窗。
    public func advanceAnimations(atTime!: MonoTime): Bool {
        return advanceAnimationsAtMs(animationNowMs(atTime))
    }

    /// 以显式毫秒时间推进所有通道。生产入口用单调时钟换算的毫秒；确定性测试
    /// 直接用固定毫秒序列驱动同一条路径，不依赖真实时钟。
    private func advanceAnimationsAtMs(nowMs: Float64): Bool {
        if (!isWindowOpen || this.closeStopsNewOwnerWork()) {
            return false
        }
        if (animationDriver.isPaused()) {
            return false
        }
        let hadActive = animationDriver.hasActive()
        let changed = animationDriver.advance(nowMs)

        // 仅在活动期间或刚静止的那一帧校验绑定存活：静止后不再每帧重建身份
        // 表，也不产生无关分配。只有 accepted 场景能判定绑定是否仍存活，被拒
        // 候选不改变 nativeInputScene，因此不会取消或污染当前动画。
        if (animationDriver.boundCount() > 0 && (changed || hadActive)) {
            animationDriver.reconcileAccepted(acceptedAnimationBindings())
        }
        // 提交条件不止“本帧数值变了”：reduce-motion 收敛、零时长补间，以及上一
        // 帧提交失败的终值都靠 pending 标记驱动，保证终值一定落到画面（失败则
        // 保留脏标记并在后续帧重试，旧画面保持有效）。
        if (changed || animationDriver.hasPendingPresentation()) {
            let _ = presentAnimationValueOrKeepPending()
        }
        return animationDriver.needsTick()
    }

    /// 调度是否需要为本窗申请下一次动画机会：有活动通道，或有未提交的终值。
    /// 暂停或窗口关闭时为假，宿主不再按动画帧预算唤醒本窗。
    public func needsAnimationTick(): Bool {
        return isWindowOpen && !this.closeStopsNewOwnerWork() && animationDriver.needsTick()
    }

    /// 提交一次动效视觉投影。成功清除驱动的未提交标记；失败则保留，使后续帧
    /// （needsAnimationTick 仍为真）可靠重试，并保持上次有效画面。
    private func presentAnimationValueOrKeepPending(): Bool {
        if (!isWindowOpen || nativeInputScene.version <= 0) {
            return false
        }
        if (drainingInputEvents) {
            deferredInteractionPaint = true
            return false
        }
        // A mutation can be queued while the old native ticket is unresolved.
        // Do not settle it as a side effect of the new request; the next pump
        // settles the original picture, then presents the current intent.
        if (pendingTransaction.isSome()) { return false }
        if (refreshInteractionPaintIfNeeded()) {
            return true
        }
        return false
    }

    /// accepted 场景成功切换后立即清理退役绑定：动画已停止（没有活动帧）时被
    /// 移除的节点也必须在这一刻释放，否则绑定会长期残留并占用绑定上限。只有
    /// 确有条目时才构造身份表，静止且无绑定时零成本。
    ///
    /// 该 accepted scene（paintScene）本身已按当前乘子投影并由 native 受理，因此
    /// 无论是否仍有绑定，此前的"未提交终值"都已经被这个 scene 表达：在这里确认
    /// pending，避免"暂停中接受换绑/终值已随普通 scene 提交"之后恢复出无意义的
    /// 动画 tick。候选被拒不会走到本函数，pending 因而在拒绝路径上被保留。
    private func reconcileAnimationBindingsAfterAcceptedChange(): Unit {
        commitStagedAnimationPaint()
    }

    public func hasActiveAnimations(): Bool {
        return animationDriver.hasActive()
    }

    public func activeAnimationCount(): Int64 {
        return animationDriver.activeCount()
    }

    public func animationBindingCount(): Int64 {
        return animationDriver.boundCount()
    }

    /// 当前呈现的 paint alpha 乘子（已夹在 [0,1]）；未绑定时为 None。
    public func animatedNodeOpacity(identityKey: String): ?Float64 {
        return animationDriver.presentedFor(identityKey)
    }

    /// 动画目标 alpha；未绑定时为 None。它与 accepted 样式目标、业务目标分开
    /// 归属，外部只读这一事实，不需要每帧广播。
    public func animatedNodeOpacityTarget(identityKey: String): ?Float64 {
        return animationDriver.targetFor(identityKey)
    }

    public func animatedEffectGroupOpacity(identityKey: String): ?Float64 {
        return animationDriver.effectGroupOpacityPresented(identityKey)
    }

    public func animatedEffectGroupOpacityTarget(identityKey: String): ?Float64 {
        return animationDriver.effectGroupOpacityTarget(identityKey)
    }

    /// Read the accepted interaction-color channel through this window's
    /// binding generation. A retired or candidate-only identity has no value.
    public func interactionPaintPresented(identityKey: String): ?CjguiComposableUiPaintColorSet {
        if (let Some(binding) <- acceptedBindingForAnimationIdentity(identityKey)) {
            return animationDriver.paintColorFor(identityKey, binding.nodeId, resourceId: binding.resourceId,
                nodeKind: binding.nodeKind, actionName: binding.actionName,
                operationActionName: binding.operationActionName, operationResourceId: binding.operationResourceId,
                fieldId: binding.fieldId, acceptedBindingEpoch: binding.acceptedBindingEpoch)
        }
        return None
    }

    public func interactionPaintTarget(identityKey: String): ?CjguiComposableUiPaintColorSet {
        if (let Some(binding) <- acceptedBindingForAnimationIdentity(identityKey)) {
            return animationDriver.paintColorTargetFor(identityKey, binding.nodeId, resourceId: binding.resourceId,
                nodeKind: binding.nodeKind, actionName: binding.actionName,
                operationActionName: binding.operationActionName, operationResourceId: binding.operationResourceId,
                fieldId: binding.fieldId, acceptedBindingEpoch: binding.acceptedBindingEpoch)
        }
        return None
    }

    public func interactionPaintActive(identityKey: String): Bool {
        if (let Some(binding) <- acceptedBindingForAnimationIdentity(identityKey)) {
            return animationDriver.isColorActiveFor(identityKey, binding.nodeId, resourceId: binding.resourceId,
                nodeKind: binding.nodeKind, actionName: binding.actionName,
                operationActionName: binding.operationActionName, operationResourceId: binding.operationResourceId,
                fieldId: binding.fieldId, acceptedBindingEpoch: binding.acceptedBindingEpoch)
        }
        return false
    }

    /// 暂停/恢复本窗动效。暂停不推进也不申请帧；恢复用显式时间继续。
    public func setAnimationsPaused(paused: Bool): Unit {
        animationDriver.setPaused(paused)
    }

    public func animationsPaused(): Bool {
        return animationDriver.isPaused()
    }

    /// 接入 macOS“减少动态效果”偏好。开启时已有活动动画立即确定收敛；返回
    /// 真表示偏好状态发生变化。
    public func setReduceMotionEnabled(enabled: Bool): Bool {
        return animationDriver.setReduceMotion(enabled)
    }

    public func reduceMotionEnabled(): Bool {
        return animationDriver.reduceMotion()
    }

    /// The host offers a value-only platform fact. A pending native candidate
    /// keeps its original controller projection; the new palette is delivered
    /// to the controller only after that ticket settles.
    public func offerPlatformColorScheme(scheme: CjguiComposableUiColorScheme): Bool {
        let token = CjguiComposableUiPlatformStateCodec.colorSchemeToken(scheme)
        if (token == deliveredPlatformColorSchemeToken && pendingPlatformColorScheme.isNone()) {
            return false
        }
        pendingPlatformColorScheme = Some(scheme)
        return deliverPendingPlatformColorScheme()
    }

    private func deliverPendingPlatformColorScheme(): Bool {
        if (pendingTransaction.isSome()) {
            return false
        }
        let scheme = match (pendingPlatformColorScheme) {
            case Some(value) => value
            case None => return false
        }
        let token = CjguiComposableUiPlatformStateCodec.colorSchemeToken(scheme)
        if (token == deliveredPlatformColorSchemeToken) {
            pendingPlatformColorScheme = None
            return false
        }
        if (let Some(consumer) <- (controller as CjguiComposableUiPlatformThemeConsumer)) {
            let _ = consumer.applyPlatformColorScheme(scheme)
            requestRefresh()
        } else if (acceptedWindowBackgroundToken == CjguiWindowBackgroundPolicy.SYSTEM_CONTENT_AREA) {
            // The material host still needs the resolved system appearance
            // even when this controller has no theme-specific content.
            requestRefresh()
        }
        deliveredPlatformColorSchemeToken = token
        pendingPlatformColorScheme = None
        return true
    }

    /// The host samples the system on its AppKit turn. The tracker retains the
    /// last successful sRGB8 value if conversion fails; a failed read never
    /// pushes an invented color into application paint.
    public func observeSystemAccent(): Bool {
        let changed = platformAccentTracker.observeSystem()
        if (changed) { let _ = offerEffectiveAccent() }
        return changed
    }

    /// Deterministic platform-source seam for controlled tests and alternate
    /// hosts. Native reports -1 for unavailable and 0x1000000|RRGGBB otherwise.
    public func observeAccentPacked(packed: Int64): Bool {
        let changed = platformAccentTracker.observePacked(packed)
        if (changed) { let _ = offerEffectiveAccent() }
        return changed
    }

    public func selectAccentPreference(token: String): Bool {
        let choice = match (CjguiComposableUiAccentPreference.fromToken(token)) {
            case Some(value) => value
            case None => return false
        }
        let oldFixed = match (accentPreference.fixedColor) {
            case Some(value) => cjguiComposableUiColorToken(value)
            case None => ""
        }
        let newFixed = match (choice.fixedColor) {
            case Some(value) => cjguiComposableUiColorToken(value)
            case None => ""
        }
        if (choice.source == accentPreference.source && newFixed == oldFixed) {
            return false
        }
        accentPreference = choice
        let _ = offerEffectiveAccent()
        return true
    }

    private func offerEffectiveAccent(): Bool {
        let color = match (accentPreference.effectiveColor(platformAccentTracker)) {
            case Some(value) => value
            case None => return false
        }
        let token = cjguiComposableUiColorToken(color)
        let source = accentPreference.effectiveSource(platformAccentTracker)
        if (token == deliveredPlatformAccentToken && source == deliveredPlatformAccentSource &&
            pendingPlatformAccentColor.isNone()) { return false }
        pendingPlatformAccentColor = Some(color)
        pendingPlatformAccentSource = source
        platformAccentDeliveryFailure = ""
        return deliverPendingPlatformAccent()
    }

    private func deliverPendingPlatformAccent(): Bool {
        if (pendingTransaction.isSome()) { return false }
        let color = match (pendingPlatformAccentColor) {
            case Some(value) => value
            case None => return false
        }
        let token = cjguiComposableUiColorToken(color)
        let source = pendingPlatformAccentSource
        pendingPlatformAccentColor = None
        pendingPlatformAccentSource = ""
        if (token == deliveredPlatformAccentToken && source == deliveredPlatformAccentSource) { return false }
        if (let Some(consumer) <- (controller as CjguiComposableUiPlatformAccentConsumer)) {
            if (!consumer.applyPlatformAccentColor(color, source)) {
                platformAccentDeliveryFailure = "consumer_rejected"
                return false
            }
            deliveredPlatformAccentToken = token
            deliveredPlatformAccentSource = source
            requestRefresh()
            return true
        }
        platformAccentDeliveryFailure = "no_consumer"
        return false
    }

    private func promoteAcceptedAccent(): Unit {
        if (deliveredPlatformAccentToken.size > 0) {
            adoptedPlatformAccentToken = deliveredPlatformAccentToken
            adoptedPlatformAccentSource = deliveredPlatformAccentSource
            adoptedPlatformAccentSceneVersion = acceptedSceneVersion
        }
    }

    public func platformAccentStatus(): CjguiComposableUiPlatformAccentStatus {
        let requested = match (accentPreference.effectiveColor(platformAccentTracker)) {
            case Some(value) => cjguiComposableUiColorToken(value)
            case None => "unavailable"
        }
        return CjguiComposableUiPlatformAccentStatus(CJGUI_COMPOSABLE_UI_PLATFORM_SYSTEM_ACCENT_COLOR,
            platformAccentTracker.readStatus(), platformAccentTracker.colorToken(),
            platformAccentTracker.observationRevision(), accentPreference.source, requested,
            adoptedPlatformAccentToken, adoptedPlatformAccentSource, adoptedPlatformAccentSceneVersion,
            deliveryFailure: platformAccentDeliveryFailure)
    }

    private func animationNowMs(now: MonoTime): Float64 {
        let elapsed = now - animationEpoch
        return Float64(elapsed.toMicroseconds()) / 1000.0
    }

    /// Window-issued token for an accepted binding. Callers retaining an async
    /// request must carry this token; reconstructing seven fields from a node
    /// cannot prove the generation after A→B→A or across windows.
    public func acceptedAnimationBindingToken(identityKey: String): ?CjguiComposableUiAnimationBinding {
        return acceptedAnimationBindingTable.get(identityKey)
    }

    private func acceptedBindingForAnimationIdentity(identityKey: String): ?CjguiComposableUiAnimationBinding {
        return acceptedAnimationBindingTable.get(identityKey)
    }

    private static func animationBindingFor(node: CjguiComposableUiLayoutNode,
        windowInstanceToken!: Int64 = 0, acceptedBindingEpoch!: Int64 = 0): CjguiComposableUiAnimationBinding {
        return CjguiComposableUiAnimationBinding(node.nodeId, resourceId: node.resourceId, nodeKind: node.nodeKind,
            actionName: node.actionName, operationActionName: node.operationActionName,
            operationResourceId: node.operationResourceId, fieldId: node.fieldId,
            windowInstanceToken: windowInstanceToken, acceptedBindingEpoch: acceptedBindingEpoch)
    }

    private func acceptedAnimationBindings(): HashMap<String, CjguiComposableUiAnimationBinding> {
        return acceptedAnimationBindingTable
    }

    private func stageAnimationBindings(scene: CjguiComposableUiScene): Unit {
        stagedPaintRevision = animationDriver.presentationRevision()
        let candidate = HashMap<String, CjguiComposableUiAnimationBinding>()
        let effectGroups = HashMap<String, CjguiComposableUiAnimationBinding>()
        for (node in scene.nodes()) {
            // The native AX binding and animation token use one semantic epoch.
            // In particular, incarnation-only changes retire the old animation.
            let epoch = Int64(candidateBindingEpoch(node, scene.version))
            let binding = CjguiComposableUiWindow.animationBindingFor(node,
                windowInstanceToken: animationDriver.windowInstanceToken(), acceptedBindingEpoch: epoch)
            candidate.add(node.identityKey, binding)
            if (node.style.effectGroup.isSome()) {
                effectGroups.add(node.identityKey, binding)
            }
        }
        stagedAnimationBindingTable = candidate
        stagedEffectGroupBindingTable = effectGroups
        for ((identityKey, rebase) in stagedPositionOriginRebases) {
            let matches = if (let Some(binding) <- candidate.get(identityKey)) {
                binding.matches(rebase.ticket.binding)
            } else { false }
            if (!matches) { originRebaseCandidateFailure = "origin_binding_stale" }
        }
        stagedInteractionColorTargets = HashMap<String, CjguiComposableUiPaintColorSet>()
        stagedPositionSamples = HashMap<String, CjguiComposableUiPositionSample>()
        stagedPositionRevision = animationDriver.positionRevision()
        stagedPositionRequestRevisions = HashMap<String, Int64>()
        for ((identityKey, revision) in positionRequestRevisions) {
            if (let Some(nextBinding) <- candidate.get(identityKey)) {
                if (let Some(previousBinding) <- acceptedAnimationBindingTable.get(identityKey)) {
                    if (nextBinding.matches(previousBinding)) {
                        stagedPositionRequestRevisions.add(identityKey, revision)
                    }
                }
            }
        }
    }

    /// Pixel equality alone cannot make a color-target change semantic-only:
    /// the current animation value can equal the former submitted pixels while
    /// the new declaration has a different normal target. That declaration
    /// must replace nativeInputScene before a later paint-only frame reads it.
    private func stagedInteractionTargetsMatchAccepted(): Bool {
        for ((identityKey, target) in stagedInteractionColorTargets) {
            let binding = match (stagedAnimationBindingTable.get(identityKey)) {
                case Some(value) => value
                case None => return false
            }
            let acceptedTarget = match (animationDriver.paintColorTargetFor(identityKey, binding.nodeId,
                resourceId: binding.resourceId, nodeKind: binding.nodeKind, actionName: binding.actionName,
                operationActionName: binding.operationActionName, operationResourceId: binding.operationResourceId,
                fieldId: binding.fieldId, acceptedBindingEpoch: binding.acceptedBindingEpoch)) {
                case Some(value) => value
                case None => return false
            }
            if (!CjguiComposableUiColorChannelAnimation.sameColor(target.background, acceptedTarget.background) ||
                !CjguiComposableUiColorChannelAnimation.sameColor(target.border, acceptedTarget.border) ||
                !CjguiComposableUiColorChannelAnimation.sameColor(target.textColor, acceptedTarget.textColor)) {
                return false
            }
        }
        return true
    }

    private func stagedPositionRequestAlreadyVisible(): Bool {
        for ((identityKey, _) in stagedPositionRequestRevisions) {
            var found = false
            for (node in nativeInputScene.nodes()) {
                if (node.identityKey == identityKey) {
                    found = true
                    let target = animationDriver.positionTargetFor(identityKey) ??
                        CjguiComposableUiPositionValue(node.declaredStyle.translateX, node.declaredStyle.translateY)
                    if (node.style.translateX != target.x || node.style.translateY != target.y ||
                        animationDriver.isPositionActiveFor(identityKey)) { return false }
                }
            }
            if (!found) { return false }
        }
        return true
    }

    private func commitStagedAnimationPaint(positionPresented!: Bool = true): Unit {
        // The accepted picture contains the current presented value. New
        // targets can schedule from their active channels after this commit.
        let previousBindings = acceptedAnimationBindingTable
        acceptedAnimationBindingTable = stagedAnimationBindingTable
        acceptedEffectGroupBindingTable = stagedEffectGroupBindingTable
        retireAcceptedPositionMotionMetadata(previousBindings)
        if (animationDriver.boundCount() > 0) {
            animationDriver.reconcileAccepted(acceptedAnimationBindingTable)
            animationDriver.reconcileEffectGroupAccepted(acceptedEffectGroupBindingTable)
        }
        animationDriver.markPositionSamplesAccepted(stagedPositionSamples, stagedPositionRevision,
            originRebases: stagedPositionOriginRebases)
        animationDriver.markPresentationCommitted(revision: stagedPaintRevision)
        if (positionPresented) {
            for ((identityKey, revision) in stagedPositionRequestRevisions) {
                if (let Some(current) <- positionRequestRevisions.get(identityKey)) {
                    if (revision <= current) {
                        acceptedPositionRequestRevisions.add(identityKey, revision)
                        if (revision == current) { positionLastFailure.add(identityKey, "none") }
                    }
                }
            }
        }
        for ((identityKey, target) in stagedInteractionColorTargets) {
            if (let Some(binding) <- acceptedAnimationBindingTable.get(identityKey)) {
                let _ = animationDriver.syncInteractionPaint(identityKey, binding.nodeId, target,
                    spec: CjguiGeneratedMotionRegistry.interactionSpec(), resourceId: binding.resourceId,
                    nodeKind: binding.nodeKind, actionName: binding.actionName,
                    operationActionName: binding.operationActionName,
                    operationResourceId: binding.operationResourceId, fieldId: binding.fieldId,
                    acceptedBindingEpoch: binding.acceptedBindingEpoch)
            }
        }
        // A freshly settled baseline was already painted by this acceptance;
        // it must not request a redundant frame. Active retargets still tick.
        stagedAnimationBindingTable = HashMap<String, CjguiComposableUiAnimationBinding>()
        stagedEffectGroupBindingTable = HashMap<String, CjguiComposableUiAnimationBinding>()
        stagedInteractionColorTargets = HashMap<String, CjguiComposableUiPaintColorSet>()
        stagedPositionSamples = HashMap<String, CjguiComposableUiPositionSample>()
        stagedPositionRevision = 0
        stagedPositionOriginRebases = HashMap<String, CjguiComposableUiPositionOriginRebase>()
        originRebaseCandidateFailure = "none"
        stagedPaintRevision = 0
        stagedPositionRequestRevisions = HashMap<String, Int64>()
    }

    /// Metadata follows the accepted semantic binding, not a reusable string
    /// key. A rejected candidate never reaches this hook.
    private func retireAcceptedPositionMotionMetadata(
        previous: HashMap<String, CjguiComposableUiAnimationBinding>): Unit {
        let keptExposures = ArrayList<String>()
        let keptExposureBindings = HashMap<String, CjguiComposableUiAnimationBinding>()
        for (key in exposedPositionMotionKeys) {
            if (let Some(exposed) <- exposedPositionMotionBindings.get(key)) {
                if (let Some(current) <- acceptedAnimationBindingTable.get(key)) {
                    if (exposed.matches(current)) {
                        keptExposures.add(key)
                        keptExposureBindings.add(key, exposed)
                    }
                }
            }
        }
        exposedPositionMotionKeys = keptExposures
        exposedPositionMotionBindings = keptExposureBindings
        let keptRequests = HashMap<String, Int64>()
        let keptAccepted = HashMap<String, Int64>()
        let keptModes = HashMap<String, String>()
        let keptFailures = HashMap<String, String>()
        for ((key, revision) in positionRequestRevisions) {
            if (let Some(oldBinding) <- previous.get(key)) {
                if (let Some(current) <- acceptedAnimationBindingTable.get(key)) {
                    if (oldBinding.matches(current)) {
                        keptRequests.add(key, revision)
                        if (let Some(value) <- acceptedPositionRequestRevisions.get(key)) {
                            keptAccepted.add(key, value)
                        }
                        if (let Some(value) <- positionRequestModes.get(key)) { keptModes.add(key, value) }
                        if (let Some(value) <- positionLastFailure.get(key)) { keptFailures.add(key, value) }
                    }
                }
            }
        }
        positionRequestRevisions = keptRequests
        acceptedPositionRequestRevisions = keptAccepted
        positionRequestModes = keptModes
        positionLastFailure = keptFailures
    }

    private func discardStagedAnimationPaint(): Unit {
        stagedAnimationBindingTable = HashMap<String, CjguiComposableUiAnimationBinding>()
        stagedEffectGroupBindingTable = HashMap<String, CjguiComposableUiAnimationBinding>()
        stagedInteractionColorTargets = HashMap<String, CjguiComposableUiPaintColorSet>()
        stagedPositionSamples = HashMap<String, CjguiComposableUiPositionSample>()
        stagedPositionOriginRebases = HashMap<String, CjguiComposableUiPositionOriginRebase>()
        originRebaseCandidateFailure = "none"
        stagedPositionRevision = 0
        stagedPaintRevision = 0
        stagedPositionRequestRevisions = HashMap<String, Int64>()
    }

    private func pumpWithRefreshPolicy(timeoutMs: UInt32, refreshNow: Bool): CjguiComposableUiWindowPumpResult {
        if (!isWindowOpen) {
            return result(false, false)
        }
        // A failed installation keeps its exact restoration identity. Repair A
        // before any further AppKit acquisition, owner input, or projection.
        if (!this.retrySelectionTransferRecovery()) { return result(isWindowOpen, false) }
        // A captured range claim remains the native FIFO head until both its
        // ACK and managed memo retirement settle. Retry it before any other
        // operation can dequeue or replace the native sideband.
        if (heldInstalledRangeSettlement.isSome()) {
            if (!this.retryHeldInstalledRangeSettlement()) {
                return result(isWindowOpen, false)
            }
        }
        if (!this.retryHeldCaretOwnerReceipt()) { return result(isWindowOpen, false) }
        if (closeIntentPending || discardRetryReason.size > 0) {
            let _ = refreshIfNeeded()
            return result(isWindowOpen, false)
        }
        // Native may already have accepted the frozen candidate whose input
        // snapshot Cangjie has yet to publish. Settle it before dequeueing any
        // dependent input; an unresolved ticket keeps the original FIFO intact.
        if (pendingTransaction.isSome()) {
            let _ = settlePendingPresent()
            if (!isWindowOpen || pendingTransaction.isSome()) {
                return result(isWindowOpen, false)
            }
        }
        var didApply = false
        var requiresProjection = false
        var ordinaryWheelOnlyBatch = true
        var ordinaryWheelCount: Int64 = 0
        let wheelViewportRequests = ArrayList<CjguiWheelViewportRequest>()
        var requiresInteractionPaint = deferredInteractionPaint
        deferredInteractionPaint = false
        var waitMs = timeoutMs
        if (let Some(budget) <- ownerTurnBudget) {
            // Only a real retained preparation wakes the next turn. Stable
            // windows keep their ordinary wait, so idle does not become a spin.
            if (budget.hasPreparedWork()) { waitMs = 0u32 }
            if (animationDriver.needsTick() || this.hasActiveWindowActivities()) {
                budget.limitSchedulingWait(Int64(CJGUI_COMPOSABLE_UI_ANIMATION_FRAME_WAIT_MS) * 1000)
            }
        }
        // P2：有活动动效时不长睡。把等待上限压到一个帧预算，让本窗（以及共享
        // 宿主）每帧获得一次推进机会；无活动动效时保持原有休眠策略，静止后
        // 帧请求自然收敛。
        if (animationDriver.needsTick() && waitMs > CJGUI_COMPOSABLE_UI_ANIMATION_FRAME_WAIT_MS) {
            waitMs = CJGUI_COMPOSABLE_UI_ANIMATION_FRAME_WAIT_MS
        }
        let drainBudget = CjguiComposableUiEventDrainBudget()
        // Consume the complete FIFO against its original rendered snapshot,
        // then publish once. Rebuilding after each event used to invalidate
        // later accepted keystrokes from that same displayed scene.
        drainingInputEvents = true
        let drainStarted = this.ownerPhaseStarted()
        try {
        while (drainBudget.consumeOne()) {
            // Leave the next event in the native FIFO when the outer owner
            // allowance is nearly spent. Accepted callbacks finish atomically;
            // a fast producer cannot reopen a budget or discard an input.
            if (!this.ownerBudgetAdmits(4000, "input_event")) { break }
            // A route may have accepted its owner edit but failed native ACK
            // earlier in this same drain. Retry the held claim before asking
            // native for another event, which would replace its pump sideband.
            if (heldInstalledRangeSettlement.isSome() &&
                !this.retryHeldInstalledRangeSettlement()) {
                break
            }
            if (!this.retryHeldCaretOwnerReceipt()) { break }
            let pollStarted = this.ownerPhaseStarted()
            let nativeEvent = internalRendererPumpEvent(sessionToken, waitMs, budget: ownerTurnBudget)
            cjguiOwnerTraceBoundary(sessionToken, 0u64, 305u32, nativeEvent.eventKind, 0u32,
                nativeEvent.inputSequence, UInt64.Max)
            this.traceOwnerPhase("pump_native_poll", pollStarted)
            cjguiOwnerTraceBoundary(sessionToken, 0u64, 306u32, nativeEvent.eventKind, 0u32,
                nativeEvent.inputSequence, UInt64.Max)
            if (nativeEvent.eventKind == 27u32 || (nativeEvent.eventKind >= 45u32 && nativeEvent.eventKind <= 47u32)) {
                traceTabsPointerEvent(nativeEvent)
            }
            waitMs = 0u32
            lastNativeStatus = nativeEvent.status
            if (nativeEvent.eventKind == 1u32) {
                testCloseEventKind = Int64(nativeEvent.eventKind)
                testCloseNativeStatus = nativeEvent.status
                discardSession("pump_session_closed")
                return result(isWindowOpen, didApply)
            }
            if (nativeEvent.status != CJGUI_INTERNAL_RENDERER_OK) {
                activationPrefixGate.cancel()
                if (nativeEvent.status == CJGUI_INTERNAL_RENDERER_NOT_MAIN_THREAD) {
                    // AppKit rejected this call before reading the FIFO or touching
                    // the session. The accepted projection and pending work remain
                    // owned by this live window for a later legal owner turn.
                    lastNativeFailure = "not_main_thread"
                    return result(isWindowOpen, didApply)
                }
                if (!isRecoverableNativeStatus(nativeEvent.status)) {
                    testCloseEventKind = Int64(nativeEvent.eventKind)
                    testCloseNativeStatus = nativeEvent.status
                    discardSession("pump_native_status")
                    return result(isWindowOpen, didApply)
                }
                let _ = noteRefreshFailure(nativeEvent.status)
                return result(true, didApply)
            }
            if (nativeEvent.eventKind == 0u32) {
                traceActivationPrefixMarker(34u32, activationPrefixGate.snapshot())
                break
            }
            if (nativeEvent.eventKind == 30u32 && nativeEvent.gestureEpoch == 0u64) {
                ordinaryWheelCount += 1
            } else {
                ordinaryWheelOnlyBatch = false
            }
            // Windows keyboard edits carry the binding that owned their value
            // and UTF-16 range at capture time. Binding retirement can happen
            // before this queued event is consumed, so retire it here rather
            // than letting a controller reinterpret stale coordinates.
            // A sealed installed-range input names the actual presentation
            // proxy, which need not be the source mirror node. Its complete
            // receipt is settled below before legacy scene/binding routing.
            if (nativeEvent.eventKind == 51u32 && !nativeEvent.installedRangeOwned &&
                nativeEvent.bindingEpoch != 0u64 &&
                (nativeEvent.bindingEpoch != textSessionBindingEpoch || ownedTextSession.isNone() ||
                Int64(nativeEvent.nodeId) != ownedTextSessionNodeId ||
                nativeEvent.resourceId != ownedTextSessionResourceId ||
                Int64(nativeEvent.nodeKind) != ownedTextSessionNodeKind)) {
                continue
            }
            let prefixTarget = nativeInputScene.resolvePointerTarget(Int64(nativeEvent.nodeId),
                nativeEvent.resourceId, Int64(nativeEvent.nodeKind), Int64(nativeEvent.projectionVersion))
            let prefixMember = activationPrefixGate.admit(nativeEvent, textSessionBindingEpoch,
                prefixTarget.nodeId == Int64(nativeEvent.nodeId))
            if (prefixMember < 0) {
                traceActivationPrefixMarker(36u32, nativeEvent.activationPrefix)
                // Prefix rejection cannot swallow cleanup of a retained old
                // press. This handler can only terminate the matching lease.
                if (nativeEvent.eventKind == 47u32 && nativeEvent.bindingEpoch != 0u64) {
                    requiresInteractionPaint = applyInteractionIntent(47u32, nativeEvent.nodeId,
                        nativeEvent.resourceId, nativeEvent.nodeKind, nativeEvent.projectionVersion,
                        pressSequence: nativeEvent.bindingEpoch,
                        pointX: if (nativeEvent.pointerGeometryAccepted) { nativeEvent.pointerVisualX } else { Float64(nativeEvent.pointerX) },
                        pointY: if (nativeEvent.pointerGeometryAccepted) { nativeEvent.pointerVisualY } else { Float64(nativeEvent.pointerY) }) || requiresInteractionPaint
                    continue
                }
                let rejection = controller.rejectUiEvent(Int64(nativeEvent.eventKind), Int64(nativeEvent.nodeId))
                didApply = didApply || rejection.didApply
                requiresProjection = true
                if (rejection.shouldClose) { close(); return result(isWindowOpen, didApply) }
                continue
            }
            if (prefixMember == 1) { traceActivationPrefixMarker(33u32, nativeEvent.activationPrefix) }
            var dragEdgeFractionConsumed = false
            try {
                    if ((nativeEvent.eventKind == 35u32 || nativeEvent.eventKind == 34u32) &&
                        nativeEvent.inputSequence != 0u64 && ownedTextSession.isSome()) {
                        macCaretInput = Some(
                            InternalRendererInputProvenance(nativeEvent.inputSessionGeneration,
                                nativeEvent.inputSequence, nativeEvent.inputPreviousSequence, nativeEvent.eventKind))
                        macCaretInputTicket = Some(ownedTextSession.getOrThrow().freezeSelectionTicket())
                        macCaretInitialEditSeq = ownedTextSession.getOrThrow().currentEditSeq()
                        macCaretDispatchActive = true
                        macCaretEditApplied = false
                        if (getVariable("CJGUI_CARET_FINISH_TRACE").isSome()) {
                            println("CJGUI_CARET_ROUTE seq=${nativeEvent.inputSequence} " +
                                "native=${nativeEvent.nodeId}:${nativeEvent.nodeKind} " +
                                "resolved=${prefixTarget.nodeId}:${prefixTarget.nodeKind} " +
                                "owned=${ownedTextSessionNodeId}:${ownedTextSessionNodeKind} " +
                                "presentation=${presentationTextSessionNodeId} scene=${nativeInputScene.version}")
                        }
                    }
            // Owner/selection input retires an unsubmitted candidate before its
            // callback. A proven framework viewport wheel only requests a new
            // position; its post-dispatch generation chain decides whether A
            // may finish. No incomplete layout or accepted event is reused.
            if (!canRetainPreparationForFrameworkWheel(nativeEvent, wheelViewportRequests)) {
                cancelPreparedCandidate("accepted_input")
            }
            if (nativeEvent.eventKind == 51u32 && nativeEvent.installedRangeOwned) {
                // Captured source ranges are resolved by their actual installed
                // binding before scene lookup. They never fall back to the
                // product dispatcher if their old source is no longer valid.
                let accepted = this.routeCapturedInstalledRange(nativeEvent)
                didApply = didApply || accepted
                requiresProjection = true
                continue
            }
            if (nativeEvent.eventKind == 42u32) {
                // The native AppKit delegate already returned immediately
                // with NSTerminateCancel.  Keep this request outside the
                // controller's event vocabulary so a document cannot turn a
                // process-close decision into an ordinary content action.
                applicationExitRequested = true
            } else if (nativeEvent.eventKind == 11u32) {
                let _ = this.collectCaretInputRecovery()
                // A refused terminal cannot leave an admitted press visually
                // held or invent an activation after the FIFO has drained.
                if (pressLease.isSome()) {
                    pressLease = None
                    pressedInteractionNode = CjguiComposableUiLayoutNode.missing()
                    requiresInteractionPaint = true
                }
                // Native refused a new interaction only after preserving the
                // accepted FIFO.  It is never a successful edit; give the
                // consumer an explicit retry-visible outcome.
                let rejection = controller.rejectUiEvent(11, 0)
                didApply = didApply || rejection.didApply
                if (rejection.shouldClose) {
                    close();
                    return result(isWindowOpen, didApply)
                }
                requiresProjection = true
            } else if (nativeEvent.eventKind == 24u32) {
                let closeResult = controller.requestWindowClose()
                didApply = didApply || closeResult.didApply
                if (closeResult.shouldClose) {
                    close();
                    return result(isWindowOpen, didApply)
                }
                requiresProjection = true
            } else if (nativeEvent.eventKind >= 37u32 && nativeEvent.eventKind <= 40u32) {
                let dispatch = dispatchPointerEvent(nativeEvent)
                didApply = didApply || dispatch.didApply
                if (dispatch.shouldClose) {
                    close()
                    return result(isWindowOpen, didApply)
                }
                // A pointer phase may change only controller-local visual
                // state.  Keep the ordinary coalesced projection path rather
                // than pushing a native scene from inside the event loop.
                requiresProjection = true
            } else if (nativeEvent.eventKind >= 43u32 && nativeEvent.eventKind <= 47u32) {
                // Interaction-only intents are resolved against the exact
                // native input snapshot that produced them. They never enter
                // the controller/business event path; the framework owns
                // hover, press and focus projection locally.
                if (applyInteractionIntent(nativeEvent.eventKind, nativeEvent.nodeId, nativeEvent.resourceId,
                    nativeEvent.nodeKind, nativeEvent.projectionVersion,
                    pressSequence: nativeEvent.bindingEpoch,
                    pointX: if (nativeEvent.pointerGeometryAccepted) { nativeEvent.pointerVisualX } else {
                        Float64(nativeEvent.pointerX) },
                    pointY: if (nativeEvent.pointerGeometryAccepted) { nativeEvent.pointerVisualY } else {
                        Float64(nativeEvent.pointerY) })) {
                    requiresInteractionPaint = true
                }
            } else if ((nativeEvent.eventKind >= 48u32 && nativeEvent.eventKind <= 50u32) ||
                nativeEvent.eventKind == 53u32 || nativeEvent.eventKind == 54u32) {
                let eventSessionIdentity = windowSessionIdentity
                let deliveryOrdinal = internalRendererDataTransferEventDeliveryOrdinal(sessionToken)
                // Match the receiver's accepted incarnation rather than the
                // global scene version: unrelated redraws do not revoke it,
                // while disable/rebind/re-add invalidates an older FIFO item.
                let nodeId = Int64(nativeEvent.nodeId)
                let nativeFormat = internalRendererDataTransferEventFormat(sessionToken)
                var resolved = CjguiComposableUiLayoutNode.missing()
                let wantedRole = if (nativeEvent.eventKind == 48u32) { "SOURCE" } else { "TARGET" }
                for (binding in dataTransferBindings) {
                    if (binding.bindingEpoch == nativeEvent.bindingEpoch &&
                        binding.declaration.role == wantedRole && binding.nativeFormat == nativeFormat &&
                        binding.node.nodeId == nodeId && binding.node.resourceId == nativeEvent.resourceId &&
                        binding.node.nodeKind == Int64(nativeEvent.nodeKind)) {
                        resolved = binding.node
                    }
                }
                if (resolved.nodeId == nodeId) {
                    let eventKind = Int64(nativeEvent.eventKind)
                    let eventId = nativeEvent.dataTransferEventId
                    let sourceKind = internalRendererDataTransferEventSourceKind(sessionToken)
                    let capturedOwnerVersion = internalRendererDataTransferEventExpectedOwnerVersion(sessionToken)
                    var receiptAdmission = "copy"
                    if (eventKind != CJGUI_COMPOSABLE_UI_EVENT_DATA_TRANSFER_COPY) {
                        let originKind = if (eventKind == CJGUI_COMPOSABLE_UI_EVENT_FILE_TRANSFER_BEGIN ||
                            eventKind == CJGUI_COMPOSABLE_UI_EVENT_FILE_TRANSFER_REJECTED) {
                            Int64(nativeEvent.recordIndex)
                        } else { eventKind }
                        receiptAdmission = beginTransferReceipt(eventSessionIdentity, eventId,
                            deliveryOrdinal, originKind, resolved, nativeEvent.bindingEpoch,
                            sourceKind, capturedOwnerVersion,
                            if (eventKind == CJGUI_COMPOSABLE_UI_EVENT_FILE_TRANSFER_BEGIN) {
                                "reading"
                            } else { "queued" })
                        if (receiptAdmission == "capacity_rejected") {
                            if (let Some(provider) <- dataTransferProvider()) {
                                let _ = provider.rejectDataTransfer(nodeId, eventKind,
                                    "receipt_capacity_exceeded")
                            }
                            requiresProjection = true
                            continue
                        }
                        if (receiptAdmission == "replayed" || receiptAdmission == "invalid_delivery" ||
                            receiptAdmission == "capacity_unobservable") { continue }
                    }
                    if (eventKind == CJGUI_COMPOSABLE_UI_EVENT_FILE_TRANSFER_BEGIN) {
                        continue
                    }
                    if (eventKind == CJGUI_COMPOSABLE_UI_EVENT_FILE_TRANSFER_REJECTED) {
                        let prior = transferReceipt(eventSessionIdentity, eventId)
                        if (let Some(value) <- prior.receipt) {
                            if (transferReceiptIsFinal(value)) { continue }
                        }
                        let reason = internalRendererFormEventText(sessionToken)
                        settleTransferReceipt(eventSessionIdentity, eventId, "rejected", reason, "", None)
                        if (let Some(provider) <- dataTransferProvider()) {
                            let _ = provider.rejectDataTransfer(nodeId, eventKind, reason)
                        }
                        requiresProjection = true
                        continue
                    }
                    let existingReceipt = transferReceipt(eventSessionIdentity, eventId)
                    if (let Some(prior) <- existingReceipt.receipt) {
                        if (prior.state == "owner_accepted" || transferReceiptIsFinal(prior)) {
                            continue
                        }
                    }
                    let dispatchKey = "${eventSessionIdentity}:${eventId}"
                    if (eventKind != CJGUI_COMPOSABLE_UI_EVENT_DATA_TRANSFER_COPY) {
                        if (transferReceiptDispatchClaims.get(dispatchKey).isSome()) { continue }
                        let _ = transferReceiptDispatchClaims.add(dispatchKey, true)
                    }
                    let binaryBytes: ?Array<Byte> = if (nativeFormat == "image/png" && eventKind !=
                        CJGUI_COMPOSABLE_UI_EVENT_DATA_TRANSFER_COPY) {
                        internalRendererDataTransferEventBinary(sessionToken, eventId)
                    } else { None }
                    let dispatch = applyDataTransfer(resolved, eventKind, internalRendererFormEventText(sessionToken),
                        binaryBytes, nativeFormat,
                        sourceKind,
                        internalRendererDataTransferEventSourceIdentity(sessionToken),
                        internalRendererDataTransferEventSourceId(sessionToken), Int64(nativeEvent.projectionVersion),
                        nativeEvent.bindingEpoch, capturedOwnerVersion, eventId)
                    if (eventKind != CJGUI_COMPOSABLE_UI_EVENT_DATA_TRANSFER_COPY) {
                        let _ = transferReceiptDispatchClaims.remove(dispatchKey)
                        let digest = lastTransferOfferDigest
                        if (let Some(result) <- dispatch.transferResult) {
                            settleTransferReceipt(eventSessionIdentity, eventId,
                                if (result.applied) { "owner_accepted" } else {
                                "rejected"
                            }, result.reason, digest, Some(result))
                        } else {
                            settleTransferReceipt(eventSessionIdentity, eventId, if (dispatch.didApply) {
                                "owner_result_unavailable"
                            } else { "rejected" }, if (dispatch.didApply) {
                                "owner_result_unavailable"
                            } else if (lastTransferRejectionReason.size > 0) {
                                lastTransferRejectionReason
                            } else { "provider_rejected" }, digest, None)
                        }
                    }
                    didApply = didApply || dispatch.didApply
                    if (dispatch.shouldClose) {
                        close()
                        return result(isWindowOpen, didApply)
                    }
                    // Copy acknowledgement and rejected paste/drop are visible
                    // consumer-local state.  A successful target consumes the
                    // owner mutation through the same coalesced projection
                    // path as every normal human action.
                    requiresProjection = true
                } else {
                    if (nativeEvent.eventKind >= 49u32 && nativeEvent.eventKind <= 54u32) {
                        let eventId = nativeEvent.dataTransferEventId
                        var staleAdmission = "unbound"
                        for (captured in transferBindingHistory) {
                            if (captured.bindingEpoch == nativeEvent.bindingEpoch &&
                                captured.node.nodeId == nodeId &&
                                captured.node.resourceId == nativeEvent.resourceId &&
                                captured.node.nodeKind == Int64(nativeEvent.nodeKind)) {
                                let originKind = if (nativeEvent.eventKind == 53u32 ||
                                    nativeEvent.eventKind == 54u32) {
                                    Int64(nativeEvent.recordIndex)
                                } else { Int64(nativeEvent.eventKind) }
                                staleAdmission = beginTransferReceipt(eventSessionIdentity, eventId,
                                    deliveryOrdinal, originKind, captured.node,
                                    nativeEvent.bindingEpoch,
                                    internalRendererDataTransferEventSourceKind(sessionToken),
                                    internalRendererDataTransferEventExpectedOwnerVersion(sessionToken),
                                    "queued")
                                break
                            }
                        }
                        if (staleAdmission == "replayed" || staleAdmission == "invalid_delivery" ||
                            staleAdmission == "capacity_unobservable") { continue }
                        if (staleAdmission == "existing") {
                            let prior = transferReceipt(eventSessionIdentity, eventId)
                            if (let Some(value) <- prior.receipt) {
                                if (transferReceiptIsFinal(value)) { continue }
                            }
                        }
                        settleTransferReceipt(eventSessionIdentity, eventId,
                            "cancelled", "stale_target", "", None)
                    }
                    let rejection = controller.rejectUiEvent(Int64(nativeEvent.eventKind), nodeId)
                    didApply = didApply || rejection.didApply
                    if (rejection.shouldClose) {
                        close()
                        return result(isWindowOpen, didApply)
                    }
                    requiresProjection = true
                }
            } else if (nativeEvent.eventKind == 33u32) {
                // Platform-owned selection is view state, not a domain
                // action. A document consumer may translate this UTF-16
                // range at its UI boundary, but it must not turn a caret
                // move into an external operation or force a scene rebuild.
                let nodeId = Int64(nativeEvent.nodeId)
                let resolved = if (nativeEvent.nodeId == 0u64) {
                    CjguiComposableUiLayoutNode.missing()
                } else {
                    nativeInputScene.resolveSelection(nodeId, nativeEvent.resourceId, Int64(nativeEvent.nodeKind),
                        Int64(nativeEvent.projectionVersion))
                }
                if (resolved.nodeId == nodeId) {
                    var acceptSelection = true
                    // Keep the bound session's UTF-16 selection in step with the
                    // accepted native proxy. A caret/selection move is view state:
                    // it must not become a range transaction or content version.
                    if (resolved.nodeId == ownedTextSessionNodeId &&
                        resolved.resourceId == ownedTextSessionResourceId) {
                        if (let Some(session) <- ownedTextSession) {
                            let pendingNative = session.needsNativeSelectionRestore()
                            let pacedSource = ownerTurnBudget.isSome() &&
                                resolved.nodeKind == CJGUI_COMPOSABLE_UI_MULTILINE_TEXT_INPUT
                            let humanSourceSelection = pacedSource && nativeEvent.pointerGeometryAccepted
                            if (!pacedSource) {
                                // Preserve the existing recovery path for consumers
                                // that have not opted into source installation pacing.
                                if (pendingNative) {
                                    acceptSelection = false
                                } else {
                                    let current = internalRendererReadComposableSelection(sessionToken,
                                        resolved.nodeId, resolved.resourceId, resolved.nodeKind,
                                        nativeInputScene.version, resolved.value)
                                    if (current[0] != CJGUI_INTERNAL_RENDERER_OK ||
                                        current[1] != Int64(nativeEvent.selectionStart) ||
                                        current[2] != Int64(nativeEvent.selectionEnd) ||
                                        session.contentVersion() != session.mirrorSnapshot().sourceVersion) {
                                        acceptSelection = false
                                    } else {
                                        session.setSelection16(current[1], current[2])
                                    }
                                }
                            } else if ((pendingNative && !humanSourceSelection) || session.hasComposition() ||
                                session.awaitingCalibration() || session.mirrorText() != resolved.value ||
                                session.contentVersion() != session.mirrorSnapshot().sourceVersion) {
                                // Named attribution: a refused selection adoption also skips
                                // `registerInstalledRangeForNativeFocus`, so the NEXT keystroke is
                                // refused as an unclaimed range callback. Which sub-condition said no?
                                if (getVariable("CJGUI_SELECTION_ADOPT_TRACE").isSome()) {
                                    getStdOut().writeln("CJGUI_SELECTION_ADOPT_REFUSED pendingNative=${pendingNative} " +
                                        "humanSource=${humanSourceSelection} composition=${session.hasComposition()} " +
                                        "calibration=${session.awaitingCalibration()} " +
                                        "mirrorTextMatch=${session.mirrorText() == resolved.value} " +
                                        "versionMatch=${session.contentVersion() == session.mirrorSnapshot().sourceVersion} " +
                                        "sessionVersion=${session.contentVersion()} mirrorSource=${session.mirrorSnapshot().sourceVersion}")
                                    getStdOut().flush()
                                }
                                acceptSelection = false
                            } else {
                                // The exact readback is inside the same owner-version
                                // guard that publishes the new selection revision.
                                // A proven fresh pointer can supersede a pending
                                // installation; old callbacks cannot acknowledge it.
                                let semantic = session.freezeSelectionTicket()
                                acceptSelection = session.commitSelectionTicket(semantic,
                                    Int64(nativeEvent.selectionStart), Int64(nativeEvent.selectionEnd), { =>
                                        let current = internalRendererReadComposableSelection(sessionToken,
                                            resolved.nodeId, resolved.resourceId, resolved.nodeKind,
                                            nativeInputScene.version, resolved.value)
                                        return current[0] == CJGUI_INTERNAL_RENDERER_OK &&
                                            current[1] == Int64(nativeEvent.selectionStart) &&
                                            current[2] == Int64(nativeEvent.selectionEnd)
                                    })
                                if (acceptSelection && humanSourceSelection) {
                                    if (let Some(request) <- pendingSelectionRestore) {
                                        this.finishSelectionRestore(request.id, "human_selection_superseded")
                                    }
                                    this.invalidatePlainPositionBranch()
                                }
                            }
                            if (!acceptSelection) {
                                staleOwnedSelectionEvents += 1
                            }
                        }
                    }
                    if (acceptSelection) {
                        rememberInteraction(resolved, 33, Int64(nativeEvent.selectionStart), Int64(nativeEvent.selectionEnd))
                        // Mouse/AX focus can install the real adapter without
                        // going through the Cangjie explicit-focus method.
                        // Register that adapter through the same candidate /
                        // actual-adoption / receipt handshake before later input.
                        this.registerInstalledRangeForNativeFocus(resolved, acceptedSourceSelection: true,
                            selectionStart16: Int64(nativeEvent.selectionStart),
                            selectionEnd16: Int64(nativeEvent.selectionEnd))
                    let selection = controller.applyUiEvent(
                        CjguiComposableUiEvent(
                            resolved,
                            33,
                            "",
                            Int64(nativeEvent.selectionStart),
                            Int64(nativeEvent.selectionEnd),
                            Int64(nativeEvent.projectionVersion)
                        )
                    )
                    didApply = didApply || selection.didApply
                    if (selection.shouldClose) {
                        close();
                        return result(isWindowOpen, didApply)
                    }
                    }
                }
            } else if (nativeEvent.eventKind == 41u32) {
                let target = boundCommandTarget(
                    internalRendererFormEventText(sessionToken),
                    true,
                    Int64(nativeEvent.projectionVersion)
                )
                if (target.nodeId >= 0) {
                    let dispatch = applyBoundCommand(target, Int64(nativeEvent.projectionVersion))
                    didApply = didApply || dispatch.didApply
                    if (dispatch.shouldClose) {
                        close()
                        return result(isWindowOpen, didApply)
                    }
                    requiresProjection = true
                }
            } else if (nativeEvent.eventKind == 34u32) {
                let command = internalRendererFormEventText(sessionToken)
                let target = boundCommandTarget(
                    command,
                    false,
                    Int64(nativeEvent.projectionVersion)
                )
                if (getVariable("CJGUI_CARET_FINISH_TRACE").isSome()) {
                    let focused = nativeInputScene.nodeForId(focusedNodeId)
                    println("CJGUI_CARET_COMMAND seq=${nativeEvent.inputSequence} " +
                        "command=[${command}] captured_scene=${nativeEvent.projectionVersion} " +
                        "accepted_scene=${nativeInputScene.version} focus=${focusedNodeId} " +
                        "scope=[${focused.inputScopeId}] bindings=${commandBindings.size} " +
                        "target=${target.nodeId} action=[${target.actionName}]")
                    for (binding in commandBindings) {
                        let declaration = binding.declaration
                        if (commandMatches(declaration, command, false)) {
                            let node = commandTargetForAcceptedScene(nativeInputScene, declaration)
                            println("CJGUI_CARET_COMMAND_CANDIDATE id=${declaration.id} " +
                                "node=${node.nodeId} enabled=${declaration.isEnabled} " +
                                "declared=${commandTargetIsDeclared(node, declaration)} " +
                                "receives_input=${node.canReceiveInput()} " +
                                "scope=[${declaration.focusScopeId}]")
                        }
                    }
                }
                if (target.nodeId >= 0) {
                    let dispatch = applyBoundCommand(target, Int64(nativeEvent.projectionVersion))
                    didApply = didApply || dispatch.didApply
                    if (dispatch.shouldClose) {
                        close();
                        return result(isWindowOpen, didApply)
                    }
                    requiresProjection = true
                }
            } else if (nativeEvent.eventKind == 35u32) {
                // Native recognizes only a list-navigation gesture and its
                // scroll-container target. Cangjie resolves the current
                // stable-key range, so a recycled/off-screen row cannot be
                // mistaken for the prior materialized index.
                let nodeId = Int64(nativeEvent.nodeId)
                let resolved = if (nativeEvent.nodeId == 0u64) {
                    CjguiComposableUiLayoutNode.missing()
                } else {
                    nativeInputScene.resolveInput(nodeId, nativeEvent.resourceId, Int64(nativeEvent.nodeKind),
                        Int64(nativeEvent.projectionVersion))
                }
                // A tab TITLE owns Left/Right inside its OWN accepted group: the
                // focus moves to the next ENABLED title and nothing else moves.
                // Selecting a page is the ordinary ACTIVATE interaction, so the
                // arrow rule can never switch a page by itself.
                var resolvedNavigate = resolved
                if (resolvedNavigate.nodeId != nodeId && nativeEvent.nodeId != 0u64) {
                    // A pointer-reporting, non-input presentation node resolves
                    // through the pointer-target path: it owns caret intents but
                    // is deliberately not an editable input.
                    resolvedNavigate = nativeInputScene.resolvePointerTarget(nodeId, nativeEvent.resourceId,
                        Int64(nativeEvent.nodeKind), Int64(nativeEvent.projectionVersion))
                }
                let titleKeyboardText = internalRendererFormEventText(sessionToken)
                if (titleKeyboardText.startsWith("selection_install_pending:")) {
                    textSessionRangeDecisions += 1
                    textSessionRefusedEdits += 1
                    lastTextSessionCompositionReason = "selection_install_pending"
                    getStdOut().writeln("CJGUI_INPUT_REFUSED reason=selection_install_pending " +
                        "node=${nativeEvent.nodeId} scene=${nativeEvent.projectionVersion} wrote_owner=false")
                    getStdOut().flush()
                    continue
                }
                // 统一普通文字意图（Astra Q5）：会话**拥有**的文字表面（source 绑定
                // 节点）的 delete/move/Shift 扩选由框架文本会话共同处理器唯一裁决
                // （native 选择器已拦截，不再默认执行一遍）；presentation TEXT 仍
                // 先走产品语义层（SourceMap/reveal）。
                if (let Some(session) <- ownedTextSession) {
                    let sessionSurface = resolved.nodeId == Int64(nativeEvent.nodeId) &&
                        Int64(nativeEvent.nodeId) == ownedTextSessionNodeId &&
                        nativeEvent.resourceId == ownedTextSessionResourceId &&
                        Int64(nativeEvent.nodeKind) == ownedTextSessionNodeKind
                    let shiftHeld = (nativeEvent.modifierFlags & 0x020000) != 0
                    var plainIntent: ?CjguiTextPlainIntent = None
                    if (titleKeyboardText == "deleteBackward") {
                        plainIntent = Some(CjguiTextPlainIntent.DeleteBackward)
                    } else if (titleKeyboardText == "deleteForward") {
                        plainIntent = Some(CjguiTextPlainIntent.DeleteForward)
                    } else if (sessionSurface && (nativeEvent.modifierFlags & 0x040000) != 0 &&
                        (titleKeyboardText == "home" || titleKeyboardText == "end")) {
                        plainIntent = Some(if (titleKeyboardText == "home") {
                            if (shiftHeld) { CjguiTextPlainIntent.ExtendDocumentStart }
                            else { CjguiTextPlainIntent.MoveDocumentStart }
                        } else {
                            if (shiftHeld) { CjguiTextPlainIntent.ExtendDocumentEnd }
                            else { CjguiTextPlainIntent.MoveDocumentEnd }
                        })
                    } else if (titleKeyboardText == "left" || titleKeyboardText == "right") {
                        // Astra 终态分发（2026-09-30）：会话表面的水平箭头由视觉
                        // 导航处理器给出**终态**——Success/AtBoundary/NeedPrepare/
                        // Refused 一律终止该意图（不得回落逻辑移动或平台默认）；
                        // 只有 NotApplicable（接管前确定不归本处理器）才走旧逻辑。
                        if (sessionSurface && internalRendererSelectionTransferSupported()) {
                            match (this.handlePlainHorizontalIntent(titleKeyboardText == "left", shiftHeld)) {
                                case NotApplicable => ()
                                case AtBoundary =>
                                            let _ = this.finishMacCaretInput(2u32)
                                            didApply = true
                                            return result(isWindowOpen, didApply)
                                        case Success | Retained(_) | NeedPrepare(_) | Refused(_) =>
                                    didApply = true
                                    return result(isWindowOpen, didApply)
                            }
                        }
                        // Windows（无跨选择 transfer）：水平导航落到会话共同处理器，
                        // 选区零写入即时累积，并由 pushOwnedPlainSelectionToProxy
                        // 在同一排水步内同步推回 native 代理。
                        plainIntent = Some(if (titleKeyboardText == "left") {
                            if (shiftHeld) {
                                CjguiTextPlainIntent.ExtendLeft
                            } else {
                                CjguiTextPlainIntent.MoveLeft
                            }
                        } else {
                            if (shiftHeld) {
                                CjguiTextPlainIntent.ExtendRight
                            } else {
                                CjguiTextPlainIntent.MoveRight
                            }
                        })
                    }
                    if (sessionSurface && plainIntent.isNone() &&
                        (titleKeyboardText == "up" || titleKeyboardText == "down")) {
                        // 垂直意图走窗口级 accepted-排版路径（首选列位）；终态
                        // 同样唯一消费——拒绝/待准备不落滚动语义。
                        match (this.handlePlainVerticalIntent(titleKeyboardText == "down", shiftHeld)) {
                            case NotApplicable => ()
                            case AtBoundary =>
                                        let _ = this.finishMacCaretInput(2u32)
                                        didApply = true
                                        return result(isWindowOpen, didApply)
                                    case Success | Retained(_) | NeedPrepare(_) | Refused(_) =>
                                didApply = true
                                return result(isWindowOpen, didApply)
                        }
                    }
                    if (!shiftHeld && plainIntent.isSome() &&
                        (titleKeyboardText == "left" || titleKeyboardText == "right")) {
                        // 水平移动重置垂直首选列位（Astra 位置契约）。
                        this.resetPlainVerticalPreferredX()
                    }
                    if (sessionSurface && plainIntent.isSome()) {
                        let plain = plainIntent.getOrThrow()
                        let outcome = session.handlePlainIntent(plain)
                        // 三类守恒：正文接受 / 零写入选区意图 / 具名拒绝。
                        textSessionRangeDecisions += 1
                        if (outcome.wroteOwner) {
                            // The actual Sink decision is recorded once against
                            // this physical command before its restoration/ACK.
                            if (macCaretInput.isSome()) {
                                    if (!this.recordMacCaretOwnerEditIfApplied()) {
                                        let _ = this.finishMacCaretInput(3u32)
                                    } else {
                                        // Close source admission before the new owner
                                        // projection can replace the actual old adapter.
                                        // This is the same restore slot and common B
                                        // terminal used by AUTO, carrying this edit's
                                        // immutable result and causal successors.
                                        let _ = this.requestOwnedSelectionRestore()
                                    }
                            }
                            textSessionAcceptedEdits += 1
                        } else if (outcome.handled) {
                            textSessionZeroWriteSelections += 1
                        } else {
                            textSessionRefusedEdits += 1
                        }
                        lastTextSessionCompositionReason = "plain_intent"
                        getStdOut().writeln("CJGUI_PLAIN_INTENT text=${titleKeyboardText} " +
                            "handled=${outcome.handled} wrote_owner=${outcome.wroteOwner} " +
                            "reason=${outcome.reason} sel=${outcome.selectionStart16}:${outcome.selectionEnd16}")
                        getStdOut().flush()
                        if (outcome.handled && !outcome.wroteOwner) {
                            // 纯选区意图：立即把会话选区推回 native 代理。
                            this.pushOwnedPlainSelectionToProxy(session)
                        } else if (outcome.wroteOwner) {
                            requiresProjection = true
                            // Astra：写入改变文字——旧位置分支明确失效，下次意图
                            // 从新选择重解析（曾沿用到新位置产生分支错配）。
                            this.plainCaretAffinity = CJGUI_TEXT_AFFINITY_AUTO
                        }
                        if (outcome.handled) {
                            didApply = true
                            return result(isWindowOpen, didApply)
                        }
                    }
                }
                let titleOwnsKeyboard = resolved.nodeId == nodeId && resolved.isTabTitle() && resolved.isEnabled && (titleKeyboardText ==
                    "left" || titleKeyboardText == "right" || titleKeyboardText == "pageUp" || titleKeyboardText ==
                    "pageDown" || titleKeyboardText == "up" || titleKeyboardText == "down")
                let titleStepApplied = titleOwnsKeyboard && applyTabsTitleNavigation(resolved, titleKeyboardText)
                // A divider whose author bound shared split view state is owned by
                // the framework: the keyboard nudge is applied against the ACCEPTED
                // track and the event never reaches an application split owner.
                let splitKeyboardText = internalRendererFormEventText(sessionToken)
                let splitOwnsKeyboard = resolved.nodeId == nodeId && isSplitSizeNavigation(splitKeyboardText) &&
                    splitStateForDivider(resolved).isSome()
                let splitStepApplied = splitOwnsKeyboard && applySplitStateKeyboardStep(resolved, splitKeyboardText)
                let caretIntentOwned = resolvedNavigate.nodeId == nodeId && resolvedNavigate.nodeKind ==
                    CJGUI_COMPOSABLE_UI_TEXT && resolvedNavigate.style.pointerInteractive && (titleKeyboardText ==
                    "deleteBackward" || titleKeyboardText == "deleteForward" || titleKeyboardText == "left" ||
                    titleKeyboardText == "right" || titleKeyboardText == "up" || titleKeyboardText == "down" ||
                        // Tab in a presentation text node is the product's own intent
                        // (e.g. table cell navigation), not a key the framework owns.
                        titleKeyboardText == "nextCell" ||
                        // Select All can be addressed to the focused TEXT
                        // itself when a long node's center is outside its
                        // scroll clip. Its source scope still belongs to the
                        // same product handler as the scroll-addressed intent.
                        titleKeyboardText == "select_all" ||
                        // Cmd+Z/Cmd+Shift+Z（自绘编辑器撤销——菜单 Undo 项已退役，
                        // native performKeyEquivalent 入队，产品 handleVisualCaretIntent
                        // 前的 undo 分支消费）。
                        titleKeyboardText == "undo" || titleKeyboardText == "redo")
                if (caretIntentOwned) {
                    // The product resolves this intent against its own SourceMap;
                    // the framework only reports which key was pressed.
                    let caretDispatch = controller.applyUiEvent(
                        CjguiComposableUiEvent(resolvedNavigate, 35, titleKeyboardText, 0, 0,
                        Int64(nativeEvent.projectionVersion),
                            // A caret key carries its own modifiers: Shift+Left/Right
                            // extends the product's range. Dropping them here made every
                            // real Shift+Arrow indistinguishable from a bare arrow
                            // (measured 2026-09-27: PHAROS_CARET_MOVE ... shift=false on a
                            // posted Shift+Right, while the native bridge had stamped the
                            // flag on this queued NAVIGATE).
                            modifierFlags: Int64(nativeEvent.modifierFlags),
                            inputSessionGeneration: nativeEvent.inputSessionGeneration,
                            inputSequence: nativeEvent.inputSequence,
                            inputPreviousSequence: nativeEvent.inputPreviousSequence))
                    didApply = didApply || caretDispatch.didApply
                    if (caretDispatch.shouldClose) {
                        close()
                        return result(isWindowOpen, didApply)
                    }
                    requiresProjection = true
                } else if (titleOwnsKeyboard) {
                    didApply = didApply || titleStepApplied
                    requiresProjection = true
                } else if (splitOwnsKeyboard) {
                    didApply = didApply || splitStepApplied
                    requiresProjection = true
                } else if (resolved.nodeId == nodeId && (resolved.nodeKind == CJGUI_COMPOSABLE_UI_SCROLL_AREA || ((resolved
                    .nodeKind == CJGUI_COMPOSABLE_UI_SPLIT_HANDLE || resolved.nodeKind == CJGUI_COMPOSABLE_UI_SLIDER) &&
                    (internalRendererFormEventText(sessionToken) == "left" ||
                    internalRendererFormEventText(sessionToken) == "right" ||
                    internalRendererFormEventText(sessionToken) == "up" ||
                    internalRendererFormEventText(sessionToken) == "down")))) {
                    let dispatch = controller.applyUiEvent(
                        CjguiComposableUiEvent(
                            resolved,
                            35,
                            internalRendererFormEventText(sessionToken),
                            0,
                            0,
                            Int64(nativeEvent.projectionVersion),
                            // The keyDown that produced this navigation carries
                            // its own modifiers (Shift extends a range, Command
                            // marks select-all); a programmatic/AX navigation is
                            // enqueued with zero and never inherits a mouse
                            // gesture's state.
                            modifierFlags: Int64(nativeEvent.modifierFlags),
                            inputSessionGeneration: nativeEvent.inputSessionGeneration,
                            inputSequence: nativeEvent.inputSequence,
                            inputPreviousSequence: nativeEvent.inputPreviousSequence
                        )
                    )
                    didApply = didApply || dispatch.didApply
                    if (dispatch.shouldClose) {
                        close();
                        return result(isWindowOpen, didApply)
                    }
                    requiresProjection = true
                } else {
                    let rejection = controller.rejectUiEvent(35, nodeId)
                    didApply = didApply || rejection.didApply
                    if (rejection.shouldClose) {
                        close();
                        return result(isWindowOpen, didApply)
                    }
                    requiresProjection = true
                }
            } else if (nativeEvent.eventKind == 52u32) {
                // 平台组字相位属于声明过的会话节点：窗口就地判决（update/commit/cancel），
                // owner 不参与，也不会出现同一次提交的第二写入者。
                let compositionCommitted = routeOwnedTextCompositionPhase(nativeEvent)
                didApply = didApply || compositionCommitted
                requiresProjection = true
            } else if (nativeEvent.eventKind == CJGUI_INTERNAL_RENDERER_EVENT_HUMAN_COMPOSABLE_CONTEXT_MENU_REQUEST) {
                if (routeContextMenuRequest(nativeEvent)) {
                    requiresProjection = true
                } else {
                    let rejection = controller.rejectUiEvent(Int64(nativeEvent.eventKind), Int64(nativeEvent.nodeId))
                    didApply = didApply || rejection.didApply
                    if (rejection.shouldClose) {
                        close()
                        return result(isWindowOpen, didApply)
                    }
                }
            } else if (nativeEvent.eventKind == 36u32 && routeContextMenuDismiss(nativeEvent)) {
                didApply = true
                requiresProjection = true
            } else if (nativeEvent.eventKind == 31u32 && routeContextMenuOutsideFocus(nativeEvent)) {
                // The outside focus and its paired activation come from the
                // same physical click. Dismiss through event 36, then suppress
                // only that target's activation for this FIFO turn.
                didApply = true
                requiresProjection = true
            } else if (nativeEvent.eventKind == 27u32 && consumeContextMenuOutsideActivation(nativeEvent)) {
                // Deliberately consumed: a click outside dismisses the menu
                // without activating the underlying node on the same press.
            } else if ((nativeEvent.eventKind >= 27u32 && nativeEvent.eventKind <= 31u32) || nativeEvent.eventKind ==
                36u32 || nativeEvent.eventKind == 51u32) {
                let nodeId = Int64(nativeEvent.nodeId)
                let rawEventText = internalRendererFormEventText(sessionToken)
                let nativeWheel: ?CjguiComposableUiWheelDelta = if (nativeEvent.eventKind == 30u32) {
                    cjguiParseWheelDelta(rawEventText)
                } else { None }
                // Decode the private wheel carrier before any viewport or
                // controller dispatch. Legacy consumers never see its syntax.
                let eventText = if (let Some(wheel) <- nativeWheel) {
                    wheel.legacyText()
                } else { rawEventText }
                if (nativeEvent.eventKind == 36u32) {
                    if (let Some(request) <- activeContextMenuRequest) {
                        if (eventText == "escape:${request.requestId}") { contextMenuDismissReason = "escape" }
                    }
                }
                let ordinaryWheel = nativeEvent.eventKind == 30u32 && nativeEvent.gestureEpoch == 0u64
                var resolved = if (ordinaryWheel) {
                    resolveAcceptedWheelTarget(nativeEvent, nativeWheel.isSome())
                } else if (nativeEvent.nodeId == 0u64) {
                    CjguiComposableUiLayoutNode.missing()
                } else {
                    nativeInputScene.resolveInput(nodeId, nativeEvent.resourceId, Int64(nativeEvent.nodeKind),
                        Int64(nativeEvent.projectionVersion))
                }
                if (!ordinaryWheel && resolved.nodeId != nodeId && nativeEvent.nodeId != 0u64) {
                    // A pointer-reporting, non-input node (a read-only
                    // presentation fragment) resolves through the pointer-target
                    // path with the same identity checks.
                    resolved = nativeInputScene.resolvePointerTarget(nodeId, nativeEvent.resourceId,
                        Int64(nativeEvent.nodeKind), Int64(nativeEvent.projectionVersion))
                }
                if (!ordinaryWheel && resolved.nodeId != nodeId && nativeEvent.eventKind == 30u32 && nativeEvent.nodeId != 0u64) {
                    // A wheel gesture resolves by DECLARATION, not by node kind:
                    // native routing already admits a plain container that
                    // declared wheelScrollable, and this is the other half of
                    // that capability. Without it the intent dies here even
                    // though the framework routed it (B, 2026-09-28). This
                    // resolver is scroll-only: such a container is still not a
                    // click/keyboard/focus input target.
                    resolved = nativeInputScene.resolveWheelTarget(nodeId, nativeEvent.resourceId,
                        Int64(nativeEvent.nodeKind), Int64(nativeEvent.projectionVersion))
                }
                var continuation = if (resolved.nodeId == nodeId || ordinaryWheel) {
                    resolved
                } else {
                    resolveLocalTextContinuation(
                        Int64(nativeEvent.eventKind),
                        nodeId,
                        nativeEvent.resourceId,
                        Int64(nativeEvent.nodeKind),
                        eventText,
                        Int64(nativeEvent.projectionVersion)
                    )
                }
                // This exception is only the paired terminal of an admitted
                // physical control press. Keyboard, AX, text, wheel and
                // pointer-capture events keep their existing version rules.
                let isPressActivation = (nativeEvent.eventKind == 27u32 || nativeEvent.eventKind == 29u32) &&
                    nativeEvent.bindingEpoch != 0u64 && nativeEvent.gestureEpoch == 0u64
                if (isPressActivation) {
                    continuation = consumePressActivation(nativeEvent.bindingEpoch, nodeId,
                        nativeEvent.resourceId, Int64(nativeEvent.nodeKind), Int64(nativeEvent.eventKind),
                        eventText,
                        if (nativeEvent.pointerGeometryAccepted) { nativeEvent.pointerVisualX } else {
                            Float64(nativeEvent.pointerX) },
                        if (nativeEvent.pointerGeometryAccepted) { nativeEvent.pointerVisualY } else {
                            Float64(nativeEvent.pointerY) })
                }
                let gestureBindingReady = nativeEvent.gestureEpoch == 0u64 ||
                    (nativeEvent.gestureAppInstance != 0u64 && nativeEvent.gestureComponentInstance != 0u64 &&
                    nativeEvent.gestureSurfaceGeneration != 0u64 && nativeEvent.gesturePointerId >= 0 &&
                    nativeEvent.acceptedBindingEpoch != 0u64 &&
                    currentAcceptedBindingEpoch(continuation) == nativeEvent.acceptedBindingEpoch)
                let wantsWheelDelta = nativeEvent.eventKind == 30u32 &&
                    if (let Some(consumer) <- (controller as CjguiComposableUiWheelDeltaConsumer)) {
                        consumer.consumesWheelDelta(continuation)
                    } else { false }
                if (nativeEvent.eventKind == 30u32 && rawEventText.startsWith("cjgui-wheel-v1|") &&
                    nativeWheel.isNone()) {
                    let refusal = controller.rejectUiEvent(30, nodeId)
                    didApply = didApply || refusal.didApply
                    if (refusal.shouldClose) { close(); return result(isWindowOpen, didApply) }
                    continue
                }
                // Zero-y lifecycle packets are observable only by an opted-in
                // consumer. They cannot activate the old "else -> next" step.
                if (nativeEvent.eventKind == 30u32 && nativeWheel.isSome() &&
                    continuation.nodeId == nodeId && eventText.size == 0 && !wantsWheelDelta) {
                    let wheel = nativeWheel.getOrThrow()
                    if (wheel.beginsGesture() || wheel.isTerminal()) {
                        if (let Some(binding) <- acceptedWheelBindings.get(nodeId)) {
                            binding.clearPreciseRemainder()
                        }
                    }
                    if (ordinaryWheel) {
                        if (let Some(viewport) <- continuation.scrollViewport) {
                            wheelViewportRequests.add(CjguiWheelViewportRequest(viewport,
                                viewport.requestGeneration(), viewport.offset(),
                                viewport.requestGeneration(), viewport.offset()))
                        }
                    }
                    continue
                }
                // A viewport-bound scroll area is owned by the framework: the
                // real wheel gesture changes the shared viewport request and the
                // next commit presents the new offset. The business version,
                // drafts and selection are untouched, and no field write is
                // invented to drive the viewport.
                let wheelViewport: ?CjguiComposableUiScrollViewport = if (nativeEvent.eventKind == 30u32) {
                    continuation.scrollViewport
                } else { None }
                var scrollRequestedBefore: Int64 = 0
                var scrollGenerationBefore: Int64 = 0
                var scrollAcceptedBefore: Int64 = 0
                if (let Some(viewport) <- wheelViewport) {
                    scrollRequestedBefore = viewport.offset()
                    scrollGenerationBefore = viewport.requestGeneration()
                    scrollAcceptedBefore = viewport.acceptedOffset()
                }
                let viewportScrollApplied = gestureBindingReady && nativeEvent.eventKind == 30u32 && !wantsWheelDelta && continuation.nodeId == nodeId &&
                    applyViewportScrollStep(continuation, eventText, nativeWheel)
                var scrollRequestedAfter: Int64 = 0
                var scrollGenerationAfter: Int64 = 0
                var scrollAcceptedAfter: Int64 = 0
                if (let Some(viewport) <- wheelViewport) {
                    scrollRequestedAfter = viewport.offset()
                    scrollGenerationAfter = viewport.requestGeneration()
                    scrollAcceptedAfter = viewport.acceptedOffset()
                    if (nativeEvent.bindingEpoch != 0u64 && gestureBindingReady &&
                        !wantsWheelDelta && continuation.nodeId == nodeId &&
                        acceptedWheelBindings.contains(nodeId)) {
                        if (let Some(delta) <- nativeWheel) {
                            dragEdgeFractionConsumed = delta.isPrecise &&
                                scrollRequestedBefore == scrollRequestedAfter &&
                                scrollGenerationBefore == scrollGenerationAfter &&
                                scrollRequestedAfter == scrollAcceptedAfter &&
                                ((delta.deltaY < 0.0 && scrollRequestedAfter < viewport.maximumOffset()) ||
                                 (delta.deltaY > 0.0 && scrollRequestedAfter > viewport.minimumOffset()))
                        }
                    }
                }
                // Tab can land on a legal control that is currently clipped out of
                // its viewport. Reveal it and let this commit present the new
                // offset: the focused identity does not change, so the keyboard
                // reaches an editor below the fold without a coordinate guess.
                if (gestureBindingReady && nativeEvent.eventKind == 31u32 && continuation.nodeId == nodeId &&
                    activationPrefixPending()) { deferredPairRevealNode = continuation.nodeId }
                let viewportFocusRevealed = gestureBindingReady && nativeEvent.eventKind == 31u32 && continuation.nodeId == nodeId &&
                    !activationPrefixPending() && revealAcceptedNodeIfNeeded(continuation.nodeId)
                // A tab TITLE is a framework-owned view intent: pointer activation
                // and the keyboard both switch the shared tab state, so a page
                // switch is presented by the next commit without a business write.
                let tabsIntentConsumed = gestureBindingReady && nativeEvent.eventKind == 27u32 && continuation.nodeId == nodeId &&
                    continuation.isTabTitle() && continuation.isEnabled && applyTabsActivationStep(continuation)
                if (tabsIntentConsumed) {
                    didApply = true
                    requiresProjection = true
                }
                let rejectsReboundPressActivation = !isPressActivation && gestureBindingReady && nativeEvent.eventKind == 27u32 && consumeSuppressedPressActivation(
                    continuation)
                if (gestureBindingReady && continuation.nodeId == nodeId && !rejectsReboundPressActivation && !tabsIntentConsumed) {
                    if (nativeEvent.eventKind == 30u32) { this.wheelObservationSerial += 1 }
                    let controllerVersionBefore = controller.uiSceneVersion()
                    let businessVersionBefore = currentBusinessOwnerRevision()
                    let positionRevisionBefore = animationDriver.positionRevision()
                    rememberInteraction(continuation, Int64(nativeEvent.eventKind), Int64(nativeEvent.selectionStart),
                        Int64(nativeEvent.selectionEnd))
                    if (nativeEvent.eventKind == 31u32) {
                        this.registerInstalledRangeForNativeFocus(continuation)
                    }
                    // 窗口拥有该节点的会话时，范围意图就地判决：owner 只经会话的 Sink
                    // 被写一次，消费方不重复判决同一意图。None ⇒ 仍走原 owner 路径。
                    let dispatch = match (routeOwnedTextSessionRangeEdit(nativeEvent, continuation, eventText)) {
                        case Some(sessionDispatch) => sessionDispatch
                        case None => controller.applyUiEvent(
                            CjguiComposableUiEvent(
                                continuation,
                                Int64(nativeEvent.eventKind),
                                eventText,
                                Int64(nativeEvent.selectionStart),
                                Int64(nativeEvent.selectionEnd),
                                Int64(nativeEvent.projectionVersion),
                                // A pointer activation must carry WHERE it happened:
                                // a pointer-reporting, non-input node resolves the
                                // clicked display offset from this point through the
                                // framework hit test. Keyboard/AX activations keep
                                // zero here and are unaffected.
                                pointerX: Int64(nativeEvent.pointerX),
                                pointerY: Int64(nativeEvent.pointerY),
                                pointerVisualX: nativeEvent.pointerVisualX,
                                pointerVisualY: nativeEvent.pointerVisualY,
                                pointerTranslateX: nativeEvent.pointerTranslateX,
                                pointerTranslateY: nativeEvent.pointerTranslateY,
                                pointerGeometryAccepted: nativeEvent.pointerGeometryAccepted,
                                // A queued pointer activation keeps the modifier
                                // state observed when that pointer event happened;
                                // keyboard/AX activations are enqueued with zero
                                // in the native bridge and therefore never inherit
                                // a previous mouse gesture's Command/Shift.
                                modifierFlags: Int64(nativeEvent.modifierFlags),
                                wheelDelta: nativeWheel,
                                wheelEventSerial: if (nativeEvent.eventKind == 30u32) { this.wheelObservationSerial } else { 0 },
                                frameworkScrollApplied: viewportScrollApplied,
                                scrollRequestedBefore: scrollRequestedBefore,
                                scrollRequestedAfter: scrollRequestedAfter,
                                scrollAcceptedBefore: scrollAcceptedBefore,
                                scrollAcceptedAfter: scrollAcceptedAfter
                            )
                        )
                    }
                    didApply = didApply || dispatch.didApply || viewportScrollApplied
                    if (ordinaryWheel && !wantsWheelDelta &&
                        (viewportScrollApplied || !dispatch.didApply) &&
                        controller.uiSceneVersion() == controllerVersionBefore &&
                        currentBusinessOwnerRevision() == businessVersionBefore &&
                        animationDriver.positionRevision() == positionRevisionBefore) {
                        if (let Some(viewport) <- wheelViewport) {
                            wheelViewportRequests.add(CjguiWheelViewportRequest(viewport,
                                scrollGenerationBefore, scrollRequestedBefore,
                                scrollGenerationAfter, scrollRequestedAfter))
                        }
                    }
                    if (viewportScrollApplied || viewportFocusRevealed) {
                        requiresProjection = true
                    }
                    if (dispatch.shouldClose) {
                        close();
                        return result(isWindowOpen, didApply)
                    }
                    if ((nativeEvent.eventKind == 28u32 || nativeEvent.eventKind == 51u32) && !dispatch.didApply &&
                        isEditableTextNodeKind(continuation.nodeKind)) {
                        // The owner refused this edit. Native already applied it
                        // locally, so the accepted value must be written back on
                        // the next projection instead of being skipped as "same".
                        clearPendingLocalTextValue()
                    }
                    if (nativeEvent.eventKind == 51u32 && textRangeEditDeltaDeliveryEnabled && !dispatch.didApply &&
                        isEditableTextNodeKind(continuation.nodeKind)) {
                        // A refused RANGE edit leaves a proxy that the ordinary
                        // projection path cannot repair: the Cangjie scene is
                        // unchanged, so staging would skip the node, and native
                        // reads "candidate == previous value" as a local edit to
                        // preserve. Record an explicit rollback intent instead.
                        refusedRangeTextPending = true
                        refusedRangeTextNodeId = continuation.nodeId
                        refusedRangeTextResourceId = continuation.resourceId
                        refusedRangeTextNodeKind = continuation.nodeKind
                        refusedRangeTextAttempts = 0
                    }
                    if (nativeEvent.eventKind == 28u32 && dispatch.didApply && isEditableTextNodeKind(
                        continuation.nodeKind)) {
                        pendingLocalTextNodeId = continuation.nodeId
                        pendingLocalTextResourceId = continuation.resourceId
                        pendingLocalTextNodeKind = continuation.nodeKind
                        pendingLocalTextValue = eventText
                        pendingLocalTextOwnerRevision = currentBusinessOwnerRevision()
                        localTextContinuationNodeId = continuation.nodeId
                        localTextContinuationResourceId = continuation.resourceId
                        localTextContinuationNodeKind = continuation.nodeKind
                        localTextContinuationValue = eventText
                        localTextContinuationOwnerVersion = controller.uiSceneVersion()
                    } else if (nativeEvent.eventKind == 31u32) {
                        // A focus transfer ends the narrow adapter handoff.
                        // Returning to a field later is a new interaction,
                        // never authority for a stale callback captured
                        // before the blur/re-focus sequence.
                        clearLocalTextContinuation()
                    }
                    if (controller.uiSceneVersion() == controllerVersionBefore &&
                        (nativeEvent.eventKind == 31u32 || animationDriver.positionRevision() != positionRevisionBefore)) {
                        // Focus paint is framework-local when the owner did
                        // not change its declared scene. Preserve the system
                        // text proxy and reuse the accepted geometry.
                        requiresInteractionPaint = true
                    } else {
                        requiresProjection = true
                    }
                } else {
                    // S3（ACTIVATE 分发延迟追因）：大门未通过时留一行事实。
                    // 丢弃原因四选一：gestureBindingReady=false（绑定代次未就绪）、
                    // continuation.nodeId != nodeId（resolve 失败/换绑）、
                    // rejectsReboundPressActivation（按压身份翻转抑制）、
                    // tabsIntentConsumed（Tab 标题消费）。
                    if (nativeEvent.eventKind == 27u32) {
                        println("CJGUI_ACTIVATE_DROPPED evNode=${nodeId} evV=${nativeEvent.projectionVersion} " +
                            "evEpoch=${nativeEvent.acceptedBindingEpoch} resolvedNode=${continuation.nodeId} " +
                            "resolvedSceneV=${nativeInputScene.version} bindingReady=${gestureBindingReady} " +
                            "reboundSuppress=${rejectsReboundPressActivation} tabConsumed=${tabsIntentConsumed} " +
                            "sceneV=${nativeInputScene.version}")
                    }
                    let rejection = controller.rejectUiEvent(Int64(nativeEvent.eventKind), nodeId)
                    didApply = didApply || rejection.didApply
                    if (rejection.shouldClose) {
                        close();
                        return result(isWindowOpen, didApply)
                    }
                    requiresProjection = true
                }
            } else if (nativeEvent.eventKind == 32u32) {
                requiresProjection = true
            }
            } catch (error: Exception) {
                if (prefixMember > 0) { activationPrefixGate.cancel() }
                throw error
            } finally {
                if (nativeEvent.eventKind == 30u32 && nativeEvent.bindingEpoch != 0u64) {
                    if (let Some(facts) <- macTextCapture) {
                        if (let Some(scroll) <- facts.scroll) {
                            if (facts.revokedReason.size == 0 && nativeEvent.bindingEpoch == facts.gestureEpoch &&
                                Int64(nativeEvent.nodeId) == scroll.binding.nodeId &&
                                nativeEvent.resourceId == scroll.binding.resourceId) {
                                let awaited = CjguiMacDragEdgeAwaitedViewport(sessionToken, facts.gestureEpoch,
                                    scroll.binding, nativeInputScene.version)
                                let ackStatus = internalRendererAckDragEdgeViewport(sessionToken, facts.gestureEpoch,
                                    scroll.binding, nativeInputScene.version,
                                    if (dragEdgeFractionConsumed) { 4u32 } else { 1u32 })
                                if (ackStatus == CJGUI_INTERNAL_RENDERER_OK && !dragEdgeFractionConsumed &&
                                    awaited.requested != awaited.accepted) {
                                    macDragEdgeAwaitedViewport = Some(awaited)
                                }
                            }
                        }
                    }
                }
                if (macCaretDispatchActive) {
                        let _ = this.recordMacCaretOwnerEditIfApplied()
                        macCaretDispatchActive = false
                        let retained = !retainedVisualInputIntents.isEmpty() &&
                            retainedVisualInputIntents[0].sequence == nativeEvent.inputSequence
                        let arrivingIntent = if (nativeEvent.eventKind == 35u32) {
                            internalRendererFormEventText(sessionToken)
                        } else {
                            ""
                        }
                        if (getVariable("CJGUI_CARET_FINISH_TRACE").isSome()) {
                            let headSeq = if (retainedVisualInputIntents.isEmpty()) {
                                UInt64.Max
                            } else {
                                retainedVisualInputIntents[0].sequence
                            }
                            println("CJGUI_CARET_FINISH kind=${nativeEvent.eventKind} " +
                                "intent=[${arrivingIntent}] seq=${nativeEvent.inputSequence} " +
                                "prev=${nativeEvent.inputPreviousSequence} head=${headSeq} " +
                                "retained=${retained} " +
                                "restoreId=${macCaretRestoreId} hasInput=${macCaretInput.isSome()}")
                        }
                        if (!retained && !macCaretEditApplied && macCaretRestoreId < 0 && macCaretInput.isSome()) {
                            let _ = this.finishMacCaretInput(3u32)
                        }
                    }
                    if (prefixMember == 2) {
                    traceActivationPrefixMarker(35u32, nativeEvent.activationPrefix)
                    activationPrefixGate.settleTerminal(nativeEvent.activationPrefix)
                }
            }
        }
        } finally {
            drainingInputEvents = false
            this.traceOwnerPhase("pump_fifo_drain", drainStarted)
        }
        // The native focus/activation pair is emitted adjacently for one
        // pointer-down. An unmatched suppression expires with this FIFO turn.
        if (!activationPrefixPending()) {
            contextMenuOutsideSuppressPending = false
            if (deferredPairRevealNode >= 0) {
                if (focusedNodeId == deferredPairRevealNode) {
                    requiresProjection = revealAcceptedNodeIfNeeded(deferredPairRevealNode) || requiresProjection
                }
                deferredPairRevealNode = -1
            }
        }
        cjguiOwnerTraceBoundary(sessionToken, 0u64, 307u32, 0u32, 0u32, 0u64, UInt64.Max)
        finishPendingSourceHandoffIfAllowed(activationPrefixPending())
        cjguiOwnerTraceBoundary(sessionToken, 0u64, 308u32, 0u32, 0u32, 0u64, UInt64.Max)
        if (requiresProjection) {
            if (getVariable("CJGUI_VIEWPORT_HANDOFF_TRACE").isSome()) {
                println("CJGUI_VIEWPORT_HANDOFF phase=batch only_wheel=${ordinaryWheelOnlyBatch} " +
                    "wheel_count=${ordinaryWheelCount} requests=${wheelViewportRequests.size} " +
                    "paint=${requiresInteractionPaint} prepared=${preparingCandidate.isSome()} " +
                    "static=${staticLayoutPreparation.isSome()}")
            }
            if (ordinaryWheelOnlyBatch && ordinaryWheelCount > 0 &&
                wheelViewportRequests.size == ordinaryWheelCount && !requiresInteractionPaint) {
                requestViewportRefresh(wheelViewportRequests)
            } else {
                requestRefresh()
            }
            if (!refreshNow) {
                deferredEventWork = true
            }
            if (refreshNow) {
                let refreshed = refreshIfNeeded()
                if (!refreshed && !isWindowOpen) {
                    return result(isWindowOpen, didApply)
                }
                if (refreshed) { reconcileContextMenuAfterAcceptedScene() }
            }
        } else if (requiresInteractionPaint) {
            if (refreshNow) {
                let _ = refreshInteractionPaintIfNeeded()
            } else {
                deferredInteractionPaint = true
                deferredEventWork = true
            }
        }
        // The FIFO is drained for this turn. Only now is it safe to roll a
        // refused range edit's proxy back: every queued delta has been judged
        // against the accepted value, and no later event is pending.
        let recoveryStarted = this.ownerPhaseStarted()
        cjguiOwnerTraceBoundary(sessionToken, 0u64, 309u32, 0u32, 0u32, 0u64, UInt64.Max)
        recoverRefusedRangeTextProxy()
        cjguiOwnerTraceBoundary(sessionToken, 0u64, 310u32, 0u32, 0u32, 0u64, UInt64.Max)
        this.traceOwnerPhase("pump_refused_proxy_recovery", recoveryStarted)
        return result(true, didApply)
    }

    private func closeStopsNewOwnerWork(): Bool {
        return internalRendererCloseStopsNewOwnerWork(closeIntentPending, discardRetryReason.size > 0)
    }

    public func close() {
        this.retireOwnerSelectionHandoff("window_closed")
        if (!isWindowOpen) {
            return
        }
        let prepared = this.prepareTextSessionUnbind()
        if (!prepared || this.hasUnclaimedCaretRecovery()) {
            pendingRefreshReason = "input_recovery_draft_pending"
            lastNativeFailure = "input_recovery_draft_pending"
            startupPhase = "input_recovery_draft_pending"
            requestRefresh()
            return
        }
        retainedVisualInputIntents.clear()
        retainedVisualInputGeneration = 0u64
        closeIntentPending = true
        activationPrefixGate.cancel()
        deferredPairRevealNode = -1
        // An accepted owner decision is still owed its native ACK. Retain the
        // window/session and the close intent when that exact ACK cannot be
        // confirmed now; pumpWithRefreshPolicy retries it before any dequeue,
        // then refreshIfNeeded completes this close after settlement succeeds.
        if (heldInstalledRangeSettlement.isSome() && !this.retryHeldInstalledRangeSettlement()) {
            pendingRefreshReason = "close_pending_installed_range_ack"
            lastNativeFailure = "close_pending_installed_range_ack"
            startupPhase = "close_pending_installed_range_ack"
            return
        }
        // A1：关闭前先尝试结算原票据。仍未定时不得谎称已关闭——native 会拒绝
        // 销毁未结算的会话，核心同样把窗口留在“关闭未完成”，等 owner 继续结算。
        if (settlePendingPresent()) {
            if (!isWindowOpen) {
                return
            }
            match (pendingTransaction) {
                case Some(tx) =>
                    if (tx.ackCompleted && !tx.coreSettled) {
                        // A1：终止收敛持有（native 已确认、协议已 ACK、核心收尾
                        // 未完整）的唯一出路就是关闭——直接 discard。ACK 已完成，
                        // native destroy 不会因未结算被拒；原票与故障已留痕。
                        discardSession("close_after_settlement_incomplete")
                        return
                    }
                    // A1：持久记录关闭意图。票据结算（Accepted 按事实收尾 /
                    // Rejected 回滚）完成后由刷新门自动完成本次 close；
                    // 关闭态不再恢复焦点/挂代理。
                    pendingRefreshReason = "close_pending_settlement"
                    lastNativeFailure = "close_pending_settlement"
                    startupPhase = "close_pending_settlement"
                    return
                case None => ()
            }
        }
        if (!isWindowOpen) {
            return
        }
        if (isWindowOpen) {
            internalRendererRequestCloseBeforeDestroy(sessionToken)
        }
        discardSession("close")
    }
    /// Ask the controller through the same close decision used by a native
    /// window-close event. A rejection leaves the Cangjie projection open;
    /// acceptance closes its session without exposing a platform object.
    public func requestCloseFromApplication(): Bool {
        if (!isWindowOpen) {
            return false
        }
        let closeResult = controller.requestWindowClose()
        if (closeResult.shouldClose) {
            close()
            return true
        }
        if (closeResult.didApply) {
            requestRefresh()
        }
        return false
    }
    public func cancelComposition(): String {
        var hadMarked: Int32 = 0
        var returned: Int32 = 0
        var status: Int32 = CJGUI_INTERNAL_RENDERER_INTERNAL_ERROR
        unsafe {
            status = cjgui_internal_renderer_cancel_composition(this.sessionToken, inout hadMarked, inout returned)
        }
        return "status=${status} had_marked=${hadMarked} returned=${returned}"
    }

    /// Reanchor the live platform composition onto a new proxy base instead of
    /// cancelling it. `newBaseText` is the new owner projection the platform
    /// should hold once the preedit is removed; the preedit itself is installed
    /// at `[replacementStart16, +replacementLength16)` of that base. The window
    /// supplies the native identity from its accepted binding (the presentation
    /// surface when one is adopted, else the owned text surface). Native
    /// validates the exact node/resource/kind/scene and the live marked run and
    /// reads back the installed text, marked range, attributes and selection
    /// before signing; a refused receipt changed nothing.
    public func reanchorActiveComposition(newBaseText: String, replacementStart16: Int64,
        replacementLength16: Int64): CjguiCompositionReanchorReceipt {
        if (!isWindowOpen) {
            return CjguiCompositionReanchorReceipt.refused(CJGUI_INTERNAL_RENDERER_VIEW_INVALIDATED)
        }
        let nodeId = if (presentationTextSessionNodeId >= 0) {
            presentationTextSessionNodeId
        } else {
            ownedTextSessionNodeId
        }
        let resourceId = if (presentationTextSessionNodeId >= 0) {
            presentationTextSessionResourceId
        } else {
            ownedTextSessionResourceId
        }
        let nodeKind = if (presentationTextSessionNodeId >= 0) {
            CJGUI_COMPOSABLE_UI_TEXT
        } else {
            ownedTextSessionNodeKind
        }
        if (nodeId < 0 || resourceId < 0 || nodeKind < 0) {
            return CjguiCompositionReanchorReceipt.refused(CJGUI_INTERNAL_RENDERER_INTERNAL_ERROR)
        }
        let reanchored = internalRendererReanchorComposition(sessionToken, nodeId, resourceId, nodeKind,
            nativeInputScene.version, newBaseText, replacementStart16, replacementLength16)
        if (reanchored[0] != CJGUI_INTERNAL_RENDERER_OK) {
            return CjguiCompositionReanchorReceipt.refused(reanchored[0])
        }
        return CjguiCompositionReanchorReceipt(true, reanchored[1], reanchored[2], reanchored[3],
            reanchored[4], reanchored[5], reanchored[0])
    }

    /// The native window number of this window, so a capture can name the window it wants.
    /// Relying on "the frontmost window" silently produced all-black screenshots.
    public func windowNumber(): Int64 {
        var number: Int64 = 0
        var status: Int32 = CJGUI_INTERNAL_RENDERER_INTERNAL_ERROR
        unsafe {
            status = cjgui_internal_renderer_window_number(this.sessionToken, inout number)
        }
        return if (status == CJGUI_INTERNAL_RENDERER_OK) {
            number
        } else {
            0
        }
    }

    public func probeImageTexture(nodeId: Int64): String {
        var found: Int32 = 0
        var hasTexture: Int32 = 0
        var keyLength: Int32 = 0
        var failed: Int32 = 0
        var status: Int32 = CJGUI_INTERNAL_RENDERER_INTERNAL_ERROR
        unsafe {
            status = cjgui_internal_renderer_probe_image_texture(this.sessionToken, UInt64(nodeId), inout found,
                inout hasTexture, inout keyLength, inout failed)
        }
        return "status=${status} found=${found} texture=${hasTexture} key_len=${keyLength} failed=${failed}"
    }
    public func isOpen(): Bool {
        return isWindowOpen
    }

    /// Returns exactly one pending standard-Quit intent for this window.
    /// Acknowledgement clears native coalescing before the application asks
    /// its decision provider, so a rejected request leaves a later human Quit
    /// available while repeated clicks before that turn remain idempotent.
    public func consumeApplicationExitRequest(): Bool {
        if (!applicationExitRequested) {
            return false
        }
        applicationExitRequested = false
        internalRendererCompleteApplicationExitRequest()
        return true
    }
    /// True when this window opted in to explicit text edit deltas and the
    /// native renderer accepted the request. Readiness only; it says nothing
    /// about whether any edit has happened yet.
    public func isTextRangeEditDeltaDeliveryEnabled(): Bool {
        return textRangeEditDeltaDeliveryEnabled
    }

    public func nativeStatus(): Int32 {
        return lastNativeStatus
    }
    public func displayedSceneVersion(): Int64 {
        return renderedScene.version
    }

    /// Read-only view of the window's OWN accepted scene: the displayed text of
    /// the accepted node carrying this semantic id, or None when the accepted
    /// scene has no such node.
    ///
    /// It reports what the window actually committed, not the controller's
    /// latest build output, so a caller can verify that a content change really
    /// reached the accepted projection in the same step instead of inferring it
    /// from controller state or from a later full rebuild. A text node carries
    /// its string in `value` and a button in `label`, so the displayed text is
    /// whichever the node kind really uses.
    public func acceptedNodeText(semanticId: String): ?String {
        if (!isWindowOpen) {
            return None
        }
        for (node in renderedScene.nodes()) {
            if (node.semanticId == semanticId) {
                if (!node.label.isEmpty()) {
                    return Some(node.label)
                }
                return Some(node.value)
            }
        }
        return None
    }

    /// Read-only dump of the window's accepted scene, one line per node:
    /// node_id|kind|semantic_id|label|value|field_id|action|operation|
    /// operation_target|resource|role|gap|padding|x,y,w,h.
    ///
    /// A generation node's semantic id is its declared structural key, so a caller
    /// can address the node the window really accepted (content, binding, layout
    /// and style) instead of guessing a registry allocation. It reports the
    /// committed scene, never the controller's latest build.
    public func acceptedSceneDump(): String {
        if (!isWindowOpen) {
            return ""
        }
        let builder = StringBuilder()
        for (node in renderedScene.nodes()) {
            builder.append(
                "${node.nodeId}|${node.nodeKind}|${node.semanticId}|${node.label}|${node.value}|" +
                    "${node.fieldId}|${node.actionName}|${node.operationActionName}|" +
                    "${node.operationResourceId}|${node.resourceId}|${node.displayValueRole}|" +
                    "${node.style.gap}|${node.style.padding}|" +
                    "${node.bounds.x},${node.bounds.y},${node.bounds.width},${node.bounds.height}\n")
        }
        return builder.toString()
    }

    /// Accepted VALUE of the node carrying this semantic id, or None when the
    /// accepted scene has no such node. `acceptedNodeText` reports the accessible
    /// caption (a button's label, a text node's value); an editable control's
    /// displayed content is its value, and this is the precise probe for it.
    public func acceptedNodeValue(semanticId: String): ?String {
        if (!isWindowOpen) {
            return None
        }
        for (node in renderedScene.nodes()) {
            if (node.semanticId == semanticId) {
                return Some(node.value)
            }
        }
        return None
    }

    /// Accepted geometry of the node carrying this semantic id, or None when the
    /// accepted scene has no such node. Companion to `acceptedNodeText`: it lets a
    /// caller verify that a layout change really reached the accepted scene
    /// instead of inferring it from a controller counter.
    public func acceptedNodeBounds(semanticId: String): ?CjguiComposableUiRect {
        if (!isWindowOpen) {
            return None
        }
        for (node in renderedScene.nodes()) {
            if (node.semanticId == semanticId) {
                return Some(node.bounds)
            }
        }
        return None
    }
    /// Exact logical-point presentation bounds of an accepted semantic node.
    /// `acceptedNodeBounds` remains the integer layout rectangle.
    public func acceptedNodeVisualBounds(semanticId: String): ?CjguiComposableUiVisualRect {
        if (!isWindowOpen) { return None }
        let nodes = renderedScene.nodes()
        var index: Int64 = 0
        while (index < nodes.size) {
            if (nodes[index].semanticId == semanticId) {
                return Some(renderedScene.visualGeometryAt(index).visualBounds(nodes[index].bounds))
            }
            index += 1
        }
        return None
    }

    /// Number of nodes in the window's accepted scene (0 when nothing is
    /// accepted). Read-only: it reports what the window committed, so a caller
    /// can record the real expansion size of the scene it timed.
    public func acceptedNodeCount(): Int64 {
        if (!isWindowOpen) {
            return 0
        }
        return renderedScene.nodes().size
    }

    private func diagnosticOverlayFlags(options: CjguiComposableUiDiagnosticOverlayOptions): UInt32 {
        if (!options.enabled) { return 0u32 }
        var flags: UInt32 = 0u32
        if (options.layout) { flags += 1u32 }
        if (options.clip) { flags += 2u32 }
        if (options.effectOutput) { flags += 4u32 }
        if (options.backdropSample) { flags += 8u32 }
        return flags
    }

    private func syncDiagnosticOverlayAfterAcceptance() {
        let options = diagnosticOverlayOptions
        if (!options.enabled || !isWindowOpen) { return }
        var selectedNodeId: UInt64 = 0u64
        var hasSelection: UInt8 = 0u8
        if (options.selectedIdentityKey.size > 0) {
            for (node in renderedScene.nodes()) {
                if (node.identityKey == options.selectedIdentityKey && node.nodeId >= 0) {
                    selectedNodeId = UInt64(node.nodeId)
                    hasSelection = 1u8
                    break
                }
            }
            if (hasSelection == 0u8) {
                // A removed/rebound accepted identity must not revive merely
                // because a later scene reuses the same native numeric id.
                diagnosticOverlayOptions = CjguiComposableUiDiagnosticOverlayOptions(true,
                    layout: options.layout, clip: options.clip, effectOutput: options.effectOutput,
                    backdropSample: options.backdropSample)
            }
        }
        let status = unsafe { cjgui_internal_renderer_set_diagnostic_overlay(
            sessionToken, diagnosticOverlayFlags(diagnosticOverlayOptions), selectedNodeId, hasSelection) }
        diagnosticOverlayStatus = if (status == CJGUI_INTERNAL_RENDERER_OK) { "enabled" } else { "native_unavailable" }
    }

    /// Toggle an independent developer paint layer. It never changes a scene,
    /// owner, hit target, focus target or AX tree and never requests Metal work.
    public func setDiagnosticOverlay(options: CjguiComposableUiDiagnosticOverlayOptions): Bool {
        if (!isWindowOpen || renderedScene.version <= 0) { return false }
        let flags = diagnosticOverlayFlags(options)
        if (options.enabled && flags == 0u32) { return false }
        var selectedNodeId: UInt64 = 0u64
        var hasSelection: UInt8 = 0u8
        if (options.enabled && options.selectedIdentityKey.size > 0) {
            for (node in renderedScene.nodes()) {
                if (node.identityKey == options.selectedIdentityKey && node.nodeId >= 0) {
                    selectedNodeId = UInt64(node.nodeId)
                    hasSelection = 1u8
                    break
                }
            }
            if (hasSelection == 0u8) { return false }
        }
        let status = unsafe { cjgui_internal_renderer_set_diagnostic_overlay(
            sessionToken, flags, selectedNodeId, hasSelection) }
        if (status != CJGUI_INTERNAL_RENDERER_OK) {
            diagnosticOverlayStatus = "native_unavailable"
            return false
        }
        diagnosticOverlayOptions = options
        diagnosticOverlayStatus = if (options.enabled) { "enabled" } else { "disabled" }
        return true
    }

    /// Explicitly enables publication of the bounded workload scalars in
    /// `diagnosticSnapshot`. Native counts the work points in normal builds and
    /// this call changes no scene, submission or refresh behavior: disabled
    /// reads publish -1 with status "disabled", enabled reads report the last
    /// completed refresh attempt and the session totals. Reads themselves never
    /// trigger a refresh, a clone or a submission.
    public func setWorkloadDiagnostics(enabled: Bool): Bool {
        if (!isWindowOpen) {
            workloadDiagnosticsStatus = "closed"
            return false
        }
        workloadDiagnosticsEnabled = enabled
        workloadDiagnosticsStatus = if (enabled) { "enabled" } else { "disabled" }
        recordDiagnosticEnableTrace()
        return true
    }

    /// Experimental: enables normal-build monotonic timing for the current native window.
    /// This only toggles fixed scalar diagnostics and never requests a refresh
    /// or frame. Disabled snapshots publish -1/unavailable for all timings.
    public func setTimingDiagnostics(enabled: Bool): Bool {
        if (!isWindowOpen || sessionToken == CJGUI_INTERNAL_RENDERER_INVALID_SESSION_TOKEN) {
            timingDiagnosticsStatus = "closed"
            return false
        }
        let nativeStatus = unsafe { cjgui_internal_renderer_set_diagnostic_timing(
            sessionToken, if (enabled) { 1u32 } else { 0u32 }) }
        if (nativeStatus != CJGUI_INTERNAL_RENDERER_OK) {
            timingDiagnosticsEnabled = false
            timingDiagnosticsStatus = "native_unavailable"
            return false
        }
        timingDiagnosticsEnabled = enabled
        timingDiagnosticsStatus = if (enabled) { "enabled" } else { "disabled" }
        recordDiagnosticEnableTrace()
        return true
    }

    private func diagnosticTimerStart(): ?MonoTime {
        if (!timingDiagnosticsEnabled) { return None }
        return Some(MonoTime.now())
    }

    private func ownerPhaseStarted(): UInt64 {
        return unsafe { cjgui_internal_renderer_owner_trace_ns() }
    }

    private func ownerTraceTurnIdentity(): UInt64 {
        if (let Some(budget) <- ownerTurnBudget) { return UInt64(budget.turnIdentity()) }
        return UInt64.Max
    }

    /// Diagnostic hooks used by the product's opt-in owner trace. Native
    /// session tokens stay owned by this window.
    public func beginOwnerTraceTurn(turn: Int64): UInt64 {
        cjguiOwnerTraceBoundary(sessionToken, UInt64(turn), 144u32, 1u32, 0u32, 0u64, UInt64.Max)
        return cjguiOwnerTraceRecord(1u32, sessionToken, UInt64(turn), 0u64, 0u64,
            UInt64.Max, 0u32, 0u64)
    }

    public func endOwnerTraceTurn(turn: Int64, span: UInt64): Unit {
        let _ = cjguiOwnerTraceRecord(2u32, sessionToken, UInt64(turn), 0u64, 0u64,
            UInt64.Max, 0u32, span)
    }

    /// Experimental diagnostic boundary. Fixed native storage only; this
    /// does not change the budget or ask for a managed thread identity.
    public func recordOwnerTraceBoundary(turn: Int64, phase: UInt32): Unit {
        cjguiOwnerTraceBoundary(sessionToken, UInt64(turn), phase, 0u32, 0u32, 0u64, UInt64.Max)
    }

    public func exportOwnerTrace(): Unit {
        cjguiOwnerTraceExport()
    }

    /// Experimental, read-only diagnostic for the current pointer callback.
    /// Reuses the native FIFO's identity; empty means unknown. This key is not
    /// selection authority and must not be retained as an input capability.
    public func consumedPointerTraceIdentity(expectedEventKind: Int64): String {
        let fifo = internalRendererConsumedPointerFifo(sessionToken)
        if (fifo.generation == 0u64 || fifo.binding == 0u64 || fifo.first == 0u64 ||
            fifo.last < fifo.first || Int64(fifo.phase) != expectedEventKind) { return "" }
        return "${sessionToken}:${fifo.generation}:${fifo.binding}:${fifo.first}:${fifo.last}"
    }

    public func recordOwnerTraceLegacyPhase(phase: UInt32, startedNs: UInt64): Unit {
        cjguiOwnerTraceLegacySpan(sessionToken, ownerTraceTurnIdentity(), 0u64, UInt64.Max,
            phase, startedNs)
    }

    public func beginOwnerTracePhase(phase: UInt32, request!: UInt64 = 0u64): UInt64 {
        return cjguiOwnerTraceRecord(3u32, sessionToken, ownerTraceTurnIdentity(), request,
            0u64, UInt64.Max, phase, 0u64)
    }

    public func endOwnerTracePhase(phase: UInt32, span: UInt64, request!: UInt64 = 0u64): Unit {
        let _ = cjguiOwnerTraceRecord(4u32, sessionToken, ownerTraceTurnIdentity(), request,
            0u64, UInt64.Max, phase, span)
    }

    // Nested intervals are intentionally retained; consumers take interval
    // unions rather than adding a refresh to its contained native work.
    private func traceOwnerPhase(name: String, started: UInt64): Unit {
        if (started == 0u64) { return }
        let phase = if (name == "pump_native_poll") { 9u32 }
            else if (name == "pump_fifo_drain") { 9u32 }
            else if (name == "sync_projection") { 4u32 }
            else if (name == "refresh") { 19u32 }
            else if (name == "pump_refused_proxy_recovery") { 317u32 }
            else { 0u32 }
        cjguiOwnerTraceLegacySpan(sessionToken, ownerTraceTurnIdentity(), 0u64, 0u64, phase, started)
    }

    private func diagnosticElapsedNanoseconds(started: ?MonoTime): Int64 {
        if (let Some(begin) <- started) {
            let elapsed = (MonoTime.now() - begin).toNanoseconds()
            return if (elapsed < 0) { 0 } else { elapsed }
        }
        return -1
    }

    /// Captures the session totals at the start of one refresh attempt so its
    /// own cost can be attributed at the accept/reject terminal.
    private func recordDiagnosticEnableTrace(): Unit {
        let flags = (if (workloadDiagnosticsEnabled) { 1u64 } else { 0u64 }) +
            (if (timingDiagnosticsEnabled) { 2u64 } else { 0u64 })
        let _ = cjguiOwnerTraceRecord(21u32, sessionToken, ownerTraceTurnIdentity(), 0u64,
            0u64, UInt64.Max, 68u32, flags)
    }

    @When[os == "macOS"]
    private func readWorkloadAttemptCounts(expectedGeneration: UInt64):
        InternalRendererWorkloadAttemptCountsResult {
        var counts = CjguiInternalRendererWorkloadAttemptCounts()
        let status = unsafe { cjgui_internal_renderer_workload_attempt_counts(
            sessionToken, expectedGeneration, inout counts) }
        return InternalRendererWorkloadAttemptCountsResult(status, counts)
    }

    @When[os != "macOS"]
    private func readWorkloadAttemptCounts(expectedGeneration: UInt64):
        InternalRendererWorkloadAttemptCountsResult {
        var workload = CjguiInternalRendererDiagnosticWorkload()
        let status = unsafe { cjgui_internal_renderer_diagnostic_workload(sessionToken, inout workload) }
        var counts = CjguiInternalRendererWorkloadAttemptCounts()
        counts.nodeWriteCount = workload.nodeWriteCount
        counts.nodeCloneCount = workload.nodeCloneCount
        counts.nodeAllocationCount = workload.nodeAllocationCount
        counts.textLayoutPreparationCount = workload.textLayoutPreparationCount
        counts.imageDecodeStartCount = workload.imageDecodeStartCount
        return InternalRendererWorkloadAttemptCountsResult(status, counts)
    }

    private func beginWorkloadAttempt(): Unit {
        recordDiagnosticEnableTrace()
        timingAttemptActive = true
        if (!workloadDiagnosticsEnabled || !isWindowOpen ||
            sessionToken == CJGUI_INTERNAL_RENDERER_INVALID_SESSION_TOKEN) {
            workloadAttemptBaseValid = false
            return
        }
        let readSpan = this.beginOwnerTracePhase(66u32)
        let readResult = this.readWorkloadAttemptCounts(0u64)
        let status = readResult.status
        let workload = readResult.counts
        this.endOwnerTracePhase(66u32, readSpan)
        if (status != CJGUI_INTERNAL_RENDERER_OK) {
            workloadAttemptBaseValid = false
            workloadDiagnosticsStatus = "native_unavailable"
            return
        }
        workloadAttemptBase = workload
        workloadAttemptBaseValid = true
    }

    /// Stores the attempt's deltas at its accept or reject terminal. It is a
    /// no-op when observation is disabled or the attempt never captured a base.
    private func finalizeWorkloadAttempt(result: String): Unit {
        let totalSpan = this.beginOwnerTracePhase(89u32)
        try {
        if (timingAttemptActive) {
            timingAttemptActive = false
            let build = lastRefreshTiming.buildNanoseconds
            let layout = lastRefreshTiming.layoutNanoseconds
            let native = lastRefreshTiming.nativeStageAndSubmitNanoseconds
            if (build > 0) {
                totalBuildNanoseconds = if (totalBuildNanoseconds > Int64.Max - build) {
                    Int64.Max
                } else { totalBuildNanoseconds + build }
            }
            if (layout > 0) {
                totalLayoutNanoseconds = if (totalLayoutNanoseconds > Int64.Max - layout) {
                    Int64.Max
                } else { totalLayoutNanoseconds + layout }
            }
            if (native > 0) {
                totalNativeStageAndSubmitNanoseconds = if (
                    totalNativeStageAndSubmitNanoseconds > Int64.Max - native) {
                    Int64.Max
                } else { totalNativeStageAndSubmitNanoseconds + native }
            }
        }
        if (!workloadAttemptBaseValid) { return }
        workloadAttemptBaseValid = false
        let readSpan = this.beginOwnerTracePhase(67u32)
        let readResult = this.readWorkloadAttemptCounts(workloadAttemptBase.sessionGeneration)
        let status = readResult.status
        let workload = readResult.counts
        this.endOwnerTracePhase(67u32, readSpan)
        if (status != CJGUI_INTERNAL_RENDERER_OK) {
            workloadDiagnosticsStatus = "native_unavailable"
            return
        }
        workloadLastResult = result
        workloadLastNodeWrites = workloadDelta(workload.nodeWriteCount, workloadAttemptBase.nodeWriteCount)
        workloadLastNodeClones = workloadDelta(workload.nodeCloneCount, workloadAttemptBase.nodeCloneCount)
        workloadLastNodeAllocations = workloadDelta(workload.nodeAllocationCount,
            workloadAttemptBase.nodeAllocationCount)
        workloadLastTextLayoutPreparations = workloadDelta(workload.textLayoutPreparationCount,
            workloadAttemptBase.textLayoutPreparationCount)
        workloadLastImageDecodeStarts = workloadDelta(workload.imageDecodeStartCount,
            workloadAttemptBase.imageDecodeStartCount)
        } finally {
            this.endOwnerTracePhase(89u32, totalSpan)
        }
    }

    private func workloadDelta(current: UInt64, base: UInt64): Int64 {
        if (current <= base) { return 0 }
        let delta = current - base
        return if (delta > UInt64(Int64.Max)) { Int64.Max } else { Int64(delta) }
    }

    private func workloadScalar(value: UInt64): Int64 {
        return if (value > UInt64(Int64.Max)) { Int64.Max } else { Int64(value) }
    }

    /// Bounded immutable values from the currently accepted scene. Pagination
    /// requires the same window session and accepted version on every page.
    /// A read never invokes controller/build/layout/present or waits for GPU.
    public func diagnosticSnapshot(startIndex!: Int64 = 0, maximumNodes!: Int64 = 128,
        expectedSessionIdentity!: String = "", expectedAcceptedSceneVersion!: Int64 = -1): CjguiComposableUiDiagnosticSnapshot {
        return diagnosticSnapshotImpl(startIndex, maximumNodes, expectedSessionIdentity, expectedAcceptedSceneVersion,
            false)
    }

    /// Experimental macOS observation of the last published scalar facts.
    /// This does not refresh ACK/accepted/settlement state or query AppKit.
    /// Session/accepted-version mismatches fail closed; a missing publication
    /// is pending. Nodes, effect resources and traversed resource-byte totals
    /// are unavailable. Accepted, submitted and completed facts stay distinct.
    public func diagnosticScalarSnapshot(expectedSessionIdentity!: String = "",
        expectedAcceptedSceneVersion!: Int64 = -1): CjguiComposableUiDiagnosticSnapshot {
        return diagnosticSnapshotImpl(0, 1, expectedSessionIdentity, expectedAcceptedSceneVersion, true)
    }

    private func diagnosticSnapshotImpl(startIndex: Int64, maximumNodes: Int64, expectedSessionIdentity: String,
        expectedAcceptedSceneVersion: Int64, scalarOnly: Bool): CjguiComposableUiDiagnosticSnapshot {
        recordDiagnosticEnableTrace()
        let resultNodes = ArrayList<CjguiComposableUiDiagnosticNode>()
        let active = isWindowOpen && renderedScene.version > 0
        let acceptedVersion = if (active) {
            renderedScene.version
        } else {
            0
        }
        let session = if (active) {
            windowSessionIdentity
        } else {
            "unavailable"
        }
        var state = if (active) {
            "ok"
        } else {
            "closed"
        }
        if (active && ((expectedSessionIdentity.size > 0 && expectedSessionIdentity != session) || (expectedAcceptedSceneVersion >=
            0 && expectedAcceptedSceneVersion != acceptedVersion))) {
            state = "stale_accepted"
        }
        if (startIndex < 0 || maximumNodes <= 0) {
            state = "invalid_range"
        }
        if (active && !scalarOnly) {
            observeDisplayProgress(153u32)
        }
        let sceneNodes = if (active && state == "ok" && !scalarOnly) {
            renderedScene.nodes()
        } else {
            ArrayList<CjguiComposableUiLayoutNode>()
        }
        let total = if (active && !scalarOnly) {
            renderedScene.nodes().size
        } else {
            0
        }
        let begin = if (startIndex >= 0 && startIndex < total) {
            startIndex
        } else {
            total
        }
        let bound = if (maximumNodes > 256) {
            256
        } else {
            maximumNodes
        }
        var cursor = begin
        var resources = CjguiInternalRendererDiagnosticResources()
        var resourcesStatus = CJGUI_INTERNAL_RENDERER_INTERNAL_ERROR
        if (active && state == "ok" && !scalarOnly) {
            resourcesStatus = unsafe { cjgui_internal_renderer_diagnostic_resources(sessionToken, inout resources) }
            while (cursor < sceneNodes.size && resultNodes.size < bound) {
                let node = sceneNodes[cursor]
                let output = node.effectOutputBounds()
                let visible = node.bounds.intersect(node.clip).intersect(renderedScene.viewport)
                let visibleOutput = output.intersect(renderedScene.viewport)
                if (visible.width > 0 && visible.height > 0 || visibleOutput.width > 0 && visibleOutput.height > 0) {
                    let keyAvailable = node.identityKey.size <= 256
                    let clips = ArrayList<CjguiComposableUiDiagnosticClip>()
                    let originalClips = node.clipConstraints()
                    for (clip in originalClips) {
                        if (clips.size >= 4) {
                            break
                        }
                        let ownerAvailable = clip.ownerIdentity.size <= 256
                        clips.add(
                            CjguiComposableUiDiagnosticClip(clip.rect, clip.cornerRadius, if (ownerAvailable) {
                                clip.ownerIdentity
                            } else {
                                ""
                            }, ownerAvailable))
                    }
                    var geometry = CjguiInternalRendererDiagnosticNodeGeometry()
                    let eligible = submittedSceneVersion == acceptedVersion && submittedFrameIndex >= 0
                    let nativeStatus = if (eligible) {
                        unsafe { cjgui_internal_renderer_diagnostic_node_geometry(sessionToken, UInt32(cursor),
                            inout geometry) }
                    } else {
                        CJGUI_INTERNAL_RENDERER_INTERNAL_ERROR
                    }
                    let matching = eligible && nativeStatus == CJGUI_INTERNAL_RENDERER_OK && geometry.sceneVersion ==
                        UInt64(acceptedVersion) && geometry.frameIndex == UInt64(submittedFrameIndex)
                    let geometryState = if (!eligible) {
                        "not_submitted_for_version"
                    } else if (matching) {
                        "available"
                    } else {
                        "native_unavailable"
                    }
                    let nativeOutput: ?CjguiComposableUiDiagnosticFloatRect = if (matching && geometry.flags % 2u32 ==
                        1u32) {
                        Some(
                            CjguiComposableUiDiagnosticFloatRect(geometry.outputX, geometry.outputY,
                                geometry.outputWidth, geometry.outputHeight))
                    } else {
                        None
                    }
                    let nativeSample: ?CjguiComposableUiDiagnosticFloatRect = if (matching &&
                        (geometry.flags / 2u32) % 2u32 == 1u32) {
                        Some(
                            CjguiComposableUiDiagnosticFloatRect(geometry.sampleX, geometry.sampleY,
                                geometry.sampleWidth, geometry.sampleHeight))
                    } else {
                        None
                    }
                    let cacheDisposition = if (!matching) {
                        "unavailable"
                    } else if ((geometry.flags / 2u32) % 2u32 == 0u32) {
                        "not_sampled"
                    } else if ((geometry.flags / 4u32) % 2u32 == 1u32) {
                        "redrawn"
                    } else {
                        "reused"
                    }
                    resultNodes.add(
                        CjguiComposableUiDiagnosticNode(cursor, node.nodeId, node.resourceId, node.nodeKind,
                            if (keyAvailable) {
                                node.identityKey
                            } else {
                                ""
                            }, keyAvailable, node.bounds, node.clip, clips, originalClips.size <= 4, output,
                            geometryState, if (matching) {
                                Int64(geometry.sceneVersion)
                            } else {
                                -1
                            }, if (matching) {
                                Int64(geometry.frameIndex)
                            } else {
                                -1
                            }, nativeOutput, nativeSample, cacheDisposition))
                }
                cursor += 1
            }
        }
        let resourcesMatch = resourcesStatus == CJGUI_INTERNAL_RENDERER_OK && submittedFrameIndex >= 0 &&
            resources.sceneVersion == UInt64(acceptedVersion) && resources.frameIndex == UInt64(submittedFrameIndex)
        var scalarProgress = CjguiInternalRendererComposableDisplayProgress()
        var workload = CjguiInternalRendererDiagnosticWorkload()
        var timing = CjguiInternalRendererDiagnosticTiming()
        var scalarAvailable = false
        if (active && state == "ok" && scalarOnly) {
            let published = internalRendererDiagnosticScalarSnapshot(sessionToken, UInt64(acceptedVersion))
            let status = published.status
            scalarAvailable = status == CJGUI_INTERNAL_RENDERER_OK
            if (scalarAvailable) {
                scalarProgress = published.progress
                workload = published.workload
                timing = published.timing
            } else {
                state = if (status == CJGUI_INTERNAL_RENDERER_INVALID_SESSION) {
                    "stale_session"
                } else if (status == CJGUI_INTERNAL_RENDERER_SCENE_STALE) {
                    "stale_accepted"
                } else {
                    "pending_native_snapshot"
                }
            }
        }
        var workloadAvailable = scalarOnly && scalarAvailable && workloadDiagnosticsEnabled
        if (active && workloadDiagnosticsEnabled && !scalarOnly) {
            let workloadStatus = unsafe { cjgui_internal_renderer_diagnostic_workload(sessionToken, inout workload) }
            workloadAvailable = workloadStatus == CJGUI_INTERNAL_RENDERER_OK
            if (!workloadAvailable) {
                workloadDiagnosticsStatus = "native_unavailable"
            }
        }
        let workloadSceneVersion = if (workloadAvailable) {
            Int64(workload.sceneVersion)
        } else {
            -1
        }
        var timingAvailable = scalarOnly && scalarAvailable && timingDiagnosticsEnabled && timing.enabled == 1u32 &&
            timing.clockAvailable == 1u32 && timing.sceneVersion == UInt64(acceptedVersion)
        if (active && timingDiagnosticsEnabled && !scalarOnly) {
            let nativeTimingStatus = unsafe { cjgui_internal_renderer_diagnostic_timing(sessionToken, inout timing) }
            timingAvailable = nativeTimingStatus == CJGUI_INTERNAL_RENDERER_OK && timing.enabled == 1u32 &&
                timing.clockAvailable == 1u32 && timing.sceneVersion == UInt64(acceptedVersion)
            if (!timingAvailable) {
                timingDiagnosticsStatus = "native_unavailable"
            }
        }
        let timingStatus = if (!active) {
            "closed"
        } else if (!timingDiagnosticsEnabled) {
            "disabled"
        } else if (timingAvailable) {
            "enabled"
        } else if (scalarOnly) {
            state
        } else {
            timingDiagnosticsStatus
        }
        let scalarCommitted = scalarAvailable && scalarProgress.submittedFrameIndex > 0u64 &&
            scalarProgress.submittedBackingScale > 0.0
        let scalarGeometry = if (scalarAvailable) {
            CjguiSharedOperationWindowGeometry("available", scalarProgress.currentPointWidth,
                scalarProgress.currentPointHeight, scalarProgress.currentBackingScale,
                Int64(scalarProgress.currentDrawableWidthPixels), Int64(scalarProgress.currentDrawableHeightPixels),
                Int64(scalarProgress.currentGeometryRevision), if (scalarCommitted) {
                    "committed"
                } else {
                    "none"
                }, if (scalarCommitted) {
                    scalarProgress.submittedPointWidth
                } else {
                    0.0
                }, if (scalarCommitted) {
