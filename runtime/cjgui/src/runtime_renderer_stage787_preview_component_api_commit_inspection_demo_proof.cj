        didMaterializePublicPreviewContractResultSurfaceRefresh: Bool,
        didBindDemoProofToStage786CompatibilityLedger: Bool,
        didPrepareStage788PreviewComponentApiCommitInspectionPublicPreviewRuntimeManager: Bool,
        didKeepRendererSubmissionBlocked: Bool,
        didKeepRendererStateWriteBlocked: Bool,
        didKeepRuntimeStateWriteBlocked: Bool
    ) {
        this.didConsumeStage786PreviewComponentApiCommitInspectionCompatibilityLedger = didConsumeStage786PreviewComponentApiCommitInspectionCompatibilityLedger
        this.didConsumePublicPreviewCompatibilityLedger = didConsumePublicPreviewCompatibilityLedger
        this.didMaterializeTodoPublicPreviewContractProofSurface = didMaterializeTodoPublicPreviewContractProofSurface
        this.didMaterializeSettingsPublicPreviewContractProofSurface = didMaterializeSettingsPublicPreviewContractProofSurface
        this.didMaterializeAiGeneratedSettingsPublicPreviewContractProofSurface = didMaterializeAiGeneratedSettingsPublicPreviewContractProofSurface
        this.didMaterializeChatComposerPublicPreviewContractProofSurface = didMaterializeChatComposerPublicPreviewContractProofSurface
        this.didMaterializePublicPreviewContractHostInspectionReceipt = didMaterializePublicPreviewContractHostInspectionReceipt
        this.didMaterializePublicPreviewContractResultSurfaceRefresh = didMaterializePublicPreviewContractResultSurfaceRefresh
        this.didBindDemoProofToStage786CompatibilityLedger = didBindDemoProofToStage786CompatibilityLedger
        this.didPrepareStage788PreviewComponentApiCommitInspectionPublicPreviewRuntimeManager = didPrepareStage788PreviewComponentApiCommitInspectionPublicPreviewRuntimeManager
        this.didKeepRendererSubmissionBlocked = didKeepRendererSubmissionBlocked
        this.didKeepRendererStateWriteBlocked = didKeepRendererStateWriteBlocked
        this.didKeepRuntimeStateWriteBlocked = didKeepRuntimeStateWriteBlocked
    }
}

