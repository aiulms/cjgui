func cjguiInternalBuildRendererRealBackendPlatformObjectIntent(
    noPlatformObjectImplementationReadiness:
        CjguiInternalRendererNoPlatformObjectImplementationReadiness
): CjguiInternalRendererRealBackendPlatformObjectIntent {
    let upstreamEndpointReady =
        noPlatformObjectImplementationReadiness
            .isRendererNoPlatformObjectImplementationReady
    let upstreamCanEvaluate =
        noPlatformObjectImplementationReadiness
            .canFutureRendererPlatformObjectImplementationBoundaryEvaluate
    let upstreamShouldDefer =
        noPlatformObjectImplementationReadiness
            .shouldDeferRendererNoPlatformObjectImplementationReadiness
    let upstreamBlocked =
        noPlatformObjectImplementationReadiness
            .shouldReportRendererNoPlatformObjectImplementationReadinessBlocked
    let upstreamReady =
        upstreamEndpointReady &&
        upstreamCanEvaluate &&
        noPlatformObjectImplementationReadiness
            .didSealRendererNoPlatformObjectImplementationReadiness &&
        noPlatformObjectImplementationReadiness
            .didKeepNoPlatformObjectImplementationReadinessValueOnly &&
        noPlatformObjectImplementationReadiness
            .didConfirmNoPlatformObjectCreation &&
        noPlatformObjectImplementationReadiness
            .didAvoidPlatformObjectPermissionWrapper &&
        noPlatformObjectImplementationReadiness
            .didAvoidBackendImplementationWrapper &&
        noPlatformObjectImplementationReadiness
            .didAvoidReceiptRecordPublication &&
        noPlatformObjectImplementationReadiness.didAvoidThinWrapper &&
        noPlatformObjectImplementationReadiness.didStayFullRebuildOnly &&
        upstreamShouldDefer == false &&
        upstreamBlocked == false
    let upstreamDeferred =
        upstreamEndpointReady == false &&
        upstreamCanEvaluate == false &&
        upstreamShouldDefer &&
        upstreamBlocked == false
    let upstreamInconsistent =
        upstreamBlocked ||
        (
            upstreamEndpointReady &&
            (
                upstreamCanEvaluate == false ||
                noPlatformObjectImplementationReadiness
                    .didSealRendererNoPlatformObjectImplementationReadiness ==
                    false ||
                noPlatformObjectImplementationReadiness
                    .didKeepNoPlatformObjectImplementationReadinessValueOnly ==
                    false ||
                noPlatformObjectImplementationReadiness
                    .didConfirmNoPlatformObjectCreation == false ||
                noPlatformObjectImplementationReadiness
                    .didAvoidPlatformObjectPermissionWrapper == false ||
                noPlatformObjectImplementationReadiness
                    .didAvoidBackendImplementationWrapper == false ||
                noPlatformObjectImplementationReadiness
                    .didAvoidReceiptRecordPublication == false ||
                noPlatformObjectImplementationReadiness
                    .didAvoidThinWrapper == false ||
                noPlatformObjectImplementationReadiness
                    .didStayFullRebuildOnly == false ||
                upstreamShouldDefer
            )
        ) ||
        (upstreamCanEvaluate && upstreamEndpointReady == false) ||
        (upstreamShouldDefer && upstreamBlocked)

    if (upstreamInconsistent) {
        return CjguiInternalRendererRealBackendPlatformObjectIntent(
            noPlatformObjectImplementationReadiness,
            false,
            false,
            true,
            false,
            false,
            false,
            false,
            false,
            true,
            true,
            true,
            true,
            true
        )
    }

    if (upstreamReady) {
        return CjguiInternalRendererRealBackendPlatformObjectIntent(
            noPlatformObjectImplementationReadiness,
            true,
            false,
            false,
            true,
            true,
            true,
            true,
            true,
            true,
            true,
            true,
            true,
            true
        )
    }

    if (upstreamDeferred) {
        return CjguiInternalRendererRealBackendPlatformObjectIntent(
            noPlatformObjectImplementationReadiness,
            false,
            true,
            false,
            false,
            false,
            false,
            false,
            false,
            true,
            true,
            true,
            true,
            true
        )
    }

    return CjguiInternalRendererRealBackendPlatformObjectIntent(
        noPlatformObjectImplementationReadiness,
        false,
        false,
        true,
        false,
        false,
        false,
        false,
        false,
        true,
        true,
        true,
        true,
        true
    )
}

