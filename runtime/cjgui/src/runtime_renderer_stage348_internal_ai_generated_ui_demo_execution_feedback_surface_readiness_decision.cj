        executionFeedbackSurfaceProbeInputResultEnvelope.didConfirmOwnerAcceptanceRequired,
        executionFeedbackSurfaceProbeInputResultEnvelope.didConfirmOwnerAcceptanceGranted == false,
        executionFeedbackSurfaceProbeInputResultEnvelope.didConfirmBackendReadyTruth == false,
        executionFeedbackSurfaceProbeInputResultEnvelope.didConfirmPublicComponentApiAdded == false,
        executionFeedbackSurfaceProbeInputResultEnvelope.didConfirmActionDispatch == false,
        executionFeedbackSurfaceProbeInputResultEnvelope.didConfirmStateUpdateCommitted == false,
