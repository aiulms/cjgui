func cjguiInternalBuildRendererStage352InternalAiGeneratedUiDemoExecutionFeedbackProbeReadinessDecisionFacts(
    executionFeedbackProbeResultEnvelope: CjguiInternalRendererStage351InternalAiGeneratedUiDemoExecutionFeedbackProbeResultEnvelopeReadiness): CjguiInternalRendererStage352InternalAiGeneratedUiDemoExecutionFeedbackProbeReadinessDecisionFacts {
    let diffExplain = executionFeedbackProbeResultEnvelope.executionFeedbackSurfaceProbeSemanticDiffExplain
    let refresh = diffExplain.executionFeedbackSurfaceToProbeRefresh

    return CjguiInternalRendererStage352InternalAiGeneratedUiDemoExecutionFeedbackProbeReadinessDecisionFacts(
        executionFeedbackProbeResultEnvelope.didConfirmAiGeneratedUiDemoExecutionFeedbackProbeResultEnvelopeReady,
        refresh.didConfirmAiGeneratedUiDemoExecutionFeedbackSurfaceToProbeRefreshReady && diffExplain
            .didConfirmAiGeneratedUiDemoExecutionFeedbackSurfaceProbeSemanticDiffExplainReady,
        executionFeedbackProbeResultEnvelope.didConfirmAiGeneratedUiDemoExecutionFeedbackProbeResultEnvelopeMaterialized &&
            executionFeedbackProbeResultEnvelope
            .didConfirmExecutionFeedbackProbeResultEnvelopeBoundToFeedbackSurfaceProbeSemanticDiffExplain,
        executionFeedbackProbeResultEnvelope.didConfirmExecutionFeedbackProbeResultEnvelopeRollbackReady &&
            executionFeedbackProbeResultEnvelope.didConfirmExecutionFeedbackProbeResultEnvelopeVisibilityNotPublished,
        true,
        true,
        true,
        executionFeedbackProbeResultEnvelope.didConfirmOwnerAcceptanceRequired,
        executionFeedbackProbeResultEnvelope.didConfirmOwnerAcceptanceGranted == false,
        executionFeedbackProbeResultEnvelope.didConfirmBackendReadyTruth == false,
        executionFeedbackProbeResultEnvelope.didConfirmPublicComponentApiAdded == false,
        executionFeedbackProbeResultEnvelope.didConfirmActionDispatch == false,
        executionFeedbackProbeResultEnvelope.didConfirmStateUpdateCommitted == false,
        executionFeedbackProbeResultEnvelope.didConfirmRendererSubmissionBlocked,
        executionFeedbackProbeResultEnvelope.didConfirmRendererStateWriteBlocked,
        executionFeedbackProbeResultEnvelope.didConfirmRuntimeStateWriteBlocked,
        executionFeedbackProbeResultEnvelope.didConfirmVisibilityPublished == false
    )
}

