): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedResultEnvelopeFirstFrameObservationAfterPresentSchedulingContractFirstSliceReadiness {
    let inputReady =
        firstFrameFacts
            .didConsumePresentSchedulingAfterCommitNoPresentContract &&
        presentScheduling.didConfirmPresentSchedulingOrdering &&
        presentScheduling.didConfirmPresentSchedulingStopLine
    let contractReady =
        firstFrameFacts.didRequireStage141PresentSchedulingPacket &&
        firstFrameFacts
            .didRequirePositivePresentSchedulingBeforeFirstFrameObservation &&
        firstFrameFacts.didRequireBoundedFirstFrameObservationProbe &&
        firstFrameFacts.didRequireProbeLocalVisibleWindowCapture &&
        firstFrameFacts.didRequireFrameHashSummary &&
        firstFrameFacts.didRequireNoFrameHashPersistence &&
        firstFrameFacts.didRequireNoFrameHashValueLogging &&
        firstFrameFacts.didRequireNoBaselineComparison &&
        firstFrameFacts.didAllowFirstFrameObservedEnvelope
    let stopLineReady =
        firstFrameFacts.didKeepProductionTruthPromotionBlocked &&
        firstFrameFacts.didKeepBackendReadyTruthBlocked &&
        firstFrameFacts.didKeepRendererStateWriteAdmissionBlocked &&
        firstFrameFacts.didKeepRendererStateWriteBlocked &&
        firstFrameFacts.didKeepRuntimeStateWriteBlocked &&
        firstFrameFacts.didConfirmNoNativeBridgeExpansion &&
        firstFrameFacts.didConfirmNoPublicApi &&
        firstFrameFacts.didConfirmNoProductionPublicCAbi &&
        firstFrameFacts.didConfirmNoRuntimeStateWrite &&
        firstFrameFacts.didConfirmNoCjpmTomlChange &&
        firstFrameFacts.didConfirmNoRendererStateWrite

    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationRuntimeNativeProbeD3BoundedResultEnvelopeFirstFrameObservationAfterPresentSchedulingContractFirstSliceReadiness(
        presentScheduling,
        firstFrameFacts,
        inputReady && contractReady && stopLineReady,
        firstFrameFacts.didConsumePresentSchedulingAfterCommitNoPresentContract,
        firstFrameFacts.didRequireStage141PresentSchedulingPacket,
        firstFrameFacts
            .didRequirePositivePresentSchedulingBeforeFirstFrameObservation,
        firstFrameFacts.didRequireBoundedFirstFrameObservationProbe,
        firstFrameFacts.didRequireProbeLocalVisibleWindowCapture,
        firstFrameFacts.didRequireFrameHashSummary,
        firstFrameFacts.didRequireNoFrameHashPersistence,
        firstFrameFacts.didRequireNoFrameHashValueLogging,
        firstFrameFacts.didRequireNoBaselineComparison,
        firstFrameFacts.didAllowFirstFrameObservedEnvelope,
        inputReady,
        contractReady,
        stopLineReady,
        firstFrameFacts.didKeepProductionTruthPromotionBlocked,
        firstFrameFacts.didKeepBackendReadyTruthBlocked,
        firstFrameFacts.didKeepRendererStateWriteAdmissionBlocked,
        firstFrameFacts.didKeepRendererStateWriteBlocked,
        firstFrameFacts.didKeepRuntimeStateWriteBlocked,
        firstFrameFacts.didConfirmNoNativeBridgeExpansion,
        firstFrameFacts.didConfirmNoPublicApi,
        firstFrameFacts.didConfirmNoProductionPublicCAbi,
        firstFrameFacts.didConfirmNoRuntimeStateWrite,
        firstFrameFacts.didConfirmNoCjpmTomlChange,
