func cjguiInternalBuildRendererRealBackendPlatformObjectFailurePolicy(
    teardownProof:
        CjguiInternalRendererRealBackendPlatformObjectTeardownProof
): CjguiInternalRendererRealBackendPlatformObjectFailurePolicy {
    let proofReady =
        teardownProof.didPrepareRendererRealBackendPlatformObjectTeardownProof &&
        teardownProof.didPreserveRendererRealBackendPlatformObjectShellPolicy &&
        teardownProof.didDefineOwnerLocalTeardownProof &&
        teardownProof.didDescribeTeardownOrderingProof &&
        teardownProof.didDescribeRepeatableCloseProof &&
        teardownProof.didDescribeFailureSafeCloseProof &&
        teardownProof.didConfirmNoExternalLifecycleCall &&
        teardownProof.didConfirmNoStateMutation &&
        teardownProof.didConfirmNoPublicSurface &&
        teardownProof
