func cjguiInternalBuildRendererStage308InternalAiGeneratedUiDemoComponentStateRenderReadinessDecisionFacts(
    internalAiGeneratedUiDemoComponentRenderCommandPreview:
        CjguiInternalRendererStage307InternalAiGeneratedUiDemoComponentRenderCommandPreviewReadiness
): CjguiInternalRendererStage308InternalAiGeneratedUiDemoComponentStateRenderReadinessDecisionFacts {
    let stateDelta =
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .internalAiGeneratedUiDemoComponentStateDeltaDryRun
    let dryRunInput =
        stateDelta.internalAiGeneratedUiDemoComponentStateRenderDryRunInput

    return CjguiInternalRendererStage308InternalAiGeneratedUiDemoComponentStateRenderReadinessDecisionFacts(
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .didConfirmInternalAiGeneratedUiComponentRenderCommandPreviewReady,
        dryRunInput
            .didConfirmInternalAiGeneratedUiComponentStateRenderDryRunInputReady &&
            stateDelta
                .didConfirmInternalAiGeneratedUiComponentStateDeltaDryRunReady,
        stateDelta
            .didConfirmInternalAiGeneratedUiComponentStateDeltaDryRunReady &&
            internalAiGeneratedUiDemoComponentRenderCommandPreview
                .didConfirmGeneratedComponentRenderPreviewBoundToStateDeltaDryRun,
        stateDelta
            .didConfirmGeneratedComponentStateDeltaBoundToRollbackReadyBoundary,
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .didConfirmVisibilityPublished == false,
        true,
        true,
        true,
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .didConfirmOwnerAcceptanceRequired,
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .didConfirmOwnerAcceptanceGranted == false,
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .didConfirmBackendReadyTruth == false,
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .didConfirmPublicComponentApiAdded == false,
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .didConfirmActionDispatch == false,
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .didConfirmStateUpdateCommitted == false,
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .didConfirmRendererSubmissionBlocked,
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .didConfirmRendererStateWriteBlocked,
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .didConfirmRuntimeStateWriteBlocked,
        internalAiGeneratedUiDemoComponentRenderCommandPreview
            .didConfirmVisibilityPublished == false
    )
}

