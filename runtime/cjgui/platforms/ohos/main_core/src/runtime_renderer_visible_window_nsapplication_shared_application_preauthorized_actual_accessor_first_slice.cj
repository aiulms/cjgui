func cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSliceFacts(
    postWitnessPacketActualAccessorCallPreflightReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationPostWitnessPacketActualAccessorCallPreflightReadiness,
    throwawayCreationProbeEvidenceReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationThrowawayCreationProbeEvidenceReadiness
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSliceFacts {
    let isolatedProbeEvidenceReadiness =
        throwawayCreationProbeEvidenceReadiness
            .nsApplicationSharedApplicationIsolatedActualAccessorCallProbeEvidenceReadiness
    let postWitnessReady =
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didPreparePostWitnessPacketActualAccessorCallPreflight &&
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didRequireExplicitHumanDecisionBeforeActualCallFirstSlice &&
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoProductionActualAccessorCallSite &&
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoActivationPolicyMutation &&
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoApplicationActivation &&
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoAppKitEventLoop &&
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoBoundedRunLoopPump &&
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoRuntimeStateWrite &&
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoCjpmTomlChange
    let isolatedProbeReady =
        isolatedProbeEvidenceReadiness
            .didPrepareRendererVisibleWindowNsApplicationSharedApplicationIsolatedActualAccessorCallProbeEvidenceReadiness &&
        isolatedProbeEvidenceReadiness
            .didConfineActualAccessorCallToIsolatedNativeProbe &&
        isolatedProbeEvidenceReadiness
            .didFailClosedWhenPreexistingApplicationMissing &&
        isolatedProbeEvidenceReadiness.didReturnIntegerClassificationOnly &&
        isolatedProbeEvidenceReadiness.didReturnDehydratedFactsOnly &&
        isolatedProbeEvidenceReadiness.didConfirmNoApplicationCreation &&
        isolatedProbeEvidenceReadiness.didConfirmNoActivationPolicyMutation &&
        isolatedProbeEvidenceReadiness.didConfirmNoApplicationActivation &&
        isolatedProbeEvidenceReadiness.didConfirmNoAppKitEventLoop &&
        isolatedProbeEvidenceReadiness.didConfirmNoBoundedRunLoopPump &&
        isolatedProbeEvidenceReadiness.didConfirmNoWindowCreation &&
        isolatedProbeEvidenceReadiness.didConfirmNoVisibleOrder &&
        isolatedProbeEvidenceReadiness.didConfirmNoDrawable &&
        isolatedProbeEvidenceReadiness.didConfirmNoRender &&
        isolatedProbeEvidenceReadiness.didConfirmNoArtifactPublication &&
        isolatedProbeEvidenceReadiness.didConfirmNoPublicApi &&
        isolatedProbeEvidenceReadiness.didConfirmNoProductionPublicCAbi &&
        isolatedProbeEvidenceReadiness.didConfirmNoRuntimeStateWrite &&
        isolatedProbeEvidenceReadiness.didConfirmNoCjpmTomlChange
    let throwawayReady =
        throwawayCreationProbeEvidenceReadiness
            .didPrepareRendererVisibleWindowNsApplicationSharedApplicationThrowawayCreationProbeEvidenceReadiness &&
        throwawayCreationProbeEvidenceReadiness
            .didConfirmExplicitHumanApprovalForThrowawayCreationProbeFirstSlice &&
        throwawayCreationProbeEvidenceReadiness
            .didConfineThrowawayCreationToIsolatedNativeProbe &&
        throwawayCreationProbeEvidenceReadiness
            .didAllowNsApplicationSharedApplicationToCreateThrowawaySingleton &&
        throwawayCreationProbeEvidenceReadiness
            .didRecordThrowawayCreationEvidenceNotProductionOwnershipTruth &&
        throwawayCreationProbeEvidenceReadiness
            .didReturnIntegerClassificationOnly &&
        throwawayCreationProbeEvidenceReadiness.didReturnDehydratedFactsOnly &&
        throwawayCreationProbeEvidenceReadiness
            .didKeepNsApplicationSharedApplicationThrowawayCreationProbeEvidenceReadinessDehydrated

    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSliceFacts(
        postWitnessReady,
        isolatedProbeReady,
        throwawayReady,
        true,
        true,
        true,
        isolatedProbeEvidenceReadiness
            .didFailClosedWhenPreexistingApplicationMissing,
        throwawayCreationProbeEvidenceReadiness
            .didAllowNsApplicationSharedApplicationToCreateThrowawaySingleton,
        throwawayCreationProbeEvidenceReadiness
            .didRecordThrowawayCreationEvidenceNotProductionOwnershipTruth,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoProductionActualAccessorCallSite,
        true,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoActivationPolicyMutation,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoApplicationActivation,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoAppKitEventLoop,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoBoundedRunLoopPump,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoCleanupTeardownExecution,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoWindowViewLayerCreation,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoVisibleOrder,
        postWitnessPacketActualAccessorCallPreflightReadiness.didConfirmNoDrawable,
        true,
        true,
        true,
        postWitnessPacketActualAccessorCallPreflightReadiness.didConfirmNoPublicApi,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoProductionPublicCAbi,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoRuntimeStateWrite,
        postWitnessPacketActualAccessorCallPreflightReadiness.didConfirmNoCjpmTomlChange,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoPointerHandleClassIdReturn,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoRendererStateWrite,
        postWitnessPacketActualAccessorCallPreflightReadiness
            .didConfirmNoBackendReadyTruth,
        true
    )
}

func cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSlice(
    facts:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSliceFacts
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSlice {
    let admitted =
        facts.didPreservePostWitnessPacketActualAccessorCallPreflightReadiness &&
        facts.didPreserveIsolatedActualAccessorCallProbeEvidenceReadiness &&
        facts.didPreserveThrowawayCreationProbeEvidenceReadiness &&
        facts.didConsumeAutomationPreauthorizationForActualAccessorFirstSlice &&
        facts
            .didResolvePreviousExplicitApprovalBlockerInsidePreauthorizedRunway &&
        facts.didKeepActualAccessorCallInIsolatedNativeProbeOnly &&
        facts.didConfirmPreexistingSingletonMissingPathFailClosed &&
        facts.didConfirmThrowawayCreationEvidenceObserved &&
        facts.didRejectThrowawayCreationAsProductionOwnershipTruth &&
        facts.didConfirmNoProductionActualAccessorCallSite &&
        facts.didConfirmNoProductionSingletonOwnerImplementation &&
        facts.didConfirmNoActivationPolicyMutation &&
        facts.didConfirmNoApplicationActivation &&
        facts.didConfirmNoAppKitEventLoop &&
        facts.didConfirmNoBoundedRunLoopPump &&
        facts.didConfirmNoCleanupTeardownExecution &&
        facts.didConfirmNoWindowViewLayerCreation &&
        facts.didConfirmNoVisibleOrder &&
        facts.didConfirmNoDrawable &&
        facts.didConfirmNoCommandQueueBufferEncoder &&
        facts.didConfirmNoRenderCommitPresentGpuSubmission &&
        facts.didConfirmNoArtifactOrDiagnosticsPublication &&
        facts.didConfirmNoPublicApi &&
        facts.didConfirmNoProductionPublicCAbi &&
        facts.didConfirmNoRuntimeStateWrite &&
        facts.didConfirmNoCjpmTomlChange &&
        facts.didConfirmNoPointerHandleClassIdReturn &&
        facts.didConfirmNoRendererStateWrite &&
        facts.didConfirmNoBackendReadyTruth &&
        facts.didKeepPreauthorizedActualAccessorFirstSliceValueOnly

    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSlice(
        facts,
        admitted,
        !admitted,
        !admitted,
        facts.didConsumeAutomationPreauthorizationForActualAccessorFirstSlice,
        facts.didConfirmThrowawayCreationEvidenceObserved,
        facts.didRejectThrowawayCreationAsProductionOwnershipTruth,
        facts.didConfirmNoProductionActualAccessorCallSite,
        facts.didKeepPreauthorizedActualAccessorFirstSliceValueOnly
    )
}

func cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSliceReadiness(
    postWitnessPacketActualAccessorCallPreflightReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationPostWitnessPacketActualAccessorCallPreflightReadiness,
    throwawayCreationProbeEvidenceReadiness:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationThrowawayCreationProbeEvidenceReadiness,
    preauthorizedActualAccessorFirstSlice:
        CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSlice
): CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSliceReadiness {
    let admitted =
        preauthorizedActualAccessorFirstSlice
            .didAdmitPreauthorizedActualAccessorFirstSlice
    let facts =
        preauthorizedActualAccessorFirstSlice
            .preauthorizedActualAccessorFirstSliceFacts

    return CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSliceReadiness(
        postWitnessPacketActualAccessorCallPreflightReadiness,
        throwawayCreationProbeEvidenceReadiness,
        preauthorizedActualAccessorFirstSlice,
        admitted,
        !admitted,
        !admitted,
        facts.didConsumeAutomationPreauthorizationForActualAccessorFirstSlice,
        facts.didKeepActualAccessorCallInIsolatedNativeProbeOnly,
        preauthorizedActualAccessorFirstSlice
            .didConfirmThrowawayCreationEvidenceObserved,
        preauthorizedActualAccessorFirstSlice
            .didRejectThrowawayCreationAsProductionOwnershipTruth,
        preauthorizedActualAccessorFirstSlice
            .didConfirmNoProductionActualAccessorCallSite,
        facts.didConfirmNoRuntimeStateWrite,
        facts.didConfirmNoCjpmTomlChange,
        facts.didKeepPreauthorizedActualAccessorFirstSliceValueOnly
    )
}

func cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSliceDraft():
    CjguiInternalRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSliceReadiness {
    let postWitnessPacketActualAccessorCallPreflightReadiness =
        cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationPostWitnessPacketActualAccessorCallPreflightDraft()
    let throwawayCreationProbeEvidenceReadiness =
        cjguiInternalExecuteDefaultRendererVisibleWindowNsApplicationSharedApplicationThrowawayCreationProbeEvidenceDraft()
    let facts =
        cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSliceFacts(
            postWitnessPacketActualAccessorCallPreflightReadiness,
            throwawayCreationProbeEvidenceReadiness
        )
    let preauthorizedActualAccessorFirstSlice =
        cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSlice(
            facts
        )
    return cjguiInternalBuildRendererVisibleWindowNsApplicationSharedApplicationPreauthorizedActualAccessorFirstSliceReadiness(
        postWitnessPacketActualAccessorCallPreflightReadiness,
        throwawayCreationProbeEvidenceReadiness,
        preauthorizedActualAccessorFirstSlice
    )
}
