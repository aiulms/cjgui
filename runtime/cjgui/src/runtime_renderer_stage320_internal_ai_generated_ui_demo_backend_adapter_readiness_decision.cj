func cjguiInternalBuildRendererStage320InternalAiGeneratedUiDemoBackendAdapterReadinessDecisionFacts(
    backendAdapterSemanticDiffExplain:
        CjguiInternalRendererStage319InternalAiGeneratedUiDemoBackendAdapterSemanticDiffExplainReadiness
): CjguiInternalRendererStage320InternalAiGeneratedUiDemoBackendAdapterReadinessDecisionFacts {
    let resultEnvelope = backendAdapterSemanticDiffExplain.backendAdapterResultEnvelope
    let adapterDryRun = resultEnvelope.aiGeneratedUiActionLoopBackendAdapterDryRun
    let actionLoop = adapterDryRun.internalAiGeneratedUiDemoActionLoopReadinessDecision

    return CjguiInternalRendererStage320InternalAiGeneratedUiDemoBackendAdapterReadinessDecisionFacts(
        backendAdapterSemanticDiffExplain
            .didConfirmAiGeneratedUiBackendAdapterSemanticDiffExplainReady,
        adapterDryRun.didConfirmAiGeneratedUiActionLoopBackendAdapterDryRunReady &&
            resultEnvelope
                .didConfirmAiGeneratedUiBackendAdapterDryRunResultEnvelopeReady,
        resultEnvelope
            .didConfirmAiGeneratedUiBackendAdapterDryRunResultEnvelopeReady &&
            backendAdapterSemanticDiffExplain
                .didConfirmAiGeneratedUiBackendAdapterSemanticDiffMaterialized &&
            backendAdapterSemanticDiffExplain
                .didConfirmAiGeneratedUiBackendAdapterExplainPacketMaterialized,
        actionLoop
            .didConfirmAiGeneratedUiActionLoopJoinedWithRollbackReadyBoundary &&
            actionLoop
                .didConfirmAiGeneratedUiActionLoopJoinedWithVisibilityNotPublishedBoundary &&
            resultEnvelope.didConfirmBackendAdapterResultVisibilityNotPublished,
        true,
        true,
        true,
        backendAdapterSemanticDiffExplain.didConfirmOwnerAcceptanceRequired,
        backendAdapterSemanticDiffExplain
            .didConfirmOwnerAcceptanceGranted == false,
        backendAdapterSemanticDiffExplain.didConfirmBackendReadyTruth == false,
        resultEnvelope.didConfirmPlatformCommandBufferBlocked,
        backendAdapterSemanticDiffExplain.didConfirmRendererSubmissionBlocked,
        backendAdapterSemanticDiffExplain.didConfirmRendererStateWriteBlocked,
        backendAdapterSemanticDiffExplain.didConfirmRuntimeStateWriteBlocked,
        backendAdapterSemanticDiffExplain.didConfirmVisibilityPublished == false
    )
}

func cjguiInternalBuildRendererStage320InternalAiGeneratedUiDemoBackendAdapterReadinessDecisionReadiness(
