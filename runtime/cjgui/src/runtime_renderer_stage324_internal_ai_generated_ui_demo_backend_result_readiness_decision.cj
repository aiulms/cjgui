func cjguiInternalBuildRendererStage324InternalAiGeneratedUiDemoBackendResultReadinessDecisionFacts(
    backendResultStateRenderBridge: CjguiInternalRendererStage323InternalAiGeneratedUiDemoBackendResultStateRenderBridgeReadiness): CjguiInternalRendererStage324InternalAiGeneratedUiDemoBackendResultReadinessDecisionFacts {
    let diffExplain = backendResultStateRenderBridge.backendResultSemanticDiffExplain
    let preview = diffExplain.aiGeneratedUiBackendResultPreview

    return CjguiInternalRendererStage324InternalAiGeneratedUiDemoBackendResultReadinessDecisionFacts(
        backendResultStateRenderBridge.didConfirmAiGeneratedUiBackendResultStateRenderBridgeReady,
        preview.didConfirmAiGeneratedUiBackendResultPreviewReady && diffExplain
            .didConfirmAiGeneratedUiBackendResultSemanticDiffExplainReady,
        backendResultStateRenderBridge.didConfirmBackendResultBoundToOwnerLocalStateUpdateDryRun && backendResultStateRenderBridge
            .didConfirmBackendResultBoundToRefreshedRenderCommandPreview,
        preview.didConfirmBackendAdapterRollbackVisibilityBoundaryPreserved && diffExplain
            .didConfirmBackendResultRollbackReadyBoundaryMaterialized && backendResultStateRenderBridge
            .didConfirmBackendResultVisibilityPublicationRejected,
        true,
        true,
        true,
        backendResultStateRenderBridge.didConfirmOwnerAcceptanceRequired,
        backendResultStateRenderBridge.didConfirmOwnerAcceptanceGranted == false,
        backendResultStateRenderBridge.didConfirmBackendReadyTruth == false,
        backendResultStateRenderBridge.didConfirmPublicComponentApiAdded == false,
        backendResultStateRenderBridge.didConfirmStateUpdateCommitted == false,
        backendResultStateRenderBridge.didConfirmRendererSubmissionBlocked,
        backendResultStateRenderBridge.didConfirmRendererStateWriteBlocked,
        backendResultStateRenderBridge.didConfirmRuntimeStateWriteBlocked,
        backendResultStateRenderBridge.didConfirmVisibilityPublished == false
    )
}

