        .didKeepRendererStateWriteBlocked && executionReadinessDecisionFacts.didKeepRuntimeStateWriteBlocked && executionReadinessDecisionFacts
        .didKeepVisibilityNotPublished

    return CjguiInternalRendererStage332InternalAiGeneratedUiDemoExecutionReadinessDecisionReadiness(
        executionSemanticDiffExplain,
        executionReadinessDecisionFacts,
        decisionReady && stopLineReady,
        decisionReady && stopLineReady,
        executionReadinessDecisionFacts.didJoinExecutionDryRunWithResultEnvelope,
